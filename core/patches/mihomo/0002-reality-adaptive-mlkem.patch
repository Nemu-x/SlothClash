+	report := func(ok bool) {
+		if adaptive {
+			realityReportMLKEM(memoKey, useMLKEM, ok, conn.RemoteAddr())
+		}
+	}
 	for retry := 0; ; retry++ {
 		verifier := &realityVerifier{
 			serverName: serverName,
@@ -61,7 +185,17 @@ func GetRealityConn(ctx context.Context, conn net.Conn, fingerprint UClientHello
 			return nil, err
 		}
 
-		if !realityConfig.SupportX25519MLKEM768 { // for X25519MLKEM768 does not work properly with the old reality server
+		// Only the chrome specs in utls carry the hybrid share. When the hybrid
+		// handshake is wanted (forced, or learned because the server rejected the
+		// classic one) and this fingerprint cannot produce it, chrome is the only
+		// hello that can still reach that server; swap it for this handshake.
+		if useMLKEM && !realityHasMLKEMShare(uConn) && fingerprint.Client != utls.HelloChrome_Auto.Client {
+			log.Debugln("REALITY %v: %s fingerprint has no X25519MLKEM768 share, using chrome", conn.RemoteAddr(), fingerprint.Client)
+			fingerprint = utls.HelloChrome_Auto
+			continue
+		}
+
+		if !useMLKEM { // for X25519MLKEM768 does not work properly with the old reality server
 			err = BuildRemovedX25519MLKEM768HandshakeState(uConn)
 			if err != nil {
 				return nil, err
@@ -123,16 +257,19 @@ func GetRealityConn(ctx context.Context, conn net.Conn, fingerprint UClientHello
 
 		err = uConn.HandshakeContext(ctx)
 		if err != nil {
+			report(false)
 			return nil, err
 		}
 
 		log.Debugln("REALITY Authentication: %v, AEAD: %T", verifier.verified, aeadCipher)
 
 		if !verifier.verified {
+			report(false)
 			go realityClientFallback(uConn, uConfig.ServerName, fingerprint)
 			return nil, errors.New("REALITY authentication failed")
 		}
 
+		report(true)
 		return uConn, nil
 	}
 }
diff --git a/component/tls/reality_mlkem_memo_test.go b/component/tls/reality_mlkem_memo_test.go
new file mode 100644
index 00000000..4a113b30
--- /dev/null
+++ b/component/tls/reality_mlkem_memo_test.go
@@ -0,0 +1,82 @@
+package tls
+
+import (
+	"crypto/ecdh"
+	"crypto/rand"
+	"net"
+	"testing"
+)
+
+type fakeAddr string
+
+func (a fakeAddr) Network() string { return "tcp" }
+func (a fakeAddr) String() string  { return string(a) }
+
+func realityMemoTestConfig(t *testing.T, force bool) *RealityConfig {
+	t.Helper()
+	key, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &RealityConfig{PublicKey: key.PublicKey(), SupportX25519MLKEM768: force}
+}
+
+func TestRealityMLKEMMemoLearnsPerServer(t *testing.T) {
+	ResetRealityMLKEMMemo()
+	SetRealityMLKEMPolicy(RealityMLKEMAuto)
+	SetRealityMLKEMFirst(false)
+	config := realityMemoTestConfig(t, false)
+	addr := net.Addr(fakeAddr("203.0.113.1:443"))
+	key := addr.String() + "|" + string(config.PublicKey.Bytes())
+
+	mlkem, adaptive := realityChooseMLKEM(key, config)
+	if mlkem || !adaptive {
+		t.Fatalf("first guess = (%v, %v), want classic and adaptive", mlkem, adaptive)
+	}
+	realityReportMLKEM(key, false, false, addr) // new-generation server rejected the classic hello
+	if mlkem, _ = realityChooseMLKEM(key, config); !mlkem {
+		t.Fatal("memo did not flip to X25519MLKEM768 after a classic failure")
+	}
+	realityReportMLKEM(key, true, true, addr)
+	for i := 0; i < realityMemoFlipAfter-1; i++ {
+		realityReportMLKEM(key, true, false, addr) // transient failures must not unpin a confirmed verdict
+	}
+	if mlkem, _ = realityChooseMLKEM(key, config); !mlkem {
+		t.Fatal("pinned verdict was dropped by transient failures")
+	}
+	realityReportMLKEM(key, true, false, addr)
+	if mlkem, _ = realityChooseMLKEM(key, config); mlkem {
+		t.Fatal("verdict did not flip after repeated failures (server downgrade)")
+	}
+
+	other := addr.String() + "|" + string(realityMemoTestConfig(t, false).PublicKey.Bytes())
+	if mlkem, _ = realityChooseMLKEM(other, config); mlkem {
+		t.Fatal("memo leaked between different public keys")
+	}
+}
+
+func TestRealityMLKEMPolicyOverridesMemo(t *testing.T) {
+	ResetRealityMLKEMMemo()
+	defer SetRealityMLKEMPolicy(RealityMLKEMAuto)
+	config := realityMemoTestConfig(t, false)
+	key := "198.51.100.1:443|" + string(config.PublicKey.Bytes())
+
+	SetRealityMLKEMPolicy(RealityMLKEMOn)
+	if mlkem, adaptive := realityChooseMLKEM(key, config); !mlkem || adaptive {
+		t.Fatalf("On policy = (%v, %v), want forced hybrid", mlkem, adaptive)
+	}
+	SetRealityMLKEMPolicy(RealityMLKEMOff)
+	if mlkem, adaptive := realityChooseMLKEM(key, config); mlkem || adaptive {
+		t.Fatalf("Off policy = (%v, %v), want forced classic", mlkem, adaptive)
+	}
+	SetRealityMLKEMPolicy(RealityMLKEMAuto)
+	if mlkem, adaptive := realityChooseMLKEM(key, realityMemoTestConfig(t, true)); !mlkem || adaptive {
+		t.Fatalf("per-proxy support-x25519mlkem768 = (%v, %v), want forced hybrid", mlkem, adaptive)
+	}
+}
+
+func TestRealityClientVersionDefault(t *testing.T) {
+	if RealityClientVersion == [3]byte{1, 8, 2} {
+		t.Fatal("client version still reports the legacy 1.8.2")
+	}
+}
