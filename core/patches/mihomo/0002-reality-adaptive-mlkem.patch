+package tls
+
+import (
+	"context"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/binary"
+	"io"
+	"math/big"
+	"net"
+	"sync"
+	"testing"
+	"time"
+
+	utls "github.com/metacubex/utls"
+)
+
+// realityTestServer serves one loopback connection with serve and returns the
+// address to dial.
+func realityTestServer(t *testing.T, serve func(net.Conn)) string {
+	t.Helper()
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		c, err := l.Accept()
+		if err != nil {
+			return
+		}
+		defer c.Close()
+		serve(c)
+	}()
+	t.Cleanup(func() { l.Close(); wg.Wait() })
+	return l.Addr().String()
+}
+
+// recordingConn keeps every byte the server reads: the client's hello first.
+type recordingConn struct {
+	net.Conn
+	buf []byte
+}
+
+func (c *recordingConn) Read(p []byte) (int, error) {
+	n, err := c.Conn.Read(p)
+	c.buf = append(c.buf, p[:n]...)
+	return n, err
+}
+
+// coverSite answers like the site an Xray server relays an unauthenticated
+// client to: a complete TLS handshake with a certificate REALITY cannot verify.
+// It sends the key shares of the client's hello on hello.
+func coverSite(t *testing.T, hello chan<- []utls.KeyShare) func(net.Conn) {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tmpl := &x509.Certificate{
+		SerialNumber: big.NewInt(1),
+		Subject:      pkix.Name{CommonName: "www.example.com"},
+		DNSNames:     []string{"www.example.com"},
+		NotBefore:    time.Now().Add(-time.Hour),
+		NotAfter:     time.Now().Add(time.Hour),
+	}
+	der, err := x509.CreateCertificate(rand.Reader, tmpl, tmpl, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	config := &tls.Config{Certificates: []tls.Certificate{{Certificate: [][]byte{der}, PrivateKey: key}}}
+	return func(c net.Conn) {
+		rc := &recordingConn{Conn: c}
+		_ = c.SetDeadline(time.Now().Add(5 * time.Second))
+		_ = tls.Server(rc, config).Handshake()
+		if hello != nil {
+			hello <- parseHelloKeyShares(rc.buf)
+		}
+	}
+}
+
+func parseHelloKeyShares(record []byte) []utls.KeyShare {
+	if len(record) < 5 || record[0] != 0x16 {
+		return nil
+	}
+	n := int(binary.BigEndian.Uint16(record[3:5]))
+	if len(record) < 5+n {
+		return nil
+	}
+	msg := utls.UnmarshalClientHello(record[5 : 5+n])
+	if msg == nil {
+		return nil
+	}
+	return msg.KeyShares
+}
+
+func hasHybridShare(shares []utls.KeyShare) bool {
+	for _, ks := range shares {
+		if ks.Group == utls.X25519MLKEM768 {
+			return true
+		}
+	}
+	return false
+}
+
+func realityMemoSnapshot(key string) (realityMemoEntry, bool) {
+	realityMemo.Lock()
+	defer realityMemo.Unlock()
+	if entry, ok := realityMemo.entries[key]; ok {
+		return *entry, true
+	}
+	return realityMemoEntry{}, false
+}
+
+// realityTestHandshake runs one REALITY handshake against addr and returns its
+// error and the memo key of that server.
+func realityTestHandshake(t *testing.T, ctx context.Context, addr string, fingerprint UClientHelloID, config *RealityConfig) (string, error) {
+	t.Helper()
+	conn, err := net.Dial("tcp", addr)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	key := realityMemoKey(conn, config)
+	_, err = GetRealityConn(ctx, conn, fingerprint, "www.example.com", config)
+	return key, err
+}
+
+func TestRealityMLKEMMemoIgnoresNetworkFailures(t *testing.T) {
+	defer ResetRealityMLKEMMemo()
+	SetRealityMLKEMPolicy(RealityMLKEMAuto)
+	SetRealityMLKEMFirst(false)
+	cancelled, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	for _, tc := range []struct {
+		name  string
+		ctx   context.Context
+		serve func(net.Conn)
+	}{
+		{"closed before the hello", context.Background(), func(net.Conn) {}},
+		{"reset after the hello", context.Background(), func(c net.Conn) {
+			_, _ = c.Read(make([]byte, 4096))
+			if tcp, ok := c.(*net.TCPConn); ok {
+				_ = tcp.SetLinger(0)
+			}
+		}},
+		{"closed after the hello", context.Background(), func(c net.Conn) {
+			_, _ = io.ReadFull(c, make([]byte, 5))
+		}},
+		{"silent until the timeout", nil, func(c net.Conn) {
+			_, _ = io.Copy(io.Discard, c)
+		}},
+		{"not a TLS server", context.Background(), func(c net.Conn) {
+			_, _ = c.Read(make([]byte, 4096))
+			_, _ = c.Write([]byte("HTTP/1.1 400 Bad Request\r\nConnection: close\r\n\r\n"))
+		}},
+		{"request cancelled", cancelled, func(c net.Conn) {
+			_, _ = io.Copy(io.Discard, c)
+		}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ResetRealityMLKEMMemo()
+			ctx := tc.ctx
+			if ctx == nil {
+				var cancel context.CancelFunc
+				ctx, cancel = context.WithTimeout(context.Background(), 300*time.Millisecond)
+				defer cancel()
+			}
+			config := realityMemoTestConfig(t, false)
+			key, err := realityTestHandshake(t, ctx, realityTestServer(t, tc.serve), utls.HelloChrome_Auto, config)
+			if err == nil {
+				t.Fatal("handshake succeeded")
+			}
+			if entry, ok := realityMemoSnapshot(key); ok {
+				t.Fatalf("%v moved the memo: %+v", err, entry)
+			}
+			if mlkem, _ := realityChooseMLKEM(key, config); mlkem {
+				t.Fatal("next attempt switched to X25519MLKEM768 after a network failure")
+			}
+		})
+	}
+}
+
+func TestRealityMLKEMMemoLearnsFromCoverSite(t *testing.T) {
+	defer ResetRealityMLKEMMemo()
+	ResetRealityMLKEMMemo()
+	SetRealityMLKEMPolicy(RealityMLKEMAuto)
+	SetRealityMLKEMFirst(false)
+	config := realityMemoTestConfig(t, false)
+
+	hello := make(chan []utls.KeyShare, 1)
+	key, err := realityTestHandshake(t, context.Background(), realityTestServer(t, coverSite(t, hello)), utls.HelloChrome_Auto, config)
+	if err == nil {
+		t.Fatal("the cover site's certificate passed REALITY verification")
+	}
+	if hasHybridShare(<-hello) {
+		t.Fatal("first attempt offered X25519MLKEM768, want the classic hello")
+	}
+	if entry, ok := realityMemoSnapshot(key); !ok || !entry.mlkem {
+		t.Fatalf("a relayed classic hello did not flip the memo: %+v, %v", entry, ok)
+	}
+}
+
+// realityFingerprintCase is one hello the core must send unchanged or with the
+// hybrid share, and whether its outcome may reach the memo.
+type realityFingerprintCase struct {
+	name        string
+	policy      RealityMLKEMPolicy
+	force       bool
+	fingerprint UClientHelloID
+	hybrid      bool
+}
+
+func runRealityFingerprintCases(t *testing.T, cases []realityFingerprintCase) {
+	t.Helper()
+	defer ResetRealityMLKEMMemo()
+	defer SetRealityMLKEMPolicy(RealityMLKEMAuto)
+	SetRealityMLKEMFirst(false)
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			ResetRealityMLKEMMemo()
+			SetRealityMLKEMPolicy(tc.policy)
+			config := realityMemoTestConfig(t, tc.force)
+			hello := make(chan []utls.KeyShare, 1)
+			addr := realityTestServer(t, coverSite(t, hello))
+			key := addr + "|" + string(config.PublicKey.Bytes())
+			if tc.policy == RealityMLKEMAuto {
+				realityReportMLKEM(key, false, false, nil) // this server relayed a classic hello before
+			}
+			before, _ := realityMemoSnapshot(key)
+
+			if _, err := realityTestHandshake(t, context.Background(), addr, tc.fingerprint, config); err == nil {
+				t.Fatal("the cover site's certificate passed REALITY verification")
+			}
+			if got := hasHybridShare(<-hello); got != tc.hybrid {
+				t.Fatalf("hello offered X25519MLKEM768 = %v, want %v", got, tc.hybrid)
+			}
+			if after, _ := realityMemoSnapshot(key); !tc.hybrid && after != before {
+				t.Fatalf("a hello without the hybrid share was reported to the memo: %+v -> %+v", before, after)
+			}
+		})
+	}
+}
+
+// The fingerprint is the user's choice: a parrot without the hybrid share is
+// never swapped for chrome, and with reality-mlkem off a forced share behaves
+// as in stock mihomo.
+func TestRealityFingerprintWithoutMLKEMShareIsKept(t *testing.T) {
+	runRealityFingerprintCases(t, []realityFingerprintCase{
+		{"auto learned hybrid, chrome", RealityMLKEMAuto, false, utls.HelloChrome_Auto, true},
+		{"auto learned hybrid, ios", RealityMLKEMAuto, false, utls.HelloIOS_Auto, false},
+		{"auto learned hybrid, edge", RealityMLKEMAuto, false, utls.HelloEdge_Auto, false},
+		{"on, ios", RealityMLKEMOn, false, utls.HelloIOS_Auto, false},
+		{"off, forced, ios", RealityMLKEMOff, true, utls.HelloIOS_Auto, false},
+		{"off, forced, chrome", RealityMLKEMOff, true, utls.HelloChrome_Auto, true},
+		{"off, chrome", RealityMLKEMOff, false, utls.HelloChrome_Auto, false},
+	})
+}
+
+// From mihomo v1.19.34 (metacubex/utls v1.9.0-alpha.1) the stock firefox
+// (Firefox 148) and safari (Safari 26.3) parrots carry the hybrid share
+// themselves, so they reach a server that needs it without any swap, and a
+// classic attempt still strips it.
+func TestRealityFirefoxSafariParrotsOfferMLKEM(t *testing.T) {
+	runRealityFingerprintCases(t, []realityFingerprintCase{
+		{"auto learned hybrid, firefox", RealityMLKEMAuto, false, utls.HelloFirefox_Auto, true},
+		{"auto learned hybrid, safari", RealityMLKEMAuto, false, utls.HelloSafari_Auto, true},
+		{"on, firefox", RealityMLKEMOn, false, utls.HelloFirefox_Auto, true},
+		{"off, forced, safari", RealityMLKEMOff, true, utls.HelloSafari_Auto, true},
+		{"off, firefox", RealityMLKEMOff, false, utls.HelloFirefox_Auto, false},
+		{"off, safari", RealityMLKEMOff, false, utls.HelloSafari_Auto, false},
+	})
+}
+
+// xrayAcceptsKeyShares mirrors the key-share gate of XTLS/REALITY 8cdf7bf
+// (Xray 26.9.8+): exactly one X25519MLKEM768 share, an optional X25519 share
+// only after it, and the X25519 key the server will use for the auth key.
+func xrayAcceptsKeyShares(shares []utls.KeyShare) (x25519 []byte, ok bool) {
+	var peerPub, peerPub2 []byte
+	for _, ks := range shares {
+		if ks.Group == utls.X25519MLKEM768 && len(ks.Data) == 1184+32 {
+			if peerPub2 != nil {
+				return nil, false
+			}
+			peerPub2 = ks.Data[1184:]
+			continue
+		}
+		if ks.Group == utls.X25519 && len(ks.Data) == 32 {
+			if peerPub != nil {
+				return nil, false
+			}
+			peerPub = ks.Data
+			break
+		}
+	}
+	if peerPub2 == nil {
+		return nil, false
+	}
+	if peerPub == nil {
+		peerPub = peerPub2
+	}
+	return peerPub, true
+}
+
+// The hybrid hellos must pass the Xray 26.9.8+ gate, and the X25519 key the
+// server derives the REALITY auth key from must be the one GetRealityConn
+// uses (State13 Ecdhe, else the hybrid's X25519 half). Firefox sends one
+// X25519 key in both shares, Safari two.
+func TestRealityHybridParrotsPassXrayGate(t *testing.T) {
+	for _, tc := range []struct {
+		fp     UClientHelloID
+		shared bool
+	}{{utls.HelloChrome_Auto, false}, {utls.HelloFirefox_Auto, true}, {utls.HelloSafari_Auto, false}} {
+		c1, c2 := net.Pipe()
+		uConn := utls.UClient(c1, &utls.Config{ServerName: "www.example.com", InsecureSkipVerify: true}, tc.fp)
+		if err := uConn.BuildHandshakeState(); err != nil {
+			t.Fatalf("%s: %v", tc.fp.Client, err)
+		}
+		c1.Close()
+		c2.Close()
+		keys := uConn.HandshakeState.State13.KeyShareKeys
+		if !realityHasMLKEMShare(uConn) {
+			t.Fatalf("%s: no X25519MLKEM768 share", tc.fp.Client)
+		}
+		x25519, ok := xrayAcceptsKeyShares(uConn.HandshakeState.Hello.KeyShares)
+		if !ok {
+			t.Fatalf("%s: hello would be forwarded to the cover site by Xray 26.9.8+", tc.fp.Client)
+		}
+		auth := keys.Ecdhe
+		if auth == nil {
+			auth = keys.MlkemEcdhe
+		}
+		if string(x25519) != string(auth.PublicKey().Bytes()) {
+			t.Fatalf("%s: server-side X25519 share does not match the client's auth key", tc.fp.Client)
+		}
+		if shared := keys.Ecdhe == keys.MlkemEcdhe; shared != tc.shared {
+			t.Fatalf("%s: one X25519 key in both shares = %v, want %v", tc.fp.Client, shared, tc.shared)
+		}
+	}
+}
