+// RealityMLKEMPolicy decides whether the REALITY ClientHello offers the
+// X25519MLKEM768 key share when the proxy itself does not force it with
+// support-x25519mlkem768. Xray servers are split by generation: builds before
+// 2025 do not accept a hybrid ClientHello, builds from 26.9.8 on do not accept a
+// classic one, and the server never announces which it is. Either way the
+// server does not fail the handshake: it treats the client as unauthenticated
+// and relays it to its cover site, whose certificate then fails REALITY
+// verification. In Auto mode the outcome of each handshake that got that far is
+// remembered per server and public key, so a wrong first guess costs one failed
+// connection per server, not a dead node. Failures that say nothing about the
+// key share (dial errors, timeouts, resets, cancelled requests) never move it.
+type RealityMLKEMPolicy int32
+
+const (
+	RealityMLKEMAuto RealityMLKEMPolicy = iota
+	RealityMLKEMOn
+	RealityMLKEMOff
+)
+
+// RealityMLKEMFirst is the first guess in Auto mode for a server not seen yet.
+// Classic first keeps the historical behaviour; the memo flips it after one
+// failure against a server that insists on the hybrid key share.
+var (
+	realityMLKEMPolicy atomic.Int32
+	realityMLKEMFirst  atomic.Bool
+)
+
+func SetRealityMLKEMPolicy(policy RealityMLKEMPolicy) { realityMLKEMPolicy.Store(int32(policy)) }
+func GetRealityMLKEMPolicy() RealityMLKEMPolicy       { return RealityMLKEMPolicy(realityMLKEMPolicy.Load()) }
+func SetRealityMLKEMFirst(mlkem bool)                 { realityMLKEMFirst.Store(mlkem) }
+
+type realityMemoEntry struct {
+	mlkem    bool
+	pinned   bool
+	failures int
+	flips    int
+}
+
+// realityMemoFlipAfter is how many consecutive failures a pinned verdict
+// survives before the other key share is tried again (servers do get upgraded).
+const realityMemoFlipAfter = 3
+
+var realityMemo = struct {
+	sync.Mutex
+	entries map[string]*realityMemoEntry
+}{entries: map[string]*realityMemoEntry{}}
+
+func realityMemoKey(conn net.Conn, config *RealityConfig) string {
+	key := string(config.PublicKey.Bytes())
+	if addr := conn.RemoteAddr(); addr != nil {
+		key = addr.String() + "|" + key
+	}
+	return key
+}
+
+// realityChooseMLKEM returns whether this handshake offers X25519MLKEM768 and
+// whether the choice came from the adaptive memo (and so must be reported back).
+func realityChooseMLKEM(key string, config *RealityConfig) (mlkem bool, adaptive bool) {
+	if config.SupportX25519MLKEM768 {
+		return true, false
+	}
+	switch GetRealityMLKEMPolicy() {
+	case RealityMLKEMOn:
+		return true, false
+	case RealityMLKEMOff:
+		return false, false
+	}
+	realityMemo.Lock()
+	defer realityMemo.Unlock()
+	if entry, ok := realityMemo.entries[key]; ok {
+		return entry.mlkem, true
+	}
+	return realityMLKEMFirst.Load(), true
+}
+
+func realityReportMLKEM(key string, mlkem bool, ok bool, remote net.Addr) {
+	realityMemo.Lock()
+	defer realityMemo.Unlock()
+	entry := realityMemo.entries[key]
+	if entry == nil {
+		entry = &realityMemoEntry{mlkem: mlkem}
+		realityMemo.entries[key] = entry
+	}
+	if ok {
+		if !entry.pinned || entry.mlkem != mlkem {
+			log.Infoln("REALITY %v: X25519MLKEM768=%v confirmed", remote, mlkem)
+		}
+		entry.mlkem, entry.pinned, entry.failures, entry.flips = mlkem, true, 0, 0
+		return
+	}
+	if entry.mlkem != mlkem {
+		return // a stale attempt; the memo already moved on
+	}
+	entry.failures++
+	if !entry.pinned || entry.failures >= realityMemoFlipAfter {
+		entry.mlkem, entry.pinned, entry.failures = !mlkem, false, 0
+		entry.flips++
+		// A server that rejects both key shares is simply down or misconfigured;
+		// keep flipping (it may come back) but stop narrating it after two rounds.
+		if entry.flips <= 2 {
+			log.Infoln("REALITY %v: handshake with X25519MLKEM768=%v failed, next attempt uses %v", remote, mlkem, !mlkem)
+		} else {
+			log.Debugln("REALITY %v: handshake with X25519MLKEM768=%v failed again, next attempt uses %v", remote, mlkem, !mlkem)
+		}
+	}
+}
+
+func realityHasMLKEMShare(uConn *utls.UConn) bool {
+	keys := uConn.HandshakeState.State13.KeyShareKeys
+	return keys != nil && keys.MlkemEcdhe != nil
+}
+
+// realityNoMLKEMShareLogged remembers the fingerprints already reported as
+// unable to offer X25519MLKEM768, so the note is logged once per fingerprint.
+var realityNoMLKEMShareLogged sync.Map
+
+func realityLogNoMLKEMShare(fingerprint UClientHelloID) {
+	if _, seen := realityNoMLKEMShareLogged.LoadOrStore(fingerprint.Client, struct{}{}); !seen {
+		log.Debugln("REALITY: the %s fingerprint cannot offer X25519MLKEM768; its classic hello is sent unchanged", fingerprint.Client)
+	}
+}
+
+// ResetRealityMLKEMMemo forgets every learned verdict (new profile, tests).
+func ResetRealityMLKEMMemo() {
+	realityMemo.Lock()
+	defer realityMemo.Unlock()
+	realityMemo.entries = map[string]*realityMemoEntry{}
+}
