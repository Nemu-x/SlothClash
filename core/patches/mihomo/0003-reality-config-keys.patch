--- /dev/null
+++ b/component/tls/reality_policy.go
@@ -0,0 +1,69 @@
+package tls
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+
+	"github.com/metacubex/mihomo/log"
+)
+
+// defaultRealityClientVersion is the compiled-in client version, kept so that a
+// config without reality-client-version restores it after one that set it.
+var defaultRealityClientVersion = RealityClientVersion
+
+func DefaultRealityClientVersion() [3]byte { return defaultRealityClientVersion }
+
+// ParseRealityClientVersion parses "x.y.z" (each part 0..255). An empty string
+// selects the compiled-in default.
+func ParseRealityClientVersion(s string) ([3]byte, error) {
+	s = strings.TrimSpace(s)
+	if s == "" {
+		return defaultRealityClientVersion, nil
+	}
+	parts := strings.Split(strings.TrimPrefix(s, "v"), ".")
+	if len(parts) != 3 {
+		return [3]byte{}, fmt.Errorf("reality-client-version %q: want x.y.z", s)
+	}
+	var v [3]byte
+	for i, p := range parts {
+		n, err := strconv.ParseUint(p, 10, 8)
+		if err != nil {
+			return [3]byte{}, fmt.Errorf("reality-client-version %q: part %q is not a number in 0..255", s, p)
+		}
+		v[i] = byte(n)
+	}
+	return v, nil
+}
+
+// ParseRealityMLKEMPolicy parses auto | on | off. An empty string means auto.
+func ParseRealityMLKEMPolicy(s string) (RealityMLKEMPolicy, error) {
+	switch strings.ToLower(strings.TrimSpace(s)) {
+	case "", "auto":
+		return RealityMLKEMAuto, nil
+	case "on":
+		return RealityMLKEMOn, nil
+	case "off":
+		return RealityMLKEMOff, nil
+	}
+	return RealityMLKEMAuto, fmt.Errorf("reality-mlkem %q: want auto, on or off", s)
+}
+
+func (p RealityMLKEMPolicy) String() string {
+	switch p {
+	case RealityMLKEMOn:
+		return "on"
+	case RealityMLKEMOff:
+		return "off"
+	}
+	return "auto"
+}
+
+// ApplyRealityPolicy installs the REALITY settings of a loaded config.
+func ApplyRealityPolicy(version [3]byte, policy RealityMLKEMPolicy) {
+	if RealityClientVersion != version {
+		RealityClientVersion = version
+	}
+	SetRealityMLKEMPolicy(policy)
+	log.Infoln("REALITY policy: client version %d.%d.%d, X25519MLKEM768 %s", version[0], version[1], version[2], policy)
+}
diff --git a/component/tls/reality_policy_test.go b/component/tls/reality_policy_test.go
new file mode 100644
index 00000000..d4f321c1
--- /dev/null
+++ b/component/tls/reality_policy_test.go
@@ -0,0 +1,58 @@
+package tls
+
+import "testing"
+
+func TestParseRealityClientVersion(t *testing.T) {
+	for in, want := range map[string][3]byte{
+		"":        DefaultRealityClientVersion(),
+		"  ":      DefaultRealityClientVersion(),
+		"1.9.0":   {1, 9, 0},
+		"v25.1.1": {25, 1, 1},
+		"255.0.0": {255, 0, 0},
+	} {
+		got, err := ParseRealityClientVersion(in)
+		if err != nil || got != want {
+			t.Errorf("ParseRealityClientVersion(%q) = %v, %v; want %v", in, got, err, want)
+		}
+	}
+	for _, in := range []string{"1.9", "1.9.0.1", "256.0.0", "-1.0.0", "a.b.c", "1..2", "1.9.0-rc1"} {
+		if _, err := ParseRealityClientVersion(in); err == nil {
+			t.Errorf("ParseRealityClientVersion(%q) accepted an invalid version", in)
+		}
+	}
+}
+
+func TestParseRealityMLKEMPolicy(t *testing.T) {
+	for in, want := range map[string]RealityMLKEMPolicy{
+		"": RealityMLKEMAuto, "auto": RealityMLKEMAuto, "ON": RealityMLKEMOn, " off ": RealityMLKEMOff,
+	} {
+		got, err := ParseRealityMLKEMPolicy(in)
+		if err != nil || got != want {
+			t.Errorf("ParseRealityMLKEMPolicy(%q) = %v, %v; want %v", in, got, err, want)
+		}
+	}
+	for _, in := range []string{"always", "true", "1"} {
+		if _, err := ParseRealityMLKEMPolicy(in); err == nil {
+			t.Errorf("ParseRealityMLKEMPolicy(%q) accepted an invalid policy", in)
+		}
+	}
+}
+
+func TestApplyRealityPolicyRestoresDefaults(t *testing.T) {
+	defer ApplyRealityPolicy(DefaultRealityClientVersion(), RealityMLKEMAuto)
+
+	ApplyRealityPolicy([3]byte{1, 9, 0}, RealityMLKEMOff)
+	if RealityClientVersion != [3]byte{1, 9, 0} || GetRealityMLKEMPolicy() != RealityMLKEMOff {
+		t.Fatalf("apply = %v/%v", RealityClientVersion, GetRealityMLKEMPolicy())
+	}
+	// A later config without the keys parses to the defaults and must restore them.
+	v, _ := ParseRealityClientVersion("")
+	p, _ := ParseRealityMLKEMPolicy("")
+	ApplyRealityPolicy(v, p)
+	if RealityClientVersion != DefaultRealityClientVersion() || GetRealityMLKEMPolicy() != RealityMLKEMAuto {
+		t.Fatalf("defaults not restored: %v/%v", RealityClientVersion, GetRealityMLKEMPolicy())
+	}
+	if DefaultRealityClientVersion() == [3]byte{1, 8, 2} {
+		t.Fatal("default client version is still the legacy 1.8.2")
+	}
+}
