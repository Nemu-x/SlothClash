diff --git a/config/reality.go b/config/reality.go
new file mode 100644
index 00000000..ff6651d6
--- /dev/null
+++ b/config/reality.go
@@ -0,0 +1,25 @@
+package config
+
+import (
+	tlsC "github.com/metacubex/mihomo/component/tls"
+)
+
+// Reality holds the top-level REALITY settings: reality-client-version and
+// reality-mlkem. Absent keys resolve to the core defaults, so reloading a
+// config without them undoes an earlier one that set them.
+type Reality struct {
+	ClientVersion [3]byte
+	MLKEM         tlsC.RealityMLKEMPolicy
+}
+
+func parseReality(cfg *RawConfig) (*Reality, error) {
+	version, err := tlsC.ParseRealityClientVersion(cfg.RealityClientVersion)
+	if err != nil {
+		return nil, err
+	}
+	policy, err := tlsC.ParseRealityMLKEMPolicy(cfg.RealityMLKEM)
+	if err != nil {
+		return nil, err
+	}
+	return &Reality{ClientVersion: version, MLKEM: policy}, nil
+}
diff --git a/config/reality_test.go b/config/reality_test.go
new file mode 100644
index 00000000..8f0cd68d
--- /dev/null
+++ b/config/reality_test.go
@@ -0,0 +1,39 @@
+package config
+
+import (
+	"testing"
+
+	tlsC "github.com/metacubex/mihomo/component/tls"
+)
+
+func TestParseRealityKeys(t *testing.T) {
+	raw, err := UnmarshalRawConfig([]byte("reality-client-version: \"1.9.0\"\nreality-mlkem: on\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	r, err := parseReality(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r.ClientVersion != [3]byte{1, 9, 0} || r.MLKEM != tlsC.RealityMLKEMOn {
+		t.Fatalf("parsed %+v", r)
+	}
+
+	raw, err = UnmarshalRawConfig([]byte("mode: rule\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r, err = parseReality(raw); err != nil || r.ClientVersion != tlsC.DefaultRealityClientVersion() || r.MLKEM != tlsC.RealityMLKEMAuto {
+		t.Fatalf("absent keys = %+v, %v; want defaults", r, err)
+	}
+
+	for _, bad := range []string{"reality-client-version: \"1.300.0\"\n", "reality-mlkem: always\n"} {
+		raw, err = UnmarshalRawConfig([]byte(bad))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err = parseReality(raw); err == nil {
+			t.Errorf("%q accepted", bad)
+		}
+	}
+}
