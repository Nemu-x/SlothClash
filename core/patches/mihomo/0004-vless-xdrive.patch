index 00000000..08cc11b2
--- /dev/null
+++ b/transport/xdrive/lifecycle_test.go
@@ -0,0 +1,117 @@
+package xdrive
+
+import (
+	"context"
+	"errors"
+	"net"
+	"os"
+	"testing"
+	"time"
+)
+
+func TestDeadlineInterruptsPendingRead(t *testing.T) {
+	c, s, cleanup := pair(t)
+	defer cleanup()
+	result := make(chan error, 1)
+	go func() { _, err := c.Read(make([]byte, 1)); result <- err }()
+	time.Sleep(20 * time.Millisecond)
+	c.SetReadDeadline(time.Now().Add(20 * time.Millisecond))
+	select {
+	case err := <-result:
+		if !errors.Is(err, os.ErrDeadlineExceeded) {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("deadline did not interrupt pending Read")
+	}
+	c.SetReadDeadline(time.Time{})
+	if _, err := s.Write([]byte("x")); err != nil {
+		t.Fatal(err)
+	}
+	expectRead(t, c, "x")
+}
+
+type stalledStorage struct {
+	Storage
+	started chan struct{}
+}
+
+func (s *stalledStorage) Put(ctx context.Context, name string, b []byte) error {
+	select {
+	case s.started <- struct{}{}:
+	default:
+	}
+	<-ctx.Done()
+	return ctx.Err()
+}
+func TestWriteBackpressureAndCancellation(t *testing.T) {
+	base, err := newLocalStorage(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	store := &stalledStorage{Storage: base, started: make(chan struct{}, 1)}
+	p := paramsFromConfig(&Config{SegmentBytes: 8, Concurrency: 1})
+	c := newConn(ctx, store, "up", "down", p, nil)
+	defer c.Close()
+	result := make(chan error, 1)
+	go func() { _, err := c.Write(make([]byte, 1024)); result <- err }()
+	<-store.started
+	c.SetWriteDeadline(time.Now().Add(30 * time.Millisecond))
+	select {
+	case err := <-result:
+		if !errors.Is(err, os.ErrDeadlineExceeded) {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("Write ignored backpressure deadline")
+	}
+	cancel()
+}
+func TestCloseListenerAndClient(t *testing.T) {
+	cfg := *settings(t.TempDir())
+	l, err := Listen(cfg, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result := make(chan error, 1)
+	go func() { _, err := l.Accept(); result <- err }()
+	l.Close()
+	if err := <-result; !errors.Is(err, net.ErrClosed) {
+		t.Fatal(err)
+	}
+	c, err := NewClient(cfg, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c.Close()
+	if _, err := c.Dial(context.Background()); !errors.Is(err, net.ErrClosed) {
+		t.Fatal(err)
+	}
+}
+func TestLocalWindowsTraversalRejected(t *testing.T) {
+	s, err := newLocalStorage(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, name := range []string{`..\escape`, `folder\..\..\escape`, `a:stream`} {
+		if err := s.Put(context.Background(), name, nil); err == nil {
+			t.Fatalf("accepted %q", name)
+		}
+	}
+}
+func TestRejectInvalidSessionAnnouncements(t *testing.T) {
+	for _, name := range []string{"123-../escape", "123-not-a-session", "123-0000000000000000000000000000000z"} {
+		if _, _, ok := parseAnnounce(name); ok {
+			t.Fatalf("accepted %q", name)
+		}
+	}
+}
+
+func TestParameterCapsDoNotOverflow32Bit(t *testing.T) {
+	p := paramsFromConfig(&Config{SegmentBytes: ^uint32(0), Concurrency: ^uint32(0)})
+	if p.segmentBytes != maxSegmentBytes || p.concurrency != maxConcurrency {
+		t.Fatalf("invalid parameter caps: %+v", p)
+	}
+}
diff --git a/transport/xdrive/local.go b/transport/xdrive/local.go
new file mode 100644
index 00000000..39dce2f1
--- /dev/null
+++ b/transport/xdrive/local.go
@@ -0,0 +1,146 @@
+// Adapted from XTLS/Xray-core transport/internet/xdrive at 92ccc939aaf4.
+// Copyright Xray-core contributors. Licensed under MPL-2.0.
+// SPDX-License-Identifier: MPL-2.0
+
+package xdrive
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"syscall"
+	"time"
+)
+
+const tempPrefix = ".xdrive-tmp-"
+
+type localStorage struct {
+	root string
+}
+
+func newLocalStorage(root string) (*localStorage, error) {
+	if root == "" {
+		return nil, newError(`empty "remoteFolder"`)
+	}
+	if err := os.MkdirAll(root, 0o700); err != nil {
+		return nil, newError("failed to create remote folder").Base(err)
+	}
+	return &localStorage{root: root}, nil
+}
+
+func (s *localStorage) resolve(name string) (string, error) {
+	if strings.ContainsAny(name, "\\:") {
+		return "", newError("invalid object name")
+	}
+	clean := path.Clean("/" + name)
+	if clean == "/" {
+		return "", newError("invalid object name: ", name)
+	}
+	if strings.HasPrefix(path.Base(clean), tempPrefix) {
+		return "", newError("reserved object name: ", name)
+	}
+	return filepath.Join(s.root, filepath.FromSlash(clean[1:])), nil
+}
+
+func (s *localStorage) Put(ctx context.Context, name string, data []byte) error {
+	full, err := s.resolve(name)
+	if err != nil {
+		return err
+	}
+	dir := filepath.Dir(full)
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		return newError("failed to create folder ", dir).Base(err)
+	}
+
+	tmp, err := os.CreateTemp(dir, tempPrefix+"*")
+	if err != nil {
+		return newError("failed to create temp file in ", dir).Base(err)
+	}
+	tmpName := tmp.Name()
+	defer os.Remove(tmpName)
+
+	if _, err := tmp.Write(data); err != nil {
+		tmp.Close()
+		return newError("failed to write ", name).Base(err)
+	}
+	if err := tmp.Close(); err != nil {
+		return newError("failed to close ", name).Base(err)
+	}
+	// Publishing an immutable segment as a hard link avoids opening the final
+	// name for rename on Windows while the other process tries to read it.
+	// Filesystems without hard links retain the atomic-rename fallback.
+	if err := os.Link(tmpName, full); err != nil {
+		if err := os.Rename(tmpName, full); err != nil {
+			return newError("failed to commit ", name).Base(err)
+		}
+	}
+	return nil
+}
+
+func (s *localStorage) Get(ctx context.Context, name string) ([]byte, error) {
+	full, err := s.resolve(name)
+	if err != nil {
+		return nil, err
+	}
+	var data []byte
+	for attempt := 0; ; attempt++ {
+		data, err = os.ReadFile(full)
+		sharing := runtime.GOOS == "windows" && (errors.Is(err, syscall.Errno(32)) || errors.Is(err, syscall.Errno(33)))
+		if !sharing || attempt >= 10 {
+			break
+		}
+		select {
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-time.After(10 * time.Millisecond):
+		}
+	}
+	if err != nil {
+		if os.IsNotExist(err) {
+			return nil, errNotFound
+		}
+		return nil, newError("failed to read ", name).Base(err)
+	}
+	return data, nil
+}
+
+func (s *localStorage) Delete(ctx context.Context, name string) error {
+	full, err := s.resolve(name)
+	if err != nil {
+		return err
+	}
+	if err := os.RemoveAll(full); err != nil {
+		return newError("failed to delete ", name).Base(err)
+	}
+	return nil
+}
+
+func (s *localStorage) List(ctx context.Context, prefix string) ([]Entry, error) {
+	full, err := s.resolve(prefix)
+	if err != nil {
+		return nil, err
+	}
+	entries, err := os.ReadDir(full)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return nil, nil
+		}
+		return nil, newError("failed to list ", prefix).Base(err)
+	}
+	found := make([]Entry, 0, len(entries))
+	for _, entry := range entries {
+		if strings.HasPrefix(entry.Name(), tempPrefix) {
+			continue
+		}
+		found = append(found, Entry{Name: entry.Name()})
+	}
+	return found, nil
+}
+
+func (s *localStorage) Close() error {
+	return nil
+}
diff --git a/transport/xdrive/params.go b/transport/xdrive/params.go
new file mode 100644
index 00000000..d0caf19a
--- /dev/null
+++ b/transport/xdrive/params.go
@@ -0,0 +1,73 @@
+// Adapted from XTLS/Xray-core transport/internet/xdrive at 92ccc939aaf4.
+// Copyright Xray-core contributors. Licensed under MPL-2.0.
+// SPDX-License-Identifier: MPL-2.0
+
+package xdrive
+
+import "time"
+
+const (
+	defaultSegmentBytes    = 512 * 1024
+	defaultFlushInterval   = 20 * time.Millisecond
+	defaultMinPollInterval = 50 * time.Millisecond
+	defaultMaxPollInterval = 500 * time.Millisecond
+	defaultEagerWindow     = 2 * time.Second
+	defaultHoleTimeout     = 30 * time.Second
+	defaultSessionTTL      = 5 * time.Minute
+	defaultConcurrency     = 8
+
+	maxSegmentBytes = 16 * 1024 * 1024
+	maxConcurrency  = 64
+)
+
+type params struct {
+	segmentBytes    int
+	flushInterval   time.Duration
+	minPollInterval time.Duration
+	maxPollInterval time.Duration
+	eagerWindow     time.Duration
+	holeTimeout     time.Duration
+	sessionTTL      time.Duration
+	concurrency     int
+}
+
+func millis(value uint32, fallback time.Duration) time.Duration {
+	if value == 0 {
+		return fallback
+	}
+	return time.Duration(value) * time.Millisecond
+}
+
+func seconds(value uint32, fallback time.Duration) time.Duration {
+	if value == 0 {
+		return fallback
+	}
+	return time.Duration(value) * time.Second
+}
+
+func capped(value uint32, fallback, limit int) int {
+	if value == 0 {
+		return fallback
+	}
+	if value > uint32(limit) {
+		return limit
+	}
+	return int(value)
+}
+
+func paramsFromConfig(c *Config) params {
+	p := params{
+		segmentBytes:    capped(c.SegmentBytes, defaultSegmentBytes, maxSegmentBytes),
+		flushInterval:   millis(c.FlushIntervalMs, defaultFlushInterval),
+		minPollInterval: millis(c.PollIntervalMs, defaultMinPollInterval),
+		maxPollInterval: millis(c.MaxPollIntervalMs, defaultMaxPollInterval),
+		eagerWindow:     millis(c.EagerWindowMs, defaultEagerWindow),
+		holeTimeout:     millis(c.HoleTimeoutMs, defaultHoleTimeout),
+		sessionTTL:      seconds(c.SessionTtlSeconds, defaultSessionTTL),
+		concurrency:     capped(c.Concurrency, defaultConcurrency, maxConcurrency),
+	}
+	if p.maxPollInterval < p.minPollInterval {
+		p.maxPollInterval = p.minPollInterval
+	}
+	return p
+}
diff --git a/transport/xdrive/session.go b/transport/xdrive/session.go
new file mode 100644
index 00000000..51c592dc
--- /dev/null
+++ b/transport/xdrive/session.go
@@ -0,0 +1,284 @@
+// XDRIVE object names and session discovery follow XTLS/Xray-core at
+// 92ccc939aaf4. SPDX-License-Identifier: MPL-2.0
+package xdrive
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"fmt"
+	"net"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/metacubex/http"
+	"github.com/metacubex/mihomo/log"
+)
+
+const (
+	sessionsDir = "sessions"
+	streamsDir  = "streams"
+	maxSessions = 256
+)
+
+func sessionPrefix(id string) string  { return streamsDir + "/" + id }
+func uplinkPrefix(id string) string   { return sessionPrefix(id) + "/c2s" }
+func downlinkPrefix(id string) string { return sessionPrefix(id) + "/s2c" }
+func announceName(id string, t time.Time) string {
+	return fmt.Sprintf("%s/%d-%s", sessionsDir, t.UnixNano(), id)
+}
+func parseAnnounce(name string) (string, time.Time, bool) {
+	stamp, id, ok := strings.Cut(name, "-")
+	if !ok || len(id) != 32 {
+		return "", time.Time{}, false
+	}
+	if _, err := hex.DecodeString(id); err != nil {
+		return "", time.Time{}, false
+	}
+	n, err := strconv.ParseInt(stamp, 10, 64)
+	return id, time.Unix(0, n), err == nil
+}
+
+type Client struct {
+	ctx     context.Context
+	cancel  context.CancelFunc
+	storage Storage
+	http    *http.Client
+	params
+	mu     sync.Mutex
+	conns  map[*Conn]bool
+	closed bool
+}
+
+func NewClient(c Config, h *http.Client) (*Client, error) {
+	if h == nil {
+		h = defaultHTTPClient(c)
+	}
+	storage, err := newStorage(c, h)
+	if err != nil {
+		return nil, err
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	return &Client{ctx: ctx, cancel: cancel, storage: storage, http: h, params: paramsFromConfig(&c), conns: make(map[*Conn]bool)}, nil
+}
+func (c *Client) Dial(ctx context.Context) (net.Conn, error) {
+	c.mu.Lock()
+	closed := c.closed
+	c.mu.Unlock()
+	if closed {
+		return nil, net.ErrClosed
+	}
+	var random [16]byte
+	if _, err := rand.Read(random[:]); err != nil {
+		return nil, err
+	}
+	id := hex.EncodeToString(random[:])
+	announceCtx, cancel := context.WithCancel(ctx)
+	stop := context.AfterFunc(c.ctx, cancel)
+	defer func() { stop(); cancel() }()
+	if err := c.storage.Put(announceCtx, announceName(id, time.Now()), nil); err != nil {
+		return nil, err
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed {
+		return nil, net.ErrClosed
+	}
+	var conn *Conn
+	conn = newConn(c.ctx, c.storage, uplinkPrefix(id), downlinkPrefix(id), c.params, func() { c.mu.Lock(); delete(c.conns, conn); c.mu.Unlock() })
+	c.conns[conn] = true
+	return conn, nil
+}
+func (c *Client) Close() error {
+	c.mu.Lock()
+	if c.closed {
+		c.mu.Unlock()
+		return nil
+	}
+	c.closed = true
+	c.cancel()
+	conns := make([]*Conn, 0, len(c.conns))
+	for conn := range c.conns {
+		conns = append(conns, conn)
+	}
+	c.mu.Unlock()
+	for _, conn := range conns {
+		_ = conn.Close()
+	}
+	c.http.CloseIdleConnections()
+	return c.storage.Close()
+}
+
+type Listener struct {
+	ctx     context.Context
+	cancel  context.CancelFunc
+	storage Storage
+	http    *http.Client
+	params
+	accepted           chan net.Conn
+	mu                 sync.Mutex
+	active             map[string]*Conn
+	handled, idleSince map[string]time.Time
+	closeOnce          sync.Once
+	closeErr           error
+}
+
+func Listen(c Config, h *http.Client) (*Listener, error) {
+	if h == nil {
+		h = defaultHTTPClient(c)
+	}
+	storage, err := newStorage(c, h)
+	if err != nil {
+		return nil, err
+	}
+	if _, disabled := storage.(disabledLocalStorage); disabled {
+		return nil, ErrLocalServiceDisabled
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	l := &Listener{ctx: ctx, cancel: cancel, storage: storage, http: h, params: paramsFromConfig(&c), accepted: make(chan net.Conn, 32), active: make(map[string]*Conn), handled: make(map[string]time.Time), idleSince: make(map[string]time.Time)}
+	go l.run()
+	return l, nil
+}
+func (l *Listener) Accept() (net.Conn, error) {
+	select {
+	case <-l.ctx.Done():
+		return nil, net.ErrClosed
+	case conn := <-l.accepted:
+		return conn, nil
+	}
+}
+func (l *Listener) Addr() net.Addr { return placeholderAddr }
+func (l *Listener) Close() error {
+	l.closeOnce.Do(func() {
+		l.cancel()
+		l.mu.Lock()
+		conns := make([]*Conn, 0, len(l.active))
+		for _, conn := range l.active {
+			conns = append(conns, conn)
+		}
+		l.mu.Unlock()
+		for _, conn := range conns {
+			_ = conn.Close()
+		}
+		l.http.CloseIdleConnections()
+		l.closeErr = l.storage.Close()
+	})
+	return l.closeErr
+}
+func (l *Listener) run() {
+	delay := l.minPollInterval
+	active := time.Now()
+	collected := time.Now()
+	for {
+		accepted, err := l.acceptPending()
+		if err != nil && l.ctx.Err() == nil {
+			log.Warnln("[XDRIVE] session discovery: %v", err)
+		}
+		if accepted {
+			active = time.Now()
+		}
+		if time.Since(active) < l.eagerWindow {
+			delay = l.minPollInterval
+		} else {
+			delay *= 2
+			if delay > l.maxPollInterval {
+				delay = l.maxPollInterval
+			}
+		}
+		if time.Since(collected) >= l.sessionTTL/2 {
+			_ = l.collect()
+			collected = time.Now()
+		}
+		timer := time.NewTimer(delay)
+		select {
+		case <-l.ctx.Done():
+			timer.Stop()
+			return
+		case <-timer.C:
+		}
+	}
+}
+func (l *Listener) acceptPending() (bool, error) {
+	entries, err := l.storage.List(l.ctx, sessionsDir)
+	if err != nil {
+		return false, err
+	}
+	accepted := false
+	for _, entry := range entries {
+		id, at, ok := parseAnnounce(entry.Name)
+		if !ok {
+			continue
+		}
+		if time.Since(at) > l.sessionTTL {
+			_ = l.storage.Delete(l.ctx, sessionsDir+"/"+entry.Name)
+			continue
+		}
+		l.mu.Lock()
+		if l.active[id] != nil || !l.handled[id].IsZero() || len(l.active) >= maxSessions {
+			l.mu.Unlock()
+			continue
+		}
+		conn := newConn(l.ctx, l.storage, downlinkPrefix(id), uplinkPrefix(id), l.params, func() { l.mu.Lock(); delete(l.active, id); l.mu.Unlock() })
+		l.active[id] = conn
+		l.handled[id] = time.Now()
+		l.mu.Unlock()
+		select {
+		case l.accepted <- conn:
+			accepted = true
+			_ = l.storage.Delete(l.ctx, sessionsDir+"/"+entry.Name)
+		case <-l.ctx.Done():
+			_ = conn.Close()
+			return accepted, l.ctx.Err()
+		}
+	}
+	return accepted, nil
+}
+func (l *Listener) collect() error {
+	entries, err := l.storage.List(l.ctx, streamsDir)
+	if err != nil {
+		return err
+	}
+	now := time.Now()
+	var expired []string
+	l.mu.Lock()
+	present := make(map[string]bool, len(entries))
+	for _, entry := range entries {
+		id := entry.Name
+		if len(id) != 32 {
+			continue
+		}
+		if _, err := hex.DecodeString(id); err != nil {
+			continue
+		}
+		present[id] = true
+		if l.active[id] != nil {
+			delete(l.idleSince, id)
+			continue
+		}
+		if since, ok := l.idleSince[id]; !ok {
+			l.idleSince[id] = now
+		} else if now.Sub(since) >= l.sessionTTL {
+			expired = append(expired, id)
+			delete(l.idleSince, id)
+		}
+	}
+	for id := range l.idleSince {
+		if !present[id] {
+			delete(l.idleSince, id)
+		}
+	}
+	for id, at := range l.handled {
+		if l.active[id] == nil && now.Sub(at) >= l.sessionTTL {
+			delete(l.handled, id)
+		}
+	}
+	l.mu.Unlock()
+	for _, id := range expired {
+		if err := l.storage.Delete(l.ctx, sessionPrefix(id)); err != nil {
+			return err
+		}
+	}
+	return nil
+}
diff --git a/transport/xdrive/storage.go b/transport/xdrive/storage.go
new file mode 100644
index 00000000..c08e2c96
--- /dev/null
+++ b/transport/xdrive/storage.go
@@ -0,0 +1,73 @@
+package xdrive
+
+import (
+	"context"
+	"errors"
+	"io"
+
+	"github.com/metacubex/http"
+)
+
+var errNotFound = errors.New("object not found")
+
+// A listing can contain many inline objects. Bound the whole response as well
+// as individual segments, including responses from a misconfigured template.
+func readResponse(r io.Reader) ([]byte, error) {
+	const maxResponseBytes = 32 << 20
+	b, err := io.ReadAll(io.LimitReader(r, maxResponseBytes+1))
+	if err == nil && len(b) > maxResponseBytes {
+		return nil, newError("storage response too large")
+	}
+	return b, err
+}
+
+type Entry struct {
+	Name   string
+	Inline []byte
+}
+type Storage interface {
+	Put(context.Context, string, []byte) error
+	Get(context.Context, string) ([]byte, error)
+	Delete(context.Context, string) error
+	List(context.Context, string) ([]Entry, error)
+	Close() error
+}
+
+func newStorage(c Config, client *http.Client) (Storage, error) {
+	if err := c.Validate(); err != nil {
+		return nil, err
+	}
+	if client == nil {
+		client = defaultHTTPClient(c)
+	}
+	switch c.Service {
+	case "local":
+		if !AllowLocalService {
+			return disabledLocalStorage{}, nil
+		}
+		return newLocalStorage(c.RemoteFolder)
+	case "google-drive", "Google Drive":
+		return newDriveStorage(client, &c)
+	default:
+		return newTemplateStorage(client, &c)
+	}
+}
+
+// disabledLocalStorage stands in for `service: local` while AllowLocalService
+// is off (ClashFest core patch 0003). It creates nothing and refuses every
+// operation, so the proxy loads but cannot be used.
+type disabledLocalStorage struct{}
+
+func (disabledLocalStorage) Put(context.Context, string, []byte) error {
+	return ErrLocalServiceDisabled
+}
+func (disabledLocalStorage) Get(context.Context, string) ([]byte, error) {
+	return nil, ErrLocalServiceDisabled
+}
+func (disabledLocalStorage) Delete(context.Context, string) error {
+	return ErrLocalServiceDisabled
+}
+func (disabledLocalStorage) List(context.Context, string) ([]Entry, error) {
+	return nil, ErrLocalServiceDisabled
+}
+func (disabledLocalStorage) Close() error { return nil }
diff --git a/transport/xdrive/template.go b/transport/xdrive/template.go
new file mode 100644
index 00000000..eb26239e
--- /dev/null
+++ b/transport/xdrive/template.go
@@ -0,0 +1,452 @@
+// Adapted from XTLS/Xray-core transport/internet/xdrive at 92ccc939aaf4.
+// Copyright Xray-core contributors. Licensed under MPL-2.0.
+// SPDX-License-Identifier: MPL-2.0
+
+package xdrive
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"github.com/metacubex/http"
+	"io"
+	"net/url"
+	"regexp"
+	"strings"
+	"sync"
+	"time"
+)
+
+type authTemplate struct {
+	Type       string            `json:"type"`
+	Header     map[string]string `json:"header"`
+	Username   string            `json:"username"`
+	Password   string            `json:"password"`
+	TokenURL   string            `json:"tokenUrl"`
+	Form       map[string]string `json:"form"`
+	TokenPath  string            `json:"tokenPath"`
+	ExpiryPath string            `json:"expiryPath"`
+}
+
+type opTemplate struct {
+	Method     string            `json:"method"`
+	URL        string            `json:"url"`
+	Headers    map[string]string `json:"headers"`
+	Body       string            `json:"body"`
+	NamesRegex string            `json:"namesRegex"`
+}
+
+type retryTemplate struct {
+	Status     []int  `json:"status"`
+	RateReason string `json:"rateReason"`
+}
+
+type storageTemplate struct {
+	Flatten     bool          `json:"flatten"`
+	Concurrency int           `json:"concurrency"`
+	Auth        authTemplate  `json:"auth"`
+	Put         opTemplate    `json:"put"`
+	Get         opTemplate    `json:"get"`
+	Delete      opTemplate    `json:"delete"`
+	List        opTemplate    `json:"list"`
+	Retry       retryTemplate `json:"retry"`
+
+	names *regexp.Regexp
+}
+
+type templateStorage struct {
+	tmpl    *storageTemplate
+	client  *http.Client
+	folder  string
+	secrets []string
+
+	inflight chan struct{}
+
+	tokenMu     sync.Mutex
+	token       string
+	tokenExpiry time.Time
+}
+
+func newTemplateStorage(client *http.Client, config *Config) (*templateStorage, error) {
+	tmpl := &storageTemplate{}
+	payload, err := json.Marshal(config.Template)
+	if err != nil {
+		return nil, err
+	}
+	if err := json.Unmarshal(payload, tmpl); err != nil {
+		return nil, newError("invalid template").Base(err)
+	}
+	if tmpl.Put.URL == "" || tmpl.Get.URL == "" || tmpl.List.URL == "" || tmpl.Delete.URL == "" {
+		return nil, newError("template needs put, get, list and delete operations")
+	}
+	if tmpl.List.NamesRegex == "" {
+		return nil, newError("template list needs a namesRegex")
+	}
+	re, err := regexp.Compile(tmpl.List.NamesRegex)
+	if err != nil {
+		return nil, newError("bad namesRegex").Base(err)
+	}
+	if re.NumSubexp() < 1 {
+		return nil, newError("namesRegex needs one capture group")
+	}
+	tmpl.names = re
+
+	conc := tmpl.Concurrency
+	if conc <= 0 {
+		conc = driveMaxInflight
+	}
+	if conc > maxTemplateConcurrency {
+		conc = maxTemplateConcurrency
+	}
+
+	return &templateStorage{
+		tmpl:     tmpl,
+		client:   client,
+		folder:   config.RemoteFolder,
+		secrets:  config.Secrets,
+		inflight: make(chan struct{}, conc),
+	}, nil
+}
+
+const maxTemplateConcurrency = 256
+
+func (s *templateStorage) baseVars() map[string]string {
+	vars := map[string]string{"folder": s.folder}
+	for i, secret := range s.secrets {
+		vars["secret"+itoa(i)] = secret
+	}
+	return vars
+}
+
+func subst(tmpl string, vars map[string]string) string {
+	if tmpl == "" || !strings.ContainsRune(tmpl, '{') {
+		return tmpl
+	}
+	out := tmpl
+	for k, v := range vars {
+		out = strings.ReplaceAll(out, "{"+k+"}", v)
+	}
+	return out
+}
+
+func itoa(i int) string {
+	if i == 0 {
+		return "0"
+	}
+	var b [20]byte
+	pos := len(b)
+	for i > 0 {
+		pos--
+		b[pos] = byte('0' + i%10)
+		i /= 10
+	}
+	return string(b[pos:])
+}
+
+func (s *templateStorage) storedName(name string) string {
+	if s.tmpl.Flatten {
+		return flatten(name)
+	}
+	return name
+}
+
+func (s *templateStorage) retryable(status int, payload []byte) bool {
+	for _, code := range s.tmpl.Retry.Status {
+		if status == code {
+			return true
+		}
+	}
+	if status == http.StatusForbidden && s.tmpl.Retry.RateReason != "" {
+		if reason := jsonString(payload, s.tmpl.Retry.RateReason); reason != "" {
+			return true
+		}
+	}
+	return false
+}
+
+func (s *templateStorage) authHeaders(ctx context.Context, vars map[string]string) (map[string]string, error) {
+	switch s.tmpl.Auth.Type {
+	case "", "none":
+		return nil, nil
+	case "static", "oauth2":
+		if s.tmpl.Auth.Type == "oauth2" {
+			token, err := s.accessToken(ctx)
+			if err != nil {
+				return nil, err
+			}
+			vars["token"] = token
+		}
+		headers := make(map[string]string, len(s.tmpl.Auth.Header))
+		for k, v := range s.tmpl.Auth.Header {
+			headers[k] = subst(v, vars)
+		}
+		return headers, nil
+	case "basic":
+		user := subst(s.tmpl.Auth.Username, vars)
+		pass := subst(s.tmpl.Auth.Password, vars)
+		enc := base64.StdEncoding.EncodeToString([]byte(user + ":" + pass))
+		return map[string]string{"Authorization": "Basic " + enc}, nil
+	default:
+		return nil, newError("unsupported auth type: ", s.tmpl.Auth.Type)
+	}
+}
+
+func (s *templateStorage) accessToken(ctx context.Context) (string, error) {
+	s.tokenMu.Lock()
+	defer s.tokenMu.Unlock()
+
+	if s.token != "" && time.Now().Before(s.tokenExpiry) {
+		return s.token, nil
+	}
+
+	form := make(map[string]string, len(s.tmpl.Auth.Form))
+	vars := s.baseVars()
+	values := strings.Builder{}
+	first := true
+	for k, v := range s.tmpl.Auth.Form {
+		form[k] = subst(v, vars)
+		if !first {
+			values.WriteByte('&')
+		}
+		first = false
+		values.WriteString(url.QueryEscape(k))
+		values.WriteByte('=')
+		values.WriteString(url.QueryEscape(form[k]))
+	}
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, s.tmpl.Auth.TokenURL,
+		strings.NewReader(values.String()))
+	if err != nil {
+		return "", newError("failed to build the token request").Base(err)
+	}
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+
+	resp, err := s.client.Do(req)
+	if err != nil {
+		return "", newError("failed to fetch the token").Base(err)
+	}
+	defer resp.Body.Close()
+	payload, err := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
+	if err != nil {
+		return "", newError("failed to read the token response").Base(err)
+	}
+	if resp.StatusCode != http.StatusOK {
+		return "", newError("the token endpoint answered ", resp.StatusCode, ": ", string(payload))
+	}
+
+	path := s.tmpl.Auth.TokenPath
+	if path == "" {
+		path = "access_token"
+	}
+	token := jsonString(payload, path)
+	if token == "" {
+		return "", newError("the token response has no token at ", path)
+	}
+
+	lifetime := int64(3600)
+	if s.tmpl.Auth.ExpiryPath != "" {
+		if n := jsonNumber(payload, s.tmpl.Auth.ExpiryPath); n > 0 {
+			lifetime = n
+		}
+	}
+	if lifetime > 60 {
+		lifetime -= 60
+	}
+	s.token = token
+	s.tokenExpiry = time.Now().Add(time.Duration(lifetime) * time.Second)
+	return s.token, nil
+}
+
+func (s *templateStorage) invalidateToken() {
+	s.tokenMu.Lock()
+	s.token = ""
+	s.tokenMu.Unlock()
+}
+
+func (s *templateStorage) do(ctx context.Context, op *opTemplate, vars map[string]string, body []byte) (int, []byte, error) {
+	backoff := driveInitialBackoff
+	var lastErr error
+
+	for attempt := 0; attempt < driveMaxAttempts; attempt++ {
+		if attempt > 0 {
+			select {
+			case <-ctx.Done():
+				return 0, nil, ctx.Err()
+			case <-time.After(jitter(backoff)):
+			}
+			backoff *= 2
+			if backoff > driveMaxBackoff {
+				backoff = driveMaxBackoff
+			}
+		}
+
+		authHeaders, err := s.authHeaders(ctx, vars)
+		if err != nil {
+			lastErr = err
+			continue
+		}
+
+		method := op.Method
+		if method == "" {
+			method = http.MethodGet
+		}
+
+		var reader io.Reader
+		if body != nil {
+			reader = bytes.NewReader(body)
+		}
+		req, err := http.NewRequestWithContext(ctx, method, subst(op.URL, vars), reader)
+		if err != nil {
+			return 0, nil, newError("failed to build request").Base(err)
+		}
+		for k, v := range authHeaders {
+			req.Header.Set(k, v)
+		}
+		for k, v := range op.Headers {
+			req.Header.Set(k, subst(v, vars))
+		}
+
+		select {
+		case s.inflight <- struct{}{}:
+		case <-ctx.Done():
+			return 0, nil, ctx.Err()
+		}
+		resp, err := s.client.Do(req)
+		if err != nil {
+			<-s.inflight
+			if ctx.Err() != nil {
+				return 0, nil, ctx.Err()
+			}
+			lastErr = newError("request failed").Base(err)
+			continue
+		}
+		payload, err := readResponse(resp.Body)
+		resp.Body.Close()
+		<-s.inflight
+		if err != nil {
+			if ctx.Err() != nil {
+				return 0, nil, ctx.Err()
+			}
+			lastErr = newError("failed to read response").Base(err)
+			continue
+		}
+
+		if resp.StatusCode == http.StatusUnauthorized && s.tmpl.Auth.Type == "oauth2" {
+			s.invalidateToken()
+			lastErr = newError("the service rejected the token")
+			continue
+		}
+		if s.retryable(resp.StatusCode, payload) {
+			lastErr = newError("the service answered ", resp.StatusCode)
+			continue
+		}
+		return resp.StatusCode, payload, nil
+	}
+	return 0, nil, lastErr
+}
+
+func (s *templateStorage) Put(ctx context.Context, name string, data []byte) error {
+	vars := s.baseVars()
+	vars["name"] = s.storedName(name)
+
+	body := data
+	if s.tmpl.Put.Body != "" {
+		vars["data"] = base64.StdEncoding.EncodeToString(data)
+		body = []byte(subst(s.tmpl.Put.Body, vars))
+	}
+
+	status, payload, err := s.do(ctx, &s.tmpl.Put, vars, body)
+	if err != nil {
+		return err
+	}
+	if status < 200 || status >= 300 {
+		return newError("put of ", name, " answered ", status, ": ", string(payload))
+	}
+	return nil
+}
+
+func (s *templateStorage) Get(ctx context.Context, name string) ([]byte, error) {
+	vars := s.baseVars()
+	vars["name"] = s.storedName(name)
+
+	status, payload, err := s.do(ctx, &s.tmpl.Get, vars, nil)
+	if err != nil {
+		return nil, err
+	}
+	switch {
+	case status >= 200 && status < 300:
+		return payload, nil
+	case status == http.StatusNotFound:
+		return nil, errNotFound
+	default:
+		return nil, newError("get of ", name, " answered ", status, ": ", string(payload))
+	}
+}
+
+func (s *templateStorage) Delete(ctx context.Context, name string) error {
+	vars := s.baseVars()
+	vars["name"] = s.storedName(name)
+
+	status, payload, err := s.do(ctx, &s.tmpl.Delete, vars, nil)
+	if err != nil {
+		return err
+	}
+	if status == http.StatusNotFound || (status >= 200 && status < 300) {
+		return nil
+	}
+	return newError("delete of ", name, " answered ", status, ": ", string(payload))
+}
+
+func (s *templateStorage) List(ctx context.Context, prefix string) ([]Entry, error) {
+	vars := s.baseVars()
+	flat := s.storedName(prefix)
+	vars["prefix"] = flat
+
+	status, payload, err := s.do(ctx, &s.tmpl.List, vars, nil)
+	if err != nil {
+		return nil, err
+	}
+	if status == http.StatusNotFound {
+		return nil, nil
+	}
+	if status < 200 || status >= 300 {
+		return nil, newError("list of ", prefix, " answered ", status, ": ", string(payload))
+	}
+
+	matches := s.tmpl.names.FindAllStringSubmatch(string(payload), -1)
+	if !s.tmpl.Flatten {
+		entries := make([]Entry, 0, len(matches))
+		for _, m := range matches {
+			entries = append(entries, Entry{Name: m[1]})
+		}
+		return entries, nil
+	}
+
+	want := flat + flatSeparator
+	seen := make(map[string]bool, len(matches))
+	entries := make([]Entry, 0, len(matches))
+	for _, m := range matches {
+		name := m[1]
+		if !strings.HasPrefix(name, want) {
+			continue
+		}
+		rest := strings.TrimPrefix(name, want)
+		if rest == "" {
+			continue
+		}
+		if cut := strings.Index(rest, flatSeparator); cut >= 0 {
+			rest = rest[:cut]
+		}
+		if seen[rest] {
+			continue
+		}
+		seen[rest] = true
+		entries = append(entries, Entry{Name: rest})
+	}
+	return entries, nil
+}
+
+func (s *templateStorage) Close() error {
+	return nil
+}
diff --git a/transport/xdrive/template_test.go b/transport/xdrive/template_test.go
new file mode 100644
index 00000000..753657a8
--- /dev/null
+++ b/transport/xdrive/template_test.go
@@ -0,0 +1,273 @@
+// Adapted from XTLS/Xray-core at 92ccc939aaf4; SPDX-License-Identifier: MPL-2.0
+
+package xdrive
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+type fakeStore struct {
+	server *httptest.Server
+
+	mu       sync.Mutex
+	objects  map[string][]byte
+	needAuth string
+	sawAuth  string
+	tokens   int
+}
+
+func newFakeStore(t *testing.T) *fakeStore {
+	t.Helper()
+
+	store := &fakeStore{objects: make(map[string][]byte)}
+	store.server = httptest.NewServer(http.HandlerFunc(store.handle))
+	t.Cleanup(store.server.Close)
+	return store
+}
+
+func (s *fakeStore) handle(w http.ResponseWriter, r *http.Request) {
+	if r.URL.Path == "/token" {
+		s.mu.Lock()
+		s.tokens++
+		s.mu.Unlock()
+		json.NewEncoder(w).Encode(map[string]interface{}{
+			"access_token": "tok-fake", "expires_in": 3600,
+		})
+		return
+	}
+
+	if auth := r.Header.Get("Authorization"); auth != "" {
+		s.mu.Lock()
+		s.sawAuth = auth
+		s.mu.Unlock()
+	}
+	if s.needAuth != "" && r.Header.Get("Authorization") != s.needAuth {
+		w.WriteHeader(http.StatusUnauthorized)
+		return
+	}
+
+	key := strings.TrimPrefix(r.URL.Path, "/folder/")
+
+	switch r.Method {
+	case "PROPFIND":
+		s.mu.Lock()
+		var b strings.Builder
+		for name := range s.objects {
+			fmt.Fprintf(&b, "<d:href>/folder/%s</d:href>\n", name)
+		}
+		s.mu.Unlock()
+		w.Write([]byte(b.String()))
+	case http.MethodPut:
+		body, _ := io.ReadAll(r.Body)
+		s.mu.Lock()
+		s.objects[key] = body
+		s.mu.Unlock()
+		w.WriteHeader(http.StatusCreated)
+	case http.MethodGet:
+		s.mu.Lock()
+		data, ok := s.objects[key]
+		s.mu.Unlock()
+		if !ok {
+			w.WriteHeader(http.StatusNotFound)
+			return
+		}
+		w.Write(data)
+	case http.MethodDelete:
+		s.mu.Lock()
+		delete(s.objects, key)
+		s.mu.Unlock()
+		w.WriteHeader(http.StatusNoContent)
+	default:
+		w.WriteHeader(http.StatusMethodNotAllowed)
+	}
+}
+
+func (s *fakeStore) count() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return len(s.objects)
+}
+
+func (s *fakeStore) seenAuth() string {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.sawAuth
+}
+
+func templateSettings(store *fakeStore, auth map[string]interface{}, secrets []string) *Config {
+	base := store.server.URL
+	tmpl := map[string]interface{}{
+		"flatten": true,
+		"auth":    auth,
+		"put":     map[string]interface{}{"method": "PUT", "url": base + "/folder/{name}"},
+		"get":     map[string]interface{}{"method": "GET", "url": base + "/folder/{name}"},
+		"delete":  map[string]interface{}{"method": "DELETE", "url": base + "/folder/{name}"},
+		"list": map[string]interface{}{
+			"method":     "PROPFIND",
+			"url":        base + "/folder/",
+			"namesRegex": `<d:href>/folder/([^<]+)</d:href>`,
+		},
+		"retry": map[string]interface{}{"status": []int{429, 500, 502, 503}},
+	}
+	return &Config{RemoteFolder: "folder", Service: "template", Secrets: secrets, Template: tmpl, FlushIntervalMs: 5, PollIntervalMs: 5, MaxPollIntervalMs: 20, SessionTtlSeconds: 5}
+}
+
+func newTemplateBackend(t *testing.T, store *fakeStore, auth map[string]interface{}, secrets []string) *templateStorage {
+	t.Helper()
+	settings := templateSettings(store, auth, secrets)
+	storage, err := newTemplateStorage(NewHTTPClient(nil, nil), settings)
+	if err != nil {
+		t.Fatalf("newTemplateStorage: %v", err)
+	}
+	return storage
+}
+
+func TestTemplateRoundTrip(t *testing.T) {
+	store := newFakeStore(t)
+	storage := newTemplateBackend(t, store, map[string]interface{}{"type": "none"}, nil)
+	ctx := context.Background()
+
+	if err := storage.Put(ctx, "streams/abc/c2s/000000000.seg", []byte("hello")); err != nil {
+		t.Fatalf("Put: %v", err)
+	}
+	data, err := storage.Get(ctx, "streams/abc/c2s/000000000.seg")
+	if err != nil {
+		t.Fatalf("Get: %v", err)
+	}
+	if string(data) != "hello" {
+		t.Fatalf("Get returned %q, want hello", data)
+	}
+
+	entries, err := storage.List(ctx, "streams/abc/c2s")
+	if err != nil {
+		t.Fatalf("List: %v", err)
+	}
+	if len(entries) != 1 || entries[0].Name != "000000000.seg" {
+		t.Fatalf("List returned %v, want one segment", entries)
+	}
+
+	if _, err := storage.Get(ctx, "streams/abc/c2s/000000009.seg"); err != errNotFound {
+		t.Fatalf("Get of a missing object returned %v, want errNotFound", err)
+	}
+
+	if err := storage.Delete(ctx, "streams/abc/c2s/000000000.seg"); err != nil {
+		t.Fatalf("Delete: %v", err)
+	}
+	if store.count() != 0 {
+		t.Fatalf("store still holds %d objects", store.count())
+	}
+}
+
+func TestTemplateListReturnsDirectChildren(t *testing.T) {
+	store := newFakeStore(t)
+	storage := newTemplateBackend(t, store, map[string]interface{}{"type": "none"}, nil)
+	ctx := context.Background()
+
+	for _, name := range []string{
+		"streams/one/c2s/000000000.seg",
+		"streams/one/s2c/000000000.seg",
+		"streams/two/c2s/000000000.seg",
+	} {
+		if err := storage.Put(ctx, name, []byte("x")); err != nil {
+			t.Fatalf("Put %s: %v", name, err)
+		}
+	}
+
+	entries, err := storage.List(ctx, "streams")
+	if err != nil {
+		t.Fatalf("List: %v", err)
+	}
+	if len(entries) != 2 {
+		t.Fatalf("List returned %v, want the two session ids", entries)
+	}
+}
+
+func TestTemplateBasicAuth(t *testing.T) {
+	store := newFakeStore(t)
+	store.needAuth = "Basic dXNlcjpwYXNz"
+	auth := map[string]interface{}{"type": "basic", "username": "{secret0}", "password": "{secret1}"}
+	storage := newTemplateBackend(t, store, auth, []string{"user", "pass"})
+
+	if err := storage.Put(context.Background(), "sessions/a", []byte("x")); err != nil {
+		t.Fatalf("Put with basic auth: %v", err)
+	}
+	if store.seenAuth() != "Basic dXNlcjpwYXNz" {
+		t.Fatalf("server saw auth %q", store.seenAuth())
+	}
+}
+
+func TestTemplateOAuth(t *testing.T) {
+	store := newFakeStore(t)
+	store.needAuth = "Bearer tok-fake"
+	auth := map[string]interface{}{
+		"type":     "oauth2",
+		"tokenUrl": store.server.URL + "/token",
+		"form":     map[string]interface{}{"grant_type": "refresh_token", "refresh_token": "{secret0}"},
+		"header":   map[string]interface{}{"Authorization": "Bearer {token}"},
+	}
+	storage := newTemplateBackend(t, store, auth, []string{"refresh"})
+	ctx := context.Background()
+
+	for i := 0; i < 4; i++ {
+		if err := storage.Put(ctx, fmt.Sprintf("sessions/s%d", i), nil); err != nil {
+			t.Fatalf("Put: %v", err)
+		}
+	}
+	if store.tokens != 1 {
+		t.Fatalf("token endpoint was hit %d times, want 1", store.tokens)
+	}
+}
+
+func TestTemplateTransport(t *testing.T) {
+	store := newFakeStore(t)
+	settings := templateSettings(store, map[string]interface{}{"type": "none"}, nil)
+
+	client, server, cleanup := pairWith(t, settings)
+	defer cleanup()
+
+	if _, err := client.Write([]byte("ping")); err != nil {
+		t.Fatalf("client write: %v", err)
+	}
+	expectRead(t, server, "ping")
+
+	if _, err := server.Write([]byte("pong")); err != nil {
+		t.Fatalf("server write: %v", err)
+	}
+	expectRead(t, client, "pong")
+
+	payload := make([]byte, 300000)
+	for i := range payload {
+		payload[i] = byte(i % 251)
+	}
+	go func() { client.Write(payload) }()
+
+	if err := server.SetReadDeadline(time.Now().Add(30 * time.Second)); err != nil {
+		t.Fatalf("SetReadDeadline: %v", err)
+	}
+	got := make([]byte, len(payload))
+	if _, err := io.ReadFull(server, got); err != nil {
+		t.Fatalf("ReadFull: %v", err)
+	}
+	for i := range got {
+		if got[i] != payload[i] {
+			t.Fatalf("payload mismatch at byte %d", i)
+		}
+	}
+}
+
+func TestTemplateConcurrencyDefault(t *testing.T) {
+	store := newFakeStore(t)
+	storage := newTemplateBackend(t, store, map[string]interface{}{"type": "none"}, nil)
+	if cap(storage.inflight) != driveMaxInflight {
+		t.Fatalf("default inflight cap is %d, want %d", cap(storage.inflight), driveMaxInflight)
+	}
+}
diff --git a/transport/xdrive/wal.go b/transport/xdrive/wal.go
new file mode 100644
index 00000000..07e42604
--- /dev/null
+++ b/transport/xdrive/wal.go
@@ -0,0 +1,297 @@
+// Adapted from XTLS/Xray-core transport/internet/xdrive at 92ccc939aaf4.
+// Copyright Xray-core contributors. Licensed under MPL-2.0.
+// SPDX-License-Identifier: MPL-2.0
+
+package xdrive
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+const (
+	segSuffix = ".seg"
+	endSuffix = ".end"
+	errSuffix = ".err"
+)
+
+func objectName(prefix string, seq int64, suffix string) string {
+	return fmt.Sprintf("%s/%09d%s", prefix, seq, suffix)
+}
+
+func parseEntry(name string) (int64, bool) {
+	dot := strings.LastIndexByte(name, '.')
+	if dot < 0 {
+		return 0, false
+	}
+	switch name[dot:] {
+	case segSuffix, endSuffix, errSuffix:
+	default:
+		return 0, false
+	}
+	seq, err := strconv.ParseInt(name[:dot], 10, 64)
+	if err != nil || seq < 0 {
+		return 0, false
+	}
+	return seq, true
+}
+
+type walReader struct {
+	ctx     context.Context
+	storage Storage
+	prefix  string
+	params
+	seq int64
+
+	ch        chan []byte
+	discards  chan string
+	wake      chan struct{}
+	holeSince time.Time
+
+	errMu sync.Mutex
+	err   error
+}
+
+func newWALReader(ctx context.Context, storage Storage, prefix string, p params) *walReader {
+	r := &walReader{
+		ctx:      ctx,
+		storage:  storage,
+		prefix:   prefix,
+		params:   p,
+		ch:       make(chan []byte, p.concurrency),
+		discards: make(chan string, 4*p.concurrency),
+		wake:     make(chan struct{}, 1),
+	}
+	go r.run()
+	go r.discardLoop()
+	return r
+}
+
+func (r *walReader) Wake() {
+	select {
+	case r.wake <- struct{}{}:
+	default:
+	}
+}
+
+func (r *walReader) run() {
+	defer close(r.ch)
+
+	delay := r.minPollInterval
+	active := time.Now()
+	for {
+		polled := time.Now()
+		advanced, eof, err := r.poll()
+		if err != nil {
+			r.setErr(err)
+			return
+		}
+		if eof {
+			return
+		}
+
+		switch {
+		case advanced:
+			active = time.Now()
+			delay = r.minPollInterval
+		case time.Since(active) < r.eagerWindow:
+			delay = r.minPollInterval
+		default:
+			delay *= 2
+			if delay > r.maxPollInterval {
+				delay = r.maxPollInterval
+			}
+		}
+
+		timer := time.NewTimer(delay)
+		select {
+		case <-r.ctx.Done():
+			timer.Stop()
+			return
+		case <-timer.C:
+		case <-r.wake:
+			timer.Stop()
+			active = time.Now()
+			delay = r.minPollInterval
+			if rest := r.minPollInterval - time.Since(polled); rest > 0 {
+				select {
+				case <-r.ctx.Done():
+					return
+				case <-time.After(rest):
+				}
+			}
+		}
+	}
+}
+
+func (r *walReader) poll() (advanced, eof bool, err error) {
+	listed, err := r.storage.List(r.ctx, r.prefix)
+	if err != nil {
+		return false, false, err
+	}
+	if len(listed) == 0 {
+		return false, false, nil
+	}
+
+	pending := make(map[int64]Entry, len(listed))
+	ahead := false
+	for _, entry := range listed {
+		seq, ok := parseEntry(entry.Name)
+		if !ok {
+			continue
+		}
+		pending[seq] = entry
+		if seq > r.seq {
+			ahead = true
+		}
+	}
+
+	if _, ok := pending[r.seq]; !ok && ahead {
+		if r.holeSince.IsZero() {
+			r.holeSince = time.Now()
+		} else if time.Since(r.holeSince) >= r.holeTimeout {
+			return false, false, newError("segment ", r.seq,
+				" never arrived while later ones did, the peer lost it")
+		}
+	} else {
+		r.holeSince = time.Time{}
+	}
+
+	for {
+		if entry, ok := pending[r.seq]; ok && strings.HasSuffix(entry.Name, errSuffix) {
+			r.discard(r.prefix + "/" + entry.Name)
+			return advanced, false, newError("the peer could not store segment ", r.seq)
+		}
+
+		batch, done := r.nextBatch(pending)
+		if done {
+			return advanced, true, nil
+		}
+		if len(batch) == 0 {
+			return advanced, false, nil
+		}
+
+		chunks, err := r.fetch(batch)
+		if err != nil {
+			if err == errNotFound {
+				return advanced, false, nil
+			}
+			return advanced, false, err
+		}
+
+		for i, chunk := range chunks {
+			select {
+			case r.ch <- chunk:
+			case <-r.ctx.Done():
+				return advanced, true, nil
+			}
+			r.seq++
+			advanced = true
+			r.discard(r.prefix + "/" + batch[i].Name)
+		}
+	}
+}
+
+func (r *walReader) nextBatch(pending map[int64]Entry) (batch []Entry, done bool) {
+	for i := 0; i < r.concurrency; i++ {
+		entry, ok := pending[r.seq+int64(i)]
+		if !ok {
+			break
+		}
+		if !strings.HasSuffix(entry.Name, segSuffix) {
+			if i == 0 && strings.HasSuffix(entry.Name, endSuffix) {
+				r.discard(r.prefix + "/" + entry.Name)
+				return nil, true
+			}
+			break
+		}
+		batch = append(batch, entry)
+	}
+	return batch, false
+}
+
+func (r *walReader) fetch(batch []Entry) ([][]byte, error) {
+	chunks := make([][]byte, len(batch))
+	failures := make([]error, len(batch))
+
+	var wg sync.WaitGroup
+	for i, entry := range batch {
+		if entry.Inline != nil {
+			if len(entry.Inline) > maxSegmentBytes {
+				return nil, newError("segment too large")
+			}
+			chunks[i] = entry.Inline
+			continue
+		}
+		wg.Add(1)
+		go func(i int, name string) {
+			defer wg.Done()
+			chunks[i], failures[i] = r.storage.Get(r.ctx, r.prefix+"/"+name)
+			if len(chunks[i]) > maxSegmentBytes {
+				failures[i] = newError("segment too large")
+			}
+		}(i, entry.Name)
+	}
+	wg.Wait()
+
+	for i := range batch {
+		if failures[i] != nil {
+			return nil, failures[i]
+		}
+	}
+	return chunks, nil
+}
+
+func (r *walReader) discard(name string) {
+	select {
+	case r.discards <- name:
+	default:
+	}
+}
+
+func (r *walReader) discardLoop() {
+	var wg sync.WaitGroup
+	defer wg.Wait()
+
+	sem := make(chan struct{}, r.concurrency)
+	for {
+		select {
+		case <-r.ctx.Done():
+			return
+		case name := <-r.discards:
+			select {
+			case sem <- struct{}{}:
+			case <-r.ctx.Done():
+				return
+			}
+			wg.Add(1)
+			go func(name string) {
+				defer wg.Done()
+				defer func() { <-sem }()
+				r.storage.Delete(r.ctx, name)
+			}(name)
+		}
+	}
+}
+
+func (r *walReader) setErr(err error) {
+	r.errMu.Lock()
+	defer r.errMu.Unlock()
+	if r.err == nil {
+		r.err = err
+	}
+}
+
+func (r *walReader) Err() error {
+	r.errMu.Lock()
+	defer r.errMu.Unlock()
+	if r.err != nil {
+		return r.err
+	}
+	return io.EOF
+}
diff --git a/transport/xdrive/writer.go b/transport/xdrive/writer.go
new file mode 100644
index 00000000..b565253c
--- /dev/null
+++ b/transport/xdrive/writer.go
@@ -0,0 +1,171 @@
+package xdrive
+
+import (
+	"context"
+	"io"
+	"net"
+	"os"
+	"sync"
+	"time"
+
+	"github.com/metacubex/mihomo/common/net/deadline"
+)
+
+type segment struct {
+	seq  int64
+	data []byte
+}
+
+// A fixed number of workers and a bounded queue apply backpressure before
+// allocating another segment, rather than spawning a goroutine per Write.
+type walWriter struct {
+	ctx     context.Context
+	storage Storage
+	prefix  string
+	params
+	deadline *deadline.PipeDeadline
+	mu       sync.Mutex
+	buf      []byte
+	seq      int64
+	closed   bool
+	queue    chan segment
+	stop     chan struct{}
+	failed   chan struct{}
+	workers  sync.WaitGroup
+	errMu    sync.Mutex
+	err      error
+}
+
+func newWALWriter(ctx context.Context, storage Storage, prefix string, p params, d *deadline.PipeDeadline) *walWriter {
+	w := &walWriter{ctx: ctx, storage: storage, prefix: prefix, params: p, deadline: d, queue: make(chan segment, p.concurrency), stop: make(chan struct{}), failed: make(chan struct{})}
+	for i := 0; i < p.concurrency; i++ {
+		w.workers.Add(1)
+		go w.uploadLoop()
+	}
+	go w.flushLoop()
+	return w
+}
+func (w *walWriter) Err() error { w.errMu.Lock(); defer w.errMu.Unlock(); return w.err }
+func (w *walWriter) fail(err error) {
+	w.errMu.Lock()
+	defer w.errMu.Unlock()
+	if w.err == nil {
+		w.err = err
+		close(w.failed)
+	}
+}
+func (w *walWriter) Write(p []byte) (int, error) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if w.closed {
+		return 0, net.ErrClosed
+	}
+	total := 0
+	for len(p) > 0 {
+		if err := w.Err(); err != nil {
+			return total, err
+		}
+		select {
+		case <-w.ctx.Done():
+			return total, net.ErrClosed
+		case <-w.deadline.Wait():
+			return total, os.ErrDeadlineExceeded
+		default:
+		}
+		n := minInt(len(p), w.segmentBytes-len(w.buf))
+		w.buf = append(w.buf, p[:n]...)
+		p = p[n:]
+		total += n
+		if len(w.buf) == w.segmentBytes {
+			if err := w.flushLocked(); err != nil {
+				return total, err
+			}
+		}
+	}
+	return total, nil
+}
+func (w *walWriter) flushLocked() error {
+	if len(w.buf) == 0 {
+		return nil
+	}
+	select {
+	case w.queue <- segment{seq: w.seq, data: w.buf}:
+		w.seq++
+		w.buf = nil
+		return nil
+	case <-w.ctx.Done():
+		return net.ErrClosed
+	case <-w.failed:
+		return w.Err()
+	case <-w.deadline.Wait():
+		return os.ErrDeadlineExceeded
+	}
+}
+func (w *walWriter) flushLoop() {
+	ticker := time.NewTicker(w.flushInterval)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-w.ctx.Done():
+			return
+		case <-w.stop:
+			return
+		case <-ticker.C:
+			w.mu.Lock()
+			if !w.closed {
+				_ = w.flushLocked()
+			}
+			w.mu.Unlock()
+		}
+	}
+}
+func (w *walWriter) uploadLoop() {
+	defer w.workers.Done()
+	for {
+		select {
+		case <-w.ctx.Done():
+			return
+		case item, ok := <-w.queue:
+			if !ok {
+				return
+			}
+			if err := w.storage.Put(w.ctx, objectName(w.prefix, item.seq, segSuffix), item.data); err != nil {
+				w.fail(newError("failed to store segment").Base(err))
+				_ = w.storage.Put(w.ctx, objectName(w.prefix, item.seq, errSuffix), nil)
+				return
+			}
+		}
+	}
+}
+func (w *walWriter) Close() error {
+	w.mu.Lock()
+	if w.closed {
+		w.mu.Unlock()
+		return nil
+	}
+	w.closed = true
+	close(w.stop)
+	err := w.flushLocked()
+	close(w.queue)
+	seq := w.seq
+	w.mu.Unlock()
+	w.workers.Wait()
+	if err != nil {
+		return err
+	}
+	if err = w.Err(); err != nil {
+		return err
+	}
+	if w.ctx.Err() != nil {
+		return io.ErrClosedPipe
+	}
+	return w.storage.Put(w.ctx, objectName(w.prefix, seq, endSuffix), nil)
+}
+
+// minInt replaces the go1.21 built-in min: vanilla mihomo is still go 1.20 (ClashFest patch 0003).
+func minInt(a, b int) int {
+	if a < b {
+		return a
+	}
+	return b
+}
