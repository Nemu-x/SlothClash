diff --git a/transport/xdrive/client.go b/transport/xdrive/client.go
new file mode 100644
index 00000000..efa892e5
--- /dev/null
+++ b/transport/xdrive/client.go
@@ -0,0 +1,187 @@
+// Adapted from XTLS/Xray-core at 92ccc939aaf4; SPDX-License-Identifier: MPL-2.0
+
+package xdrive
+
+import (
+	"context"
+	"github.com/metacubex/http"
+	"io"
+	"sync"
+	"time"
+
+	"github.com/metacubex/tls"
+	"net"
+)
+
+var errStalled = newError("the request made no progress")
+
+type serviceTransport struct {
+	plain  http.RoundTripper
+	secure http.RoundTripper
+	stall  time.Duration
+}
+
+// RoundTrip ends a request that stands still for t.stall, with no answer that
+// long after its body went out or no byte of either body, but not one that just
+// runs long: a large object on a slow link takes minutes and is fine as long as
+// its bytes move
+func (t *serviceTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	next := t.plain
+	if r.URL.Scheme == "https" {
+		next = t.secure
+	}
+
+	ctx, cancel := context.WithCancelCause(r.Context())
+	timer := time.AfterFunc(t.stall, func() { cancel(errStalled) })
+	alive := func() { timer.Reset(t.stall) }
+	end := func() {
+		timer.Stop()
+		cancel(nil)
+	}
+	r = r.WithContext(ctx)
+	if r.Body != nil && r.Body != http.NoBody {
+		r.Body = &progressBody{ReadCloser: r.Body, alive: alive}
+	}
+	// a body sent again by the transport itself, after a GOAWAY or on a reused
+	// connection that failed, moves just the same
+	if getBody := r.GetBody; getBody != nil {
+		r.GetBody = func() (io.ReadCloser, error) {
+			body, err := getBody()
+			if err != nil || body == http.NoBody {
+				return body, err
+			}
+			return &progressBody{ReadCloser: body, alive: alive}, nil
+		}
+	}
+
+	resp, err := next.RoundTrip(r)
+	if err != nil {
+		err = stalled(ctx, err)
+		end()
+		return nil, err
+	}
+	alive()
+	resp.Body = &progressBody{ReadCloser: resp.Body, alive: alive, end: end, ctx: ctx}
+	return resp, nil
+}
+
+// stalled returns errStalled for an error that the stall gave, which http2 reports
+// as a plain cancel
+func stalled(ctx context.Context, err error) error {
+	if context.Cause(ctx) == errStalled {
+		return errStalled
+	}
+	return err
+}
+
+type progressBody struct {
+	io.ReadCloser
+	alive func()
+	end   func()
+	// ctx is that of the request, for the body of its response
+	ctx context.Context
+}
+
+func (b *progressBody) Read(p []byte) (int, error) {
+	// http2 reads a request body up to 512 KiB at a time and sends it all before
+	// the next read, which on a slow link could look like no progress
+	n, err := b.ReadCloser.Read(p[:minInt(len(p), 16<<10)])
+	if n > 0 {
+		b.alive()
+	}
+	if err != nil && err != io.EOF && b.ctx != nil {
+		err = stalled(b.ctx, err)
+	}
+	return n, err
+}
+
+func (b *progressBody) Close() error {
+	err := b.ReadCloser.Close()
+	if b.end != nil {
+		b.end()
+	}
+	return err
+}
+
+// NewHTTPClient uses the caller's dialer for storage HTTP requests. HTTPS is
+// negotiated per API URL; TLS belongs to these requests, not the storage stream.
+func NewHTTPClient(dial, dialTLS func(context.Context, string, string) (net.Conn, error)) *http.Client {
+	if dial == nil {
+		dial = (&net.Dialer{Timeout: 30 * time.Second, KeepAlive: 30 * time.Second}).DialContext
+	}
+	if dialTLS == nil {
+		dialTLS = func(ctx context.Context, network, addr string) (net.Conn, error) {
+			raw, err := dial(ctx, network, addr)
+			if err != nil {
+				return nil, err
+			}
+			host, _, err := net.SplitHostPort(addr)
+			if err != nil {
+				raw.Close()
+				return nil, err
+			}
+			conn := tls.Client(raw, &tls.Config{ServerName: host, MinVersion: tls.VersionTLS12, NextProtos: []string{"h2", "http/1.1"}})
+			handshakeCtx, cancel := context.WithTimeout(ctx, driveTimeout)
+			defer cancel()
+			if err := conn.HandshakeContext(handshakeCtx); err != nil {
+				raw.Close()
+				return nil, err
+			}
+			return conn, nil
+		}
+	}
+	secure := func(maxConns int) *http.Transport {
+		return &http.Transport{
+			DialTLSContext: dialTLS, ForceAttemptHTTP2: true, IdleConnTimeout: 90 * time.Second,
+			MaxIdleConns: 32, MaxIdleConnsPerHost: 32, MaxConnsPerHost: maxConns,
+		}
+	}
+	return &http.Client{Transport: &serviceTransport{
+		plain:  &http.Transport{DialContext: dial, IdleConnTimeout: 90 * time.Second, MaxIdleConns: 32, MaxIdleConnsPerHost: 32, MaxConnsPerHost: 32},
+		secure: &secureTransport{h2: secure(1), h1: secure(32)}, stall: driveTimeout,
+	}}
+}
+
+func defaultHTTPClient(c Config) *http.Client {
+	if c.Fronting == "" {
+		return NewHTTPClient(nil, nil)
+	}
+	dial := func(ctx context.Context, network, _ string) (net.Conn, error) {
+		return (&net.Dialer{Timeout: 30 * time.Second}).DialContext(ctx, network, c.Fronting)
+	}
+	return NewHTTPClient(dial, nil)
+}
+
+func (t *serviceTransport) CloseIdleConnections() {
+	for _, next := range []http.RoundTripper{t.plain, t.secure} {
+		if closer, ok := next.(interface{ CloseIdleConnections() }); ok {
+			closer.CloseIdleConnections()
+		}
+	}
+}
+func (t *secureTransport) CloseIdleConnections() {
+	for _, next := range []http.RoundTripper{t.h2, t.h1} {
+		if closer, ok := next.(interface{ CloseIdleConnections() }); ok {
+			closer.CloseIdleConnections()
+		}
+	}
+}
+
+// secureTransport keeps a host to one connection, all that h2 needs, as without
+// a limit parallel requests would each dial their own. A host that answers over
+// h1 moves to a transport with more, since h1 carries one request at a time
+type secureTransport struct {
+	h2, h1  http.RoundTripper
+	h1Hosts sync.Map
+}
+
+func (t *secureTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	if _, ok := t.h1Hosts.Load(r.URL.Host); ok {
+		return t.h1.RoundTrip(r)
+	}
+	resp, err := t.h2.RoundTrip(r)
+	if err == nil && resp.ProtoMajor == 1 {
+		t.h1Hosts.Store(r.URL.Host, true)
+	}
+	return resp, err
+}
diff --git a/transport/xdrive/config.go b/transport/xdrive/config.go
new file mode 100644
index 00000000..ba53fca2
--- /dev/null
+++ b/transport/xdrive/config.go
@@ -0,0 +1,87 @@
+// Package xdrive implements Xray-compatible remote-storage stream transport.
+package xdrive
+
+import (
+	"errors"
+	"fmt"
+	"net"
+	"runtime"
+	"strconv"
+	"strings"
+)
+
+type Config struct {
+	Fronting          string         `proxy:"fronting,omitempty" inbound:"fronting,omitempty" yaml:"fronting,omitempty" json:"fronting,omitempty"`
+	RemoteFolder      string         `proxy:"remote-folder" inbound:"remote-folder" yaml:"remote-folder" json:"remote-folder"`
+	Service           string         `proxy:"service" inbound:"service" yaml:"service" json:"service"`
+	Secrets           []string       `proxy:"secrets,omitempty" inbound:"secrets,omitempty" yaml:"secrets,omitempty" json:"secrets,omitempty"`
+	SegmentBytes      uint32         `proxy:"segment-bytes,omitempty" inbound:"segment-bytes,omitempty" yaml:"segment-bytes,omitempty" json:"segment-bytes,omitempty"`
+	FlushIntervalMs   uint32         `proxy:"flush-interval-ms,omitempty" inbound:"flush-interval-ms,omitempty" yaml:"flush-interval-ms,omitempty" json:"flush-interval-ms,omitempty"`
+	PollIntervalMs    uint32         `proxy:"poll-interval-ms,omitempty" inbound:"poll-interval-ms,omitempty" yaml:"poll-interval-ms,omitempty" json:"poll-interval-ms,omitempty"`
+	MaxPollIntervalMs uint32         `proxy:"max-poll-interval-ms,omitempty" inbound:"max-poll-interval-ms,omitempty" yaml:"max-poll-interval-ms,omitempty" json:"max-poll-interval-ms,omitempty"`
+	SessionTtlSeconds uint32         `proxy:"session-ttl-seconds,omitempty" inbound:"session-ttl-seconds,omitempty" yaml:"session-ttl-seconds,omitempty" json:"session-ttl-seconds,omitempty"`
+	Concurrency       uint32         `proxy:"concurrency,omitempty" inbound:"concurrency,omitempty" yaml:"concurrency,omitempty" json:"concurrency,omitempty"`
+	EagerWindowMs     uint32         `proxy:"eager-window-ms,omitempty" inbound:"eager-window-ms,omitempty" yaml:"eager-window-ms,omitempty" json:"eager-window-ms,omitempty"`
+	HoleTimeoutMs     uint32         `proxy:"hole-timeout-ms,omitempty" inbound:"hole-timeout-ms,omitempty" yaml:"hole-timeout-ms,omitempty" json:"hole-timeout-ms,omitempty"`
+	Template          map[string]any `proxy:"template,omitempty" inbound:"template,omitempty" yaml:"template,omitempty" json:"template,omitempty"`
+}
+
+// AllowLocalService gates `service: local`, a folder on the device meant for
+// tests. ClashFest core patch 0003: Android builds accept such a node in a
+// config, so one bad node does not fail a whole subscription, but give it a
+// storage that refuses every operation: it never touches the filesystem and
+// every dial through it fails. This covers http and file proxy-providers too
+// (the app's YAML hardening only sees config.yaml and inline payloads).
+var AllowLocalService = runtime.GOOS != "android"
+
+// ErrLocalServiceDisabled is returned by every operation of a `service: local`
+// storage while AllowLocalService is off.
+var ErrLocalServiceDisabled = errors.New("xdrive service local (a folder on the device) is disabled in this build")
+
+func (c Config) Validate() error {
+	if c.Fronting != "" {
+		host, port, err := net.SplitHostPort(c.Fronting)
+		p, portErr := strconv.ParseUint(port, 10, 16)
+		if err != nil || host == "" || portErr != nil || p == 0 {
+			return fmt.Errorf("xdrive fronting must be a host:port address")
+		}
+	}
+	if c.RemoteFolder == "" {
+		return fmt.Errorf("xdrive requires remote-folder")
+	}
+	switch c.Service {
+	case "local":
+	case "google-drive", "Google Drive":
+		if len(c.Secrets) != 3 {
+			return fmt.Errorf("xdrive google-drive needs client ID, client secret and refresh token")
+		}
+		for _, secret := range c.Secrets {
+			if strings.TrimSpace(secret) == "" {
+				return fmt.Errorf("xdrive google-drive secrets must not be empty")
+			}
+		}
+	case "template":
+		if len(c.Template) == 0 {
+			return fmt.Errorf("xdrive template service requires a template object")
+		}
+	default:
+		return fmt.Errorf("unsupported xdrive service %q", c.Service)
+	}
+	return nil
+}
+
+// Preserve upstream error wrapping without importing Xray's transport framework.
+type storageError struct {
+	message string
+	cause   error
+}
+
+func newError(args ...any) *storageError             { return &storageError{message: fmt.Sprint(args...)} }
+func (e *storageError) Base(err error) *storageError { e.cause = err; return e }
+func (e *storageError) Error() string {
+	if e.cause != nil {
+		return e.message + ": " + e.cause.Error()
+	}
+	return e.message
+}
+func (e *storageError) Unwrap() error { return e.cause }
diff --git a/transport/xdrive/config_local_test.go b/transport/xdrive/config_local_test.go
new file mode 100644
index 00000000..287375f1
--- /dev/null
+++ b/transport/xdrive/config_local_test.go
@@ -0,0 +1,54 @@
+package xdrive
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestLocalServiceGate(t *testing.T) {
+	saved := AllowLocalService
+	t.Cleanup(func() { AllowLocalService = saved })
+
+	AllowLocalService = true
+	allowed := Config{Service: "local", RemoteFolder: filepath.Join(t.TempDir(), "allowed")}
+	if err := allowed.Validate(); err != nil {
+		t.Fatalf("local allowed: %v", err)
+	}
+	if _, err := newStorage(allowed, nil); err != nil {
+		t.Fatalf("local storage allowed: %v", err)
+	}
+	if _, err := os.Stat(allowed.RemoteFolder); err != nil {
+		t.Fatalf("allowed local storage must create its folder: %v", err)
+	}
+
+	AllowLocalService = false
+	folder := filepath.Join(t.TempDir(), "refused")
+	cfg := Config{Service: "local", RemoteFolder: folder}
+	if err := cfg.Validate(); err != nil {
+		t.Fatalf("a refused local node must still validate: %v", err)
+	}
+	client, err := NewClient(cfg, nil)
+	if err != nil {
+		t.Fatalf("client for a refused local node: %v", err)
+	}
+	if _, err := client.Dial(context.Background()); !errors.Is(err, ErrLocalServiceDisabled) {
+		t.Fatalf("dial through a refused local node: got %v", err)
+	}
+	if err := client.Close(); err != nil {
+		t.Fatalf("close: %v", err)
+	}
+	if _, err := Listen(cfg, nil); !errors.Is(err, ErrLocalServiceDisabled) {
+		t.Fatalf("listen on a refused local node: got %v", err)
+	}
+	if _, err := os.Stat(folder); !os.IsNotExist(err) {
+		t.Fatalf("a refused local node touched the filesystem: %v", err)
+	}
+
+	cloud := Config{Service: "google-drive", RemoteFolder: "id", Secrets: []string{"a", "b", "c"}}
+	if err := cloud.Validate(); err != nil {
+		t.Fatalf("google-drive must not be affected: %v", err)
+	}
+}
diff --git a/transport/xdrive/conn.go b/transport/xdrive/conn.go
new file mode 100644
index 00000000..6755d321
--- /dev/null
+++ b/transport/xdrive/conn.go
@@ -0,0 +1,99 @@
+package xdrive
+
+import (
+	"context"
+	"net"
+	"os"
+	"sync"
+	"time"
+
+	"github.com/metacubex/mihomo/common/net/deadline"
+)
+
+var placeholderAddr = &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1)}
+
+type Conn struct {
+	cancel                      context.CancelFunc
+	writer                      *walWriter
+	reader                      *walReader
+	onClose                     func()
+	readBuf                     []byte
+	readMu                      sync.Mutex
+	readDeadline, writeDeadline deadline.PipeDeadline
+	done                        chan struct{}
+	closeOnce                   sync.Once
+	closeErr                    error
+}
+
+func newConn(ctx context.Context, storage Storage, writePrefix, readPrefix string, p params, onClose func()) *Conn {
+	ctx, cancel := context.WithCancel(ctx)
+	c := &Conn{cancel: cancel, onClose: onClose, readDeadline: deadline.MakePipeDeadline(), writeDeadline: deadline.MakePipeDeadline(), done: make(chan struct{})}
+	c.writer = newWALWriter(ctx, storage, writePrefix, p, &c.writeDeadline)
+	c.reader = newWALReader(ctx, storage, readPrefix, p)
+	return c
+}
+func (c *Conn) Read(b []byte) (int, error) {
+	c.readMu.Lock()
+	defer c.readMu.Unlock()
+	if len(b) == 0 {
+		return 0, nil
+	}
+	if len(c.readBuf) == 0 {
+		select {
+		case <-c.done:
+			return 0, net.ErrClosed
+		case <-c.readDeadline.Wait():
+			return 0, os.ErrDeadlineExceeded
+		case data, ok := <-c.reader.ch:
+			if !ok {
+				return 0, c.reader.Err()
+			}
+			c.readBuf = data
+		}
+	}
+	n := copy(b, c.readBuf)
+	c.readBuf = c.readBuf[n:]
+	return n, nil
+}
+func (c *Conn) Write(b []byte) (int, error) {
+	select {
+	case <-c.done:
+		return 0, net.ErrClosed
+	default:
+	}
+	n, err := c.writer.Write(b)
+	if n > 0 {
+		c.reader.Wake()
+	}
+	return n, err
+}
+func (c *Conn) Close() error {
+	c.closeOnce.Do(func() {
+		close(c.done)
+		finished := make(chan error, 1)
+		go func() { finished <- c.writer.Close() }()
+		timer := time.NewTimer(5 * time.Second)
+		defer timer.Stop()
+		select {
+		case c.closeErr = <-finished:
+		case <-timer.C:
+			c.closeErr = os.ErrDeadlineExceeded
+		}
+		c.cancel()
+		c.readDeadline.Set(time.Time{})
+		c.writeDeadline.Set(time.Time{})
+		if c.onClose != nil {
+			c.onClose()
+		}
+	})
+	return c.closeErr
+}
+func (c *Conn) LocalAddr() net.Addr  { return placeholderAddr }
+func (c *Conn) RemoteAddr() net.Addr { return placeholderAddr }
+func (c *Conn) SetDeadline(t time.Time) error {
+	c.readDeadline.Set(t)
+	c.writeDeadline.Set(t)
+	return nil
+}
+func (c *Conn) SetReadDeadline(t time.Time) error  { c.readDeadline.Set(t); return nil }
+func (c *Conn) SetWriteDeadline(t time.Time) error { c.writeDeadline.Set(t); return nil }
diff --git a/transport/xdrive/drive.go b/transport/xdrive/drive.go
new file mode 100644
index 00000000..800fa9d7
--- /dev/null
+++ b/transport/xdrive/drive.go
@@ -0,0 +1,573 @@
+// Adapted from XTLS/Xray-core transport/internet/xdrive at 92ccc939aaf4.
+// Copyright Xray-core contributors. Licensed under MPL-2.0.
+// SPDX-License-Identifier: MPL-2.0
+
+package xdrive
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"github.com/metacubex/http"
+	"io"
+	"math/rand/v2"
+	"net/url"
+	"strings"
+	"sync"
+	"time"
+)
+
+const (
+	flatSeparator = "~"
+
+	driveBoundary    = "xdrive-boundary"
+	drivePageSize    = 1000
+	driveMaxAttempts = 8
+	driveMaxInflight = 32
+	driveInlineLimit = 12000
+	// driveTimeout ends a request that makes no progress for that long
+	driveTimeout = 60 * time.Second
+)
+
+var (
+	driveMaxBackoff     = 8 * time.Second
+	driveTokenURL       = "https://oauth2.googleapis.com/token"
+	driveFilesURL       = "https://www.googleapis.com/drive/v3/files"
+	driveUploadURL      = "https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart&fields=id,name"
+	driveInitialBackoff = 200 * time.Millisecond
+)
+
+type driveStorage struct {
+	folder       string
+	clientID     string
+	clientSecret string
+	refreshToken string
+	client       *http.Client
+	tokenURL     string
+	filesURL     string
+	uploadURL    string
+	backoff      time.Duration
+
+	tokenMu     sync.Mutex
+	token       string
+	tokenExpiry time.Time
+
+	inflight chan struct{}
+
+	idMu sync.Mutex
+	ids  map[string]string
+}
+
+func newDriveStorage(client *http.Client, config *Config) (*driveStorage, error) {
+	if config.RemoteFolder == "" {
+		return nil, newError(`empty "remoteFolder", it must be a Google Drive folder id`)
+	}
+	if len(config.Secrets) != 3 {
+		return nil, newError("Google Drive needs 3 secrets in order of ClientID, ClientSecret, RefreshToken")
+	}
+	for i, secret := range config.Secrets {
+		if secret == "" {
+			return nil, newError("Google Drive secret ", i, " is empty")
+		}
+	}
+
+	return &driveStorage{
+		folder:       config.RemoteFolder,
+		clientID:     config.Secrets[0],
+		clientSecret: config.Secrets[1],
+		refreshToken: config.Secrets[2],
+		client:       client,
+		tokenURL:     driveTokenURL,
+		filesURL:     driveFilesURL,
+		uploadURL:    driveUploadURL,
+		backoff:      driveInitialBackoff,
+		inflight:     make(chan struct{}, driveMaxInflight),
+		ids:          make(map[string]string),
+	}, nil
+}
+
+func flatten(name string) string {
+	return strings.ReplaceAll(name, "/", flatSeparator)
+}
+
+func quoteDriveValue(value string) string {
+	return strings.NewReplacer(`\`, `\\`, `'`, `\'`).Replace(value)
+}
+
+func (s *driveStorage) accessToken(ctx context.Context) (string, error) {
+	s.tokenMu.Lock()
+	defer s.tokenMu.Unlock()
+
+	if s.token != "" && time.Now().Before(s.tokenExpiry) {
+		return s.token, nil
+	}
+
+	form := url.Values{
+		"client_id":     {s.clientID},
+		"client_secret": {s.clientSecret},
+		"refresh_token": {s.refreshToken},
+		"grant_type":    {"refresh_token"},
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, s.tokenURL, strings.NewReader(form.Encode()))
+	if err != nil {
+		return "", newError("failed to build the token request").Base(err)
+	}
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+
+	resp, err := s.client.Do(req)
+	if err != nil {
+		return "", newError("failed to refresh the access token").Base(err)
+	}
+	defer resp.Body.Close()
+
+	body, err := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
+	if err != nil {
+		return "", newError("failed to read the token response").Base(err)
+	}
+	if resp.StatusCode != http.StatusOK {
+		return "", newError("the token endpoint answered ", resp.StatusCode, ": ", string(body))
+	}
+
+	var parsed struct {
+		AccessToken string `json:"access_token"`
+		ExpiresIn   int64  `json:"expires_in"`
+	}
+	if err := json.Unmarshal(body, &parsed); err != nil {
+		return "", newError("failed to parse the token response").Base(err)
+	}
+	if parsed.AccessToken == "" {
+		return "", newError("the token endpoint returned no access token")
+	}
+
+	lifetime := parsed.ExpiresIn
+	if lifetime > 60 {
+		lifetime -= 60
+	}
+	s.token = parsed.AccessToken
+	s.tokenExpiry = time.Now().Add(time.Duration(lifetime) * time.Second)
+	return s.token, nil
+}
+
+func jitter(backoff time.Duration) time.Duration {
+	half := backoff / 2
+	if half <= 0 {
+		return backoff
+	}
+	return half + time.Duration(rand.Int64N(int64(half)))
+}
+
+func rateLimited(payload []byte) bool {
+	var parsed struct {
+		Error struct {
+			Status string `json:"status"`
+			Errors []struct {
+				Reason string `json:"reason"`
+			} `json:"errors"`
+		} `json:"error"`
+	}
+	if json.Unmarshal(payload, &parsed) != nil {
+		return false
+	}
+	for _, item := range parsed.Error.Errors {
+		switch item.Reason {
+		case "rateLimitExceeded", "userRateLimitExceeded", "sharingRateLimitExceeded":
+			return true
+		}
+	}
+	return parsed.Error.Status == "RESOURCE_EXHAUSTED"
+}
+
+func retryableStatus(status int) bool {
+	switch status {
+	case http.StatusTooManyRequests, http.StatusInternalServerError,
+		http.StatusBadGateway, http.StatusServiceUnavailable, http.StatusGatewayTimeout:
+		return true
+	}
+	return false
+}
+
+func (s *driveStorage) do(ctx context.Context, method, target, contentType string, body []byte) (int, []byte, error) {
+	backoff := s.backoff
+	var lastErr error
+
+	for attempt := 0; attempt < driveMaxAttempts; attempt++ {
+		if attempt > 0 {
+			select {
+			case <-ctx.Done():
+				return 0, nil, ctx.Err()
+			case <-time.After(jitter(backoff)):
+			}
+			backoff *= 2
+			if backoff > driveMaxBackoff {
+				backoff = driveMaxBackoff
+			}
+		}
+
+		token, err := s.accessToken(ctx)
+		if err != nil {
+			lastErr = err
+			continue
+		}
+
+		select {
+		case s.inflight <- struct{}{}:
+		case <-ctx.Done():
+			return 0, nil, ctx.Err()
+		}
+
+		var reader io.Reader
+		if body != nil {
+			reader = bytes.NewReader(body)
+		}
+		req, err := http.NewRequestWithContext(ctx, method, target, reader)
+		if err != nil {
+			<-s.inflight
+			return 0, nil, newError("failed to build a Drive request").Base(err)
+		}
+		req.Header.Set("Authorization", "Bearer "+token)
+		if contentType != "" {
+			req.Header.Set("Content-Type", contentType)
+		}
+
+		resp, err := s.client.Do(req)
+		if err != nil {
+			<-s.inflight
+			if ctx.Err() != nil {
+				return 0, nil, ctx.Err()
+			}
+			lastErr = newError("Drive request failed").Base(err)
+			continue
+		}
+		payload, err := readResponse(resp.Body)
+		resp.Body.Close()
+		<-s.inflight
+		if err != nil {
+			if ctx.Err() != nil {
+				return 0, nil, ctx.Err()
+			}
+			lastErr = newError("failed to read the Drive response").Base(err)
+			continue
+		}
+
+		if resp.StatusCode == http.StatusUnauthorized {
+			s.invalidateToken()
+			lastErr = newError("Drive rejected the access token")
+			continue
+		}
+		if resp.StatusCode == http.StatusForbidden && rateLimited(payload) {
+			lastErr = newError("Drive is rate limiting: ", string(payload))
+			continue
+		}
+		if retryableStatus(resp.StatusCode) {
+			lastErr = newError("Drive answered ", resp.StatusCode, ": ", string(payload))
+			continue
+		}
+		return resp.StatusCode, payload, nil
+	}
+
+	return 0, nil, lastErr
+}
+
+func (s *driveStorage) invalidateToken() {
+	s.tokenMu.Lock()
+	s.token = ""
+	s.tokenMu.Unlock()
+}
+
+func (s *driveStorage) rememberID(name, id string) {
+	s.idMu.Lock()
+	s.ids[name] = id
+	s.idMu.Unlock()
+}
+
+func (s *driveStorage) forgetID(name string) {
+	s.idMu.Lock()
+	delete(s.ids, name)
+	s.idMu.Unlock()
+}
+
+func (s *driveStorage) cachedID(name string) (string, bool) {
+	s.idMu.Lock()
+	defer s.idMu.Unlock()
+	id, ok := s.ids[name]
+	return id, ok
+}
+
+type driveFile struct {
+	id          string
+	description string
+}
+
+func (s *driveStorage) query(ctx context.Context, condition string) (map[string]driveFile, error) {
+	found := make(map[string]driveFile)
+	pageToken := ""
+
+	for {
+		params := url.Values{
+			"q":                         {"'" + quoteDriveValue(s.folder) + "' in parents and trashed = false and " + condition},
+			"fields":                    {"nextPageToken,files(id,name,description)"},
+			"pageSize":                  {fmt.Sprint(drivePageSize)},
+			"supportsAllDrives":         {"true"},
+			"includeItemsFromAllDrives": {"true"},
+		}
+		if pageToken != "" {
+			params.Set("pageToken", pageToken)
+		}
+
+		status, payload, err := s.do(ctx, http.MethodGet, s.filesURL+"?"+params.Encode(), "", nil)
+		if err != nil {
+			return nil, err
+		}
+		if status != http.StatusOK {
+			return nil, newError("Drive listing answered ", status, ": ", string(payload))
+		}
+
+		var parsed struct {
+			NextPageToken string `json:"nextPageToken"`
+			Files         []struct {
+				ID          string `json:"id"`
+				Name        string `json:"name"`
+				Description string `json:"description"`
+			} `json:"files"`
+		}
+		if err := json.Unmarshal(payload, &parsed); err != nil {
+			return nil, newError("failed to parse the Drive listing").Base(err)
+		}
+
+		for _, file := range parsed.Files {
+			found[file.Name] = driveFile{id: file.ID, description: file.Description}
+			s.rememberID(file.Name, file.ID)
+		}
+
+		pageToken = parsed.NextPageToken
+		if pageToken == "" {
+			return found, nil
+		}
+	}
+}
+
+func (s *driveStorage) resolveID(ctx context.Context, flat string) (string, error) {
+	if id, ok := s.cachedID(flat); ok {
+		return id, nil
+	}
+	found, err := s.query(ctx, "name = '"+quoteDriveValue(flat)+"'")
+	if err != nil {
+		return "", err
+	}
+	if file, ok := found[flat]; ok {
+		return file.id, nil
+	}
+	return "", errNotFound
+}
+
+func (s *driveStorage) Put(ctx context.Context, name string, data []byte) error {
+	if len(data) <= driveInlineLimit {
+		return s.putInline(ctx, name, data)
+	}
+	return s.putMedia(ctx, name, data)
+}
+
+func (s *driveStorage) putInline(ctx context.Context, name string, data []byte) error {
+	flat := flatten(name)
+
+	body, err := json.Marshal(map[string]interface{}{
+		"name":        flat,
+		"parents":     []string{s.folder},
+		"description": base64.StdEncoding.EncodeToString(data),
+	})
+	if err != nil {
+		return newError("failed to build the inline metadata").Base(err)
+	}
+
+	status, payload, err := s.do(ctx, http.MethodPost, s.filesURL+"?fields=id",
+		"application/json; charset=UTF-8", body)
+	if err != nil {
+		return err
+	}
+	if status != http.StatusOK {
+		return newError("Drive rejected the inline upload of ", name,
+			" with ", status, ": ", string(payload))
+	}
+
+	var parsed struct {
+		ID string `json:"id"`
+	}
+	if err := json.Unmarshal(payload, &parsed); err != nil {
+		return newError("failed to parse the Drive upload response").Base(err)
+	}
+	if parsed.ID != "" {
+		s.rememberID(flat, parsed.ID)
+	}
+	return nil
+}
+
+func (s *driveStorage) putMedia(ctx context.Context, name string, data []byte) error {
+	flat := flatten(name)
+
+	metadata, err := json.Marshal(map[string]interface{}{
+		"name":    flat,
+		"parents": []string{s.folder},
+	})
+	if err != nil {
+		return newError("failed to build the upload metadata").Base(err)
+	}
+
+	var body bytes.Buffer
+	fmt.Fprintf(&body, "--%s\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n", driveBoundary)
+	body.Write(metadata)
+	fmt.Fprintf(&body, "\r\n--%s\r\nContent-Type: application/octet-stream\r\n\r\n", driveBoundary)
+	body.Write(data)
+	fmt.Fprintf(&body, "\r\n--%s--\r\n", driveBoundary)
+
+	status, payload, err := s.do(ctx, http.MethodPost, s.uploadURL,
+		"multipart/related; boundary="+driveBoundary, body.Bytes())
+	if err != nil {
+		return err
+	}
+	if status != http.StatusOK {
+		return newError("Drive upload of ", name, " answered ", status, ": ", string(payload))
+	}
+
+	var parsed struct {
+		ID string `json:"id"`
+	}
+	if err := json.Unmarshal(payload, &parsed); err != nil {
+		return newError("failed to parse the Drive upload response").Base(err)
+	}
+	if parsed.ID != "" {
+		s.rememberID(flat, parsed.ID)
+	}
+	return nil
+}
+
+func (s *driveStorage) Get(ctx context.Context, name string) ([]byte, error) {
+	flat := flatten(name)
+	id, err := s.resolveID(ctx, flat)
+	if err != nil {
+		return nil, err
+	}
+
+	status, payload, err := s.do(ctx, http.MethodGet,
+		s.filesURL+"/"+url.PathEscape(id)+"?alt=media&supportsAllDrives=true", "", nil)
+	if err != nil {
+		return nil, err
+	}
+	switch status {
+	case http.StatusOK:
+		if len(payload) > 0 {
+			return payload, nil
+		}
+		return s.getInline(ctx, id)
+	case http.StatusNotFound:
+		s.forgetID(flat)
+		return nil, errNotFound
+	default:
+		return nil, newError("Drive download of ", name, " answered ", status, ": ", string(payload))
+	}
+}
+
+func (s *driveStorage) getInline(ctx context.Context, id string) ([]byte, error) {
+	status, payload, err := s.do(ctx, http.MethodGet,
+		s.filesURL+"/"+url.PathEscape(id)+"?fields=description&supportsAllDrives=true", "", nil)
+	if err != nil {
+		return nil, err
+	}
+	if status != http.StatusOK {
+		return nil, newError("Drive answered ", status, " for inline data: ", string(payload))
+	}
+
+	var parsed struct {
+		Description string `json:"description"`
+	}
+	if err := json.Unmarshal(payload, &parsed); err != nil {
+		return nil, newError("failed to parse the inline data").Base(err)
+	}
+	if parsed.Description == "" {
+		return nil, nil
+	}
+	data, err := base64.StdEncoding.DecodeString(parsed.Description)
+	if err != nil {
+		return nil, newError("the inline data is not valid base64").Base(err)
+	}
+	return data, nil
+}
+
+func (s *driveStorage) deleteID(ctx context.Context, flat, id string) error {
+	status, payload, err := s.do(ctx, http.MethodDelete,
+		s.filesURL+"/"+url.PathEscape(id)+"?supportsAllDrives=true", "", nil)
+	if err != nil {
+		return err
+	}
+	s.forgetID(flat)
+	switch status {
+	case http.StatusOK, http.StatusNoContent, http.StatusNotFound:
+		return nil
+	default:
+		return newError("Drive deletion of ", flat, " answered ", status, ": ", string(payload))
+	}
+}
+
+func (s *driveStorage) Delete(ctx context.Context, name string) error {
+	flat := flatten(name)
+
+	if id, err := s.resolveID(ctx, flat); err == nil {
+		if err := s.deleteID(ctx, flat, id); err != nil {
+			return err
+		}
+	} else if err != errNotFound {
+		return err
+	}
+
+	children, err := s.query(ctx, "name contains '"+quoteDriveValue(flat+flatSeparator)+"'")
+	if err != nil {
+		return err
+	}
+	for childName, file := range children {
+		if err := s.deleteID(ctx, childName, file.id); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (s *driveStorage) List(ctx context.Context, prefix string) ([]Entry, error) {
+	flat := flatten(prefix) + flatSeparator
+
+	found, err := s.query(ctx, "name contains '"+quoteDriveValue(flat)+"'")
+	if err != nil {
+		return nil, err
+	}
+
+	seen := make(map[string]bool, len(found))
+	entries := make([]Entry, 0, len(found))
+	for name, file := range found {
+		rest := strings.TrimPrefix(name, flat)
+		if rest == "" {
+			continue
+		}
+		direct := true
+		if cut := strings.Index(rest, flatSeparator); cut >= 0 {
+			rest = rest[:cut]
+			direct = false
+		}
+		if seen[rest] {
+			continue
+		}
+		seen[rest] = true
+
+		entry := Entry{Name: rest}
+		if direct && file.description != "" {
+			if data, err := base64.StdEncoding.DecodeString(file.description); err == nil {
+				entry.Inline = data
+			}
+		}
+		entries = append(entries, entry)
+	}
+	return entries, nil
+}
+
+func (s *driveStorage) Close() error {
+	return nil
+}
