diff --git a/transport/xdrive/jsonpath.go b/transport/xdrive/jsonpath.go
new file mode 100644
index 00000000..4206ed88
--- /dev/null
+++ b/transport/xdrive/jsonpath.go
@@ -0,0 +1,43 @@
+// Adapted from XTLS/Xray-core transport/internet/xdrive at 92ccc939aaf4.
+// Copyright Xray-core contributors. Licensed under MPL-2.0.
+// SPDX-License-Identifier: MPL-2.0
+
+package xdrive
+
+import (
+	"encoding/json"
+	"strings"
+)
+
+func jsonWalk(payload []byte, path string) interface{} {
+	var root interface{}
+	if json.Unmarshal(payload, &root) != nil {
+		return nil
+	}
+	node := root
+	for _, key := range strings.Split(path, ".") {
+		obj, ok := node.(map[string]interface{})
+		if !ok {
+			return nil
+		}
+		node, ok = obj[key]
+		if !ok {
+			return nil
+		}
+	}
+	return node
+}
+
+func jsonString(payload []byte, path string) string {
+	if s, ok := jsonWalk(payload, path).(string); ok {
+		return s
+	}
+	return ""
+}
+
+func jsonNumber(payload []byte, path string) int64 {
+	if f, ok := jsonWalk(payload, path).(float64); ok {
+		return int64(f)
+	}
+	return 0
+}
diff --git a/transport/xdrive/lifecycle_test.go b/transport/xdrive/lifecycle_test.go
