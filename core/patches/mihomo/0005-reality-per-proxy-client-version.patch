diff --git a/component/tls/reality_client_version.go b/component/tls/reality_client_version.go
new file mode 100644
index 00000000..72c0f59b
--- /dev/null
+++ b/component/tls/reality_client_version.go
@@ -0,0 +1,22 @@
+package tls
+
+// ClashFest core patch 0004: per-proxy REALITY client version.
+//
+// Patch 0001 made the client version in the REALITY session id a process-wide
+// setting (RealityClientVersion, pushed from the app settings). A single
+// subscription can mix Xray servers with different minClientVer / maxClientVer
+// bounds, so reality-opts.client-version lets one proxy report its own
+// version. Empty keeps the global value, which is read at handshake time, so a
+// later SetRealityPolicy from the app still applies to every other proxy.
+//
+// SlothClash: the value is parsed by ParseRealityClientVersion from its patch
+// 0003 (reality_policy.go), which also takes a leading "v".
+
+// EffectiveClientVersion is the version this proxy reports: its own
+// client-version when set, otherwise the global RealityClientVersion.
+func (c *RealityConfig) EffectiveClientVersion() [3]byte {
+	if c != nil && c.ClientVersion != nil {
+		return *c.ClientVersion
+	}
+	return RealityClientVersion
+}
diff --git a/component/tls/reality_client_version_test.go b/component/tls/reality_client_version_test.go
new file mode 100644
index 00000000..9f8aa6e6
--- /dev/null
+++ b/component/tls/reality_client_version_test.go
@@ -0,0 +1,32 @@
+package tls
+
+import "testing"
+
+func TestRealityEffectiveClientVersion(t *testing.T) {
+	saved := RealityClientVersion
+	t.Cleanup(func() { RealityClientVersion = saved })
+
+	RealityClientVersion = [3]byte{25, 1, 1}
+	global := &RealityConfig{}
+	override := &RealityConfig{ClientVersion: &[3]byte{26, 9, 9}}
+
+	if got := global.EffectiveClientVersion(); got != [3]byte{25, 1, 1} {
+		t.Fatalf("no override: got %v, want the global version", got)
+	}
+	if got := override.EffectiveClientVersion(); got != [3]byte{26, 9, 9} {
+		t.Fatalf("override: got %v, want 26.9.9", got)
+	}
+
+	// The global value is read at handshake time: a later policy push from the
+	// app reaches proxies without an override and leaves overrides alone.
+	RealityClientVersion = [3]byte{24, 12, 31}
+	if got := global.EffectiveClientVersion(); got != [3]byte{24, 12, 31} {
+		t.Fatalf("global change not seen: got %v", got)
+	}
+	if got := override.EffectiveClientVersion(); got != [3]byte{26, 9, 9} {
+		t.Fatalf("global change leaked into the override: got %v", got)
+	}
+	if got := (*RealityConfig)(nil).EffectiveClientVersion(); got != [3]byte{24, 12, 31} {
+		t.Fatalf("nil config: got %v", got)
+	}
+}
