index 00000000..b4ef73b8
--- /dev/null
+++ b/component/tls/utls_xray_names_test.go
@@ -0,0 +1,76 @@
+package tls
+
+import (
+	"strings"
+	"testing"
+
+	utls "github.com/metacubex/utls"
+)
+
+func TestXrayFingerprintNames(t *testing.T) {
+	for name, want := range xrayFingerprints {
+		for _, spelled := range []string{name, strings.ToUpper(name)} {
+			got, ok := GetFingerprint(spelled)
+			if !ok {
+				t.Fatalf("GetFingerprint(%q) is not known", spelled)
+			}
+			if got.Client != want.Client || got.Version != want.Version {
+				t.Fatalf("GetFingerprint(%q) = %s/%s, want %s/%s", spelled, got.Client, got.Version, want.Client, want.Version)
+			}
+		}
+		if strings.HasPrefix(want.Client, "Randomized") {
+			got, _ := GetFingerprint(name)
+			if got.Seed == nil {
+				t.Fatalf("%s has no seed", name)
+			}
+			continue
+		}
+		// a name must map to a parrot utls can build, not to a dead id
+		if _, err := utls.UTLSIdToSpec(want); err != nil {
+			t.Fatalf("%s -> %s/%s: %v", name, want.Client, want.Version, err)
+		}
+	}
+	for _, name := range []string{"", "none", "unsafe", "HelloGolang"} {
+		if _, ok := GetFingerprint(name); ok {
+			t.Fatalf("GetFingerprint(%q) should mean no uTLS", name)
+		}
+	}
+	if got, _ := GetFingerprint("chrome"); got.Client != utls.HelloChrome_Auto.Client {
+		t.Fatalf("mihomo names changed: chrome = %s", got.Client)
+	}
+	// Stock names stay case-sensitive, as in stock mihomo: a misspelled case is
+	// an unknown name there (Go's own hello), and must stay one here.
+	for _, name := range []string{"Chrome", "FIREFOX", "Safari", "iOS", "None", "Random", "Randomized"} {
+		if got, ok := GetFingerprint(name); ok {
+			t.Fatalf("GetFingerprint(%q) = %s, want the stock unknown-name result", name, got.Client)
+		}
+	}
+}
+
+func TestXrayFingerprintCurrentBrowsers(t *testing.T) {
+	// metacubex/utls v1.9.0-alpha.1 (mihomo v1.19.34) ships these parrots; before
+	// that the names fell back to Firefox 120 and Safari 16.0.
+	for name, version := range map[string]string{"hellofirefox_148": "148", "hellosafari_26_3": "26.3"} {
+		got, ok := GetFingerprint(name)
+		if !ok || got.Version != version {
+			t.Fatalf("GetFingerprint(%q) = %s/%s, want version %s", name, got.Client, got.Version, version)
+		}
+		// the point of the real parrots: they carry the hybrid key share that
+		// Xray 26.9.8+ REALITY servers require
+		spec, err := utls.UTLSIdToSpec(got)
+		if err != nil {
+			t.Fatalf("%s: %v", name, err)
+		}
+		hybrid := false
+		for _, ext := range spec.Extensions {
+			if ks, ok := ext.(*utls.KeyShareExtension); ok {
+				for _, share := range ks.KeyShares {
+					hybrid = hybrid || share.Group == utls.X25519MLKEM768
+				}
+			}
+		}
+		if !hybrid {
+			t.Fatalf("%s has no X25519MLKEM768 key share", name)
+		}
+	}
+}
