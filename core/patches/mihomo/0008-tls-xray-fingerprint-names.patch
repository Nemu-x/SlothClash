+++ b/component/tls/utls_xray_names_test.go
@@ -0,0 +1,41 @@
+package tls
+
+import (
+	"strings"
+	"testing"
+
+	utls "github.com/metacubex/utls"
+)
+
+func TestXrayFingerprintNames(t *testing.T) {
+	for name, want := range xrayFingerprints {
+		for _, spelled := range []string{name, strings.ToUpper(name)} {
+			got, ok := GetFingerprint(spelled)
+			if !ok {
+				t.Fatalf("GetFingerprint(%q) is not known", spelled)
+			}
+			if got.Client != want.Client || got.Version != want.Version {
+				t.Fatalf("GetFingerprint(%q) = %s/%s, want %s/%s", spelled, got.Client, got.Version, want.Client, want.Version)
+			}
+		}
+		if strings.HasPrefix(want.Client, "Randomized") {
+			got, _ := GetFingerprint(name)
+			if got.Seed == nil {
+				t.Fatalf("%s has no seed", name)
+			}
+			continue
+		}
+		// a name must map to a parrot utls can build, not to a dead id
+		if _, err := utls.UTLSIdToSpec(want); err != nil {
+			t.Fatalf("%s -> %s/%s: %v", name, want.Client, want.Version, err)
+		}
+	}
+	for _, name := range []string{"", "none", "unsafe", "HelloGolang"} {
+		if _, ok := GetFingerprint(name); ok {
+			t.Fatalf("GetFingerprint(%q) should mean no uTLS", name)
+		}
+	}
+	if got, _ := GetFingerprint("Chrome"); got.Client != utls.HelloChrome_Auto.Client {
+		t.Fatalf("mihomo names changed: chrome = %s", got.Client)
+	}
+}
