 func GetFingerprint(clientFingerprint string) (UClientHelloID, bool) {
+	// Stock names match exactly, as in stock mihomo ("Chrome" stays an unknown
+	// name). Only the Xray-only names are case-insensitive, as Xray reads them.
+	if _, exact := fingerprints[clientFingerprint]; !exact {
+		lower := strings.ToLower(clientFingerprint)
+		if xrayNoUTLS[lower] {
+			return UClientHelloID{}, false
+		}
+		if _, ok := xrayFingerprints[lower]; ok {
+			clientFingerprint = lower
+		}
+	}
 	if len(clientFingerprint) == 0 || clientFingerprint == "none" {
 		return UClientHelloID{}, false
 	}
