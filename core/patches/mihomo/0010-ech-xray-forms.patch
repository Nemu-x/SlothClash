@@ -0,0 +1,161 @@
+package outbound_test
+
+import (
+	"context"
+	"encoding/base64"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/adapter/outbound"
+	_ "github.com/metacubex/mihomo/config" // dns.ParseNameServer
+
+	"github.com/metacubex/tls"
+	D "github.com/miekg/dns"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// an ECHConfigList generated by xray tls ech --serverName example.com
+const testECHConfigList = "AF7+DQBaAAAgACA65DptL5QEMH3c0QQqVBp0rQ5vVr7KIgOP9k4iEldMOgAkAAEAAQABAAIAAQADAAIAAQACAAIAAgADAAMAAQADAAIAAwADAAtleGFtcGxlLmNvbQAA"
+
+// fakeECHAnswer answers HTTPS queries for echDomain with an ech SvcParam.
+func fakeECHAnswer(t *testing.T, echDomain string, queries *atomic.Int32, req *D.Msg) *D.Msg {
+	list, err := base64.StdEncoding.DecodeString(testECHConfigList)
+	require.NoError(t, err)
+	resp := new(D.Msg)
+	resp.SetReply(req)
+	if len(req.Question) == 1 && req.Question[0].Qtype == D.TypeHTTPS {
+		queries.Add(1)
+		if req.Question[0].Name == D.Fqdn(echDomain) {
+			rr := &D.HTTPS{SVCB: D.SVCB{
+				Hdr:      D.RR_Header{Name: D.Fqdn(echDomain), Rrtype: D.TypeHTTPS, Class: D.ClassINET, Ttl: 300},
+				Priority: 1,
+				Target:   ".",
+				Value:    []D.SVCBKeyValue{&D.SVCBECHConfig{ECH: list}},
+			}}
+			resp.Answer = append(resp.Answer, rr)
+		}
+	}
+	return resp
+}
+
+func newFakeDoH(t *testing.T, echDomain string, queries *atomic.Int32) *httptest.Server {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var raw []byte
+		var err error
+		if r.Method == http.MethodGet {
+			raw, err = base64.RawURLEncoding.DecodeString(r.URL.Query().Get("dns"))
+		} else {
+			raw, err = io.ReadAll(r.Body)
+		}
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+		req := new(D.Msg)
+		if err = req.Unpack(raw); err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+		out, err := fakeECHAnswer(t, echDomain, queries, req).Pack()
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusInternalServerError)
+			return
+		}
+		w.Header().Set("Content-Type", "application/dns-message")
+		_, _ = w.Write(out)
+	}))
+	t.Cleanup(srv.Close)
+	return srv
+}
+
+func newFakeUDPDNS(t *testing.T, echDomain string, queries *atomic.Int32) string {
+	pc, err := net.ListenPacket("udp", "127.0.0.1:0")
+	require.NoError(t, err)
+	srv := &D.Server{PacketConn: pc, Handler: D.HandlerFunc(func(w D.ResponseWriter, req *D.Msg) {
+		_ = w.WriteMsg(fakeECHAnswer(t, echDomain, queries, req))
+	})}
+	go func() { _ = srv.ActivateAndServe() }()
+	t.Cleanup(func() { _ = srv.Shutdown() })
+	return pc.LocalAddr().String()
+}
+
+func TestECHOptionsQueryServer(t *testing.T) {
+	want, err := base64.StdEncoding.DecodeString(testECHConfigList)
+	require.NoError(t, err)
+
+	var dohQueries, udpQueries atomic.Int32
+	doh := newFakeDoH(t, "ech.example.com", &dohQueries)
+	udpAddr := newFakeUDPDNS(t, "ech.example.com", &udpQueries)
+
+	for _, tt := range []struct {
+		name    string
+		opts    outbound.ECHOptions
+		sni     string
+		queries *atomic.Int32
+	}{
+		{"doh server name", outbound.ECHOptions{Enable: true, QueryServer: doh.URL + "/dns-query"}, "ech.example.com", &dohQueries},
+		{"doh query-server-name", outbound.ECHOptions{Enable: true, QueryServer: doh.URL + "/dns-query", QueryServerName: "ech.example.com"}, "front.example.net", &dohQueries},
+		{"udp query-server-name", outbound.ECHOptions{Enable: true, QueryServer: "udp://" + udpAddr, QueryServerName: "ech.example.com"}, "front.example.net", &udpQueries},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			echConfig, err := tt.opts.Parse()
+			require.NoError(t, err)
+			require.NotNil(t, echConfig)
+			before := tt.queries.Load()
+			for i := 0; i < 2; i++ { // the second build is served from the per-proxy cache
+				ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+				tlsConfig := &tls.Config{ServerName: tt.sni, MinVersion: tls.VersionTLS12}
+				require.NoError(t, echConfig.ClientHandle(ctx, tlsConfig))
+				cancel()
+				assert.Equal(t, want, tlsConfig.EncryptedClientHelloConfigList)
+				assert.Equal(t, uint16(tls.VersionTLS13), tlsConfig.MinVersion)
+			}
+			assert.Equal(t, int32(1), tt.queries.Load()-before)
+		})
+	}
+
+	t.Run("no record", func(t *testing.T) {
+		echConfig, err := outbound.ECHOptions{Enable: true, QueryServer: doh.URL + "/dns-query"}.Parse()
+		require.NoError(t, err)
+		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		defer cancel()
+		assert.Error(t, echConfig.ClientHandle(ctx, &tls.Config{ServerName: "other.example.com"}))
+	})
+}
+
+func TestECHOptionsParse(t *testing.T) {
+	want, err := base64.StdEncoding.DecodeString(testECHConfigList)
+	require.NoError(t, err)
+	pemConfigs := "-----BEGIN ECH CONFIGS-----\n" + testECHConfigList + "\n-----END ECH CONFIGS-----\n"
+
+	for _, config := range []string{testECHConfigList, pemConfigs} {
+		echConfig, err := outbound.ECHOptions{Enable: true, Config: config}.Parse()
+		require.NoError(t, err)
+		list, err := echConfig.GetEncryptedClientHelloConfigList(context.Background(), "example.com")
+		require.NoError(t, err)
+		assert.Equal(t, want, list)
+	}
+
+	for _, opts := range []outbound.ECHOptions{
+		{Enable: true, Config: "not base64!"},
+		{Enable: true, Config: "-----BEGIN ECH KEYS-----\nAAAA\n-----END ECH KEYS-----\n"},
+		{Enable: true, QueryServer: "foo://1.1.1.1"},
+	} {
+		_, err := opts.Parse()
+		assert.Error(t, err, opts)
+	}
+
+	echConfig, err := outbound.ECHOptions{Enable: false, QueryServer: "foo://1.1.1.1"}.Parse()
+	assert.NoError(t, err)
+	assert.Nil(t, echConfig)
+
+	// h2c:// is taken as https://, as Xray's routing would add TLS to it
+	_, err = outbound.ECHOptions{Enable: true, QueryServer: "h2c://dns.google/dns-query"}.Parse()
+	assert.NoError(t, err)
+}
