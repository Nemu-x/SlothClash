diff --git a/tunnel/tcp_connect_timeout.go b/tunnel/tcp_connect_timeout.go
new file mode 100644
index 00000000..305c18ec
--- /dev/null
+++ b/tunnel/tcp_connect_timeout.go
@@ -0,0 +1,54 @@
+package tunnel
+
+// ClashFest core patch 0012: tcp-connect-timeout, the total budget in
+// milliseconds for a new tunnel TCP connection (proxy handshake and retries
+// included), instead of the constant 5 s of C.DefaultTCPTimeout. Slow chains
+// and lossy mobile links need more. From Citrus PR #29 (commits up to
+// 0906f57e); the controller PATCH of the same PR is left out.
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"github.com/metacubex/mihomo/common/atomic"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+const (
+	// MinTCPConnectTimeout is the smallest accepted value in milliseconds. A lower
+	// one cannot fit a proxy handshake and most likely was written in seconds.
+	MinTCPConnectTimeout int64 = 100
+	// MaxTCPConnectTimeout is the largest accepted value (10 minutes).
+	MaxTCPConnectTimeout int64 = 10 * 60 * 1000
+	// DefaultTCPConnectTimeout keeps mihomo's behaviour.
+	DefaultTCPConnectTimeout = int64(C.DefaultTCPTimeout / time.Millisecond)
+)
+
+var tcpConnectTimeout = atomic.NewTypedValue(C.DefaultTCPTimeout)
+
+// ValidateTCPConnectTimeout validates a connection budget in milliseconds.
+func ValidateTCPConnectTimeout(milliseconds int64) error {
+	if milliseconds < MinTCPConnectTimeout || milliseconds > MaxTCPConnectTimeout {
+		return fmt.Errorf("tcp-connect-timeout must be between %d and %d milliseconds, got %d",
+			MinTCPConnectTimeout, MaxTCPConnectTimeout, milliseconds)
+	}
+	return nil
+}
+
+// SetTCPConnectTimeout changes the budget for new tunnel TCP connections.
+func SetTCPConnectTimeout(milliseconds int64) error {
+	if err := ValidateTCPConnectTimeout(milliseconds); err != nil {
+		return err
+	}
+	tcpConnectTimeout.Store(time.Duration(milliseconds) * time.Millisecond)
+	return nil
+}
+
+func TCPConnectTimeout() time.Duration {
+	return tcpConnectTimeout.Load()
+}
+
+func tcpConnectContext(parent context.Context) (context.Context, context.CancelFunc) {
+	return context.WithTimeout(parent, TCPConnectTimeout())
+}
diff --git a/tunnel/tcp_connect_timeout_test.go b/tunnel/tcp_connect_timeout_test.go
new file mode 100644
index 00000000..b1142aa4
--- /dev/null
+++ b/tunnel/tcp_connect_timeout_test.go
@@ -0,0 +1,31 @@
+package tunnel
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestTCPConnectTimeout(t *testing.T) {
+	defer func() { _ = SetTCPConnectTimeout(DefaultTCPConnectTimeout) }()
+	if DefaultTCPConnectTimeout != 5000 {
+		t.Fatalf("default = %d ms, mihomo's is 5000", DefaultTCPConnectTimeout)
+	}
+	for _, bad := range []int64{0, 99, MaxTCPConnectTimeout + 1, -1} {
+		if err := SetTCPConnectTimeout(bad); err == nil {
+			t.Fatalf("accepted %d", bad)
+		}
+	}
+	if TCPConnectTimeout() != 5*time.Second {
+		t.Fatalf("a rejected value changed the timeout to %v", TCPConnectTimeout())
+	}
+	if err := SetTCPConnectTimeout(15000); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := tcpConnectContext(context.Background())
+	defer cancel()
+	deadline, ok := ctx.Deadline()
+	if left := time.Until(deadline); !ok || left < 14*time.Second || left > 15*time.Second {
+		t.Fatalf("deadline in %v, want about 15s", left)
+	}
+}
