diff --git a/dns/serve_expired_test.go b/dns/serve_expired_test.go
new file mode 100644
index 00000000..783374b9
--- /dev/null
+++ b/dns/serve_expired_test.go
@@ -0,0 +1,117 @@
+package dns
+
+import (
+	"context"
+	"errors"
+	"net/netip"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	D "github.com/miekg/dns"
+)
+
+// ClashFest core patch 0014: dns.serve-expired.
+
+var (
+	staleIP = netip.MustParseAddr("192.0.2.1")
+	freshIP = netip.MustParseAddr("192.0.2.2")
+)
+
+type expiredUpstream struct {
+	delay time.Duration
+	fail  bool
+	calls atomic.Int32
+}
+
+func (f *expiredUpstream) ExchangeContext(ctx context.Context, m *D.Msg) (*D.Msg, error) {
+	f.calls.Add(1)
+	select {
+	case <-time.After(f.delay):
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	}
+	if f.fail {
+		return nil, errors.New("upstream down")
+	}
+	return expiredAnswer(m, freshIP), nil
+}
+
+func (f *expiredUpstream) Address() string  { return "fake" }
+func (f *expiredUpstream) ResetConnection() {}
+
+func expiredAnswer(query *D.Msg, ip netip.Addr) *D.Msg {
+	msg := new(D.Msg)
+	msg.SetReply(query)
+	msg.Answer = []D.RR{&D.A{
+		Hdr: D.RR_Header{Name: query.Question[0].Name, Rrtype: D.TypeA, Class: D.ClassINET, Ttl: 60},
+		A:   ip.AsSlice(),
+	}}
+	return msg
+}
+
+func TestServeExpired(t *testing.T) {
+	query := new(D.Msg)
+	query.SetQuestion("stale.example.", D.TypeA)
+
+	for _, tt := range []struct {
+		name          string
+		config        Config
+		delay         time.Duration // of the upstream answer
+		fail          bool          // the upstream fails
+		expiredFor    time.Duration
+		want          netip.Addr
+		wantUpstream  bool // queried before the answer
+		wantStaleTTL1 bool
+	}{
+		{name: "default answers stale at once", want: staleIP, wantStaleTTL1: true},
+		{name: "disabled resolves again", config: Config{DisableServeExpired: true}, want: freshIP, wantUpstream: true},
+		{name: "past serve-expired-ttl resolves again", config: Config{ServeExpiredTTL: time.Minute}, expiredFor: 2 * time.Minute, want: freshIP, wantUpstream: true},
+		{name: "within serve-expired-ttl answers stale", config: Config{ServeExpiredTTL: time.Hour}, expiredFor: 2 * time.Minute, want: staleIP, wantStaleTTL1: true},
+		{name: "client timeout gets the fresh answer", config: Config{ServeExpiredClientTimeout: time.Second}, want: freshIP, wantUpstream: true},
+		{name: "client timeout answers stale when upstream is slow", config: Config{ServeExpiredClientTimeout: 50 * time.Millisecond},
+			delay: time.Second, want: staleIP, wantStaleTTL1: true},
+		{name: "client timeout answers stale when upstream fails", config: Config{ServeExpiredClientTimeout: time.Second},
+			fail: true, want: staleIP, wantStaleTTL1: true},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			up := &expiredUpstream{delay: tt.delay, fail: tt.fail}
+			r := NewResolverFromClient(up)
+			r.cache = tt.config.newCache()
+			r.noServeExpired = tt.config.DisableServeExpired
+			r.serveExpiredTTL = tt.config.ServeExpiredTTL
+			r.serveExpiredClientTimeout = tt.config.ServeExpiredClientTimeout
+			expiredFor := tt.expiredFor
+			if expiredFor == 0 {
+				expiredFor = time.Second
+			}
+			r.cache.SetWithExpire(query.Question[0].String(), expiredAnswer(query, staleIP), time.Now().Add(-expiredFor))
+
+			msg, err := r.ExchangeContext(context.Background(), query)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if ips := msgToIP(msg); len(ips) != 1 || ips[0] != tt.want {
+				t.Fatalf("answer %v, want %s", ips, tt.want)
+			}
+			if tt.wantStaleTTL1 && msg.Answer[0].Header().Ttl != 1 {
+				t.Fatalf("stale answer with TTL %d, want 1", msg.Answer[0].Header().Ttl)
+			}
+			if tt.wantUpstream && up.calls.Load() == 0 {
+				t.Fatal("upstream was not queried before the answer")
+			}
+		})
+	}
+}
+
+func TestNewResolverServeExpired(t *testing.T) {
+	rs := NewResolver(Config{DisableServeExpired: true, ServeExpiredTTL: time.Minute, ServeExpiredClientTimeout: time.Second})
+	for _, r := range []*Resolver{rs.Resolver, rs.Resolver.defaultResolver} {
+		if !r.noServeExpired || r.serveExpiredTTL != time.Minute || r.serveExpiredClientTimeout != time.Second {
+			t.Fatalf("serve-expired settings not applied: %v %v %v", r.noServeExpired, r.serveExpiredTTL, r.serveExpiredClientTimeout)
+		}
+	}
+	if r := NewResolver(Config{}).Resolver; r.noServeExpired || r.serveExpiredTTL != 0 || r.serveExpiredClientTimeout != 0 {
+		t.Fatal("a zero Config must keep mihomo's serve-stale behaviour")
+	}
+}
