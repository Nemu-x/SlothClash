+package xdrive
+
+import "testing"
+
+// SlothClash core patch 0016: local storage is a test-only backend. A shipped
+// binary is not a test binary, so the gate is off there; the app checks that
+// on the built core (xdrive_hardening_test.go in SlothClash).
+func TestLocalServiceOnlyInTestBinaries(t *testing.T) {
+	if !testing.Testing() || !AllowLocalService {
+		t.Fatalf("AllowLocalService = %v in a test binary, want true", AllowLocalService)
+	}
+}
