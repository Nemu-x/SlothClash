diff --git a/transport/xdrive/template_gate_test.go b/transport/xdrive/template_gate_test.go
new file mode 100644
index 00000000..0caf01f9
--- /dev/null
+++ b/transport/xdrive/template_gate_test.go
@@ -0,0 +1,63 @@
+package xdrive
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+)
+
+// SlothClash core patch 0016: with AllowTemplateService off, a template node
+// still loads but sends no request at all and fails every dial and listen with
+// ErrTemplateServiceDisabled.
+func TestTemplateServiceGate(t *testing.T) {
+	saved := AllowTemplateService
+	t.Cleanup(func() { AllowTemplateService = saved })
+
+	var hits atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hits.Add(1)
+		w.WriteHeader(http.StatusNotFound)
+	}))
+	t.Cleanup(srv.Close)
+
+	cfg := Config{Service: "template", RemoteFolder: "f", Template: map[string]any{
+		"put":    map[string]any{"method": "PUT", "url": srv.URL + "/{folder}/{name}"},
+		"get":    map[string]any{"method": "GET", "url": srv.URL + "/{folder}/{name}"},
+		"delete": map[string]any{"method": "DELETE", "url": srv.URL + "/{folder}/{name}"},
+		"list":   map[string]any{"method": "GET", "url": srv.URL + "/{folder}/", "namesRegex": `"([^"]+)"`},
+	}}
+
+	AllowTemplateService = true
+	if _, err := newStorage(cfg, nil); err != nil {
+		t.Fatalf("template storage allowed: %v", err)
+	}
+
+	AllowTemplateService = false
+	if err := cfg.Validate(); err != nil {
+		t.Fatalf("a refused template node must still validate: %v", err)
+	}
+	client, err := NewClient(cfg, nil)
+	if err != nil {
+		t.Fatalf("client for a refused template node: %v", err)
+	}
+	if _, err := client.Dial(context.Background()); !errors.Is(err, ErrTemplateServiceDisabled) {
+		t.Fatalf("dial through a refused template node: got %v", err)
+	}
+	if err := client.Close(); err != nil {
+		t.Fatalf("close: %v", err)
+	}
+	if _, err := Listen(cfg, nil); !errors.Is(err, ErrTemplateServiceDisabled) {
+		t.Fatalf("listen on a refused template node: got %v", err)
+	}
+	if n := hits.Load(); n != 0 {
+		t.Fatalf("a refused template node sent %d requests", n)
+	}
+
+	cloud := Config{Service: "google-drive", RemoteFolder: "id", Secrets: []string{"a", "b", "c"}}
+	if err := cloud.Validate(); err != nil {
+		t.Fatalf("google-drive must not be affected: %v", err)
+	}
+}
