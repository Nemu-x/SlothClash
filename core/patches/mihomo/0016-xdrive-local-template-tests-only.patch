--- /dev/null
+++ b/transport/xdrive/local_gate_test.go
@@ -0,0 +1,16 @@
+package xdrive
+
+import "testing"
+
+// SlothClash core patch 0016: local and template storage are test-only
+// backends. A shipped binary is not a test binary, so the gates are off there;
+// the app checks that on the built core (xdrive_hardening_test.go in
+// SlothClash).
+func TestLocalServiceOnlyInTestBinaries(t *testing.T) {
+	if !testing.Testing() || !AllowLocalService {
+		t.Fatalf("AllowLocalService = %v in a test binary, want true", AllowLocalService)
+	}
+	if !AllowTemplateService {
+		t.Fatalf("AllowTemplateService = %v in a test binary, want true", AllowTemplateService)
+	}
+}
