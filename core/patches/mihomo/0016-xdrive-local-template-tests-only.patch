index ba53fca2..dd33c00e 100644
--- a/transport/xdrive/config.go
+++ b/transport/xdrive/config.go
@@ -5,9 +5,9 @@ import (
 	"errors"
 	"fmt"
 	"net"
-	"runtime"
 	"strconv"
 	"strings"
+	"testing"
 )
 
 type Config struct {
@@ -32,13 +32,72 @@ type Config struct {
 // storage that refuses every operation: it never touches the filesystem and
 // every dial through it fails. This covers http and file proxy-providers too
 // (the app's YAML hardening only sees config.yaml and inline payloads).
-var AllowLocalService = runtime.GOOS != "android"
+//
+// SlothClash core patch 0016: off in every shipped binary, not only on
+// Android. The desktop core can run under the privileged helper service
+// (SYSTEM / root), where a folder named by a subscription would be a
+// privileged file read/write. Test binaries keep it on for the series' own
+// tests of the transport.
+var AllowLocalService = testing.Testing()
 
 // ErrLocalServiceDisabled is returned by every operation of a `service: local`
 // storage while AllowLocalService is off.
 var ErrLocalServiceDisabled = errors.New("xdrive service local (a folder on the device) is disabled in this build")
 
+// AllowTemplateService gates `service: template`. SlothClash core patch 0016:
+// a template lets the config pick the method, URL, headers and body of every
+// storage request, sent from this machine (loopback and LAN included) as soon
+// as a health check dials the node. Off in every shipped binary, wherever the
+// node comes from (config.yaml, http, file or inline proxy-providers); test
+// binaries keep it on for the transport's own tests. A refused template node
+// loads like a refused local one but never sends a request.
+var AllowTemplateService = testing.Testing()
+
+// ErrTemplateServiceDisabled is returned by every operation of a
+// `service: template` storage while AllowTemplateService is off.
+var ErrTemplateServiceDisabled = errors.New("xdrive service template is disabled in this build")
+
+// UnsupportedServiceError is returned by every operation of an xdrive node
+// whose service this build does not implement. SlothClash core patch 0016:
+// such a node (`service: s3`, a typo, an empty service) loads like a refused
+// local or template one, so one entry the build cannot use does not fail a
+// whole proxy-provider or config, but every dial through it fails and it sends
+// no request.
+type UnsupportedServiceError struct{ Service string }
+
+func (e *UnsupportedServiceError) Error() string {
+	return fmt.Sprintf("xdrive service %q is not supported by this build", e.Service)
+}
+
+// refusal reports why this build will not run the node's storage, or nil when
+// it will. SlothClash core patch 0016.
+func (c Config) refusal() error {
+	switch c.Service {
+	case "google-drive", "Google Drive":
+		return nil
+	case "local":
+		if AllowLocalService {
+			return nil
+		}
+		return ErrLocalServiceDisabled
+	case "template":
+		if AllowTemplateService {
+			return nil
+		}
+		return ErrTemplateServiceDisabled
+	default:
+		return &UnsupportedServiceError{Service: c.Service}
+	}
+}
+
+// Validate checks the options of a service this build runs. A node the build
+// refuses (see refusal) is valid whatever its other options: none of them is
+// ever used, and the node fails on its first dial instead (SlothClash core
+// patch 0016).
 func (c Config) Validate() error {
+	if c.refusal() != nil {
+		return nil
+	}
 	if c.Fronting != "" {
 		host, port, err := net.SplitHostPort(c.Fronting)
 		p, portErr := strconv.ParseUint(port, 10, 16)
@@ -65,7 +124,8 @@ func (c Config) Validate() error {
 			return fmt.Errorf("xdrive template service requires a template object")
 		}
 	default:
-		return fmt.Errorf("unsupported xdrive service %q", c.Service)
+		// refusal covers every other service.
+		return &UnsupportedServiceError{Service: c.Service}
 	}
 	return nil
 }
