--- /dev/null
+++ b/adapter/provider/xdrive_unknown_service_test.go
@@ -0,0 +1,69 @@
+package provider
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	C "github.com/metacubex/mihomo/constant"
+)
+
+// SlothClash core patch 0016: a proxy-provider document with an XDrive node
+// whose service this build does not implement still loads, with every node;
+// only the unsupported node fails, when it is dialed.
+func TestProviderLoadsUnsupportedXDriveService(t *testing.T) {
+	const doc = `proxies:
+- name: unsupported
+  type: vless
+  server: 192.0.2.1
+  port: 443
+  uuid: 27848739-7e62-4138-9fd3-098a63964b6b
+  network: xdrive
+  encryption: mlkem768x25519plus.native.0rtt.XKbaq1BuzJKKKPxZbwgRpn-gYQbnhrYketgezASCL1I
+  xdrive-opts:
+    service: s3
+    remote-folder: folder
+- name: drive
+  type: vless
+  server: 192.0.2.2
+  port: 443
+  uuid: 27848739-7e62-4138-9fd3-098a63964b6b
+  network: xdrive
+  encryption: mlkem768x25519plus.native.0rtt.XKbaq1BuzJKKKPxZbwgRpn-gYQbnhrYketgezASCL1I
+  xdrive-opts:
+    service: google-drive
+    remote-folder: folder-id
+    secrets: [client-id, client-secret, refresh-token]
+`
+	parser, err := NewProxiesParser("test", nil, "", "", "", "", overrideSchema{}, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	proxies, err := parser([]byte(doc))
+	if err != nil {
+		t.Fatalf("provider with an unsupported XDrive service failed: %v", err)
+	}
+	t.Cleanup(func() {
+		for _, p := range proxies {
+			_ = p.Close()
+		}
+	})
+	if len(proxies) != 2 || proxies[0].Name() != "unsupported" || proxies[1].Name() != "drive" {
+		t.Fatalf("proxies = %v, want both nodes", proxies)
+	}
+
+	metadata := &C.Metadata{NetWork: C.TCP, Host: "example.com", DstPort: 443}
+	conn, err := proxies[0].DialContext(context.Background(), metadata)
+	if err == nil {
+		_ = conn.Close()
+		t.Fatal("dial through an unsupported XDrive service succeeded")
+	}
+	if want := `xdrive service "s3" is not supported by this build`; !strings.Contains(err.Error(), want) {
+		t.Fatalf("dial error = %v, want it to contain %q", err, want)
+	}
+
+	// A malformed google-drive node still fails the document.
+	if _, err := parser([]byte(strings.Replace(doc, "[client-id, client-secret, refresh-token]", "[client-id]", 1))); err == nil {
+		t.Fatal("malformed google-drive options accepted")
+	}
+}
