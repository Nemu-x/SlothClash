diff --git a/transport/xdrive/template_gate_test.go b/transport/xdrive/template_gate_test.go
new file mode 100644
index 00000000..0caf01f9
--- /dev/null
+++ b/transport/xdrive/template_gate_test.go
@@ -0,0 +1,63 @@
+package xdrive
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+)
+
+// SlothClash core patch 0016: with AllowTemplateService off, a template node
+// still loads but sends no request at all and fails every dial and listen with
+// ErrTemplateServiceDisabled.
+func TestTemplateServiceGate(t *testing.T) {
+	saved := AllowTemplateService
+	t.Cleanup(func() { AllowTemplateService = saved })
+
+	var hits atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hits.Add(1)
+		w.WriteHeader(http.StatusNotFound)
+	}))
+	t.Cleanup(srv.Close)
+
+	cfg := Config{Service: "template", RemoteFolder: "f", Template: map[string]any{
+		"put":    map[string]any{"method": "PUT", "url": srv.URL + "/{folder}/{name}"},
+		"get":    map[string]any{"method": "GET", "url": srv.URL + "/{folder}/{name}"},
+		"delete": map[string]any{"method": "DELETE", "url": srv.URL + "/{folder}/{name}"},
+		"list":   map[string]any{"method": "GET", "url": srv.URL + "/{folder}/", "namesRegex": `"([^"]+)"`},
+	}}
+
+	AllowTemplateService = true
+	if _, err := newStorage(cfg, nil); err != nil {
+		t.Fatalf("template storage allowed: %v", err)
+	}
+
+	AllowTemplateService = false
+	if err := cfg.Validate(); err != nil {
+		t.Fatalf("a refused template node must still validate: %v", err)
+	}
+	client, err := NewClient(cfg, nil)
+	if err != nil {
+		t.Fatalf("client for a refused template node: %v", err)
+	}
+	if _, err := client.Dial(context.Background()); !errors.Is(err, ErrTemplateServiceDisabled) {
+		t.Fatalf("dial through a refused template node: got %v", err)
+	}
+	if err := client.Close(); err != nil {
+		t.Fatalf("close: %v", err)
+	}
+	if _, err := Listen(cfg, nil); !errors.Is(err, ErrTemplateServiceDisabled) {
+		t.Fatalf("listen on a refused template node: got %v", err)
+	}
+	if n := hits.Load(); n != 0 {
+		t.Fatalf("a refused template node sent %d requests", n)
+	}
+
+	cloud := Config{Service: "google-drive", RemoteFolder: "id", Secrets: []string{"a", "b", "c"}}
+	if err := cloud.Validate(); err != nil {
+		t.Fatalf("google-drive must not be affected: %v", err)
+	}
+}
diff --git a/transport/xdrive/unknown_service_test.go b/transport/xdrive/unknown_service_test.go
new file mode 100644
index 00000000..e709aae9
--- /dev/null
+++ b/transport/xdrive/unknown_service_test.go
@@ -0,0 +1,79 @@
+package xdrive
+
+import (
+	"context"
+	"errors"
+	"sync/atomic"
+	"testing"
+
+	"github.com/metacubex/http"
+)
+
+// countingTransport fails every request and counts it.
+type countingTransport struct{ requests atomic.Int32 }
+
+func (t *countingTransport) RoundTrip(*http.Request) (*http.Response, error) {
+	t.requests.Add(1)
+	return nil, errors.New("unexpected request")
+}
+
+// SlothClash core patch 0016: a node whose service this build does not
+// implement loads, fails every dial and listen with a clear error and sends no
+// request.
+func TestUnsupportedServiceLoadsButNeverDials(t *testing.T) {
+	for _, service := range []string{"s3", "google_drive", "GOOGLE-DRIVE", "Template", ""} {
+		t.Run(service, func(t *testing.T) {
+			transport := &countingTransport{}
+			client := &http.Client{Transport: transport}
+			// Every other option is malformed too: none of them is used.
+			cfg := Config{Service: service, Fronting: "not an address", Template: map[string]any{"put": map[string]any{"url": "http://127.0.0.1:1/"}}}
+
+			if err := cfg.Validate(); err != nil {
+				t.Fatalf("an unsupported service must still validate: %v", err)
+			}
+			c, err := NewClient(cfg, client)
+			if err != nil {
+				t.Fatalf("client for an unsupported service: %v", err)
+			}
+			_, err = c.Dial(context.Background())
+			var unsupported *UnsupportedServiceError
+			if !errors.As(err, &unsupported) || unsupported.Service != service {
+				t.Fatalf("dial through an unsupported service: got %v", err)
+			}
+			want := `xdrive service "` + service + `" is not supported by this build`
+			if err.Error() != want {
+				t.Fatalf("error = %q, want %q", err, want)
+			}
+			if err := c.Close(); err != nil {
+				t.Fatalf("close: %v", err)
+			}
+			if _, err := Listen(cfg, client); !errors.As(err, &unsupported) {
+				t.Fatalf("listen on an unsupported service: got %v", err)
+			}
+			if n := transport.requests.Load(); n != 0 {
+				t.Fatalf("an unsupported service sent %d requests", n)
+			}
+		})
+	}
+}
+
+// Malformed options of a service the build runs are still refused at load.
+func TestSupportedServiceStillValidated(t *testing.T) {
+	for name, cfg := range map[string]Config{
+		"drive-two-secrets":    {Service: "google-drive", RemoteFolder: "id", Secrets: []string{"a", "b"}},
+		"drive-blank-secret":   {Service: "Google Drive", RemoteFolder: "id", Secrets: []string{"a", " ", "c"}},
+		"drive-no-folder":      {Service: "google-drive", Secrets: []string{"a", "b", "c"}},
+		"drive-bad-fronting":   {Service: "google-drive", RemoteFolder: "id", Secrets: []string{"a", "b", "c"}, Fronting: "host"},
+		"template-no-template": {Service: "template", RemoteFolder: "f"},
+		"local-no-folder":      {Service: "local"},
+	} {
+		t.Run(name, func(t *testing.T) {
+			if err := cfg.Validate(); err == nil {
+				t.Fatal("malformed options accepted")
+			}
+			if _, err := NewClient(cfg, nil); err == nil {
+				t.Fatal("client for malformed options")
+			}
+		})
+	}
+}
