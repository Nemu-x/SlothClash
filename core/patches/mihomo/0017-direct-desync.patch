diff --git a/adapter/outbound/direct_desync.go b/adapter/outbound/direct_desync.go
new file mode 100644
index 0000000..bc4da56
--- /dev/null
+++ b/adapter/outbound/direct_desync.go
@@ -0,0 +1,90 @@
+package outbound
+
+import (
+	"fmt"
+	"net"
+	"strings"
+	"time"
+
+	"github.com/Nemu-x/desync"
+)
+
+// DirectDesyncOption applies only to the first TLS record of this named
+// outbound. It does not change global DIRECT or provide a UDP transformation.
+type DirectDesyncOption struct {
+	TLSRec       string                  `proxy:"tlsrec,omitempty"`
+	Split        string                  `proxy:"split,omitempty"`
+	SplitDelayMS int                     `proxy:"split-delay-ms,omitempty"`
+	Fake         *DirectDesyncFakeOption `proxy:"fake,omitempty"`
+}
+
+type DirectDesyncFakeOption struct {
+	TTL       int `proxy:"ttl"`
+	Prefix    int `proxy:"prefix,omitempty"`
+	TimeoutMS int `proxy:"timeout-ms,omitempty"`
+}
+
+// directDesyncConn deliberately hides the underlying wrapper's NetConn method
+// from generic fast-path casts while retaining ordinary net.Conn deadlines.
+type directDesyncConn struct{ net.Conn }
+
+func parseDirectDesyncPositions(text string) ([]desync.Pos, error) {
+	if strings.TrimSpace(text) == "" {
+		return nil, nil
+	}
+	var positions []desync.Pos
+	for _, part := range strings.Split(text, ",") {
+		position, err := desync.ParsePos(part)
+		if err != nil {
+			return nil, err
+		}
+		positions = append(positions, position)
+	}
+	return positions, nil
+}
+
+func (o *DirectDesyncOption) options() (desync.Options, error) {
+	var result desync.Options
+	var err error
+	if o == nil {
+		return result, nil
+	}
+	if result.TLSRec, err = parseDirectDesyncPositions(o.TLSRec); err != nil {
+		return result, fmt.Errorf("desync tlsrec: %w", err)
+	}
+	if result.Split, err = parseDirectDesyncPositions(o.Split); err != nil {
+		return result, fmt.Errorf("desync split: %w", err)
+	}
+	if o.SplitDelayMS < 0 || o.SplitDelayMS > 1000 {
+		return result, fmt.Errorf("desync split-delay-ms must be between 0 and 1000")
+	}
+	result.SplitDelay = time.Duration(o.SplitDelayMS) * time.Millisecond
+	if o.Fake != nil {
+		if o.Fake.TimeoutMS < 0 || o.Fake.TimeoutMS > 60000 {
+			return result, fmt.Errorf("desync fake timeout-ms must be between 0 and 60000")
+		}
+		result.Fake = &desync.FakeOptions{TTL: o.Fake.TTL, Prefix: o.Fake.Prefix, Timeout: time.Duration(o.Fake.TimeoutMS) * time.Millisecond}
+	}
+	if !result.Enabled() {
+		return result, fmt.Errorf("desync requires at least one method")
+	}
+	return result, result.Validate()
+}
+
+// NewDirectWithDesyncOption validates optional transformations before the
+// configuration is accepted. Unsupported fake platforms fail explicitly.
+func NewDirectWithDesyncOption(option DirectOption) (*Direct, error) {
+	direct := NewDirectWithOption(option)
+	if option.Desync == nil {
+		return direct, nil
+	}
+	opts, err := option.Desync.options()
+	if err != nil {
+		return nil, err
+	}
+	if option.TFO || option.MPTCP {
+		return nil, fmt.Errorf("desync direct does not support tfo or mptcp")
+	}
+	direct.desync = &opts
+	return direct, nil
+}
