+++ b/adapter/outbound/direct_desync_test.go
@@ -0,0 +1,115 @@
+package outbound
+
+import (
+	"bytes"
+	"context"
+	"crypto/tls"
+	"encoding/binary"
+	"errors"
+	"io"
+	"net"
+	"net/netip"
+	"testing"
+	"time"
+
+	"github.com/Nemu-x/desync"
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/sing/common/bufio"
+)
+
+func TestDirectDesyncValidation(t *testing.T) {
+	for _, opts := range []*DirectDesyncOption{
+		{}, {TLSRec: "bad"}, {Split: "1+x"}, {TLSRec: "1+s", SplitDelayMS: -1},
+		{Fake: &DirectDesyncFakeOption{TTL: 0}}, {Fake: &DirectDesyncFakeOption{TTL: 256}},
+		{Fake: &DirectDesyncFakeOption{TTL: 4, TimeoutMS: 60001}},
+	} {
+		if _, err := NewDirectWithDesyncOption(DirectOption{Name: "test", Desync: opts}); err == nil {
+			t.Fatalf("accepted invalid options: %+v", opts)
+		}
+	}
+	if _, err := NewDirectWithDesyncOption(DirectOption{Name: "plain"}); err != nil {
+		t.Fatal(err)
+	}
+	_, err := NewDirectWithDesyncOption(DirectOption{Name: "fake", Desync: &DirectDesyncOption{TLSRec: "1+s", Fake: &DirectDesyncFakeOption{TTL: 4, Prefix: -1}}})
+	if desync.SupportsFake() && err != nil {
+		t.Fatal(err)
+	}
+	if !desync.SupportsFake() && !errors.Is(err, desync.ErrFakeUnsupported) {
+		t.Fatalf("unsupported platform: %v", err)
+	}
+}
+
+func captureDirectDesyncHello(t *testing.T) []byte {
+	t.Helper()
+	client, server := net.Pipe()
+	defer server.Close()
+	go func() {
+		defer client.Close()
+		_ = tls.Client(client, &tls.Config{ServerName: "example.test"}).Handshake()
+	}()
+	_ = server.SetReadDeadline(time.Now().Add(3 * time.Second))
+	header := make([]byte, 5)
+	if _, err := io.ReadFull(server, header); err != nil {
+		t.Fatal(err)
+	}
+	record := make([]byte, 5+int(binary.BigEndian.Uint16(header[3:])))
+	copy(record, header)
+	if _, err := io.ReadFull(server, record[5:]); err != nil {
+		t.Fatal(err)
+	}
+	return record
+}
+
+func TestDirectDesyncBufferedStream(t *testing.T) {
+	record := captureDirectDesyncHello(t)
+	for _, enabled := range []bool{false, true} {
+		t.Run(map[bool]string{false: "ordinary-direct", true: "tls-record-direct"}[enabled], func(t *testing.T) {
+			ln, err := net.Listen("tcp4", "127.0.0.1:0")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer ln.Close()
+			options := DirectOption{Name: "measured"}
+			want := record
+			if enabled {
+				options.Desync = &DirectDesyncOption{TLSRec: "3+s"}
+				h, _ := desync.ParseHello(record)
+				want = desync.FragmentRecord(record, []int{h.SNIOffset + 3})
+			}
+			direct, err := NewDirectWithDesyncOption(options)
+			if err != nil {
+				t.Fatal(err)
+			}
+			serverErr := make(chan error, 1)
+			go func() {
+				peer, err := ln.Accept()
+				if err != nil {
+					serverErr <- err
+					return
+				}
+				defer peer.Close()
+				_ = peer.SetDeadline(time.Now().Add(3 * time.Second))
+				got := make([]byte, len(want))
+				_, err = io.ReadFull(peer, got)
+				if err == nil && !bytes.Equal(got, want) {
+					err = errors.New("buffered relay bypassed or corrupted desync")
+				}
+				serverErr <- err
+			}()
+			ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+			defer cancel()
+			conn, err := direct.DialContext(ctx, &C.Metadata{NetWork: C.TCP, DstIP: netip.MustParseAddr("127.0.0.1"), DstPort: uint16(ln.Addr().(*net.TCPAddr).Port)})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer conn.Close()
+			_ = conn.SetDeadline(time.Now().Add(3 * time.Second))
+			if _, err := bufio.Copy(conn, bytes.NewReader(record)); err != nil {
+				t.Fatal(err)
+			}
+			if err := <-serverErr; err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
