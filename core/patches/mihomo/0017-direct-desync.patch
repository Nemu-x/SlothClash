+package adapter
+
+import (
+	"github.com/Nemu-x/desync"
+	"testing"
+)
+
+func TestDirectDesyncParser(t *testing.T) {
+	for _, mapping := range []map[string]any{
+		{"name": "ordinary", "type": "direct"},
+		{"name": "youtube", "type": "direct", "desync": map[string]any{"tlsrec": "3+s"}},
+	} {
+		if _, err := ParseProxy(mapping); err != nil {
+			t.Fatal(err)
+		}
+	}
+	fake := map[string]any{"name": "discord", "type": "direct", "desync": map[string]any{"tlsrec": "1+s", "fake": map[string]any{"ttl": 4, "prefix": -1}}}
+	_, err := ParseProxy(fake)
+	if desync.SupportsFake() && err != nil {
+		t.Fatal(err)
+	}
+	if !desync.SupportsFake() && err == nil {
+		t.Fatal("unsupported fake was accepted")
+	}
+	for _, invalid := range []map[string]any{
+		{"name": "empty", "type": "direct", "desync": map[string]any{}},
+		{"name": "position", "type": "direct", "desync": map[string]any{"tlsrec": "bad"}},
+		{"name": "ttl", "type": "direct", "desync": map[string]any{"fake": map[string]any{"ttl": 999}}},
+	} {
+		if _, err := ParseProxy(invalid); err == nil {
+			t.Fatalf("accepted invalid mapping: %v", invalid)
+		}
+	}
+}
