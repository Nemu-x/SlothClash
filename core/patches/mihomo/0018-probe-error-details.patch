index 00000000..ca734d50
--- /dev/null
+++ b/hub/route/proxies_delay_test.go
@@ -0,0 +1,123 @@
+package route
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/metacubex/http/httptest"
+
+	"github.com/metacubex/mihomo/common/utils"
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/log"
+)
+
+type delayTestProxy struct {
+	C.Proxy
+	delay          uint16
+	err            error
+	waitForTimeout bool
+}
+
+func (*delayTestProxy) Name() string { return "SLOTH-DESYNC-YOUTUBE" }
+
+func (p *delayTestProxy) URLTest(ctx context.Context, _ string, _ utils.IntRanges[uint16]) (uint16, error) {
+	if p.waitForTimeout {
+		<-ctx.Done()
+		return 0, ctx.Err()
+	}
+	return p.delay, p.err
+}
+
+// delayRequest runs GET /delay against proxy with the given extra query.
+func delayRequest(proxy *delayTestProxy, query string) *httptest.ResponseRecorder {
+	timeout := "10000"
+	if proxy.waitForTimeout {
+		timeout = "1"
+	}
+	req := httptest.NewRequest("GET", "/delay?url=https%3A%2F%2Fwww.youtube.com%2Fgenerate_204&timeout="+timeout+query, nil)
+	req = req.WithContext(context.WithValue(req.Context(), CtxKeyProxy, C.Proxy(proxy)))
+	response := httptest.NewRecorder()
+	getProxyDelay(response, req)
+	return response
+}
+
+// Without detail=1 the endpoint answers byte for byte as stock mihomo.
+func TestProxyDelayStockAnswers(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		proxy  *delayTestProxy
+		status int
+		body   string
+	}{
+		{"dial failure", &delayTestProxy{err: errors.New("dial tcp: network is unreachable")}, 503, `{"message":"An error occurred in the delay test"}`},
+		{"TLS failure", &delayTestProxy{delay: 12, err: errors.New("remote error: tls: handshake failure")}, 503, `{}`},
+		{"timeout", &delayTestProxy{waitForTimeout: true}, 504, `{"message":"Timeout"}`},
+		{"zero latency", &delayTestProxy{}, 503, `{"message":"An error occurred in the delay test"}`},
+		{"success", &delayTestProxy{delay: 1}, 200, `{"delay":1}`},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			response := delayRequest(tc.proxy, "")
+			if response.Code != tc.status || strings.TrimSpace(response.Body.String()) != tc.body {
+				t.Fatalf("HTTP %d %s, want %d %s", response.Code, response.Body.String(), tc.status, tc.body)
+			}
+		})
+	}
+}
+
+func TestProxyDelayDetailPreservesFailureDetailsAndLogs(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		proxy   *delayTestProxy
+		status  int
+		message string
+	}{
+		{"dial failure", &delayTestProxy{err: errors.New("dial tcp: network is unreachable")}, 503, "network is unreachable"},
+		{"TLS failure", &delayTestProxy{delay: 12, err: errors.New("remote error: tls: handshake failure")}, 503, "tls: handshake failure"},
+		{"timeout", &delayTestProxy{waitForTimeout: true}, 504, "context deadline exceeded"},
+		{"zero latency", &delayTestProxy{}, 503, "zero latency"},
+		{"success", &delayTestProxy{delay: 1}, 200, ""},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			sub := log.Subscribe()
+			defer log.UnSubscribe(sub)
+			// Log delivery is asynchronous: an unrelated event may arrive first.
+			log.Warnln("Unrelated warning from another controller operation")
+			response := delayRequest(tc.proxy, "&detail=1")
+			if response.Code != tc.status {
+				t.Fatalf("HTTP %d: %s", response.Code, response.Body.String())
+			}
+			var body struct {
+				Message string `json:"message"`
+				Delay   uint16 `json:"delay"`
+			}
+			if err := json.Unmarshal(response.Body.Bytes(), &body); err != nil {
+				t.Fatal(err)
+			}
+			if tc.status == 200 {
+				if body.Delay != 1 {
+					t.Fatalf("successful delay changed: %+v", body)
+				}
+				return
+			}
+			if !strings.Contains(body.Message, tc.message) {
+				t.Fatalf("failure detail lost: %+v", body)
+			}
+			deadline := time.NewTimer(time.Second)
+			defer deadline.Stop()
+			for {
+				select {
+				case event := <-sub:
+					if event.LogLevel == log.DEBUG && strings.Contains(event.Payload, tc.proxy.Name()) && strings.Contains(event.Payload, tc.message) {
+						return
+					}
+				case <-deadline.C:
+					t.Fatalf("probe failure was not logged at debug for %s: %s", tc.proxy.Name(), tc.message)
+				}
+			}
+		})
+	}
+}
