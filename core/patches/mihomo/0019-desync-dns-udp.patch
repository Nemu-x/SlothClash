diff --git a/adapter/outbound/direct_desync_dns_udp_test.go b/adapter/outbound/direct_desync_dns_udp_test.go
new file mode 100644
index 0000000..aca7da9
--- /dev/null
+++ b/adapter/outbound/direct_desync_dns_udp_test.go
@@ -0,0 +1,178 @@
+package outbound
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"net"
+	"net/netip"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/Nemu-x/desync"
+	N "github.com/metacubex/mihomo/common/net"
+	"github.com/metacubex/mihomo/component/resolver"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+type desyncDNSStub struct {
+	resolver.Resolver
+	ips   []netip.Addr
+	err   error
+	calls atomic.Int64
+}
+
+func (r *desyncDNSStub) Invalid() bool { return true }
+func (r *desyncDNSStub) LookupIP(context.Context, string) ([]netip.Addr, error) {
+	r.calls.Add(1)
+	return r.ips, r.err
+}
+func (r *desyncDNSStub) LookupIPv4(ctx context.Context, host string) ([]netip.Addr, error) {
+	return r.LookupIP(ctx, host)
+}
+func (r *desyncDNSStub) LookupIPv6(ctx context.Context, host string) ([]netip.Addr, error) {
+	return r.LookupIP(ctx, host)
+}
+
+func TestDirectDesyncDNSFallbackColdEmptyAndScope(t *testing.T) {
+	oldDirect, oldDefault, oldDisabled := resolver.DirectHostResolver, resolver.DefaultResolver, resolver.DisableIPv6
+	t.Cleanup(func() {
+		resolver.DirectHostResolver, resolver.DefaultResolver, resolver.DisableIPv6 = oldDirect, oldDefault, oldDisabled
+	})
+	resolver.DisableIPv6 = true
+	for _, tc := range []struct {
+		name         string
+		enabled      bool
+		directErr    error
+		directIPs    []netip.Addr
+		wantOK       bool
+		wantFallback bool
+	}{
+		{"cold empty direct DNS", true, resolver.ErrIPNotFound, nil, true, true},
+		{"empty answer without error", true, nil, nil, true, true},
+		{"ordinary direct retains policy", false, resolver.ErrIPNotFound, nil, false, false},
+		{"healthy direct DNS", true, nil, []netip.Addr{netip.MustParseAddr("127.0.0.1")}, true, false},
+		{"other resolver failure remains visible", true, errors.New("upstream refused query"), nil, false, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ln, err := net.Listen("tcp4", "127.0.0.1:0")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer ln.Close()
+			directDNS := &desyncDNSStub{ips: tc.directIPs, err: tc.directErr}
+			profileDNS := &desyncDNSStub{ips: []netip.Addr{netip.MustParseAddr("127.0.0.1")}}
+			resolver.DirectHostResolver, resolver.DefaultResolver = directDNS, profileDNS
+			options := DirectOption{Name: "selected"}
+			if tc.enabled {
+				options.Desync = &DirectDesyncOption{TLSRec: "3+s", DNSFallback: true}
+			}
+			direct, err := NewDirectWithDesyncOption(options)
+			if err != nil {
+				t.Fatal(err)
+			}
+			metadata := &C.Metadata{NetWork: C.TCP, Host: "cold.youtube.test", DstPort: uint16(ln.Addr().(*net.TCPAddr).Port)}
+			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+			defer cancel()
+			conn, err := direct.DialContext(ctx, metadata)
+			if (err == nil) != tc.wantOK {
+				t.Fatalf("unexpected connection result: %v", err)
+			}
+			if conn != nil {
+				conn.Close()
+			}
+			if (profileDNS.calls.Load() > 0) != tc.wantFallback {
+				t.Fatalf("fallback scope violated: %d calls", profileDNS.calls.Load())
+			}
+			if tc.wantFallback {
+				metadata.NetWork = C.UDP
+				if err := direct.ResolveUDP(ctx, metadata); err != nil || metadata.DstIP.String() != "127.0.0.1" {
+					t.Fatalf("UDP DNS fallback: %+v %v", metadata, err)
+				}
+				if direct.desyncDNSFallbacks.Load() != 2 {
+					t.Fatal("fallback count lost")
+				}
+			}
+		})
+	}
+}
+
+func TestDirectDesyncDNSFallbackDoesNotMaskConnectErrors(t *testing.T) {
+	oldDirect, oldDefault := resolver.DirectHostResolver, resolver.DefaultResolver
+	resolver.DirectHostResolver, resolver.DefaultResolver = &desyncDNSStub{}, &desyncDNSStub{}
+	t.Cleanup(func() { resolver.DirectHostResolver, resolver.DefaultResolver = oldDirect, oldDefault })
+	d := &Direct{desyncDNSFallback: true}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if d.shouldFallbackDesyncDNS(ctx, resolver.ErrIPNotFound) {
+		t.Fatal("retried a canceled request")
+	}
+	if d.shouldFallbackDesyncDNS(context.Background(), errors.New("connection refused")) {
+		t.Fatal("retried a TCP connect error as DNS")
+	}
+}
+
+func TestDirectDesyncUDPValidationAndCorePacketPath(t *testing.T) {
+	options := DirectOption{Name: "SLOTH-DESYNC-DISCORD-UDP", Desync: &DirectDesyncOption{UDP: &DirectDesyncUDPOption{TTL: 4, Repeats: 2, Packets: 1}, DNSFallback: true}}
+	direct, err := NewDirectWithDesyncOption(options)
+	if !desync.SupportsUDPFake() {
+		if !errors.Is(err, desync.ErrUDPFakeUnsupported) {
+			t.Fatalf("unsupported UDP accepted: %v", err)
+		}
+		return
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, udp := range []*DirectDesyncUDPOption{{TTL: 0}, {TTL: 256}, {TTL: 4, Repeats: 17}, {TTL: 4, Packets: 9}} {
+		if _, err := NewDirectWithDesyncOption(DirectOption{Name: "invalid", Desync: &DirectDesyncOption{UDP: udp}}); err == nil {
+			t.Fatalf("accepted invalid UDP: %+v", udp)
+		}
+	}
+	server, err := net.ListenPacket("udp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer server.Close()
+	metadata := &C.Metadata{NetWork: C.UDP, DstIP: netip.MustParseAddr("127.0.0.1"), DstPort: uint16(server.LocalAddr().(*net.UDPAddr).Port)}
+	pc, err := direct.ListenPacketContext(context.Background(), metadata)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer pc.Close()
+	if _, ok := N.FindUpstream[*net.UDPConn](pc, nil); ok {
+		t.Fatal("core fast paths can bypass UDP desync")
+	}
+	if _, err := pc.WriteTo([]byte("original-media"), server.LocalAddr()); err != nil {
+		t.Fatal(err)
+	}
+	server.SetReadDeadline(time.Now().Add(time.Second))
+	for i := 0; i < 3; i++ {
+		data := make([]byte, 256)
+		n, _, err := server.ReadFrom(data)
+		if err != nil {
+			t.Fatal(err)
+		}
+		want := make([]byte, 64)
+		if i == 2 {
+			want = []byte("original-media")
+		}
+		if !bytes.Equal(data[:n], want) {
+			t.Fatalf("core packet path skipped or corrupted datagram %d: %q", i, data[:n])
+		}
+	}
+	encoded, err := direct.MarshalJSON()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var status struct {
+		UDP struct {
+			Counters desync.UDPSnapshot `json:"counters"`
+		} `json:"desyncUDP"`
+	}
+	if err := json.Unmarshal(encoded, &status); err != nil || status.UDP.Counters.FakePackets != 2 || status.UDP.Counters.Packets != 1 {
+		t.Fatalf("missing observable UDP counters: %s %v", encoded, err)
+	}
+}
