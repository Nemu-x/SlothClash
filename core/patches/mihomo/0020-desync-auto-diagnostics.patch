@@ -0,0 +1,37 @@
+package outbound
+
+import (
+	"encoding/binary"
+	"net"
+	"testing"
+)
+
+func TestDesyncActivitySeparatesDiscoveryFromMediaAndBoundsPeers(t *testing.T) {
+	a := &directUDPActivity{}
+	addr := &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 19299}
+	discovery := make([]byte, 74)
+	binary.BigEndian.PutUint16(discovery, 1)
+	binary.BigEndian.PutUint16(discovery[2:], 70)
+	a.observe(discovery, addr, false)
+	binary.BigEndian.PutUint16(discovery, 2)
+	a.observe(discovery, addr, true)
+	rtcp := make([]byte, 28)
+	rtcp[0] = 0x80
+	rtcp[1] = 200
+	a.observe(rtcp, addr, true)
+	media := make([]byte, 100)
+	media[0] = 0x80
+	media[1] = 120
+	a.observe(media, addr, false)
+	a.observe(media, addr, true)
+	got := a.snapshot()
+	if len(got) != 1 || got[0].DiscoveryTX != 1 || got[0].DiscoveryRX != 1 || got[0].MediaTX != 1 || got[0].MediaRX != 1 || got[0].RXPackets != 3 {
+		t.Fatalf("wrong transport observations: %+v", got)
+	}
+	for port := 20000; port < 20050; port++ {
+		a.observe(media, &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: port}, false)
+	}
+	if len(a.snapshot()) != 32 {
+		t.Fatal("activity peer table is not bounded")
+	}
+}
diff --git a/hub/route/desync_udp.go b/hub/route/desync_udp.go
new file mode 100644
index 0000000..51723dc
--- /dev/null
+++ b/hub/route/desync_udp.go
@@ -0,0 +1,169 @@
+package route
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"net/netip"
+	"path"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	"github.com/metacubex/chi/render"
+	"github.com/metacubex/http"
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/tunnel/statistic"
+)
+
+var desyncUDPProbeBusy atomic.Bool
+
+type desyncUDPProbeResult struct {
+	Sent               int   `json:"sent"`
+	Received           int   `json:"received"`
+	MaxConsecutiveLoss int   `json:"maxConsecutiveLoss"`
+	DurationMS         int64 `json:"durationMS"`
+}
+
+func allowedDiscordEndpoint(target netip.AddrPort) bool {
+	if !target.IsValid() || !target.Addr().IsGlobalUnicast() || target.Addr().IsPrivate() || target.Port() < 1024 || target.Port() == 443 {
+		return false
+	}
+	found := false
+	statistic.DefaultManager.Range(func(c statistic.Tracker) bool {
+		info := c.Info()
+		m := info.Metadata
+		if m != nil && m.NetWork == C.UDP && strings.EqualFold(path.Base(strings.ReplaceAll(m.Process, `\`, "/")), "Discord.exe") && m.DstIP.Unmap() == target.Addr().Unmap() && m.DstPort == target.Port() {
+			for _, chain := range info.Chain {
+				if chain == "SLOTH-DESYNC-DISCORD-UDP" {
+					found = true
+					return false
+				}
+			}
+		}
+		return true
+	})
+	return found
+}
+
+// The normal controller authentication applies. Limit to an explicitly owned
+// UDP candidate and an active Discord endpoint; never accept arbitrary targets,
+// account credentials, payloads or packet counts from an API caller.
+func probeDesyncUDP(w http.ResponseWriter, r *http.Request) {
+	proxy := r.Context().Value(CtxKeyProxy).(C.Proxy)
+	enabled, ok := proxy.Adapter().(interface{ DesyncUDPProbeEnabled() bool })
+	var req struct {
+		Target string `json:"target"`
+	}
+	decoder := json.NewDecoder(io.LimitReader(r.Body, 1024))
+	decoder.DisallowUnknownFields()
+	err := decoder.Decode(&req)
+	var extra any
+	trailing := decoder.Decode(&extra)
+	target, parseErr := netip.ParseAddrPort(req.Target)
+	if !ok || !enabled.DesyncUDPProbeEnabled() || !strings.HasPrefix(proxy.Name(), "SLOTH-DESYNC-DISCORD-UDP-") || err != nil || trailing != io.EOF || parseErr != nil || !allowedDiscordEndpoint(target) {
+		render.Status(r, http.StatusBadRequest)
+		render.JSON(w, r, newError("expected an owned UDP candidate and an active public Discord UDP endpoint"))
+		return
+	}
+	if !desyncUDPProbeBusy.CompareAndSwap(false, true) {
+		render.Status(r, http.StatusTooManyRequests)
+		render.JSON(w, r, newError("UDP calibration is already running"))
+		return
+	}
+	defer desyncUDPProbeBusy.Store(false)
+	ctx, cancel := context.WithTimeout(r.Context(), 18*time.Second)
+	defer cancel()
+	pc, err := proxy.ListenPacketContext(ctx, &C.Metadata{NetWork: C.UDP, Type: C.INNER, DstIP: target.Addr(), DstPort: target.Port()})
+	if err != nil {
+		render.Status(r, http.StatusServiceUnavailable)
+		render.JSON(w, r, newError("UDP candidate socket failed"))
+		return
+	}
+	defer pc.Close()
+	result, err := runDesyncUDPProbe(ctx, pc, target)
+	if err != nil {
+		render.Status(r, http.StatusServiceUnavailable)
+		render.JSON(w, r, newError("UDP probe canceled or socket failed"))
+		return
+	}
+	render.JSON(w, r, result)
+}
+
+// IP-discovery is deliberately separate from real media observation. No actual
+// call packets or account SSRCs are captured/replayed. This establishes only
+// repeated request/response reachability to the selected voice endpoint.
+func runDesyncUDPProbe(ctx context.Context, pc net.PacketConn, target netip.AddrPort) (out desyncUDPProbeResult, err error) {
+	start := time.Now()
+	defer func() { out.DurationMS = time.Since(start).Milliseconds() }()
+	stop := context.AfterFunc(ctx, func() { _ = pc.Close() })
+	defer stop()
+	buffer := make([]byte, 2048)
+	addr := net.UDPAddrFromAddrPort(target)
+	consecutive := 0
+	for i := 0; i < 12; i++ {
+		if ctx.Err() != nil {
+			return out, ctx.Err()
+		}
+		request := make([]byte, 74)
+		binary.BigEndian.PutUint16(request, 1)
+		binary.BigEndian.PutUint16(request[2:], 70)
+		if _, err = rand.Read(request[4:8]); err != nil {
+			return out, err
+		}
+		deadline := time.Now().Add(800 * time.Millisecond)
+		if d, ok := ctx.Deadline(); ok && d.Before(deadline) {
+			deadline = d
+		}
+		if err = pc.SetDeadline(deadline); err != nil {
+			return out, err
+		}
+		out.Sent++
+		if _, err = pc.WriteTo(request, addr); err != nil {
+			return out, fmt.Errorf("UDP write: %w", err)
+		}
+		received := false
+		for {
+			n, from, readErr := pc.ReadFrom(buffer)
+			if readErr != nil {
+				if ctx.Err() != nil {
+					return out, ctx.Err()
+				}
+				if e, ok := readErr.(net.Error); ok && e.Timeout() {
+					break
+				}
+				return out, readErr
+			}
+			remote, ok := from.(*net.UDPAddr)
+			if ok && remote.AddrPort().Addr().Unmap() == target.Addr().Unmap() && remote.Port == int(target.Port()) && n == 74 && binary.BigEndian.Uint16(buffer[:2]) == 2 && binary.BigEndian.Uint16(buffer[2:4]) == 70 && bytes.Equal(buffer[4:8], request[4:8]) {
+				received = true
+				out.Received++
+				break
+			}
+		}
+		if received {
+			consecutive = 0
+		} else {
+			consecutive++
+			if consecutive > out.MaxConsecutiveLoss {
+				out.MaxConsecutiveLoss = consecutive
+			}
+		}
+		if consecutive >= 3 {
+			break
+		}
+		timer := time.NewTimer(180 * time.Millisecond)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return out, ctx.Err()
+		case <-timer.C:
+		}
+	}
+	return out, nil
+}
