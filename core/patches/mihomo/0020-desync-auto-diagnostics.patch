+package route
+
+import (
+	"context"
+	"encoding/binary"
+	"net"
+	"net/netip"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Nemu-x/desync"
+	"github.com/metacubex/http/httptest"
+	"github.com/metacubex/mihomo/adapter"
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/tunnel/statistic"
+)
+
+func TestDesyncUDPProbeValidatesRepliesAndRejectsInitialOnlySuccess(t *testing.T) {
+	for _, firstOnly := range []bool{false, true} {
+		t.Run(map[bool]string{false: "sustained", true: "initial-only"}[firstOnly], func(t *testing.T) {
+			server, err := net.ListenPacket("udp4", "127.0.0.1:0")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer server.Close()
+			client, err := net.ListenPacket("udp4", "127.0.0.1:0")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer client.Close()
+			ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+			defer cancel()
+			go func() {
+				buffer := make([]byte, 2048)
+				seen := 0
+				for {
+					n, addr, e := server.ReadFrom(buffer)
+					if e != nil {
+						return
+					}
+					if n != 74 {
+						continue
+					}
+					seen++
+					reply := append([]byte{}, buffer[:n]...)
+					binary.BigEndian.PutUint16(reply, 2)
+					// A forged SSRC from the correct endpoint must not count as a response.
+					bad := append([]byte{}, reply...)
+					bad[4] ^= 0xff
+					_, _ = server.WriteTo(bad, addr)
+					if !firstOnly || seen <= 3 {
+						_, _ = server.WriteTo(reply, addr)
+					}
+				}
+			}()
+			result, err := runDesyncUDPProbe(ctx, client, server.LocalAddr().(*net.UDPAddr).AddrPort())
+			if err != nil {
+				t.Fatal(err)
+			}
+			if firstOnly {
+				if result.Received != 3 || result.MaxConsecutiveLoss != 3 || result.Sent != 6 {
+					t.Fatalf("initial success misclassified: %+v", result)
+				}
+			} else if result.Received != 12 || result.Sent != 12 || result.MaxConsecutiveLoss != 0 {
+				t.Fatalf("valid sequence: %+v", result)
+			}
+		})
+	}
+}
+
+func TestDesyncUDPProbeCancellationClosesBlockedSocket(t *testing.T) {
+	pc, err := net.ListenPacket("udp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer pc.Close()
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	start := time.Now()
+	_, err = runDesyncUDPProbe(ctx, pc, netip.MustParseAddrPort("127.0.0.1:9"))
+	if err == nil || time.Since(start) > time.Second {
+		t.Fatalf("cancellation: %v", err)
+	}
+}
+
+type observedDiscordTracker struct {
+	statistic.Tracker
+	info *statistic.TrackerInfo
+}
+
+func (*observedDiscordTracker) ID() string                     { return "desync-observed-endpoint-test" }
+func (t *observedDiscordTracker) Info() *statistic.TrackerInfo { return t.info }
+func TestDesyncUDPProbeAcceptsOnlyObservedOwnedDiscordEndpoint(t *testing.T) {
+	target := netip.MustParseAddrPort("104.29.2.2:19330")
+	tracker := &observedDiscordTracker{info: &statistic.TrackerInfo{Metadata: &C.Metadata{NetWork: C.UDP, Process: "Discord.exe", DstIP: target.Addr(), DstPort: target.Port()}, Chain: C.Chain{"SLOTH-DESYNC-DISCORD-UDP-f4", "SLOTH-DESYNC-DISCORD-UDP"}}}
+	statistic.DefaultManager.Join(tracker)
+	defer statistic.DefaultManager.Leave(tracker)
+	if !allowedDiscordEndpoint(target) {
+		t.Fatal("active owned endpoint rejected")
+	}
+	tracker.info.Metadata.Process = "browser.exe"
+	if allowedDiscordEndpoint(target) {
+		t.Fatal("other application's endpoint accepted")
+	}
+	tracker.info.Metadata.Process = "Discord.exe"
+	tracker.info.Chain = C.Chain{"subscription"}
+	if allowedDiscordEndpoint(target) {
+		t.Fatal("subscription-routed endpoint accepted")
+	}
+}
+
+func TestDesyncUDPProbeRejectsUnobservedAndPrivateDestinations(t *testing.T) {
+	for _, target := range []string{"127.0.0.1:19299", "192.168.1.1:19299", "1.1.1.1:443", "1.1.1.1:19299", "[::1]:19299"} {
+		if allowedDiscordEndpoint(netip.MustParseAddrPort(target)) {
+			t.Fatalf("accepted unobserved target: %s", target)
+		}
+	}
+}
+
+// Exercise the actual parser/lifetime wrapper and handler together. The
+// canceled context prevents sending any requests to the public test target.
+func TestDesyncUDPProbeAcceptsParsedCandidateCapability(t *testing.T) {
+	if !desync.SupportsUDPFake() {
+		t.Skip("native UDP fake unavailable")
+	}
+	proxy, err := adapter.ParseProxy(map[string]any{
+		"name": "SLOTH-DESYNC-DISCORD-UDP-f4", "type": "direct",
+		"desync": map[string]any{"udp": map[string]any{"ttl": 4, "repeats": 1, "packets": 3}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer proxy.Close()
+	target := netip.MustParseAddrPort("1.1.1.1:19299")
+	tracker := &observedDiscordTracker{info: &statistic.TrackerInfo{Metadata: &C.Metadata{
+		NetWork: C.UDP, Process: `C:\Apps\Discord\Discord.exe`, DstIP: target.Addr(), DstPort: target.Port(),
+	}, Chain: C.Chain{proxy.Name(), "SLOTH-DESYNC-DISCORD-UDP"}}}
+	statistic.DefaultManager.Join(tracker)
+	defer statistic.DefaultManager.Leave(tracker)
+	if !allowedDiscordEndpoint(target) {
+		t.Fatal("owned Windows process endpoint rejected")
+	}
