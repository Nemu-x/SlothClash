+package outbound
+
+import "testing"
+
+type probeCapabilityAdapter struct {
+	ProxyAdapter
+	enabled bool
+}
+
+func (p *probeCapabilityAdapter) DesyncUDPProbeEnabled() bool { return p.enabled }
+func (p *probeCapabilityAdapter) Name() string                { return "probe-capability-test" }
+func (p *probeCapabilityAdapter) Close() error                { return nil }
+
+func TestDesyncUDPProbeCapabilitySurvivesLifetimeWrapper(t *testing.T) {
+	for _, enabled := range []bool{false, true} {
+		wrapped := NewAutoCloseProxyAdapter(&probeCapabilityAdapter{enabled: enabled})
+		capability, ok := wrapped.(interface{ DesyncUDPProbeEnabled() bool })
+		if !ok || capability.DesyncUDPProbeEnabled() != enabled {
+			t.Fatalf("optional UDP capability lost: enabled=%v, forwarded=%v", enabled, ok)
+		}
+	}
+	plain := NewAutoCloseProxyAdapter(NewDirect())
+	if p, ok := plain.(interface{ DesyncUDPProbeEnabled() bool }); ok && p.DesyncUDPProbeEnabled() {
+		t.Fatal("ordinary Direct enabled UDP probing")
+	}
+}
