diff --git a/adapter/outbound/direct_desync_activity.go b/adapter/outbound/direct_desync_activity.go
new file mode 100644
index 0000000..4a06db2
--- /dev/null
+++ b/adapter/outbound/direct_desync_activity.go
@@ -0,0 +1,132 @@
+package outbound
+
+import (
+	"encoding/binary"
+	"net"
+	"sort"
+	"sync"
+	"time"
+)
+
+// Metadata only. Application payloads and SSRCs are never retained.
+type directUDPObservation struct {
+	Endpoint    string `json:"endpoint"`
+	FirstMS     int64  `json:"firstMS"`
+	LastTXMS    int64  `json:"lastTXMS"`
+	LastRXMS    int64  `json:"lastRXMS"`
+	TXPackets   uint64 `json:"txPackets"`
+	RXPackets   uint64 `json:"rxPackets"`
+	TXBytes     uint64 `json:"txBytes"`
+	RXBytes     uint64 `json:"rxBytes"`
+	DiscoveryTX uint64 `json:"discoveryTX"`
+	DiscoveryRX uint64 `json:"discoveryRX"`
+	MediaTX     uint64 `json:"mediaTX"`
+	MediaRX     uint64 `json:"mediaRX"`
+}
+
+type directUDPActivity struct {
+	mu    sync.Mutex
+	peers map[string]directUDPObservation
+}
+
+func (a *directUDPActivity) observe(data []byte, addr net.Addr, received bool) {
+	if a == nil || addr == nil {
+		return
+	}
+	now := time.Now().UnixMilli()
+	endpoint := addr.String()
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.peers == nil {
+		a.peers = make(map[string]directUDPObservation)
+	}
+	v, exists := a.peers[endpoint]
+	if !exists && len(a.peers) >= 32 {
+		oldest := ""
+		var oldestTime int64 = 1<<63 - 1
+		for key, p := range a.peers {
+			last := lastUDPActivity(p)
+			if last < oldestTime {
+				oldest, oldestTime = key, last
+			}
+		}
+		delete(a.peers, oldest)
+	}
+	if !exists {
+		v = directUDPObservation{Endpoint: endpoint, FirstMS: now}
+	}
+	discovery := len(data) == 74 && binary.BigEndian.Uint16(data[2:4]) == 70 && (binary.BigEndian.Uint16(data[:2]) == 1 || binary.BigEndian.Uint16(data[:2]) == 2)
+	// RTP version 2 with a dynamic payload type. This is a transport hint,
+	// not authentication, successful decryption, or evidence of audible sound.
+	media := len(data) >= 12 && data[0]>>6 == 2 && data[1]&0x7f >= 96
+	if received {
+		v.LastRXMS = now
+		v.RXPackets++
+		v.RXBytes += uint64(len(data))
+		if discovery {
+			v.DiscoveryRX++
+		}
+		if media {
+			v.MediaRX++
+		}
+	} else {
+		v.LastTXMS = now
+		v.TXPackets++
+		v.TXBytes += uint64(len(data))
+		if discovery {
+			v.DiscoveryTX++
+		}
+		if media {
+			v.MediaTX++
+		}
+	}
+	a.peers[endpoint] = v
+}
+
+func (a *directUDPActivity) snapshot() []directUDPObservation {
+	out := []directUDPObservation{}
+	if a == nil {
+		return out
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	cutoff := time.Now().Add(-2 * time.Minute).UnixMilli()
+	for key, v := range a.peers {
+		if lastUDPActivity(v) < cutoff {
+			delete(a.peers, key)
+			continue
+		}
+		out = append(out, v)
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].Endpoint < out[j].Endpoint })
+	return out
+}
+
+type observedDesyncPacketConn struct {
+	net.PacketConn
+	activity *directUDPActivity
+}
+
+func (c *observedDesyncPacketConn) WriteTo(p []byte, addr net.Addr) (int, error) {
+	n, err := c.PacketConn.WriteTo(p, addr)
+	if err == nil {
+		c.activity.observe(p[:n], addr, false)
+	}
+	return n, err
+}
+func (c *observedDesyncPacketConn) ReadFrom(p []byte) (int, net.Addr, error) {
+	n, addr, err := c.PacketConn.ReadFrom(p)
+	if err == nil {
+		c.activity.observe(p[:n], addr, true)
+	}
+	return n, addr, err
+}
+
+func (d *Direct) DesyncUDPProbeEnabled() bool { return d.desyncUDP != nil }
+
+func lastUDPActivity(p directUDPObservation) int64 {
+	if p.LastRXMS > p.LastTXMS {
+		return p.LastRXMS
+	}
+	return p.LastTXMS
+}
