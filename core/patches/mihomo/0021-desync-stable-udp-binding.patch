+func bindingTestServer(t *testing.T) (*net.UDPConn, desyncBindingOwner, func(context.Context) (net.PacketConn, error)) {
+	t.Helper()
+	server, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = server.Close() })
+	go func() {
+		buf := make([]byte, 65535)
+		for {
+			n, from, err := server.ReadFromUDP(buf)
+			if err != nil {
+				return
+			}
+			packet := append([]byte(nil), buf[:n]...)
+			// Library fake datagrams expire before a real remote server; on
+			// loopback this fixture must discard their 64-byte dummy payload.
+			if len(packet) == 64 {
+				continue
+			}
+			if _, ok := desyncDiscovery(packet, 1); ok {
+				binary.BigEndian.PutUint16(packet[:2], 2)
+			}
+			_, _ = server.WriteToUDP(packet, from)
+		}
+	}()
+	owner := desyncBindingOwner{source: netip.MustParseAddr("192.168.20.2"), target: server.LocalAddr().(*net.UDPAddr).AddrPort(), process: "private/Discord.exe", inbound: "tun", route: "interface-A"}
+	factory := func(ctx context.Context) (net.PacketConn, error) {
+		return (&net.ListenConfig{}).ListenPacket(ctx, "udp4", "127.0.0.1:0")
+	}
+	return server, owner, factory
+}
+func bindingDiscovery(id uint32) []byte {
+	p := make([]byte, 74)
+	binary.BigEndian.PutUint16(p[:2], 1)
+	binary.BigEndian.PutUint16(p[2:4], 70)
+	binary.BigEndian.PutUint32(p[4:8], id)
+	return p
+}
+func bindingSession(t *testing.T, p *desyncBindingPool, o desyncBindingOwner, f func(context.Context) (net.PacketConn, error)) *desyncBindingSession {
+	t.Helper()
