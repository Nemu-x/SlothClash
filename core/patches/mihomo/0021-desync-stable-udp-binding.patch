diff --git a/adapter/outbound/direct_desync_binding.go b/adapter/outbound/direct_desync_binding.go
new file mode 100644
index 0000000..17d80a1
--- /dev/null
+++ b/adapter/outbound/direct_desync_binding.go
@@ -0,0 +1,639 @@
+package outbound
+
+import (
+	"context"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"net"
+	"net/netip"
+	"os"
+	"path"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/metacubex/mihomo/component/dialer"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+const (
+	desyncBindingMaxGroups   = 64
+	desyncBindingMaxSessions = 256
+	desyncBindingMaxMembers  = 8
+	desyncBindingQueue       = 64
+	desyncBindingMaxBytes    = 8 << 20
+	desyncBindingIdle        = 90 * time.Second
+)
+
+var errDesyncBindingLimit = errors.New("desync UDP binding limit reached")
+
+// Port is intentionally absent: a Discord association may replace its local
+// port. Discovery SSRC separates simultaneous calls/streams at the same server.
+// These identities remain in memory and are never exposed by diagnostics.
+type desyncBindingOwner struct {
+	source                  netip.Addr
+	target                  netip.AddrPort
+	process, inbound, route string
+	iface                   string
+	uid                     uint32
+}
+
+func (d *Direct) bindingOwner(m *C.Metadata) (desyncBindingOwner, bool) {
+	target := m.AddrPort()
+	process := strings.ReplaceAll(m.Process, `\`, "/")
+	if m.Type != C.TUN || m.NetWork != C.UDP || !strings.EqualFold(path.Base(process), "Discord.exe") || !m.SrcIP.IsValid() || m.SrcIP.IsUnspecified() || m.SrcPort == 0 || !target.IsValid() || !target.Addr().Is4() || !target.Addr().IsGlobalUnicast() || target.Addr().IsPrivate() || target.Port() < 1024 || netip.MustParsePrefix("100.64.0.0/10").Contains(target.Addr()) {
+		return desyncBindingOwner{}, false
+	}
+	if m.ProcessPath != "" {
+		process = strings.ReplaceAll(m.ProcessPath, `\`, "/")
+	}
+	ifaceName := d.iface
+	if ifaceName == "" {
+		ifaceName = dialer.DefaultInterface.Load()
+	}
+	if ifaceName == "" {
+		if finder := dialer.DefaultInterfaceFinder.Load(); finder != nil {
+			ifaceName = finder.FindInterfaceName(target.Addr())
+		}
+	}
+	var addresses []string
+	if ifaceName != "" {
+		if iface, err := net.InterfaceByName(ifaceName); err == nil {
+			if addrs, err := iface.Addrs(); err == nil {
+				for _, a := range addrs {
+					addresses = append(addresses, a.String())
+				}
+			}
+		}
+	}
+	sort.Strings(addresses)
+	return desyncBindingOwner{source: m.SrcIP.Unmap(), target: target, process: strings.ToLower(process), uid: m.Uid, iface: ifaceName,
+		// TUN has no listening port: sing may derive InAddr from a packet
+		// writer. Keep the listener/user identity, not its changing port.
+		inbound: fmt.Sprintf("%d|%s|%s", m.Type, m.InName, m.InUser),
+		route:   fmt.Sprintf("%s|%d|%d|%s", ifaceName, d.rmark, dialer.DefaultRoutingMark.Load(), strings.Join(addresses, ","))}, true
+}
+
+type desyncBindingKey struct {
+	owner   desyncBindingOwner
+	ssrc    uint32
+	private uint64 // non-discovery traffic never shares another association
+}
+
+type desyncBindingStats struct {
+	Enabled        bool   `json:"enabled"`
+	NativeSockets  uint64 `json:"nativeSockets"`
+	ActiveSockets  int    `json:"activeSockets"`
+	Sessions       uint64 `json:"sessions"`
+	ActiveSessions int    `json:"activeSessions"`
+	Reuses         uint64 `json:"reuses"`
+	Handovers      uint64 `json:"handovers"`
+	Dropped        uint64 `json:"dropped"`
+	Errors         uint64 `json:"errors"`
+	QueuedBytes    int    `json:"queuedBytes"`
+}
+
+type desyncBindingPool struct {
+	mu       sync.Mutex // owns all group/session state, never held for packet I/O
+	groups   map[desyncBindingKey]*desyncBindingGroup
+	sessions map[*desyncBindingSession]struct{}
+	stats    desyncBindingStats
+	idle     time.Duration
+	closed   bool
+	done     chan struct{}
+	start    sync.Once
+	wg       sync.WaitGroup
+}
+
+type desyncBindingGroup struct {
+	key       desyncBindingKey
+	pc        net.PacketConn
+	ready     chan struct{}
+	cancel    context.CancelFunc
+	writeGate chan struct{}
+	members   map[*desyncBindingSession]struct{}
+	pending   map[*desyncBindingSession]time.Time
+	active    *desyncBindingSession
+	writing   *desyncBindingSession
+	lastUsed  time.Time
+	detached  time.Time
+	closed    bool
+	err       error
+}
+
+type desyncBindingSession struct {
+	pool          *desyncBindingPool
+	owner         desyncBindingOwner
+	factory       func(context.Context) (net.PacketConn, error)
+	id            uint64
+	group         *desyncBindingGroup
+	queue         chan []byte
+	done          chan struct{}
+	changed       chan struct{}
+	writeChanged  chan struct{}
+	created       time.Time
+	readDeadline  time.Time
+	writeDeadline time.Time
+	closed        bool
+	err           error
+}
+
+func newDesyncBindingPool() *desyncBindingPool {
+	return &desyncBindingPool{groups: make(map[desyncBindingKey]*desyncBindingGroup), sessions: make(map[*desyncBindingSession]struct{}), idle: desyncBindingIdle, done: make(chan struct{})}
+}
+
+func (p *desyncBindingPool) newSession(owner desyncBindingOwner, factory func(context.Context) (net.PacketConn, error)) (net.PacketConn, error) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.closed {
+		return nil, net.ErrClosed
+	}
+	if len(p.sessions) >= desyncBindingMaxSessions {
+		return nil, errDesyncBindingLimit
+	}
+	p.stats.Sessions++
+	s := &desyncBindingSession{pool: p, owner: owner, factory: factory, id: p.stats.Sessions, queue: make(chan []byte, desyncBindingQueue), done: make(chan struct{}), changed: make(chan struct{}), writeChanged: make(chan struct{}), created: time.Now()}
+	p.sessions[s] = struct{}{}
+	p.start.Do(func() { p.wg.Add(1); go p.janitor() })
+	return s, nil
+}
+
+// Discord IP discovery is a 74-byte request/response; only its transient
+// correlation identifier is needed. Payloads are neither changed nor logged.
+func desyncDiscovery(data []byte, kind uint16) (uint32, bool) {
+	if len(data) != 74 || binary.BigEndian.Uint16(data[:2]) != kind || binary.BigEndian.Uint16(data[2:4]) != 70 {
+		return 0, false
+	}
+	return binary.BigEndian.Uint32(data[4:8]), true
+}
+
+func (s *desyncBindingSession) attach(first []byte) (*desyncBindingGroup, error) {
+	p := s.pool
+	p.mu.Lock()
+	if s.closed {
+		err := s.err
+		p.mu.Unlock()
+		return nil, err
+	}
+	if s.group != nil {
+		g := s.group
+		p.mu.Unlock()
+		return g, nil
+	}
+	key := desyncBindingKey{owner: s.owner}
+	if ssrc, ok := desyncDiscovery(first, 1); ok {
+		key.ssrc = ssrc
+	} else {
+		key.private = s.id
+	}
+	g, exists := p.groups[key]
+	if !exists && len(p.groups) >= desyncBindingMaxGroups || exists && len(g.members) >= desyncBindingMaxMembers {
+		p.mu.Unlock()
+		return nil, errDesyncBindingLimit
+	}
+	var ctx context.Context
+	if !exists {
+		deadline := time.Now().Add(5 * time.Second)
+		if !s.writeDeadline.IsZero() && s.writeDeadline.Before(deadline) {
+			deadline = s.writeDeadline
+		}
+		var cancel context.CancelFunc
+		ctx, cancel = context.WithDeadline(context.Background(), deadline)
+		g = &desyncBindingGroup{key: key, ready: make(chan struct{}), writeGate: make(chan struct{}, 1), cancel: cancel, members: make(map[*desyncBindingSession]struct{}), pending: make(map[*desyncBindingSession]time.Time), lastUsed: time.Now()}
+		g.writeGate <- struct{}{}
+		p.groups[key] = g
+		p.wg.Add(1) // include in-flight creation in adapter shutdown
+	} else {
+		p.stats.Reuses++
+	}
+	g.members[s] = struct{}{}
+	g.detached = time.Time{}
+	s.group = g
+	p.mu.Unlock()
+	if exists {
+		return g, nil
+	}
+	defer p.wg.Done()
+	pc, err := s.factory(ctx)
+	g.cancel()
+	p.mu.Lock()
+	if err == nil && pc == nil {
+		err = errors.New("desync UDP binding missing socket")
+	}
+	if err == nil && (p.closed || g.closed) {
+		err = net.ErrClosed
+	}
+	if err == nil {
+		g.pc = pc
+		p.stats.NativeSockets++
+		p.wg.Add(1)
+		go p.receive(g)
+	} else {
+		p.stats.Errors++
+		p.dropGroupLocked(g, err)
+	}
+	close(g.ready)
+	p.mu.Unlock()
+	if err != nil {
+		if pc != nil {
+			_ = pc.Close()
+		}
+		return nil, err
+	}
+	return g, nil
+}
+
+func (s *desyncBindingSession) WriteTo(data []byte, addr net.Addr) (int, error) {
+	if desyncAddrPort(addr) != s.owner.target {
+		return 0, errors.New("desync UDP binding destination changed")
+	}
+	p := s.pool
+	p.mu.Lock()
+	err := s.writeErrorLocked()
+	p.mu.Unlock()
+	if err != nil {
+		return 0, err
+	}
+	g, err := s.attach(data)
+	if err != nil {
+		return 0, err
+	}
+	if err := s.waitWrite(g.ready); err != nil {
+		return 0, err
+	}
+	if err := s.waitWrite(g.writeGate); err != nil {
+		return 0, err
+	}
+	defer func() { g.writeGate <- struct{}{} }()
+	p.mu.Lock()
+	if err := s.writeErrorLocked(); err != nil {
+		p.mu.Unlock()
+		return 0, err
+	}
+	if g.closed {
+		err := g.err
+		p.mu.Unlock()
+		return 0, err
+	}
+	previous := g.active
+	ssrc, discovery := desyncDiscovery(data, 1)
+	if discovery && g.key.private == 0 && ssrc != g.key.ssrc {
+		p.mu.Unlock()
+		return 0, errors.New("desync UDP discovery session changed")
+	}
+	if discovery {
+		g.pending[s] = time.Now().Add(5 * time.Second)
+	} else if previous == nil || s.id > previous.id {
+		g.active = s
+	}
+	g.writing = s
+	deadline := s.writeDeadline
+	if deadline.IsZero() {
+		deadline = time.Now().Add(5 * time.Second)
+	}
+	_ = g.pc.SetWriteDeadline(deadline)
+	p.mu.Unlock()
+	n, err := g.pc.WriteTo(data, net.UDPAddrFromAddrPort(s.owner.target))
+	p.mu.Lock()
+	g.writing = nil
+	if err == nil {
+		g.lastUsed = time.Now()
+		if !discovery && previous != nil && previous != s && g.active == s {
+			p.stats.Handovers++
+		}
+	} else {
+		p.stats.Errors++
+		if discovery {
+			delete(g.pending, s)
+		} else if g.active == s && previous != s {
+			g.active = nil
+			if previous != nil && !previous.closed {
+				g.active = previous
+			}
+		}
+	}
+	p.mu.Unlock()
+	return n, err
+}
+
+func (s *desyncBindingSession) writeErrorLocked() error {
+	if s.closed {
+		return s.err
+	}
+	if !s.writeDeadline.IsZero() && !time.Now().Before(s.writeDeadline) {
+		return os.ErrDeadlineExceeded
+	}
+	return nil
+}
+
+func (s *desyncBindingSession) waitWrite(ready <-chan struct{}) error {
+	for {
+		s.pool.mu.Lock()
+		err, deadline, changed := s.writeErrorLocked(), s.writeDeadline, s.writeChanged
+		s.pool.mu.Unlock()
+		if err != nil {
+			return err
+		}
+		var timer *time.Timer
+		var expires <-chan time.Time
+		if !deadline.IsZero() {
+			timer = time.NewTimer(time.Until(deadline))
+			expires = timer.C
+		}
+		select {
+		case <-ready:
+			if timer != nil {
+				timer.Stop()
+			}
+			return nil
+		case <-s.done:
+		case <-changed:
+		case <-expires:
+		}
+		if timer != nil {
+			timer.Stop()
+		}
+	}
+}
+
+func desyncAddrPort(addr net.Addr) netip.AddrPort {
+	if udp, ok := addr.(*net.UDPAddr); ok && udp != nil {
+		ap := udp.AddrPort()
+		return netip.AddrPortFrom(ap.Addr().Unmap(), ap.Port())
+	}
+	if addr == nil {
+		return netip.AddrPort{}
+	}
+	ap, _ := netip.ParseAddrPort(addr.String())
+	return ap
+}
+
+func (p *desyncBindingPool) receive(g *desyncBindingGroup) {
+	defer p.wg.Done()
+	buffer := make([]byte, 65535)
+	for {
+		n, from, err := g.pc.ReadFrom(buffer)
+		if err != nil {
+			p.mu.Lock()
+			if !g.closed {
+				p.stats.Errors++
+			}
+			p.mu.Unlock()
+			p.fail(g, err)
+			return
+		}
+		p.mu.Lock()
+		if g.closed {
+			p.mu.Unlock()
+			return
+		}
+		if desyncAddrPort(from) != g.key.owner.target {
+			p.stats.Dropped++
+			p.mu.Unlock()
+			continue
+		}
+		g.lastUsed = time.Now()
+		if ssrc, discovery := desyncDiscovery(buffer[:n], 2); discovery {
+			// A shared native address is valid for each waiting owner of this
+			// SSRC. Discovery never steals the current media recipient.
+			if g.key.private != 0 || ssrc == g.key.ssrc {
+				for s, expires := range g.pending {
+					delete(g.pending, s)
+					if time.Now().Before(expires) {
+						p.enqueueLocked(s, buffer[:n])
+					}
+				}
+			}
+		} else if g.active != nil {
+			p.enqueueLocked(g.active, buffer[:n])
+		}
+		p.mu.Unlock()
+	}
+}
+
+func (p *desyncBindingPool) enqueueLocked(s *desyncBindingSession, data []byte) {
+	if s.closed || len(s.queue) == cap(s.queue) || p.stats.QueuedBytes+len(data) > desyncBindingMaxBytes {
+		p.stats.Dropped++
+		return
+	}
+	payload := append([]byte(nil), data...)
+	p.stats.QueuedBytes += len(payload)
+	s.queue <- payload
+}
+
+func (s *desyncBindingSession) ReadFrom(buffer []byte) (int, net.Addr, error) {
+	for {
+		p := s.pool
+		p.mu.Lock()
+		closed, err, deadline, changed := s.closed, s.err, s.readDeadline, s.changed
+		p.mu.Unlock()
+		if closed {
+			return 0, nil, err
+		}
+		var timer *time.Timer
+		var expires <-chan time.Time
+		if !deadline.IsZero() {
+			if !time.Now().Before(deadline) {
+				return 0, nil, os.ErrDeadlineExceeded
+			}
+			timer = time.NewTimer(time.Until(deadline))
+			expires = timer.C
+		}
+		select {
+		case data := <-s.queue:
+			if timer != nil {
+				timer.Stop()
+			}
+			p.mu.Lock()
+			p.stats.QueuedBytes -= len(data)
+			closed, err = s.closed, s.err
+			p.mu.Unlock()
+			if closed {
+				return 0, nil, err
+			}
+			return copy(buffer, data), net.UDPAddrFromAddrPort(s.owner.target), nil
+		case <-s.done:
+		case <-changed:
+		case <-expires:
+		}
+		if timer != nil {
+			timer.Stop()
+		}
+	}
+}
+
+func (s *desyncBindingSession) LocalAddr() net.Addr {
+	s.pool.mu.Lock()
+	defer s.pool.mu.Unlock()
+	if s.group != nil && s.group.pc != nil {
+		return s.group.pc.LocalAddr()
+	}
+	return &net.UDPAddr{IP: net.IPv4zero}
+}
+
+func (s *desyncBindingSession) SetDeadline(t time.Time) error { return s.setDeadline(t, true, true) }
+func (s *desyncBindingSession) SetReadDeadline(t time.Time) error {
+	return s.setDeadline(t, true, false)
+}
+func (s *desyncBindingSession) SetWriteDeadline(t time.Time) error {
+	return s.setDeadline(t, false, true)
+}
+func (s *desyncBindingSession) setDeadline(t time.Time, read, write bool) error {
+	p := s.pool
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if s.closed {
+		return s.err
+	}
+	if read {
+		s.readDeadline = t
+		close(s.changed)
+		s.changed = make(chan struct{})
+	}
+	if write {
+		s.writeDeadline = t
+		close(s.writeChanged)
+		s.writeChanged = make(chan struct{})
+		if g := s.group; g != nil && g.writing == s {
+			return g.pc.SetWriteDeadline(t)
+		}
+	}
+	return nil
+}
+
+func (s *desyncBindingSession) Close() error {
+	s.pool.mu.Lock()
+	defer s.pool.mu.Unlock()
+	s.pool.closeSessionLocked(s, net.ErrClosed)
+	return nil
+}
+
+func (p *desyncBindingPool) closeSessionLocked(s *desyncBindingSession, err error) {
+	if s.closed {
+		return
+	}
+	s.closed, s.err = true, err
+	close(s.done)
+	delete(p.sessions, s)
+	for {
+		select {
+		case data := <-s.queue:
+			p.stats.QueuedBytes -= len(data)
+		default:
+			goto drained
+		}
+	}
+drained:
+	if g := s.group; g != nil {
+		delete(g.members, s)
+		delete(g.pending, s)
+		if g.active == s {
+			g.active = nil
+		}
+		if g.writing == s && g.pc != nil {
+			_ = g.pc.SetWriteDeadline(time.Now())
+		}
+		if len(g.members) == 0 {
+			g.detached = time.Now()
+		}
+	}
+}
+
+func (p *desyncBindingPool) dropGroupLocked(g *desyncBindingGroup, err error) net.PacketConn {
+	if g.closed {
+		return nil
+	}
+	g.closed, g.err = true, err
+	g.cancel()
+	if p.groups[g.key] == g {
+		delete(p.groups, g.key)
+	}
+	for s := range g.members {
+		p.closeSessionLocked(s, err)
+	}
+	return g.pc
+}
+
+func (p *desyncBindingPool) fail(g *desyncBindingGroup, err error) {
+	p.mu.Lock()
+	pc := p.dropGroupLocked(g, err)
+	p.mu.Unlock()
+	if pc != nil {
+		_ = pc.Close()
+	}
+}
+
+func (p *desyncBindingPool) sweep(now time.Time) {
+	var sockets []net.PacketConn
+	p.mu.Lock()
+	for _, g := range p.groups {
+		if (!g.detached.IsZero() && now.Sub(g.detached) > p.idle) || now.Sub(g.lastUsed) > 2*p.idle {
+			if pc := p.dropGroupLocked(g, net.ErrClosed); pc != nil {
+				sockets = append(sockets, pc)
+			}
+		}
+	}
+	for s := range p.sessions {
+		if s.group == nil && now.Sub(s.created) > p.idle {
+			p.closeSessionLocked(s, net.ErrClosed)
+		}
+	}
+	p.mu.Unlock()
+	for _, pc := range sockets {
+		_ = pc.Close()
+	}
+}
+
+func (p *desyncBindingPool) janitor() {
+	defer p.wg.Done()
+	ticker := time.NewTicker(15 * time.Second)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-p.done:
+			return
+		case now := <-ticker.C:
+			p.sweep(now)
+		}
+	}
+}
+
+func (p *desyncBindingPool) snapshot() desyncBindingStats {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	out := p.stats
+	out.Enabled, out.ActiveSessions = true, len(p.sessions)
+	for _, g := range p.groups {
+		if g.pc != nil && !g.closed {
+			out.ActiveSockets++
+		}
+	}
+	return out
+}
+
+func (p *desyncBindingPool) Close() error {
+	p.mu.Lock()
+	if !p.closed {
+		p.closed = true
+		close(p.done)
+		var sockets []net.PacketConn
+		for _, g := range p.groups {
+			if pc := p.dropGroupLocked(g, net.ErrClosed); pc != nil {
+				sockets = append(sockets, pc)
+			}
+		}
+		for s := range p.sessions {
+			p.closeSessionLocked(s, net.ErrClosed)
+		}
+		p.mu.Unlock()
+		for _, pc := range sockets {
+			_ = pc.Close()
+		}
+	} else {
+		p.mu.Unlock()
+	}
+	p.wg.Wait()
+	return nil
+}
