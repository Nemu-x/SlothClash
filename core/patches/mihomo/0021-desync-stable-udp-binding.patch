+	close(release)
+	if !errors.Is(err, os.ErrDeadlineExceeded) {
+		t.Fatal(err)
+	}
+	if e := <-done; e != nil {
+		t.Fatal(e)
+	}
+}
+
+func TestDesyncBindingNativeGroupLimit(t *testing.T) {
+	_, o, f := bindingTestServer(t)
+	p := newDesyncBindingPool()
+	defer p.Close()
+	for i := 0; i <= desyncBindingMaxGroups; i++ {
+		owner := o
+		owner.uid = uint32(i)
+		c := bindingSession(t, p, owner, f)
+		_, err := c.WriteTo(bindingDiscovery(6), net.UDPAddrFromAddrPort(o.target))
+		if i < desyncBindingMaxGroups && err != nil {
+			t.Fatal(err)
+		}
+		if i == desyncBindingMaxGroups && !errors.Is(err, errDesyncBindingLimit) {
+			t.Fatal(err)
+		}
+	}
+	if p.snapshot().NativeSockets != desyncBindingMaxGroups {
+		t.Fatal(p.snapshot())
+	}
+}
+
+func TestDesyncBindingSustainedCorePacketConn(t *testing.T) {
+	if testing.Short() {
+		t.Skip("75-second native transport test runs in complete core validation")
+	}
+	_, o, f := bindingTestServer(t)
+	p := newDesyncBindingPool()
+	defer p.Close()
+	d := NewDirect()
+	factory := func(ctx context.Context) (net.PacketConn, error) {
+		pc, e := f(ctx)
+		if e != nil {
+			return nil, e
+		}
+		return d.loopBack.NewPacketConn(NewPacketConn(&directDesyncPacketConn{PacketConn: pc}, d)), nil
+	}
+	c := bindingSession(t, p, o, factory)
+	bindingRoundtrip(t, c, o.target, bindingDiscovery(999))
+	bindingRoundtrip(t, c, o.target, []byte("initial"))
+	native := c.LocalAddr().String()
+	started := time.Now()
+	switched := false
+	packets := 0
+	for time.Since(started) < 75*time.Second {
+		if !switched && time.Since(started) > 60*time.Second {
+			next := bindingSession(t, p, o, factory)
+			bindingRoundtrip(t, next, o.target, bindingDiscovery(999))
+			bindingRoundtrip(t, next, o.target, []byte("handover"))
+			_ = c.Close()
+			c = next
+			switched = true
+			if c.LocalAddr().String() != native {
+				t.Fatal("native address changed at minute boundary")
+			}
+		}
+		bindingRoundtrip(t, c, o.target, bytes.Repeat([]byte{byte(packets)}, 1024))
+		packets++
+		time.Sleep(20 * time.Millisecond)
+	}
+	if !switched || p.snapshot().NativeSockets != 1 || p.snapshot().Handovers != 1 || packets < 2000 {
+		t.Fatalf("sustained path not exercised: packets=%d stats=%+v", packets, p.snapshot())
+	}
+	t.Logf("one native socket, %d unchanged datagrams, handover after60s, total=%s", packets, time.Since(started))
+}
