+func TestDesyncBindingHandoverKeepsNativeSocketAndSeparatesDiscovery(t *testing.T) {
+	server, owner, factory := bindingTestServer(t)
+	p := newDesyncBindingPool()
+	defer p.Close()
+	old := bindingSession(t, p, owner, factory)
+	bindingRoundtrip(t, old, owner.target, bindingDiscovery(1234))
+	bindingRoundtrip(t, old, owner.target, []byte("initial video feedback"))
+	native := bindingNative(old)
+	next := bindingSession(t, p, owner, factory)
+	bindingRoundtrip(t, next, owner.target, bindingDiscovery(1234))
+	if bindingNative(next) != native {
+		t.Fatal("discovery replaced external socket")
+	}
+	_, _ = server.WriteToUDP([]byte("old recipient until media handover"), net.UDPAddrFromAddrPort(native))
+	_ = old.SetReadDeadline(time.Now().Add(time.Second))
+	b := make([]byte, 100)
+	n, _, err := old.ReadFrom(b)
+	if err != nil || string(b[:n]) != "old recipient until media handover" {
+		t.Fatal("discovery stole media", err)
+	}
+	bindingRoundtrip(t, next, owner.target, []byte("new recipient"))
+	// Late packets from an older association must not steal return traffic.
+	_, _ = old.WriteTo([]byte("late control"), net.UDPAddrFromAddrPort(owner.target))
+	_ = next.SetReadDeadline(time.Now().Add(time.Second))
+	n, _, err = next.ReadFrom(b)
+	if err != nil || string(b[:n]) != "late control" {
+		t.Fatal("old control stole new recipient", err)
+	}
+	_ = old.Close()
+	bindingRoundtrip(t, next, owner.target, []byte("after old closes"))
+	if bindingNative(next) != native {
+		t.Fatal("old close replaced native port")
+	}
+	stats := p.snapshot()
+	if stats.NativeSockets != 1 || stats.Reuses != 1 || stats.Handovers != 1 || stats.Errors != 0 {
+		t.Fatalf("unexpected binding counters: %+v", stats)
+	}
