+func bindingRoundtrip(t *testing.T, c net.PacketConn, target netip.AddrPort, data []byte) {
+	t.Helper()
+	_ = c.SetReadDeadline(time.Now().Add(2 * time.Second))
+	if _, e := c.WriteTo(data, net.UDPAddrFromAddrPort(target)); e != nil {
+		t.Fatal(e)
+	}
+	buf := make([]byte, 65535)
+	n, from, e := c.ReadFrom(buf)
+	if e != nil {
+		t.Fatal(e)
+	}
+	expected := append([]byte(nil), data...)
+	if _, ok := desyncDiscovery(expected, 1); ok {
+		binary.BigEndian.PutUint16(expected[:2], 2)
+	}
+	if !bytes.Equal(buf[:n], expected) || desyncAddrPort(from) != target {
+		t.Fatalf("datagram changed: n=%d", n)
+	}
+	_ = c.SetReadDeadline(time.Time{})
+}
