+++ b/adapter/outbound/direct_desync_reserve_test.go
@@ -0,0 +1,34 @@
+package outbound
+
+import (
+	"context"
+	"io"
+	"testing"
+
+	C "github.com/metacubex/mihomo/constant"
+)
+
+func TestDesyncRejectQUICIsOptInAndPrecedesDNSAndSocket(t *testing.T) {
+	d, err := NewDirectWithDesyncOption(DirectOption{Name: "test", Desync: &DirectDesyncOption{TLSRec: "1+s", RejectQUIC: true}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer d.Close()
+	m := &C.Metadata{NetWork: C.UDP, Host: "must-not-resolve.invalid", DstPort: 443}
+	pc, err := d.ListenPacketContext(context.Background(), m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer pc.Close()
+	if _, _, err = pc.ReadFrom(make([]byte, 1)); err != io.EOF {
+		t.Fatal("targeted QUIC was not rejected")
+	}
+	ordinary := NewDirect()
+	defer ordinary.Close()
+	if ordinary.desyncRejectQUIC {
+		t.Fatal("ordinary DIRECT behavior changed")
+	}
+	if m.Host != "must-not-resolve.invalid" {
+		t.Fatal("metadata host changed")
+	}
+}
diff --git a/hub/route/desync_profile.go b/hub/route/desync_profile.go
new file mode 100644
index 0000000..36ff06d
--- /dev/null
+++ b/hub/route/desync_profile.go
@@ -0,0 +1,208 @@
+package route
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net"
+	"net/netip"
+	"net/url"
+	"path"
+	"strings"
+	"time"
+
+	"github.com/metacubex/chi/render"
+	"github.com/metacubex/http"
+	"github.com/metacubex/mihomo/component/ca"
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/tunnel"
+	"github.com/metacubex/mihomo/tunnel/statistic"
+)
+
+var desyncProfileProbeSlots = make(chan struct{}, 2)
+
+type desyncProfileProbeResult struct {
+	OK                    bool   `json:"ok"`
+	Route                 string `json:"route"`
+	Code                  string `json:"code,omitempty"`
+	DurationMS            int64  `json:"durationMS"`
+	*desyncUDPProbeResult `json:",omitempty"`
+}
+
+func observedDiscordMetadata(target netip.AddrPort, allowProfile bool) *C.Metadata {
+	if !target.IsValid() || !target.Addr().IsGlobalUnicast() || target.Addr().IsPrivate() || netip.MustParsePrefix("100.64.0.0/10").Contains(target.Addr()) || target.Port() < 1024 {
+		return nil
+	}
+	var found *C.Metadata
+	statistic.DefaultManager.Range(func(c statistic.Tracker) bool {
+		info := c.Info()
+		m := info.Metadata
+		if m == nil || m.NetWork != C.UDP || !strings.EqualFold(path.Base(strings.ReplaceAll(m.Process, `\`, "/")), "Discord.exe") || m.DstIP.Unmap() != target.Addr().Unmap() || m.DstPort != target.Port() {
+			return true
+		}
+		owned := allowProfile
+		for _, name := range info.Chain {
+			if name == "SLOTH-DESYNC-DISCORD-UDP" {
+				owned = true
+			}
+		}
+		if owned {
+			copy := *m
+			found = &copy
+			return false
+		}
+		return true
+	})
+	return found
+}
+
+// Return a privacy-safe category. A DIRECT/REJECT rule is never described as
+// a working VPN. UDP support must be present at each selected group/leaf.
+func desyncProfileKind(p C.Proxy, m *C.Metadata) string {
+	seen := map[string]bool{}
+	for depth := 0; p != nil && depth < 16; depth++ {
+		if seen[p.Name()] {
+			return "unavailable"
+		}
+		seen[p.Name()] = true
+		if m.NetWork == C.UDP && !p.SupportUDP() {
+			return "no_udp"
+		}
+		switch p.Type() {
+		case C.Direct, C.Compatible:
+			return "direct"
+		case C.Reject, C.RejectDrop, C.Pass, C.PassRule, C.Rematch, C.Dns:
+			return "blocked"
+		}
+		next := p.Unwrap(m, false)
+		if next == nil {
+			return "remote"
+		}
+		p = next
+	}
+	return "unavailable"
+}
+
+func probeDesyncProfile(w http.ResponseWriter, r *http.Request) {
+	proxy := r.Context().Value(CtxKeyProxy).(C.Proxy)
+	var req struct {
+		Target string `json:"target,omitempty"`
+	}
+	d := json.NewDecoder(io.LimitReader(r.Body, 1024))
+	d.DisallowUnknownFields()
+	err := d.Decode(&req)
+	var extra any
+	trailing := d.Decode(&extra)
+	name := proxy.Name()
+	if err != nil || trailing != io.EOF || proxy.Type() != C.Selector || (name != "SLOTH-DESYNC-YOUTUBE" && name != "SLOTH-DESYNC-DISCORD" && name != "SLOTH-DESYNC-DISCORD-UDP") || (name != "SLOTH-DESYNC-DISCORD-UDP" && req.Target != "") {
+		render.Status(r, http.StatusBadRequest)
+		render.JSON(w, r, newError("expected an owned service selector"))
+		return
+	}
+	select {
+	case desyncProfileProbeSlots <- struct{}{}:
+		defer func() { <-desyncProfileProbeSlots }()
+	default:
+		render.Status(r, 429)
+		render.JSON(w, r, newError("profile probe busy"))
+		return
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 16*time.Second)
+	defer cancel()
+	start := time.Now()
+	out := desyncProfileProbeResult{Route: "unavailable"}
+	defer func() { out.DurationMS = time.Since(start).Milliseconds(); render.JSON(w, r, out) }()
+	if name == "SLOTH-DESYNC-DISCORD-UDP" {
+		target, err := netip.ParseAddrPort(req.Target)
+		if err != nil {
+			out.Code = "endpoint_changed"
+			return
+		}
+		m := observedDiscordMetadata(target, true)
+		if m == nil {
+			out.Code = "endpoint_changed"
+			return
+		}
+		p, err := tunnel.ResolveDesyncProfile(ctx, m)
+		if err != nil {
+			out.Code = "profile_unavailable"
+			return
+		}
+		out.Route = desyncProfileKind(p, m)
+		if out.Route != "remote" {
+			out.Code = "reserve_" + out.Route
+			return
+		}
+		if !desyncUDPProbeBusy.CompareAndSwap(false, true) {
+			out.Code = "busy"
+			return
+		}
+		defer desyncUDPProbeBusy.Store(false)
+		m.Type = C.INNER // synthetic discovery never enters application telemetry
+		pc, err := p.ListenPacketContext(ctx, m)
+		if err != nil {
+			out.Code = "reserve_socket"
+			return
+		}
+		defer pc.Close()
+		result, err := runDesyncUDPProbe(ctx, pc, target)
+		out.desyncUDPProbeResult = &result
+		out.OK = err == nil && result.Sent == 12 && result.Received >= 10 && result.MaxConsecutiveLoss <= 1 && result.DurationMS >= 1500
+		if !out.OK {
+			out.Code = "reserve_udp_loss"
+		}
+		return
+	}
+	targets := []string{"https://www.youtube.com/generate_204"}
+	if name == "SLOTH-DESYNC-DISCORD" {
+		targets = []string{"https://discord.com/api/v10/gateway", "https://cdn.discordapp.com/embed/avatars/0.png"}
+	}
+	for _, target := range targets {
+		u, _ := url.Parse(target)
+		m := &C.Metadata{NetWork: C.TCP, Type: C.INNER, Host: u.Hostname(), DstPort: 443}
+		if name == "SLOTH-DESYNC-DISCORD" {
+			m.Process = "Discord.exe"
+		}
+		p, err := tunnel.ResolveDesyncProfile(ctx, m)
+		if err != nil {
+			out.Code = "profile_unavailable"
+			return
+		}
+		out.Route = desyncProfileKind(p, m)
+		if out.Route != "remote" {
+			out.Code = "reserve_" + out.Route
+			return
+		}
+		one, cancel := context.WithTimeout(ctx, 6*time.Second)
+		err = desyncProfileHTTPS(one, p, m, target)
+		cancel()
+		if err != nil {
+			out.Code = "reserve_https"
+			return
+		}
+	}
+	out.OK = true
+}
+
+func desyncProfileHTTPS(ctx context.Context, p C.Proxy, m *C.Metadata, target string) error {
+	tlsConfig, err := ca.GetTLSConfig(ca.Option{})
+	if err != nil {
+		return err
+	}
+	transport := &http.Transport{DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) { copy := *m; return p.DialContext(ctx, &copy) }, TLSClientConfig: tlsConfig, DisableKeepAlives: true, TLSHandshakeTimeout: 5 * time.Second}
+	defer transport.CloseIdleConnections()
+	client := &http.Client{Transport: transport, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	req, err := http.NewRequestWithContext(ctx, http.MethodHead, target, nil)
+	if err != nil {
+		return err
+	}
+	resp, err := client.Do(req)
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return io.ErrUnexpectedEOF
+	}
+	return nil
+}
