+)
+
+type reserveTestProxy struct {
+	C.Proxy
+	name    string
+	kind    C.AdapterType
+	udp     bool
+	leaf    C.Proxy
+	address string
+}
+
+func (p *reserveTestProxy) Name() string                     { return p.name }
+func (p *reserveTestProxy) Type() C.AdapterType              { return p.kind }
+func (p *reserveTestProxy) Addr() string                     { return p.address }
+func (p *reserveTestProxy) ProxyInfo() C.ProxyInfo           { return C.ProxyInfo{} }
+func (p *reserveTestProxy) SupportUDP() bool                 { return p.udp }
+func (p *reserveTestProxy) Unwrap(*C.Metadata, bool) C.Proxy { return p.leaf }
+func (p *reserveTestProxy) DialContext(ctx context.Context, m *C.Metadata) (C.Conn, error) {
+	c, err := (&net.Dialer{}).DialContext(ctx, "tcp", p.address)
+	if err != nil {
+		return nil, err
+	}
+	return outbound.NewConn(c, p), nil
+}
+
+func TestDesyncProfileProbeVerifiesFixedHTTPSWithoutMutatingSelector(t *testing.T) {
+	key, _ := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	cert := &x509.Certificate{SerialNumber: big.NewInt(42), Subject: pkix.Name{CommonName: "local-reserve-test"}, DNSNames: []string{"www.youtube.com", "discord.com", "cdn.discordapp.com"}, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour), KeyUsage: x509.KeyUsageDigitalSignature | x509.KeyUsageCertSign, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}, BasicConstraintsValid: true, IsCA: true}
+	der, err := x509.CreateCertificate(rand.Reader, cert, cert, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = ca.AddCertificate(string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}))); err != nil {
+		t.Fatal(err)
+	}
+	defer ca.ResetCertificate()
+	status := 204
+	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(status) }))
+	server.TLS = &tls.Config{Certificates: []tls.Certificate{{Certificate: [][]byte{der}, PrivateKey: key}}}
+	server.StartTLS()
+	defer server.Close()
+	remote := &reserveTestProxy{name: "private-subscription-name", kind: C.Socks5, udp: true, address: server.Listener.Addr().String()}
+	group := &reserveTestProxy{name: "SLOTH-DESYNC-YOUTUBE", kind: C.Selector, udp: true, leaf: adapter.NewProxy(outbound.NewDirect())}
+	oldProxies, oldRules, oldMode := tunnel.Proxies(), tunnel.Rules(), tunnel.Mode()
+	defer func() {
+		tunnel.UpdateProxies(oldProxies, nil)
+		tunnel.UpdateRules(oldRules, nil, nil)
+		tunnel.SetMode(oldMode)
+	}()
+	match, _ := R.ParseRule("MATCH", "", remote.Name(), nil, nil)
+	tunnel.UpdateProxies(map[string]C.Proxy{group.Name(): group, remote.Name(): remote}, nil)
+	tunnel.UpdateRules([]C.Rule{match}, nil, nil)
+	tunnel.SetMode(tunnel.Rule)
+	call := func(body string) desyncProfileProbeResult {
+		t.Helper()
+		req := httptest.NewRequest("POST", "/", strings.NewReader(body))
+		req = req.WithContext(context.WithValue(req.Context(), CtxKeyProxy, group))
+		w := httptest.NewRecorder()
+		probeDesyncProfile(w, req)
+		if w.Code != 200 {
+			t.Fatalf("HTTP %d: %s", w.Code, w.Body.String())
+		}
+		if strings.Contains(w.Body.String(), remote.Name()) {
+			t.Fatal("subscription name leaked")
+		}
+		var out desyncProfileProbeResult
+		if err := json.Unmarshal(w.Body.Bytes(), &out); err != nil {
+			t.Fatal(err)
+		}
+		return out
+	}
+	if out := call(`{}`); !out.OK || out.Route != "remote" {
+		t.Fatalf("working reserve rejected: %+v", out)
+	}
+	if group.leaf.Type() != C.Direct {
+		t.Fatal("prospective probe selected the reserve")
+	}
+	status = 503
+	if out := call(`{}`); out.OK || out.Code != "reserve_https" {
+		t.Fatal("HTTP error counted as success")
+	}
+	remote.kind = C.Direct
+	if out := call(`{}`); out.OK || out.Code != "reserve_direct" {
+		t.Fatal("DIRECT advertised as VPN")
+	}
+}
+
+func TestDesyncReserveRejectsUnknownTargetsAndUnsuitableUDP(t *testing.T) {
+	m := &C.Metadata{NetWork: C.UDP}
+	for _, test := range []struct {
+		p    *reserveTestProxy
+		kind string
+	}{
+		{&reserveTestProxy{name: "direct", kind: C.Direct, udp: true}, "direct"},
+		{&reserveTestProxy{name: "reject", kind: C.Reject, udp: true}, "blocked"},
+		{&reserveTestProxy{name: "tcp-only", kind: C.Socks5}, "no_udp"},
+	} {
+		if got := desyncProfileKind(test.p, m); got != test.kind {
+			t.Fatalf("got %s", got)
+		}
+	}
+	for _, target := range []string{"127.0.0.1:19330", "100.64.1.1:19330", "104.29.1.1:19330", "104.29.1.1:443"} {
+		if observedDiscordMetadata(netip.MustParseAddrPort(target), true) != nil {
+			t.Fatal("unobserved/private target accepted")
+		}
+	}
+	group := &reserveTestProxy{name: "SLOTH-DESYNC-YOUTUBE", kind: C.Selector}
+	for _, body := range []string{`{"target":"https://private.test"}`, `{"url":"https://private.test"}`, `{} {}`, `[]`} {
+		req := httptest.NewRequest("POST", "/", strings.NewReader(body))
+		req = req.WithContext(context.WithValue(req.Context(), CtxKeyProxy, group))
+		w := httptest.NewRecorder()
+		probeDesyncProfile(w, req)
+		if w.Code != 400 {
+			t.Fatal("arbitrary target/body accepted")
+		}
+	}
+}
+
+func TestDesyncRecoveryProbeAcceptsProfileEndpointOnlyDuringReserve(t *testing.T) {
+	old := tunnel.Proxies()
+	defer tunnel.UpdateProxies(old, nil)
+	group := &reserveTestProxy{name: "SLOTH-DESYNC-DISCORD-UDP", kind: C.Selector, leaf: adapter.NewProxy(outbound.NewDirect())}
+	tunnel.UpdateProxies(map[string]C.Proxy{group.Name(): group}, nil)
+	target := netip.MustParseAddrPort("104.29.2.2:19330")
+	tracker := &observedDiscordTracker{info: &statistic.TrackerInfo{Metadata: &C.Metadata{NetWork: C.UDP, Process: "Discord.exe", DstIP: target.Addr(), DstPort: target.Port()}, Chain: C.Chain{"profile"}}}
+	statistic.DefaultManager.Join(tracker)
+	defer statistic.DefaultManager.Leave(tracker)
+	if allowedDiscordEndpoint(target) {
+		t.Fatal("profile endpoint accepted outside reserve")
+	}
+	group.leaf = adapter.NewProxy(outbound.NewPass())
+	if !allowedDiscordEndpoint(target) {
+		t.Fatal("active profile endpoint unavailable to recovery")
+	}
+}
