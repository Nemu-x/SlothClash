diff --git a/tunnel/desync_profile.go b/tunnel/desync_profile.go
new file mode 100644
index 0000000..48916fa
--- /dev/null
+++ b/tunnel/desync_profile.go
@@ -0,0 +1,43 @@
+package tunnel
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/metacubex/mihomo/component/resolver"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+func desyncOverlayRoute(name string) bool {
+	return name == "SLOTH-DESYNC-YOUTUBE" || name == "SLOTH-DESYNC-DISCORD" || name == "SLOTH-DESYNC-DISCORD-UDP"
+}
+
+// ResolveDesyncProfile is prospective: it never changes a selector. Only the
+// generated overlay targets are skipped; rule providers, process/IP rules,
+// nested PASS and corporate/inbound rules keep the normal matcher semantics.
+// The caller supplies synthetic service metadata or a copy of observed UDP
+// metadata. Never look up the probe socket's own process as the application.
+func ResolveDesyncProfile(ctx context.Context, metadata *C.Metadata) (C.Proxy, error) {
+	if Mode() != Rule || metadata.SpecialProxy != "" {
+		return nil, fmt.Errorf("profile reserve requires rule mode")
+	}
+	helper := C.RuleMatchHelper{
+		ResolveIP: func() {
+			if metadata.Host != "" && !metadata.Resolved() && ctx.Err() == nil {
+				if ip, err := resolver.ResolveIP(ctx, metadata.Host); err == nil {
+					metadata.DstIP = ip
+				}
+			}
+		},
+		CheckPassRule: func(name string) bool {
+			for p, depth := proxies[name], 0; p != nil && depth < 16; p, depth = p.Unwrap(metadata, false), depth+1 {
+				if p.Type() == C.PassRule {
+					return true
+				}
+			}
+			return false
+		},
+	}
+	p, _, err := matchRules(metadata, helper, true)
+	return p, err
+}
