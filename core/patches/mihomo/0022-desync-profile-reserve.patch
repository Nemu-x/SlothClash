+
+func (p *desyncRuleProxy) Name() string                     { return p.name }
+func (p *desyncRuleProxy) Type() C.AdapterType              { return p.kind }
+func (p *desyncRuleProxy) SupportUDP() bool                 { return true }
+func (p *desyncRuleProxy) Unwrap(*C.Metadata, bool) C.Proxy { return p.leaf }
+
+func TestDesyncProfileUsesFullOriginalRuleOrderAndPASS(t *testing.T) {
+	oldProxies, oldRules, oldSub, oldMode := proxies, rules, subRules, mode
+	defer func() { proxies = oldProxies; rules = oldRules; subRules = oldSub; mode = oldMode }()
+	pass := &desyncRuleProxy{name: "PASS", kind: C.Pass}
+	direct := &desyncRuleProxy{name: "DIRECT", kind: C.Direct}
+	reject := &desyncRuleProxy{name: "REJECT", kind: C.Reject}
+	selector := &desyncRuleProxy{name: "SLOTH-DESYNC-DISCORD-UDP", kind: C.Selector, leaf: direct}
+	proxies = map[string]C.Proxy{"DIRECT": direct, "REJECT": reject, "PASS": pass, selector.Name(): selector}
+	mode = Rule
+	parse := func(tp, payload, target string) C.Rule {
+		r, err := R.ParseRule(tp, payload, target, nil, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return r
+	}
+	rules = []C.Rule{parse("IN-NAME", "corporate", "REJECT"), parse("NETWORK", "udp", selector.Name()), parse("PROCESS-NAME", "Discord.exe", "REJECT"), parse("MATCH", "", "DIRECT")}
+	m := &C.Metadata{Type: C.TUN, NetWork: C.UDP, Process: "Discord.exe", DstIP: netip.MustParseAddr("104.29.1.1"), DstPort: 19299}
+	p, _, err := match(m, C.RuleMatchHelper{})
+	if err != nil || p.Name() != selector.Name() {
+		t.Fatal("normal Desync route changed")
+	}
+	p, err = ResolveDesyncProfile(context.Background(), m.Clone())
+	if err != nil || p.Type() != C.Reject {
+		t.Fatalf("original process rule was lost: %v %v", p, err)
+	}
+	if selector.leaf != direct {
+		t.Fatal("prospective probe mutated selection")
+	}
+	selector.leaf = pass
+	p, _, err = match(m, C.RuleMatchHelper{})
+	if err != nil || p.Type() != C.Reject {
+		t.Fatal("PASS did not restore original profile matching")
+	}
+	m.InName = "corporate"
+	p, err = ResolveDesyncProfile(context.Background(), m.Clone())
+	if err != nil || p.Type() != C.Reject {
+		t.Fatal("corporate precedence lost")
+	}
+	m.InName = ""
+	m.Process = "Other.exe"
+	p, err = ResolveDesyncProfile(context.Background(), m.Clone())
+	if err != nil || p.Type() != C.Direct {
+		t.Fatal("ordinary direct profile was not retained")
+	}
+	mode = Global
+	if _, err = ResolveDesyncProfile(context.Background(), m); err == nil {
+		t.Fatal("global mode accepted")
+	}
+}
