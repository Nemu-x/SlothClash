+)
+
+func TestParseDesync(t *testing.T) {
+	p, err := ParseProxy(map[string]any{
+		"name":           "desync-yt",
+		"type":           "desync",
+		"tlsrec":         "1+s",
+		"split":          2, // a YAML number is a single position
+		"split-delay":    5,
+		"interface-name": "",
+		"routing-mark":   0,
+		"ip-version":     "ipv4-prefer",
+		"dns-fallback":   true,
+		"reject-quic":    true,
+		"random": map[string]any{
+			"tlsrec": []any{map[string]any{"from": "-8+s", "to": "8+s", "count": 2, "min-piece": 2}},
+			"split":  []any{map[string]any{"from": 1, "to": 120}},
+			"seed":   42,
+		},
+	})
+	require.NoError(t, err)
+	assert.Equal(t, "desync-yt", p.Name())
+	assert.Equal(t, C.Desync, p.Type())
+	assert.Equal(t, "Desync", p.Type().String())
+	assert.True(t, p.SupportUDP())
+
+	raw, err := json.Marshal(p)
+	require.NoError(t, err)
+	var v map[string]any
+	require.NoError(t, json.Unmarshal(raw, &v))
+	assert.Equal(t, "Desync", v["type"])
+	assert.Equal(t, "desync-yt", v["name"])
+	assert.Equal(t, true, v["udp"], "UDP is supported, plain without udp options")
+	info, _ := v["desync"].(map[string]any)
+	assert.Equal(t, "static", info["strategy"])
+	assert.Equal(t, true, info["dns-fallback"])
+	assert.Equal(t, true, info["reject-quic"])
+	tcp, _ := info["tcp"].(map[string]any)
+	assert.Equal(t, []any{"1+s"}, tcp["tlsrec"])
+	assert.Equal(t, []any{"2"}, tcp["split"])
+	assert.EqualValues(t, 5, tcp["split-delay"])
+	random, _ := tcp["random"].(map[string]any)
+	assert.EqualValues(t, 42, random["seed"])
+	assert.Equal(t, []any{map[string]any{"from": "1", "to": "120", "count": 0.0, "min-piece": 0.0}}, random["split"])
+	assert.Contains(t, info, "udp")
+	assert.Nil(t, info["udp"])
+}
+
+// The options that exist only on some OSes, in their YAML form.
+func TestParseDesyncPlatformMethods(t *testing.T) {
+	caps := desync.PlatformCapabilities()
+	for _, tc := range []struct {
+		ok      bool
+		is      error
+		mapping map[string]any
+	}{
+		{caps.FakeTCP, desync.ErrFakeUnsupported, map[string]any{"split": "1+s", "disorder": true,
+			"fake": map[string]any{"ttl": 4, "prefix": -1, "timeout": 3000, "sni": []any{"www.example.com", "cdn-##.example.net"}, "randomize": true, "offset": 0}}},
+		{caps.FakeUDP, desync.ErrUDPFakeUnsupported, map[string]any{"tlsrec": "1+s",
+			"udp": map[string]any{"ttl": 4, "repeats": 6, "packets": 3, "template": "quic-initial", "sni": "www.example.com", "quic-only": true, "stable-binding": true}}},
+		{caps.Ack.Sent, desync.ErrSplitWaitUnsupported, map[string]any{"split": "1+s", "split-wait": "sent", "split-wait-timeout": 1000}},
+		{caps.OOB && caps.Disorder.Supported, desync.ErrOOBUnsupported, map[string]any{"split": "1+s", "disorder": true, "oob": true, "oob-byte": "a"}},
+	} {
+		tc.mapping["name"], tc.mapping["type"] = "platform", "desync"
+		_, err := ParseProxy(tc.mapping)
+		if tc.ok {
+			assert.NoError(t, err, "%v", tc.mapping)
+		} else {
+			assert.Error(t, err, "%v", tc.mapping)
+		}
+	}
+}
+
+func TestParseDesyncInvalid(t *testing.T) {
+	for name, extra := range map[string]map[string]any{
+		"no method":    {},
+		"bad position": {"tlsrec": "1+x"},
+		"long delay":   {"split": "2", "split-delay": 5000},
+		"tfo":          {"tlsrec": "1+s", "tfo": true},
+		"mptcp":        {"tlsrec": "1+s", "mptcp": true},
+		"dialer-proxy": {"tlsrec": "1+s", "dialer-proxy": "vpn"},
+		"fake ttl":     {"tlsrec": "1+s", "fake": map[string]any{"ttl": 999}},
+		"fake sni":     {"fake": map[string]any{"ttl": 4, "sni": "not-a-list.example"}},
+		"udp repeats":  {"udp": map[string]any{"ttl": 4, "repeats": 100}},
+		"split-wait":   {"split": "2", "split-wait": "soon"},
+		"random":       {"random": map[string]any{"tlsrec": "1..8"}},
+	} {
+		mapping := map[string]any{"name": name, "type": "desync"}
+		for k, v := range extra {
+			mapping[k] = v
+		}
+		_, err := ParseProxy(mapping)
+		assert.Error(t, err, name)
+	}
+}
+
+// The legacy direct.desync form of patches 0017-0022 still loads next to
+// the new type, unchanged.
+func TestParseDirectDesyncStillLoads(t *testing.T) {
+	p, err := ParseProxy(map[string]any{"name": "SLOTH-DESYNC-YOUTUBE-1", "type": "direct",
+		"desync": map[string]any{"tlsrec": "1+s", "split": "1+s", "split-delay-ms": 5, "dns-fallback": true, "reject-quic": true}})
+	require.NoError(t, err)
