@@ -0,0 +1,118 @@
+package tunnel_test
+
+import (
+	"context"
+	"crypto/tls"
+	"encoding/binary"
+	"io"
+	"net"
+	"net/netip"
+	"strconv"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/adapter"
+	"github.com/metacubex/mihomo/adapter/outbound"
+	C "github.com/metacubex/mihomo/constant"
+	R "github.com/metacubex/mihomo/rules"
+	"github.com/metacubex/mihomo/tunnel"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// firstRecord reads the first TLS record of the connection ln accepts and
+// reports whether it holds the whole ClientHello.
+func firstRecord(ln net.Listener) <-chan bool {
+	whole := make(chan bool, 1)
+	go func() {
+		c, err := ln.Accept()
+		if err != nil {
+			close(whole)
+			return
+		}
+		defer c.Close()
+		_ = c.SetDeadline(time.Now().Add(5 * time.Second))
+		header := make([]byte, 5)
+		if _, err := io.ReadFull(c, header); err != nil || header[0] != 0x16 {
+			close(whole)
+			return
+		}
+		body := make([]byte, binary.BigEndian.Uint16(header[3:]))
+		if _, err := io.ReadFull(c, body); err != nil {
+			close(whole)
+			return
+		}
+		whole <- len(body) >= 4 && len(body) >= 4+(int(body[1])<<16|int(body[2])<<8|int(body[3]))
+	}()
+	return whole
+}
+
+// routeHello sends a ClientHello for host through the tunnel to ln.
+func routeHello(t *testing.T, ln net.Listener, host string) <-chan bool {
+	t.Helper()
+	whole := firstRecord(ln)
+	client, server := net.Pipe()
+	t.Cleanup(func() { _ = client.Close() })
+	ap := ln.Addr().(*net.TCPAddr).AddrPort()
+	metadata := &C.Metadata{
+		NetWork: C.TCP,
+		Type:    C.SOCKS5,
+		SrcIP:   netip.MustParseAddr("192.0.2.1"),
+		SrcPort: 40000,
+		DstIP:   ap.Addr().Unmap(),
+		DstPort: ap.Port(),
+	}
+	go tunnel.Tunnel.HandleTCPConn(server, metadata)
+	go func() {
+		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		defer cancel()
+		_ = tls.Client(client, &tls.Config{ServerName: host, InsecureSkipVerify: true}).HandshakeContext(ctx)
+	}()
+	return whole
+}
+
+// A rule sends one destination to the desync outbound (patch 0023), the
+// rest to DIRECT: only the first arrives with its ClientHello split into
+// records.
+func TestDesyncRuleRouting(t *testing.T) {
+	desyncLn, err := net.Listen("tcp4", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer desyncLn.Close()
+	directLn, err := net.Listen("tcp4", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer directLn.Close()
+
+	oldProxies, oldMode, oldStatus := tunnel.Proxies(), tunnel.Mode(), tunnel.Status()
+	oldRules := tunnel.Rules()
+	t.Cleanup(func() {
+		tunnel.UpdateProxies(oldProxies, tunnel.Providers())
+		tunnel.UpdateRules(oldRules, nil, tunnel.RuleProviders())
+		tunnel.SetMode(oldMode)
+		if oldStatus == tunnel.Suspend {
+			tunnel.OnSuspend()
+		}
+	})
+	rule, err := R.ParseRule("DST-PORT", strconv.Itoa(desyncLn.Addr().(*net.TCPAddr).Port), "desync-yt", nil, nil)
+	require.NoError(t, err)
+	match, err := R.ParseRule("MATCH", "", "DIRECT", nil, nil)
+	require.NoError(t, err)
+	desync, err := adapter.ParseProxy(map[string]any{"name": "desync-yt", "type": "desync", "tlsrec": "1+s"})
+	require.NoError(t, err)
+	tunnel.UpdateProxies(map[string]C.Proxy{
+		"DIRECT":    adapter.NewProxy(outbound.NewDirect()),
+		"REJECT":    adapter.NewProxy(outbound.NewReject()),
+		"desync-yt": desync,
+	}, nil)
+	tunnel.UpdateRules([]C.Rule{rule, match}, nil, nil)
+	tunnel.SetMode(tunnel.Rule)
+	tunnel.OnRunning()
+
+	whole, ok := <-routeHello(t, desyncLn, "www.youtube.test")
+	require.True(t, ok, "the desync connection did not arrive")
+	assert.False(t, whole, "a rule-routed desync connection must arrive fragmented")
+
+	whole, ok = <-routeHello(t, directLn, "other.test")
+	require.True(t, ok, "the DIRECT connection did not arrive")
+	assert.True(t, whole, "DIRECT must stay untouched")
+}
