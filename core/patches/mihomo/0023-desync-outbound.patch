+func TestDesyncMarshalJSON(t *testing.T) {
+	d := newTestDesync(t, DesyncOption{TLSRec: "1+s,3", Split: "2", SplitDelay: 5, DNSFallback: true,
+		Random: &DesyncRandomOption{TLSRec: []DesyncRandomCut{{From: "-4+s", To: "4+s", Count: 2, MinPiece: 1}}, Seed: 9}})
+	raw, err := d.MarshalJSON()
+	require.NoError(t, err)
+	var v struct {
+		Type   string `json:"type"`
+		ID     string `json:"id"`
+		Desync struct {
+			Strategy string `json:"strategy"`
+			TCP      struct {
+				TLSRec     []string `json:"tlsrec"`
+				Split      []string `json:"split"`
+				SplitDelay int      `json:"split-delay"`
+				SplitWait  string   `json:"split-wait"`
+				Disorder   bool     `json:"disorder"`
+				OOB        any      `json:"oob"`
+				Random     struct {
+					TLSRec []map[string]any `json:"tlsrec"`
+					Seed   uint64           `json:"seed"`
+				} `json:"random"`
+				Fake any `json:"fake"`
+			} `json:"tcp"`
+			UDP         any  `json:"udp"`
+			DNSFallback bool `json:"dns-fallback"`
+		} `json:"desync"`
+		Fallbacks *uint64 `json:"desyncDNSFallbacks"`
+	}
+	require.NoError(t, json.Unmarshal(raw, &v))
