--- /dev/null
+++ b/adapter/outbound/desync_fake_test.go
@@ -0,0 +1,75 @@
+//go:build windows || linux
+
+package outbound
+
+import (
+	"context"
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// The native fake through the outbound's own dial (Windows; Linux and
+// Android since desync v0.1.0). On loopback a low TTL never expires, so the
+// fake bytes reach the server: the decoy is set to the real bytes, which
+// keeps the stream verifiable, as the library's own native tests do.
+func TestDesyncFakeThroughOutbound(t *testing.T) {
+	record := captureClientHello(t)
+	fragments := expectedFragments(t, record)
+	for name, tc := range map[string]struct {
+		option  DesyncOption
+		want    []byte
+		payload []byte
+		offset  int
+	}{
+		"prefix":       {option: DesyncOption{TLSRec: "1+s", Fake: &DesyncFakeOption{TTL: 4, Prefix: -1, Timeout: 3000}}, want: fragments, payload: fragments},
+		"split piece":  {option: DesyncOption{Split: "40", Fake: &DesyncFakeOption{TTL: 4, Prefix: -1}}, want: record, payload: record, offset: 40},
+		"auto fallbck": {option: DesyncOption{Fake: &DesyncFakeOption{TTL: 4, AutoTTL: true}}, want: record, payload: record},
+	} {
+		t.Run(name, func(t *testing.T) {
+			if tc.option.Fake.AutoTTL {
+				caps := desyncPlatform()
+				if !caps.AutoTTL.IPv4 && !caps.AutoTTL.IPv6 {
+					t.Skip("auto-ttl is a configuration error here")
+				}
+			}
+			ln, err := net.Listen("tcp4", "127.0.0.1:0")
+			require.NoError(t, err)
+			defer ln.Close()
+			got := make(chan []byte, 1)
+			go func() {
+				c, err := ln.Accept()
+				if err != nil {
+					got <- nil
+					return
+				}
+				defer c.Close()
+				_ = c.SetDeadline(time.Now().Add(5 * time.Second))
+				buf := make([]byte, len(tc.want))
+				_, _ = io.ReadFull(c, buf)
+				got <- buf
+			}()
+
+			d := newTestDesync(t, tc.option)
+			opts := d.tcp
+			fake := *opts.Fake
+			fake.Payload, fake.Offset = tc.payload, tc.offset
+			opts.Fake = &fake
+			d.strategy = staticDesyncStrategy{opts}
+
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			conn, err := d.DialContext(ctx, desyncMetadata(ln.Addr()))
+			require.NoError(t, err)
+			defer conn.Close()
+			_ = conn.SetDeadline(time.Now().Add(5 * time.Second))
+			_, err = conn.Write(record)
+			require.NoError(t, err)
+			assert.Equal(t, tc.want, <-got)
+		})
+	}
+}
diff --git a/adapter/outbound/desync_test.go b/adapter/outbound/desync_test.go
new file mode 100644
index 0000000..d015c1b
--- /dev/null
+++ b/adapter/outbound/desync_test.go
@@ -0,0 +1,840 @@
+package outbound
+
+import (
+	"bytes"
+	"context"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"io"
+	"math/big"
+	"net"
+	"net/netip"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+
+	N "github.com/metacubex/mihomo/common/net"
+	"github.com/metacubex/mihomo/component/loopback"
+	"github.com/metacubex/mihomo/component/resolver"
+	C "github.com/metacubex/mihomo/constant"
+
+	"github.com/Nemu-x/desync"
+	"github.com/metacubex/sing/common"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+const desyncTestSNI = "www.youtube.test"
+
+func newTestDesync(t *testing.T, option DesyncOption) *Desync {
+	t.Helper()
+	if option.Name == "" {
+		option.Name = "desync-test"
+	}
+	d, err := NewDesync(option)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = d.Close() })
+	return d
+}
+
+func desyncMetadata(addr net.Addr) *C.Metadata {
+	ap := addr.(*net.TCPAddr).AddrPort()
+	return &C.Metadata{NetWork: C.TCP, DstIP: ap.Addr().Unmap(), DstPort: ap.Port()}
+}
+
+// captureClientHello returns the first record of a real crypto/tls
+// handshake, which holds the whole ClientHello.
+func captureClientHello(t *testing.T) []byte {
+	t.Helper()
+	client, server := net.Pipe()
+	defer server.Close()
+	go func() {
+		defer client.Close()
+		_ = tls.Client(client, &tls.Config{ServerName: desyncTestSNI, InsecureSkipVerify: true}).Handshake()
+	}()
+	require.NoError(t, server.SetReadDeadline(time.Now().Add(3*time.Second)))
+	header := make([]byte, 5)
+	_, err := io.ReadFull(server, header)
+	require.NoError(t, err)
+	record := make([]byte, 5+int(binary.BigEndian.Uint16(header[3:])))
+	copy(record, header)
+	_, err = io.ReadFull(server, record[5:])
+	require.NoError(t, err)
+	return record
+}
+
+// readHelloRecords reads TLS handshake records from r until they carry the
+// whole first handshake message, and returns their wire bytes and the
+// equivalent single record.
+func readHelloRecords(r io.Reader) (wire, joined []byte, records int, err error) {
+	var payload []byte
+	for {
+		header := make([]byte, 5)
+		if _, err = io.ReadFull(r, header); err != nil {
+			return
+		}
+		if header[0] != 0x16 {
+			return wire, nil, records, errors.New("not a handshake record")
+		}
+		body := make([]byte, binary.BigEndian.Uint16(header[3:]))
+		if _, err = io.ReadFull(r, body); err != nil {
+			return
+		}
+		wire = append(append(wire, header...), body...)
+		payload = append(payload, body...)
+		records++
+		if len(payload) >= 4 && len(payload) >= 4+(int(payload[1])<<16|int(payload[2])<<8|int(payload[3])) {
+			joined = append([]byte{0x16, header[1], header[2], byte(len(payload) >> 8), byte(len(payload))}, payload...)
+			return
+		}
+	}
+}
+
+// expectedFragments is what the "1+s" cut makes of a single-record hello.
+func expectedFragments(t *testing.T, record []byte) []byte {
+	t.Helper()
+	h, err := desync.ParseHello(record)
+	require.NoError(t, err)
+	require.Equal(t, desyncTestSNI, h.SNI)
+	return desync.FragmentRecord(record, []int{h.SNIOffset + 1})
+}
+
+// prefixConn replays bytes already read from a connection.
+type prefixConn struct {
+	net.Conn
+	r io.Reader
+}
+
+func (c *prefixConn) Read(p []byte) (int, error) { return c.r.Read(p) }
+
+func selfSignedCert(t *testing.T) tls.Certificate {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+	tmpl := &x509.Certificate{
+		SerialNumber: big.NewInt(1),
+		DNSNames:     []string{desyncTestSNI},
+		NotBefore:    time.Now().Add(-time.Hour),
+		NotAfter:     time.Now().Add(time.Hour),
+	}
+	der, err := x509.CreateCertificate(rand.Reader, tmpl, tmpl, &key.PublicKey, key)
+	require.NoError(t, err)
+	return tls.Certificate{Certificate: [][]byte{der}, PrivateKey: key}
+}
+
+type helloResult struct {
+	wire, joined []byte
+	records      int
+	err          error
+}
+
+// tlsServer accepts one connection, records the ClientHello records as they
+// arrived on its raw socket, completes the handshake and writes "ok".
+func tlsServer(t *testing.T) (net.Listener, <-chan helloResult) {
+	t.Helper()
+	ln, err := net.Listen("tcp4", "127.0.0.1:0")
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = ln.Close() })
+	cert := selfSignedCert(t)
+	done := make(chan helloResult, 1)
+	go func() {
+		c, err := ln.Accept()
+		if err != nil {
+			done <- helloResult{err: err}
+			return
+		}
+		defer c.Close()
+		_ = c.SetDeadline(time.Now().Add(5 * time.Second))
+		wire, joined, records, err := readHelloRecords(c)
+		if err == nil {
+			s := tls.Server(&prefixConn{Conn: c, r: io.MultiReader(bytes.NewReader(wire), c)}, &tls.Config{Certificates: []tls.Certificate{cert}})
+			if err = s.Handshake(); err == nil {
+				_, err = s.Write([]byte("ok"))
+			}
+		}
+		done <- helloResult{wire, joined, records, err}
+	}()
+	return ln, done
+}
+
+// handshake runs a TLS client through the outbound against ln.
+func handshake(t *testing.T, d *Desync, ln net.Listener) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	conn, err := d.DialContext(ctx, desyncMetadata(ln.Addr()))
+	require.NoError(t, err)
+	defer conn.Close()
+	assert.Equal(t, []string{d.Name()}, []string(conn.Chains()))
+	client := tls.Client(conn, &tls.Config{ServerName: desyncTestSNI, InsecureSkipVerify: true})
+	require.NoError(t, client.HandshakeContext(ctx))
+	got := make([]byte, 2)
+	_, err = io.ReadFull(client, got)
+	require.NoError(t, err)
+	assert.Equal(t, "ok", string(got))
+}
+
+// The outbound dials a local TLS server: the server's raw socket sees the
+// ClientHello split into records at the configured position, and the
+// handshake still completes.
+func TestDesyncTLSHandshakeFragmentsClientHello(t *testing.T) {
+	ln, done := tlsServer(t)
+	handshake(t, newTestDesync(t, DesyncOption{TLSRec: "1+s"}), ln)
+	r := <-done
+	require.NoError(t, r.err)
+	assert.Equal(t, 2, r.records, "one cut, two records")
+	assert.Equal(t, expectedFragments(t, r.joined), r.wire, "the cut is one byte into the server name")
+}
+
+// Every TCP method of the library that this OS implements, through the
+// outbound's own dial, against a real TLS server: the server reassembles the
+// identical handshake. Methods the OS lacks are configuration errors, which
+// TestDesyncPlatformErrors covers.
+func TestDesyncTCPMethodsCompleteHandshake(t *testing.T) {
+	caps := desync.PlatformCapabilities()
+	for name, tc := range map[string]struct {
+		option DesyncOption
+		skip   bool
+	}{
+		"split+delay":     {option: DesyncOption{Split: "1+s", SplitDelay: 5}},
+		"tlsrec+split":    {option: DesyncOption{TLSRec: "1+s", Split: "3,2+s"}},
+		"split-wait sent": {option: DesyncOption{Split: "1+s", SplitWait: "sent", SplitWaitTimeout: 2000}, skip: !caps.Ack.Sent},
+		"split-wait ackd": {option: DesyncOption{Split: "1+s", SplitWait: "acked"}, skip: !caps.Ack.Acked},
+		"disorder":        {option: DesyncOption{Split: "1+s", Disorder: true}, skip: !caps.Disorder.Supported},
+		"oob":             {option: DesyncOption{Split: "3", OOB: true, OOBByte: "z"}, skip: !caps.OOB},
+		"disoob":          {option: DesyncOption{TLSRec: "1+s", Split: "1+s", Disorder: true, OOB: true}, skip: !caps.OOB || !caps.Disorder.Supported},
+		"random": {option: DesyncOption{TLSRec: "1+s", Random: &DesyncRandomOption{
+			TLSRec: []DesyncRandomCut{{From: "-8+s", To: "8+s", Count: 2, MinPiece: 2}},
+			Split:  []DesyncRandomCut{{From: "1", To: "120"}},
+			Seed:   42,
+		}}},
+	} {
+		t.Run(name, func(t *testing.T) {
+			if tc.skip {
+				t.Skipf("not implemented on %s", caps.OS)
+			}
+			ln, done := tlsServer(t)
+			handshake(t, newTestDesync(t, tc.option), ln)
+			r := <-done
+			require.NoError(t, r.err)
+		})
+	}
+}
+
+// A fixed seed reproduces the random record cuts on every connection.
+func TestDesyncRandomSeedIsReproducible(t *testing.T) {
+	d := newTestDesync(t, DesyncOption{Random: &DesyncRandomOption{
+		TLSRec: []DesyncRandomCut{{From: "-8+s", To: "8+s", Count: 3}}, Seed: 7,
+	}})
+	var wires [][]byte
+	for i := 0; i < 2; i++ {
+		ln, done := tlsServer(t)
+		handshake(t, d, ln)
+		r := <-done
+		require.NoError(t, r.err)
+		assert.Greater(t, r.records, 1)
+		h, err := desync.ParseHello(r.joined)
+		require.NoError(t, err)
+		// the random part of the hello differs, the cuts do not
+		wires = append(wires, append([]byte{}, r.wire[:h.SNIOffset+16]...))
+	}
+	assert.Equal(t, recordLengths(wires[0]), recordLengths(wires[1]))
+}
+
+func recordLengths(wire []byte) (out []int) {
+	for len(wire) >= 5 {
+		n := int(binary.BigEndian.Uint16(wire[3:]))
+		out = append(out, n)
+		if len(wire) < 5+n {
+			break
+		}
+		wire = wire[5+n:]
+	}
+	return
+}
+
+// Traffic that does not start with a ClientHello is not touched.
+func TestDesyncPassesThroughNonTLS(t *testing.T) {
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer ln.Close()
+	request := []byte("GET / HTTP/1.1\r\nHost: www.youtube.test\r\n\r\n")
+	received := make(chan []byte, 1)
+	go func() {
+		c, err := ln.Accept()
+		if err != nil {
+			received <- nil
+			return
+		}
+		defer c.Close()
+		_ = c.SetDeadline(time.Now().Add(5 * time.Second))
+		buf := make([]byte, len(request))
+		_, _ = io.ReadFull(c, buf)
+		received <- buf
+	}()
+	d := newTestDesync(t, DesyncOption{TLSRec: "1+s", Split: "2"})
+	conn, err := d.DialContext(context.Background(), desyncMetadata(ln.Addr()))
+	require.NoError(t, err)
+	defer conn.Close()
+	_, err = conn.Write(request)
+	require.NoError(t, err)
+	assert.Equal(t, request, <-received)
+}
+
+// The relay must not reach the socket under the transformer for writes:
+// neither by unwrapping the writer nor by an upstream cast to the socket
+// (splice, sendfile, writev batching). Reads may go to the socket.
+func TestDesyncConnHidesSocketFromWriteFastPaths(t *testing.T) {
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer ln.Close()
+	go func() {
+		if c, err := ln.Accept(); err == nil {
+			defer c.Close()
+			_, _ = io.Copy(io.Discard, c)
+		}
+	}()
+	d := newTestDesync(t, DesyncOption{TLSRec: "1+s"})
+	conn, err := d.DialContext(context.Background(), desyncMetadata(ln.Addr()))
+	require.NoError(t, err)
+	defer conn.Close()
+
+	w := N.UnwrapWriter(conn)
+	_, isSyscall := w.(syscall.Conn)
+	assert.False(t, isSyscall, "the writer unwraps to a socket: %T", w)
+	_, isDesync := w.(*desyncConn)
+	assert.True(t, isDesync, "the writer unwraps past the transformer: %T", w)
+	_, found := N.FindUpstream[*net.TCPConn](conn, nil)
+	assert.False(t, found, "FindUpstream reaches the socket")
+	_, found = N.FindUpstream[*desync.Conn](conn, nil)
+	assert.False(t, found, "FindUpstream reaches the transformer, and NetConn below it")
+	_, found = common.Cast[syscall.Conn](conn)
+	assert.False(t, found, "common.Cast reaches the socket")
+
+	_, isTCP := N.UnwrapReader(conn).(*net.TCPConn)
+	assert.True(t, isTCP, "reads go to the socket directly")
+	_, hasCloseWrite := common.Cast[interface{ CloseWrite() error }](conn)
+	assert.True(t, hasCloseWrite, "half-close is kept")
+}
+
+// A real relay between two TCP sockets, each of which could use splice or
+// writev: the first bytes still arrive transformed.
+func TestDesyncRelayKeepsTransformer(t *testing.T) {
+	record := captureClientHello(t)
+	want := expectedFragments(t, record)
+
+	target, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer target.Close()
+	got := make(chan []byte, 1)
+	go func() {
+		c, err := target.Accept()
+		if err != nil {
+			got <- nil
+			return
+		}
+		defer c.Close()
+		_ = c.SetDeadline(time.Now().Add(5 * time.Second))
+		buf := make([]byte, len(want))
+		_, _ = io.ReadFull(c, buf)
+		got <- buf
+	}()
+
+	// the client's side: a TCP connection accepted by an inbound
+	inbound, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer inbound.Close()
+	app, err := net.Dial("tcp", inbound.Addr().String())
+	require.NoError(t, err)
+	defer app.Close()
+	accepted, err := inbound.Accept()
+	require.NoError(t, err)
+
+	d := newTestDesync(t, DesyncOption{TLSRec: "1+s"})
+	remote, err := d.DialContext(context.Background(), desyncMetadata(target.Addr()))
+	require.NoError(t, err)
+	go N.Relay(accepted, remote)
+
+	_, err = app.Write(record)
+	require.NoError(t, err)
+	assert.Equal(t, want, <-got, "the relay bypassed the transformer")
+}
+
+// blockingResolver answers only when the lookup's context ends.
+type blockingResolver struct{ desyncDNSStub }
+
+func (*blockingResolver) LookupIP(ctx context.Context, _ string) ([]netip.Addr, error) {
+	<-ctx.Done()
+	return nil, ctx.Err()
+}
+
+func (r *blockingResolver) LookupIPv4(ctx context.Context, host string) ([]netip.Addr, error) {
+	return r.LookupIP(ctx, host)
+}
+
+func (r *blockingResolver) LookupIPv6(ctx context.Context, host string) ([]netip.Addr, error) {
+	return r.LookupIP(ctx, host)
+}
+
+func TestDesyncDialRespectsContext(t *testing.T) {
+	d := newTestDesync(t, DesyncOption{TLSRec: "1+s"})
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	_, err := d.DialContext(ctx, &C.Metadata{NetWork: C.TCP, DstIP: netip.MustParseAddr("127.0.0.1"), DstPort: 9})
+	assert.ErrorIs(t, err, context.Canceled)
+
+	// cancelled while the dial is in progress: the name lookup blocks
+	// until the context ends
+	old := resolver.DirectHostResolver
+	resolver.DirectHostResolver = &blockingResolver{}
+	defer func() { resolver.DirectHostResolver = old }()
+	ctx, cancel = context.WithCancel(context.Background())
+	time.AfterFunc(100*time.Millisecond, cancel)
+	start := time.Now()
+	_, err = d.DialContext(ctx, &C.Metadata{NetWork: C.TCP, Host: "slow.example", DstPort: 443})
+	assert.ErrorIs(t, err, context.Canceled)
+	assert.Less(t, time.Since(start), 3*time.Second)
+}
+
+// dns-fallback (patch 0019) works for the outbound as for direct.desync.
+func TestDesyncDNSFallback(t *testing.T) {
+	oldDirect, oldDefault, oldDisabled := resolver.DirectHostResolver, resolver.DefaultResolver, resolver.DisableIPv6
+	t.Cleanup(func() {
+		resolver.DirectHostResolver, resolver.DefaultResolver, resolver.DisableIPv6 = oldDirect, oldDefault, oldDisabled
+	})
+	resolver.DisableIPv6 = true
+	for _, enabled := range []bool{false, true} {
+		ln, err := net.Listen("tcp4", "127.0.0.1:0")
+		require.NoError(t, err)
+		go func() {
+			if c, err := ln.Accept(); err == nil {
+				_ = c.Close()
+			}
+		}()
+		resolver.DirectHostResolver = &desyncDNSStub{err: resolver.ErrIPNotFound}
+		resolver.DefaultResolver = &desyncDNSStub{ips: []netip.Addr{netip.MustParseAddr("127.0.0.1")}}
+		d := newTestDesync(t, DesyncOption{TLSRec: "1+s", DNSFallback: enabled})
+		ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+		conn, err := d.DialContext(ctx, &C.Metadata{NetWork: C.TCP, Host: "cold.youtube.test", DstPort: uint16(ln.Addr().(*net.TCPAddr).Port)})
+		cancel()
+		if enabled {
+			require.NoError(t, err)
+			_ = conn.Close()
+			assert.EqualValues(t, 1, d.desyncDNSFallbacks.Load())
+		} else {
+			assert.Error(t, err, "without dns-fallback an empty direct answer stays an error")
+		}
+		_ = ln.Close()
+	}
+}
