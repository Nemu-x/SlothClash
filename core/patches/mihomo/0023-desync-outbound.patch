diff --git a/adapter/outbound/desync_linux_test.go b/adapter/outbound/desync_linux_test.go
new file mode 100644
index 0000000..5ca3cda
--- /dev/null
+++ b/adapter/outbound/desync_linux_test.go
@@ -0,0 +1,169 @@
+//go:build linux
+
+package outbound
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net"
+	"syscall"
+	"testing"
+	"time"
+
+	N "github.com/metacubex/mihomo/common/net"
+	"github.com/metacubex/mihomo/component/resolver"
+
+	"github.com/Nemu-x/desync"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// hopLimitListener listens on IPv6 loopback with hop limit hl, which the
+// SYN-ACK inherits, so the loopback path looks like 128 - hl hops (for hl
+// above 96) to the client.
+func hopLimitListener(t *testing.T, hl int) net.Listener {
+	t.Helper()
+	lc := net.ListenConfig{Control: func(_, _ string, c syscall.RawConn) error {
+		var opErr error
+		if err := c.Control(func(fd uintptr) {
+			opErr = syscall.SetsockoptInt(int(fd), syscall.IPPROTO_IPV6, syscall.IPV6_UNICAST_HOPS, hl)
+		}); err != nil {
+			return err
+		}
+		return opErr
+	}}
+	ln, err := lc.Listen(context.Background(), "tcp6", "[::1]:0")
+	if err != nil {
+		t.Skipf("IPv6 loopback unavailable: %v", err)
+	}
+	t.Cleanup(func() { _ = ln.Close() })
+	withIPv6(t)
+	return ln
+}
+
+func hopRecording(t *testing.T, conn net.Conn) int {
+	t.Helper()
+	dc, ok := N.UnwrapWriter(conn).(*desyncConn)
+	require.True(t, ok)
+	raw, err := dc.socket.(syscall.Conn).SyscallConn()
+	require.NoError(t, err)
+	var on int
+	var opErr error
+	require.NoError(t, raw.Control(func(fd uintptr) {
+		on, opErr = syscall.GetsockoptInt(int(fd), syscall.IPPROTO_IPV6, ipv6RecvHopLimit)
+	}))
+	require.NoError(t, opErr)
+	return on
+}
+
+// The outbound's dial prepares the socket with ControlAutoTTL: the TTL of
+// the SYN-ACK (hop limit 120: 8 hops) gives the fake TTL 7, which the API
+// reports, and the recording is off once it was read.
+func TestDesyncLinuxAutoTTL(t *testing.T) {
+	ln := hopLimitListener(t, 120)
+	record := captureClientHello(t)
+	got := readFirst(ln, len(record))
+
+	d := newTestDesync(t, DesyncOption{TLSRec: "", Fake: &DesyncFakeOption{AutoTTL: &DesyncAutoTTLOption{}}})
+	withVerifiableFake(d, record, 0)
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	conn, err := d.DialContext(ctx, desyncMetadata(ln.Addr()))
+	require.NoError(t, err)
+	defer conn.Close()
+	assert.Equal(t, 1, hopRecording(t, conn), "dialed with ControlAutoTTL")
+
+	_ = conn.SetDeadline(time.Now().Add(5 * time.Second))
+	_, err = conn.Write(record)
+	require.NoError(t, err)
+	assert.Equal(t, record, <-got)
+	assert.Equal(t, 0, hopRecording(t, conn), "the recording is off after the fake")
+
+	raw, err := d.MarshalJSON()
+	require.NoError(t, err)
+	var v struct {
+		Desync struct {
+			TCP struct {
+				Fake struct {
+					LastTTL struct {
+						TTL  int  `json:"ttl"`
+						Auto bool `json:"auto"`
+					} `json:"last-ttl"`
+				} `json:"fake"`
+			} `json:"tcp"`
+		} `json:"desync"`
+	}
+	require.NoError(t, json.Unmarshal(raw, &v))
+	assert.Equal(t, 7, v.Desync.TCP.Fake.LastTTL.TTL)
+	assert.True(t, v.Desync.TCP.Fake.LastTTL.Auto, "derived from the path")
+}
+
+// A connection that does not start with a ClientHello gets no fake; the
+// outbound turns the hop limit recording off itself.
+func TestDesyncLinuxAutoTTLNonTLS(t *testing.T) {
+	ln := hopLimitListener(t, 120)
+	request := []byte("GET / HTTP/1.1\r\n\r\n")
+	got := readFirst(ln, len(request))
+	d := newTestDesync(t, DesyncOption{Fake: &DesyncFakeOption{TTL: 4, AutoTTL: &DesyncAutoTTLOption{}}})
+	conn, err := d.DialContext(context.Background(), desyncMetadata(ln.Addr()))
+	require.NoError(t, err)
+	defer conn.Close()
+	require.Equal(t, 1, hopRecording(t, conn))
+	_, err = conn.Write(request)
+	require.NoError(t, err)
+	assert.Equal(t, request, <-got)
+	assert.Equal(t, 0, hopRecording(t, conn))
+	assert.Equal(t, int32(0), d.lastFakeTTL.Load())
+}
+
+// Without auto-ttl the socket is not prepared.
+func TestDesyncLinuxNoAutoTTLControl(t *testing.T) {
+	ln := hopLimitListener(t, 120)
+	_ = readFirst(ln, 1)
+	d := newTestDesync(t, DesyncOption{Fake: &DesyncFakeOption{TTL: 4}})
+	conn, err := d.DialContext(context.Background(), desyncMetadata(ln.Addr()))
+	require.NoError(t, err)
+	defer conn.Close()
+	assert.Equal(t, 0, hopRecording(t, conn))
+	_, err = desync.ObserveHops(N.UnwrapWriter(conn).(*desyncConn).socket)
+	assert.ErrorIs(t, err, desync.ErrAutoTTLUnobserved)
+}
+
+// Helpers of Citrus' desync_methods_test.go and desync_native_test.go that
+// the tests above use.
+
+func withIPv6(t *testing.T) {
+	t.Helper()
+	old := resolver.DisableIPv6
+	resolver.DisableIPv6 = false
+	t.Cleanup(func() { resolver.DisableIPv6 = old })
+}
+
+// withVerifiableFake makes the fake's decoy the real bytes: on loopback a low
+// TTL never expires, so the decoy reaches the server.
+func withVerifiableFake(d *Desync, wire []byte, offset int) {
+	opts := d.tcp
+	fake := *opts.Fake
+	fake.Payload, fake.Offset = wire, offset
+	opts.Fake = &fake
+	d.strategy = staticDesyncStrategy{opts}
+}
+
+// readFirst reads n bytes from the first connection accepted by ln.
+func readFirst(ln net.Listener, n int) <-chan []byte {
+	got := make(chan []byte, 1)
+	go func() {
+		c, err := ln.Accept()
+		if err != nil {
+			got <- nil
+			return
+		}
+		defer c.Close()
+		_ = c.SetDeadline(time.Now().Add(5 * time.Second))
+		buf := make([]byte, n)
+		k, _ := io.ReadFull(c, buf)
+		got <- buf[:k]
+	}()
+	return got
+}
diff --git a/adapter/outbound/desync_test.go b/adapter/outbound/desync_test.go
new file mode 100644
index 0000000..81d2d05
--- /dev/null
+++ b/adapter/outbound/desync_test.go
@@ -0,0 +1,928 @@
+package outbound
+
+import (
+	"bytes"
+	"context"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"math/big"
+	"net"
+	"net/netip"
+	"syscall"
+	"testing"
+	"time"
+
+	N "github.com/metacubex/mihomo/common/net"
+	"github.com/metacubex/mihomo/component/loopback"
+	"github.com/metacubex/mihomo/component/resolver"
+	C "github.com/metacubex/mihomo/constant"
+
+	"github.com/Nemu-x/desync"
+	"github.com/metacubex/sing/common"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+const desyncTestSNI = "www.youtube.test"
+
+func newTestDesync(t *testing.T, option DesyncOption) *Desync {
+	t.Helper()
+	if option.Name == "" {
+		option.Name = "desync-test"
+	}
+	d, err := NewDesync(option)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = d.Close() })
+	return d
+}
+
+func desyncMetadata(addr net.Addr) *C.Metadata {
+	ap := addr.(*net.TCPAddr).AddrPort()
+	return &C.Metadata{NetWork: C.TCP, DstIP: ap.Addr().Unmap(), DstPort: ap.Port()}
+}
+
+// captureClientHello returns the first record of a real crypto/tls
+// handshake, which holds the whole ClientHello.
+func captureClientHello(t *testing.T) []byte {
+	t.Helper()
+	client, server := net.Pipe()
+	defer server.Close()
+	go func() {
+		defer client.Close()
+		_ = tls.Client(client, &tls.Config{ServerName: desyncTestSNI, InsecureSkipVerify: true}).Handshake()
+	}()
+	require.NoError(t, server.SetReadDeadline(time.Now().Add(3*time.Second)))
+	header := make([]byte, 5)
+	_, err := io.ReadFull(server, header)
+	require.NoError(t, err)
+	record := make([]byte, 5+int(binary.BigEndian.Uint16(header[3:])))
+	copy(record, header)
+	_, err = io.ReadFull(server, record[5:])
+	require.NoError(t, err)
+	return record
+}
+
+// readHelloRecords reads TLS handshake records from r until they carry the
+// whole first handshake message, and returns their wire bytes and the
+// equivalent single record.
+func readHelloRecords(r io.Reader) (wire, joined []byte, records int, err error) {
+	var payload []byte
+	for {
+		header := make([]byte, 5)
+		if _, err = io.ReadFull(r, header); err != nil {
+			return
+		}
+		if header[0] != 0x16 {
+			return wire, nil, records, errors.New("not a handshake record")
+		}
+		body := make([]byte, binary.BigEndian.Uint16(header[3:]))
+		if _, err = io.ReadFull(r, body); err != nil {
+			return
+		}
+		wire = append(append(wire, header...), body...)
+		payload = append(payload, body...)
+		records++
+		if len(payload) >= 4 && len(payload) >= 4+(int(payload[1])<<16|int(payload[2])<<8|int(payload[3])) {
+			joined = append([]byte{0x16, header[1], header[2], byte(len(payload) >> 8), byte(len(payload))}, payload...)
+			return
+		}
+	}
+}
