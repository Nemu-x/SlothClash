+func TestDesyncConditionalMethods(t *testing.T) {
+	android := fakePlatform("android")
+	for name, option := range map[string]DesyncOption{
+		"split-wait sent":       {Split: "1+s", SplitWait: "sent", SplitWaitTimeout: 500},
+		"split-wait acked":      {Split: "1+s", SplitWait: "acked"},
+		"disorder":              {Split: "1+s", Disorder: true},
+		"disoob":                {Split: "1+s", Disorder: true, OOB: true},
+		"fake":                  {TLSRec: "1+s", Fake: &DesyncFakeOption{TTL: 4, SNI: []string{"www.example.com"}}},
+		"fake auto-ttl":         {TLSRec: "1+s", Fake: &DesyncFakeOption{TTL: 4, AutoTTL: &DesyncAutoTTLOption{}}},
+		"fake disorder sent":    {Split: "1+s", Disorder: true, SplitWait: "sent", Fake: &DesyncFakeOption{TTL: 4}},
+		"fake random split oob": {Random: &DesyncRandomOption{Split: []DesyncRandomCut{{From: "1", To: "8"}}}, OOB: true, Fake: &DesyncFakeOption{TTL: 4}},
+		"udp":                   {UDP: &DesyncUDPOption{TTL: 4, Template: "quic"}},
+	} {
+		option.Name = name
+		d, err := newDesync(option, android)
+		if assert.NoError(t, err, name) {
+			assert.Equal(t, option.SplitWait == "sent", d.tcp.SplitWait == desync.SplitWaitSent, name)
+			assert.Equal(t, option.Disorder, d.tcp.Disorder, name)
+			assert.Equal(t, option.Fake != nil, d.tcp.Fake != nil, name)
+			_ = d.Close()
+		}
+	}
+
+	strict := android
+	strict.Conditional = nil
+	for _, tc := range []struct {
+		option DesyncOption
+		is     error
+		says   string
+	}{
+		{DesyncOption{Split: "1+s", SplitWait: "sent"}, desync.ErrSplitWaitUnsupported, "split-wait sent is not supported on android (SIOCOUTQ observes only acked)"},
+		{DesyncOption{Split: "1+s", Disorder: true}, desync.ErrDisorderUnsupported, "disorder is not supported on android (Android does not let apps read SIOCOUTQNSD"},
+		{DesyncOption{TLSRec: "1+s", Fake: &DesyncFakeOption{TTL: 4}}, desync.ErrFakeUnsupported, "fake is not supported on android (Android does not let apps read SIOCOUTQNSD"},
+	} {
+		_, err := newDesync(tc.option, strict)
+		if assert.Error(t, err, tc.says) {
+			assert.ErrorIs(t, err, tc.is)
+			assert.Contains(t, err.Error(), tc.says)
+		}
+	}
+
+	// Conditional does not lift the checks that do not depend on the socket.
+	for _, tc := range []struct {
+		option DesyncOption
+		is     error
+		says   string
+	}{
+		{DesyncOption{BasicOption: BasicOption{IPVersion: C.IPv4Only}, Fake: &DesyncFakeOption{AutoTTL: &DesyncAutoTTLOption{}}}, desync.ErrAutoTTLUnsupported, "fake auto-ttl cannot observe the path on android (tcp_v4_do_rcv records no TTL)"},
+		{DesyncOption{TLSRec: "1+s", Disorder: true}, nil, "disorder needs split positions"},
+		{DesyncOption{TLSRec: "1+s", SplitWait: "sent"}, nil, "split-wait needs split positions"},
+	} {
+		_, err := newDesync(tc.option, android)
+		if assert.Error(t, err, tc.says) {
+			if tc.is != nil {
+				assert.ErrorIs(t, err, tc.is)
+			}
+			assert.Contains(t, err.Error(), tc.says)
+		}
+	}
+}
