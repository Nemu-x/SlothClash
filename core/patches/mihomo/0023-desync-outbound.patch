+func fakePlatform(os string) desync.Capabilities {
+	switch os {
+	case "darwin":
+		return desync.Capabilities{OS: "darwin", FakeUDP: true, TTLControl: true, OOB: true,
+			Disorder: desync.DisorderCapability{Supported: true, Mechanism: "SO_NWRITE"},
+			Ack:      desync.AckCapability{Mechanism: "SO_NWRITE", Acked: true, Reliable: true},
+			Unsupported: map[string]string{"fake-tcp": "no splice: a retransmission cannot carry other bytes",
+				"auto-ttl-ipv4": "tcp_input saves no control data", "auto-ttl-ipv6": "tcp_input saves no control data"}}
+	case "windows":
+		return desync.Capabilities{OS: "windows", FakeTCP: true, FakeUDP: true, TTLControl: true, OOB: true,
+			Disorder:    desync.DisorderCapability{Supported: true, Mechanism: "SIO_TCP_INFO", Observed: true},
+			Ack:         desync.AckCapability{Mechanism: "SIO_TCP_INFO", Sent: true, Acked: true},
+			Unsupported: map[string]string{"auto-ttl-ipv4": "no received TTL for TCP", "auto-ttl-ipv6": "no received hop limit for TCP"}}
+	case "linux":
+		return desync.Capabilities{OS: "linux", FakeTCP: true, FakeUDP: true, TTLControl: true, OOB: true,
+			Disorder:    desync.DisorderCapability{Supported: true, Mechanism: "SIOCOUTQNSD", Observed: true, Reliable: true},
+			Ack:         desync.AckCapability{Mechanism: "SIOCOUTQ/SIOCOUTQNSD", Sent: true, Acked: true, Reliable: true},
+			AutoTTL:     desync.AutoTTLCapability{Mechanism: "IPV6_RECVHOPLIMIT", IPv6: true},
+			Unsupported: map[string]string{"auto-ttl-ipv4": "tcp_v4_do_rcv records no TTL"}}
+	case "android":
+		// SIOCOUTQNSD is denied to apps: the methods that need unsent bytes
+		// are not claimed but listed in Conditional (and in Unsupported).
+		return desync.Capabilities{OS: "android", FakeUDP: true, TTLControl: true, OOB: true,
+			Ack:     desync.AckCapability{Mechanism: "SIOCOUTQ", Acked: true, Reliable: true},
+			AutoTTL: desync.AutoTTLCapability{Mechanism: "IPV6_RECVHOPLIMIT", IPv6: true},
+			Unsupported: map[string]string{"auto-ttl-ipv4": "tcp_v4_do_rcv records no TTL",
+				"split-wait-sent": desyncAndroidReason, "fake-tcp": desyncAndroidReason, "disorder": desyncAndroidReason},
+			Conditional: map[string]string{
+				"split-wait-sent": desyncAndroidReason, "fake-tcp": desyncAndroidReason, "disorder": desyncAndroidReason}}
+	}
+	return desync.Capabilities{OS: os, Unsupported: map[string]string{}}
+}
