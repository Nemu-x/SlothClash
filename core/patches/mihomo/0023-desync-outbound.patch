+// The UDP burst through ListenPacketContext on every OS that has it: repeats
+// fake datagrams, then the unchanged original, and nothing in the packet path
+// reaches the socket. The counters and activity keep the keys the client
+// reads for direct.desync (0019/0020).
+func TestDesyncUDPBurst(t *testing.T) {
+	if !desync.PlatformCapabilities().FakeUDP {
+		t.Skip("no UDP burst on this OS")
+	}
+	for _, tc := range []struct {
+		name   string
+		option DesyncUDPOption
+		fake   func([]byte) bool
+	}{
+		{"zero", DesyncUDPOption{TTL: 4, Repeats: 2, Packets: 1}, func(b []byte) bool { return bytes.Equal(b, make([]byte, 64)) }},
+		{"quic", DesyncUDPOption{TTL: 4, Repeats: 2, Packets: 1, Template: "quic", SNI: "www.example.com"},
+			func(b []byte) bool {
+				return len(b) == 1200 && b[0]&0xc0 == 0xc0 && binary.BigEndian.Uint32(b[1:5]) == 1
+			}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			option := tc.option
+			d := newTestDesync(t, DesyncOption{UDP: &option})
+			assert.True(t, d.DesyncUDPProbeEnabled())
+			server, err := net.ListenPacket("udp4", "127.0.0.1:0")
+			require.NoError(t, err)
+			defer server.Close()
+			ap := server.LocalAddr().(*net.UDPAddr).AddrPort()
+			pc, err := d.ListenPacketContext(context.Background(), &C.Metadata{NetWork: C.UDP, DstIP: ap.Addr(), DstPort: ap.Port()})
+			require.NoError(t, err)
+			defer pc.Close()
+			_, found := N.FindUpstream[*net.UDPConn](pc, nil)
+			assert.False(t, found, "the packet path can reach the socket")
+			_, found = N.FindUpstream[*desync.PacketConn](pc, nil)
+			assert.False(t, found, "the packet path can reach the wrapper")
+
+			for i := 0; i < 2; i++ {
+				_, err = pc.WriteTo([]byte("original"), server.LocalAddr())
+				require.NoError(t, err)
+			}
+			require.NoError(t, server.SetReadDeadline(time.Now().Add(3*time.Second)))
+			for i := 0; i < 4; i++ {
+				buf := make([]byte, 2048)
+				n, _, err := server.ReadFrom(buf)
+				require.NoError(t, err)
+				if i < 2 {
+					assert.True(t, tc.fake(buf[:n]), "datagram %d is not the decoy: %d bytes", i, n)
+				} else {
+					assert.Equal(t, "original", string(buf[:n]), "datagram %d", i)
+				}
+			}
+
+			raw, err := d.MarshalJSON()
+			require.NoError(t, err)
+			var v struct {
+				Desync struct {
+					UDP struct {
+						TTL      int                `json:"ttl"`
+						Repeats  int                `json:"repeats"`
+						Packets  int                `json:"packets"`
+						Template string             `json:"template"`
+						Counters desync.UDPSnapshot `json:"counters"`
+					} `json:"udp"`
+				} `json:"desync"`
+				DesyncUDP struct {
+					Counters desync.UDPSnapshot `json:"counters"`
+					Activity []map[string]any   `json:"activity"`
+				} `json:"desyncUDP"`
+			}
+			require.NoError(t, json.Unmarshal(raw, &v))
+			assert.Equal(t, 4, v.Desync.UDP.TTL)
+			assert.Equal(t, 2, v.Desync.UDP.Repeats)
+			assert.Equal(t, 1, v.Desync.UDP.Packets)
+			assert.Equal(t, tc.name, v.Desync.UDP.Template)
+			want := desync.UDPSnapshot{Packets: 2, FakePackets: 2, Peers: 1}
+			assert.Equal(t, want, v.Desync.UDP.Counters)
+			assert.Equal(t, want, v.DesyncUDP.Counters)
+			if assert.Len(t, v.DesyncUDP.Activity, 1) {
+				assert.EqualValues(t, 2, v.DesyncUDP.Activity[0]["txPackets"])
+			}
+		})
+	}
+}
