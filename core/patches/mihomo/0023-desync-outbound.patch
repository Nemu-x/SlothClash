+// On this OS: the methods it lacks fail, the ones it has load.
+func TestDesyncPlatformMethods(t *testing.T) {
+	caps := desync.PlatformCapabilities()
+	check := func(ok bool, sentinel error, option DesyncOption) {
+		t.Helper()
+		d, err := NewDesync(option)
+		if ok {
+			if assert.NoError(t, err, option.Name) {
+				_ = d.Close()
+			}
+		} else {
+			assert.ErrorIs(t, err, sentinel, option.Name)
+		}
+	}
+	check(caps.FakeTCP, desync.ErrFakeUnsupported, DesyncOption{Name: "fake", TLSRec: "1+s", Fake: &DesyncFakeOption{TTL: 4, Prefix: -1, Timeout: 3000}})
+	check(caps.FakeUDP, desync.ErrUDPFakeUnsupported, DesyncOption{Name: "udp", UDP: &DesyncUDPOption{TTL: 4}})
+	check(caps.Disorder.Supported, desync.ErrDisorderUnsupported, DesyncOption{Name: "disorder", Split: "1+s", Disorder: true})
+	check(caps.OOB, desync.ErrOOBUnsupported, DesyncOption{Name: "oob", Split: "1+s", OOB: true})
+	check(caps.Ack.Sent, desync.ErrSplitWaitUnsupported, DesyncOption{Name: "sent", Split: "1+s", SplitWait: "sent"})
+	check(caps.Ack.Acked, desync.ErrSplitWaitUnsupported, DesyncOption{Name: "acked", Split: "1+s", SplitWait: "acked"})
+	if caps.FakeTCP {
+		// with a fallback TTL auto-ttl loads wherever one family is observable
+		check(caps.AutoTTL.IPv4 || caps.AutoTTL.IPv6, desync.ErrAutoTTLUnsupported,
+			DesyncOption{Name: "auto-ttl", Fake: &DesyncFakeOption{TTL: 4, AutoTTL: true, AutoTTLDelta: 2, AutoTTLMin: 3, AutoTTLMax: 12}})
+	}
