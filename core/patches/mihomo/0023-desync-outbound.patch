+func TestDesyncStableBinding(t *testing.T) {
+	if !desync.PlatformCapabilities().FakeUDP {
+		t.Skip("no UDP burst on this OS")
+	}
+	d, err := NewDesync(DesyncOption{Name: "SLOTH-DESYNC-DISCORD-UDP-test", UDP: &DesyncUDPOption{TTL: 4, Repeats: 1, StableBinding: true}})
+	require.NoError(t, err)
+	require.NotNil(t, d.desyncBindings)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	metadata := &C.Metadata{NetWork: C.UDP, Type: C.TUN, Process: "Discord.exe", SrcIP: netip.MustParseAddr("192.168.20.2"), SrcPort: 12345, DstIP: netip.MustParseAddr("1.1.1.1"), DstPort: 19330}
+	_, err = d.ListenPacketContext(ctx, metadata)
+	assert.ErrorIs(t, err, context.Canceled)
+	assert.Zero(t, d.desyncBindings.snapshot().NativeSockets, "a canceled listen created a native socket")
+	raw, err := d.MarshalJSON()
+	require.NoError(t, err)
+	assert.Contains(t, string(raw), `"binding"`)
+	assert.Contains(t, string(raw), `"stable-binding":true`)
+	require.NoError(t, d.Close())
+	d.desyncBindings.mu.Lock()
+	closed := d.desyncBindings.closed
+	d.desyncBindings.mu.Unlock()
+	assert.True(t, closed, "the outbound's Close shuts the pool down")
+}
