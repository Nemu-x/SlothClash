+	assert.NotEmpty(t, v.ID)
+	assert.Equal(t, "static", v.Desync.Strategy)
+	assert.Equal(t, []string{"1+s", "3"}, v.Desync.TCP.TLSRec)
+	assert.Equal(t, []string{"2"}, v.Desync.TCP.Split)
+	assert.Equal(t, 5, v.Desync.TCP.SplitDelay)
+	assert.Equal(t, "none", v.Desync.TCP.SplitWait)
+	assert.Nil(t, v.Desync.TCP.OOB)
+	assert.Equal(t, uint64(9), v.Desync.TCP.Random.Seed)
+	assert.Equal(t, []map[string]any{{"from": "-4+s", "to": "4+s", "count": 2.0, "min-piece": 1.0}}, v.Desync.TCP.Random.TLSRec)
+	assert.Nil(t, v.Desync.TCP.Fake)
+	assert.Nil(t, v.Desync.UDP)
+	assert.True(t, v.Desync.DNSFallback)
+	if assert.NotNil(t, v.Fallbacks, "the 0019 counter key of direct.desync") {
+		assert.Zero(t, *v.Fallbacks)
+	}
+}
