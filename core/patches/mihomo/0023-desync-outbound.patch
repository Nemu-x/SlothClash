@@ -0,0 +1,580 @@
+package outbound
+
+// SlothClash core patch 0023: a first-class "desync" outbound.
+//
+// It is a DIRECT connection whose first TLS ClientHello is transformed by
+// github.com/Nemu-x/desync, the same client-side library the named
+// direct.desync outbounds of patches 0017-0022 use. Those keep working
+// unchanged during the migration; this type exposes every option of the
+// library release the series pins and reuses Direct for name resolution,
+// loopback detection, the profile DNS fallback (0019), the UDP burst with
+// its counters and activity diagnostics (0019/0020), the stable UDP binding
+// pool (0021) and reject-quic (0022). The design follows Citrus'
+// adapter/outbound/desync.go; Citrus' egress guard does not exist in mihomo
+// and is not part of it.
+//
+// Remove when the migrated client no longer generates direct.desync and
+// mihomo carries an equivalent outbound; no upstream issue is claimed.
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net"
+	"strings"
+	"time"
+
+	N "github.com/metacubex/mihomo/common/net"
+	"github.com/metacubex/mihomo/component/dialer"
+	"github.com/metacubex/mihomo/component/loopback"
+	C "github.com/metacubex/mihomo/constant"
+
+	"github.com/Nemu-x/desync"
+)
+
+// Bounds of the options given in milliseconds. The library accepts longer
+// values for some of them; a configuration that needs them is almost
+// certainly a mistake.
+const (
+	desyncMaxSplitDelay       = time.Second
+	desyncMaxSplitWaitTimeout = time.Minute
+	desyncMaxFakeTimeout      = time.Minute
+)
+
+// desyncPlatform reports what the library implements on this OS. A variable
+// so that tests can check the configuration errors of every OS on any host.
+var desyncPlatform = desync.PlatformCapabilities
+
+// DesyncOption is the configuration of a "desync" outbound. Field names and
+// units follow Citrus' desync outbound (milliseconds, comma-separated
+// positions); the methods of desync v0.1.0 that Citrus does not have yet are
+// added in the same style.
+type DesyncOption struct {
+	BasicOption
+	Name string `proxy:"name"`
+	// TLSRec and Split are comma-separated positions: "3" is byte 3 of the
+	// TLS wire input, "1+s" one byte after the start of the server name.
+	TLSRec     string `proxy:"tlsrec,omitempty"`
+	Split      string `proxy:"split,omitempty"`
+	SplitDelay int    `proxy:"split-delay,omitempty"` // milliseconds between split writes
+	// SplitWait is "none" (default), "sent" or "acked": before each further
+	// split piece, wait until the kernel reports the earlier bytes as such.
+	SplitWait        string `proxy:"split-wait,omitempty"`
+	SplitWaitTimeout int    `proxy:"split-wait-timeout,omitempty"` // milliseconds; 0 = library default (2 s)
+	// Disorder sends the first split piece with hop limit 1 (ByeDPI
+	// --disorder); OOB sends one urgent byte after it (--oob); both: --disoob.
+	Disorder bool                `proxy:"disorder,omitempty"`
+	OOB      bool                `proxy:"oob,omitempty"`
+	OOBByte  string              `proxy:"oob-byte,omitempty"` // one character; empty = "a"
+	Random   *DesyncRandomOption `proxy:"random,omitempty"`
+	Fake     *DesyncFakeOption   `proxy:"fake,omitempty"`
+	UDP      *DesyncUDPOption    `proxy:"udp,omitempty"`
+	// DNSFallback retries an empty direct-nameserver answer with the
+	// profile's resolver (patch 0019).
+	DNSFallback bool `proxy:"dns-fallback,omitempty"`
+	// RejectQUIC rejects UDP/443 through this outbound, so browsers fall
+	// back to TCP where the ClientHello is transformed (patch 0022).
+	RejectQUIC bool `proxy:"reject-quic,omitempty"`
+}
+
+// DesyncRandomOption adds bounded random record and write cuts on top of
+// the fixed positions. Seed 0 draws a new seed per connection.
+type DesyncRandomOption struct {
+	TLSRec []DesyncRandomCut `proxy:"tlsrec,omitempty"`
+	Split  []DesyncRandomCut `proxy:"split,omitempty"`
+	Seed   uint64            `proxy:"seed,omitempty"`
+}
+
+// DesyncRandomCut draws count cuts from the inclusive range from..to (both
+// absolute or both "+s"), at least min-piece bytes apart.
+type DesyncRandomCut struct {
+	From     string `proxy:"from"`
+	To       string `proxy:"to"`
+	Count    int    `proxy:"count,omitempty"`     // 0 = 1
+	MinPiece int    `proxy:"min-piece,omitempty"` // 0 = 1
+}
+
+// DesyncFakeOption sends a low-TTL decoy as the first transmission of the
+// ClientHello prefix, or of the split piece ending at prefix. Windows,
+// Linux and Android; macOS cannot implement it.
+type DesyncFakeOption struct {
+	// TTL expires the fake before the server. With auto-ttl it is the
+	// fallback where the path cannot be observed; 0 then fails the write.
+	TTL int `proxy:"ttl,omitempty"`
+	// AutoTTL derives the TTL from the server's SYN-ACK (Linux/Android over
+	// IPv6 only): hops - delta, clamped to min..max (defaults 1, 3, 20).
+	AutoTTL      bool `proxy:"auto-ttl,omitempty"`
+	AutoTTLDelta int  `proxy:"auto-ttl-delta,omitempty"`
+	AutoTTLMin   int  `proxy:"auto-ttl-min,omitempty"`
+	AutoTTLMax   int  `proxy:"auto-ttl-max,omitempty"`
+	Prefix       int  `proxy:"prefix,omitempty"`  // after record fragmentation; negative counts from the end, 0 = -1
+	Timeout      int  `proxy:"timeout,omitempty"` // milliseconds for the native waits; 0 = library default (3 s)
+	// Decoy ClientHello: sni replaces the decoy's server name (one drawn per
+	// connection, * ? # are random), randomize refreshes its random values,
+	// from-original builds it from the real ClientHello, offset starts the
+	// decoy at a later byte.
+	SNI          []string `proxy:"sni,omitempty"`
+	Randomize    bool     `proxy:"randomize,omitempty"`
+	FromOriginal bool     `proxy:"from-original,omitempty"`
+	Offset       int      `proxy:"offset,omitempty"`
+}
+
+// DesyncUDPOption sends a bounded burst of low-TTL datagrams before the
+// first datagrams to each peer; without it UDP is plain DIRECT.
+type DesyncUDPOption struct {
+	TTL     int `proxy:"ttl"`
+	Repeats int `proxy:"repeats,omitempty"` // 0 = 6
+	Packets int `proxy:"packets,omitempty"` // 0 = 3
+	// Template is "zero" (64 zero bytes, default) or "quic-initial" (a QUIC
+	// v1 Initial for sni); quic-only bursts only before QUIC Initials.
+	Template string `proxy:"template,omitempty"`
+	SNI      string `proxy:"sni,omitempty"`
+	QUICOnly bool   `proxy:"quic-only,omitempty"`
+	// StableBinding keeps one native socket per Discord voice association
+	// across local port replacement (patch 0021).
+	StableBinding bool `proxy:"stable-binding,omitempty"`
+}
+
+// desyncStrategy picks the TCP transformation of one connection. Options is
+// called on every dial, so it must answer from configuration or a cache and
+// never run discovery itself. The only implementation today is the static,
+// explicitly configured one; a strategy controller (desync/controller) can
+// take its place later without touching the dial path.
+type desyncStrategy interface {
+	Options(metadata *C.Metadata) desync.Options
+	String() string
+}
+
+type staticDesyncStrategy struct{ opts desync.Options }
+
+func (s staticDesyncStrategy) Options(*C.Metadata) desync.Options { return s.opts }
+
+func (s staticDesyncStrategy) String() string { return "static" }
+
+// Desync is a DIRECT outbound that applies a desync transformation to its
+// connections. It owns the TCP dial so that the transformer is in place
+// before the first byte is written; UDP is Direct's path with the 0019-0022
+// options set from this configuration.
+type Desync struct {
+	*Direct
+	strategy desyncStrategy
+	tcp      desync.Options // the configured options, for the API
+}
+
+// DialContext implements C.ProxyAdapter
+func (d *Desync) DialContext(ctx context.Context, metadata *C.Metadata) (C.Conn, error) {
+	tcpOpts := d.strategy.Options(metadata)
+	var extra []dialer.Option
+	if tcpOpts.Fake != nil && tcpOpts.Fake.AutoTTL != nil {
+		// The server's TTL is recorded from the SYN-ACK only when the socket
+		// asked for it before connect. dialer copies this net.Dialer and
+		// chains its own interface/mark controls after this one.
+		extra = append(extra, dialer.WithNetDialer(&net.Dialer{Control: desync.ControlAutoTTL}))
+	}
+	c, err := d.dialTCP(ctx, metadata, extra...)
+	if err != nil {
+		return nil, err
+	}
+	if !tcpOpts.Enabled() {
+		return d.loopBack.NewConn(NewConn(c, d)), nil
+	}
+	return d.loopBack.NewConn(newDesyncConn(c, desync.WrapConn(c, tcpOpts), d)), nil
+}
+
+// MarshalJSON implements C.ProxyAdapter
+func (d *Desync) MarshalJSON() ([]byte, error) {
+	t := d.tcp
+	tcp := map[string]any{
+		"key":                t.Key(),
+		"tlsrec":             desyncPositions(t.TLSRec),
+		"split":              desyncPositions(t.Split),
+		"split-delay":        t.SplitDelay.Milliseconds(),
+		"split-wait":         t.SplitWait.String(),
+		"split-wait-timeout": t.SplitWaitTimeout.Milliseconds(),
+		"disorder":           t.Disorder,
+		"oob":                nil,
+		"random":             nil,
+		"fake":               nil,
+	}
+	if t.OOB != nil {
+		b := t.OOB.Byte
+		if b == 0 {
+			b = desync.DefaultOOBByte
+		}
+		tcp["oob"] = map[string]any{"byte": string(rune(b))}
+	}
+	if r := t.Random; r != nil {
+		tcp["random"] = map[string]any{"tlsrec": desyncRandomCuts(r.TLSRec), "split": desyncRandomCuts(r.Split), "seed": r.Seed}
+	}
+	if fake := t.Fake; fake != nil {
+		timeout := fake.Timeout
+		if timeout == 0 {
+			timeout = 3 * time.Second
+		}
+		f := map[string]any{"ttl": fake.TTL, "prefix": fake.Prefix, "timeout": timeout.Milliseconds(), "auto-ttl": nil,
+			"sni": append([]string{}, fake.SNI...), "randomize": fake.Randomize, "from-original": fake.FromOriginal, "offset": fake.Offset}
+		if a := fake.AutoTTL; a != nil {
+			f["auto-ttl"] = map[string]any{"delta": a.Delta, "min": a.Min, "max": a.Max}
+		}
+		tcp["fake"] = f
+	}
+	var udp any
+	if u := d.desyncUDP; u != nil {
+		udp = map[string]any{
+			"ttl":            u.TTL,
+			"repeats":        u.Repeats,
+			"packets":        u.Packets,
+			"template":       u.Template.String(),
+			"sni":            u.SNI,
+			"quic-only":      u.QUICOnly,
+			"stable-binding": d.desyncBindings != nil,
+			"counters":       u.Counters.Snapshot(),
+		}
+	}
+	// One key of its own: Proxy.MarshalJSON adds "udp" and others next to
+	// it. The 0019-0022 diagnostics keep the keys of a direct.desync
+	// outbound, so the client reads both kinds the same way.
+	out := map[string]any{
+		"type": d.Type().String(),
+		"id":   d.Id(),
+		"desync": map[string]any{
+			"strategy":     d.strategy.String(),
+			"tcp":          tcp,
+			"udp":          udp,
+			"dns-fallback": d.desyncDNSFallback,
+			"reject-quic":  d.desyncRejectQUIC,
+		},
+	}
+	if d.desyncDNSFallback {
+		out["desyncDNSFallbacks"] = d.desyncDNSFallbacks.Load()
+	}
+	if u := d.desyncUDP; u != nil {
+		diag := map[string]any{"ttl": u.TTL, "repeats": u.Repeats, "packets": u.Packets, "counters": u.Counters.Snapshot(), "activity": d.desyncActivity.snapshot()}
+		if d.desyncBindings != nil {
+			diag["binding"] = d.desyncBindings.snapshot()
+		}
+		out["desyncUDP"] = diag
+	}
+	return json.Marshal(out)
+}
+
+func desyncPositions(positions []desync.Pos) []string {
+	out := make([]string, 0, len(positions))
+	for _, p := range positions {
+		out = append(out, p.String())
+	}
+	return out
+}
+
+func desyncRandomCuts(cuts []desync.RandomCut) []map[string]any {
+	out := make([]map[string]any, 0, len(cuts))
+	for _, c := range cuts {
+		out = append(out, map[string]any{"from": c.From.String(), "to": c.To.String(), "count": c.Count, "min-piece": c.MinPiece})
+	}
+	return out
+}
+
+func desyncMilliseconds(name string, ms int, limit time.Duration) (time.Duration, error) {
+	d := time.Duration(ms) * time.Millisecond
+	if ms < 0 || d > limit {
+		return 0, fmt.Errorf("%s must be between 0 and %d ms", name, limit.Milliseconds())
+	}
+	return d, nil
+}
+
+// desyncUnsupported names the method, the OS and the library's reason.
+func desyncUnsupported(caps desync.Capabilities, method, key string, err error) error {
+	reason := caps.Unsupported[key]
+	if reason == "" {
+		reason = "not implemented on " + caps.OS
+	}
+	return fmt.Errorf("%s is not supported on %s (%s): %w", method, caps.OS, reason, err)
+}
+
+func (o DesyncOption) randomOptions() (*desync.RandomOptions, error) {
+	if o.Random == nil {
+		return nil, nil
+	}
+	cuts := func(name string, in []DesyncRandomCut) ([]desync.RandomCut, error) {
+		var out []desync.RandomCut
+		for i, c := range in {
+			from, err := desync.ParsePos(c.From)
+			if err != nil {
+				return nil, fmt.Errorf("random %s[%d] from: %w", name, i, err)
+			}
+			to, err := desync.ParsePos(c.To)
+			if err != nil {
+				return nil, fmt.Errorf("random %s[%d] to: %w", name, i, err)
+			}
+			out = append(out, desync.RandomCut{From: from, To: to, Count: c.Count, MinPiece: c.MinPiece})
+		}
+		return out, nil
+	}
+	r := &desync.RandomOptions{Seed: o.Random.Seed}
+	var err error
+	if r.TLSRec, err = cuts("tlsrec", o.Random.TLSRec); err != nil {
+		return nil, err
+	}
+	if r.Split, err = cuts("split", o.Random.Split); err != nil {
+		return nil, err
+	}
+	if len(r.TLSRec) == 0 && len(r.Split) == 0 {
+		return nil, errors.New("random needs tlsrec or split ranges")
+	}
+	return r, nil
+}
+
+func (o DesyncOption) fakeOptions(caps desync.Capabilities) (*desync.FakeOptions, error) {
+	f := o.Fake
+	if f == nil {
+		return nil, nil
+	}
+	if !caps.FakeTCP {
+		return nil, desyncUnsupported(caps, "fake", "fake-tcp", desync.ErrFakeUnsupported)
+	}
+	timeout, err := desyncMilliseconds("fake timeout", f.Timeout, desyncMaxFakeTimeout)
+	if err != nil {
+		return nil, err
+	}
+	opts := &desync.FakeOptions{TTL: f.TTL, Prefix: f.Prefix, Timeout: timeout,
+		SNI: f.SNI, Randomize: f.Randomize, FromOriginal: f.FromOriginal, Offset: f.Offset}
+	if !f.AutoTTL {
+		if f.AutoTTLDelta != 0 || f.AutoTTLMin != 0 || f.AutoTTLMax != 0 {
+			return nil, errors.New("fake auto-ttl-delta, auto-ttl-min and auto-ttl-max need auto-ttl: true")
+		}
+		if f.TTL == 0 {
+			return nil, errors.New("fake needs ttl (or auto-ttl)")
+		}
+		return opts, nil
+	}
+	// The TTL of the server can be read on few platforms; where it cannot,
+	// auto-ttl would silently always use the fallback, so it is refused.
+	v4, v6 := caps.AutoTTL.IPv4, caps.AutoTTL.IPv6
+	switch {
+	case !v4 && !v6:
+		reason := caps.Unsupported["auto-ttl-ipv4"]
+		if r6 := caps.Unsupported["auto-ttl-ipv6"]; r6 != reason {
+			reason = "IPv4: " + reason + "; IPv6: " + r6
+		}
+		return nil, fmt.Errorf("fake auto-ttl is not supported on %s (%s): %w", caps.OS, reason, desync.ErrAutoTTLUnsupported)
+	case o.IPVersion == C.IPv4Only && !v4:
+		return nil, fmt.Errorf("fake auto-ttl cannot observe IPv4 on %s (%s), and ip-version is ipv4: %w",
+			caps.OS, caps.Unsupported["auto-ttl-ipv4"], desync.ErrAutoTTLUnsupported)
+	case o.IPVersion == C.IPv6Only && !v6:
+		return nil, fmt.Errorf("fake auto-ttl cannot observe IPv6 on %s (%s), and ip-version is ipv6: %w",
+			caps.OS, caps.Unsupported["auto-ttl-ipv6"], desync.ErrAutoTTLUnsupported)
+	case f.TTL == 0 && (!v4 && o.IPVersion != C.IPv6Only || !v6 && o.IPVersion != C.IPv4Only):
+		// Linux observes IPv6 only: an IPv4 connection would fail its first
+		// write. Ask for the fallback instead of failing at dial time.
+		missing, reason := "IPv4", caps.Unsupported["auto-ttl-ipv4"]
+		if v4 {
+			missing, reason = "IPv6", caps.Unsupported["auto-ttl-ipv6"]
+		}
+		return nil, fmt.Errorf("fake auto-ttl cannot observe %s on %s (%s): set ttl as the fallback or restrict ip-version", missing, caps.OS, reason)
+	}
+	opts.AutoTTL = &desync.AutoTTL{Delta: f.AutoTTLDelta, Min: f.AutoTTLMin, Max: f.AutoTTLMax}
+	return opts, nil
+}
+
+func (o DesyncOption) tcpOptions(caps desync.Capabilities) (opts desync.Options, err error) {
+	if opts.TLSRec, err = parseDirectDesyncPositions(o.TLSRec); err != nil {
+		return opts, fmt.Errorf("tlsrec: %w", err)
+	}
+	if opts.Split, err = parseDirectDesyncPositions(o.Split); err != nil {
+		return opts, fmt.Errorf("split: %w", err)
+	}
+	if opts.Random, err = o.randomOptions(); err != nil {
+		return opts, err
+	}
+	splits := len(opts.Split) > 0 || opts.Random != nil && len(opts.Random.Split) > 0
+	if opts.SplitDelay, err = desyncMilliseconds("split-delay", o.SplitDelay, desyncMaxSplitDelay); err != nil {
+		return opts, err
+	}
+	if opts.SplitDelay > 0 && !splits {
+		return opts, errors.New("split-delay needs split positions")
+	}
+	if opts.SplitWait, err = desync.ParseSplitWait(strings.TrimSpace(o.SplitWait)); err != nil {
+		return opts, fmt.Errorf("split-wait: %w", err)
+	}
+	if opts.SplitWaitTimeout, err = desyncMilliseconds("split-wait-timeout", o.SplitWaitTimeout, desyncMaxSplitWaitTimeout); err != nil {
+		return opts, err
+	}
+	if opts.SplitWait != desync.SplitWaitNone {
+		if !splits {
+			return opts, errors.New("split-wait needs split positions")
+		}
+		if !caps.Ack.Supports(opts.SplitWait) {
+			reason := "no " + opts.SplitWait.String() + " observation"
+			if caps.Ack.Mechanism != "" {
+				reason += " through " + caps.Ack.Mechanism
+			}
+			return opts, fmt.Errorf("split-wait %s is not supported on %s (%s): %w", opts.SplitWait, caps.OS, reason, desync.ErrSplitWaitUnsupported)
+		}
+	} else if o.SplitWaitTimeout != 0 && !o.Disorder {
+		return opts, errors.New("split-wait-timeout needs split-wait or disorder")
+	}
+	if o.Disorder {
+		if !caps.Disorder.Supported {
+			return opts, desyncUnsupported(caps, "disorder", "disorder", desync.ErrDisorderUnsupported)
+		}
+		opts.Disorder = true
+	}
+	if o.OOB {
+		if !caps.OOB {
+			return opts, desyncUnsupported(caps, "oob", "oob", desync.ErrOOBUnsupported)
+		}
+		opts.OOB = &desync.OOBOptions{}
+		if o.OOBByte != "" {
+			if len(o.OOBByte) != 1 {
+				return opts, errors.New("oob-byte must be one ASCII character")
+			}
+			opts.OOB.Byte = o.OOBByte[0]
+		}
+	} else if o.OOBByte != "" {
+		return opts, errors.New("oob-byte needs oob: true")
+	}
+	if (opts.Disorder || opts.OOB != nil) && !splits {
+		return opts, errors.New("disorder and oob act on the first split piece: they need split positions")
+	}
+	if opts.Fake, err = o.fakeOptions(caps); err != nil {
+		return opts, err
+	}
+	return opts, opts.Validate()
+}
+
+func (o DesyncOption) udpOptions(caps desync.Capabilities) (*desync.UDPOptions, error) {
+	u := o.UDP
+	if u == nil {
+		return nil, nil
+	}
+	if !caps.FakeUDP {
+		return nil, desyncUnsupported(caps, "udp", "fake-udp", desync.ErrUDPFakeUnsupported)
+	}
+	opts := desync.UDPOptions{TTL: u.TTL, Repeats: u.Repeats, Packets: u.Packets, SNI: u.SNI, QUICOnly: u.QUICOnly}
+	switch strings.TrimSpace(u.Template) {
+	case "", desync.UDPTemplateZero.String():
+	case desync.UDPTemplateQUICInitial.String():
+		opts.Template = desync.UDPTemplateQUICInitial
+	default:
+		return nil, fmt.Errorf("udp template %q: expected zero or quic-initial", u.Template)
+	}
+	if err := opts.Validate(); err != nil {
+		return nil, err
+	}
+	// The library's defaults, filled in here so that the API shows them.
+	if opts.Repeats == 0 {
+		opts.Repeats = 6
+	}
+	if opts.Packets == 0 {
+		opts.Packets = 3
+	}
+	opts.Counters = &desync.UDPCounters{} // shared by all sockets of the outbound
+	return &opts, nil
+}
+
+// NewDesync validates the options; anything the platform or the library
+// cannot do is a configuration error naming the outbound, never a silent
+// plain DIRECT.
+func NewDesync(option DesyncOption) (*Desync, error) {
+	d, err := newDesync(option)
+	if err != nil {
+		return nil, fmt.Errorf("desync %q: %w", option.Name, err)
+	}
+	return d, nil
+}
+
+func newDesync(option DesyncOption) (*Desync, error) {
+	// TFO sends the first write with the SYN, before the transformer could
+	// cut it; MPTCP spreads it over subflows that no longer match the cuts,
+	// and the native methods need a plain TCP socket.
+	if option.TFO {
+		return nil, errors.New("tfo is not supported: the ClientHello would leave with the SYN")
+	}
+	if option.MPTCP {
+		return nil, errors.New("mptcp is not supported")
+	}
+	if option.DialerProxy != "" {
+		return nil, errors.New("dialer-proxy is not supported: desync dials directly")
+	}
+	caps := desyncPlatform()
+	tcp, err := option.tcpOptions(caps)
+	if err != nil {
+		return nil, err
+	}
+	udp, err := option.udpOptions(caps)
+	if err != nil {
+		return nil, err
+	}
+	if !tcp.Enabled() && udp == nil {
+		return nil, errors.New("set at least one of tlsrec, split, random, fake or udp")
+	}
+	direct := &Direct{
+		Base: NewBase(BaseOption{
+			Name:         option.Name,
+			Type:         C.Desync,
+			ProviderName: option.ProviderName,
+			UDP:          true,
+			Interface:    option.Interface,
+			RoutingMark:  option.RoutingMark,
+			Prefer:       option.IPVersion,
+		}),
+		// its own detector: a desync connection coming back through a
+		// listener is refused like a DIRECT one
+		loopBack:          loopback.NewDetector(),
+		desyncUDP:         udp,
+		desyncDNSFallback: option.DNSFallback,
+		desyncRejectQUIC:  option.RejectQUIC,
+	}
+	if udp != nil {
+		direct.desyncActivity = &directUDPActivity{}
+		if option.UDP.StableBinding {
+			direct.desyncBindings = newDesyncBindingPool()
+		}
+	}
+	return &Desync{
+		Direct:   direct,
+		strategy: staticDesyncStrategy{tcp},
+		tcp:      tcp,
+	}, nil
+}
+
+// desyncConn is the transformed side of a desync TCP connection.
+//
+// The transformer must see the ClientHello, so no relay fast path may write
+// to the socket underneath it: desyncConn exposes neither the socket
+// (NetConn, Upstream, SyscallConn: splice, sendfile, writev batching) nor a
+// replaceable writer. It stays on the write path for the whole connection,
+// not just the ClientHello: a native fake may still own the socket after
+// the hello was accepted, and an extra copy of the upload is cheap next to a
+// bypass. Reads are untouched by desync, so the reader is replaceable and the
+// relay reads the socket directly (splice of the download on Linux).
+type desyncConn struct {
+	net.Conn          // *desync.Conn
+	socket   net.Conn // the dialed socket, for reading only
+}
+
+func newDesyncConn(socket, transformed net.Conn, a C.ProxyAdapter) C.Conn {
+	dc := &desyncConn{Conn: transformed, socket: socket}
+	// Not NewConn: the deadline wrapper it adds for outbound conns is not
+	// needed (deadlines go to the transformer and the socket) and would hide
+	// the raw reader.
+	cc := &conn{ExtendedConn: N.NewExtendedConn(dc), adapterAddr: a.Addr()}
+	cc.AppendToChains(a)
+	return cc
+}
+
+// UpstreamReader implements network.WithUpstreamReader
+func (c *desyncConn) UpstreamReader() any { return c.socket }
+
+// ReaderReplaceable implements network.ReaderWithUpstream
+func (c *desyncConn) ReaderReplaceable() bool { return true }
+
+// CloseWrite half-closes the socket. A ClientHello still being assembled at
+// that point is incomplete and is dropped, as it would be on Close.
+func (c *desyncConn) CloseWrite() error {
+	if cw, ok := c.socket.(interface{ CloseWrite() error }); ok {
+		return cw.CloseWrite()
+	}
+	return c.Conn.Close()
+}
diff --git a/adapter/outbound/desync_fake_test.go b/adapter/outbound/desync_fake_test.go
new file mode 100644
