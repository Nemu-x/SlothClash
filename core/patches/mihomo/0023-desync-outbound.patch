+// On this OS: the methods it lacks fail, the ones it has load (also the
+// ones it decides per socket, as Android does).
+func TestDesyncPlatformMethods(t *testing.T) {
+	caps := desync.PlatformCapabilities()
+	fake := caps.FakeTCP || desyncConditional(caps, "fake-tcp")
+	check := func(ok bool, sentinel error, option DesyncOption) {
+		t.Helper()
+		d, err := NewDesync(option)
+		if ok {
+			if assert.NoError(t, err, option.Name) {
+				_ = d.Close()
+			}
+		} else {
+			assert.ErrorIs(t, err, sentinel, option.Name)
+		}
+	}
+	check(fake, desync.ErrFakeUnsupported, DesyncOption{Name: "fake", TLSRec: "1+s", Fake: &DesyncFakeOption{TTL: 4, Prefix: -1, Timeout: 3000}})
+	check(caps.FakeUDP, desync.ErrUDPFakeUnsupported, DesyncOption{Name: "udp", UDP: &DesyncUDPOption{TTL: 4}})
+	check(caps.Disorder.Supported || desyncConditional(caps, "disorder"), desync.ErrDisorderUnsupported, DesyncOption{Name: "disorder", Split: "1+s", Disorder: true})
+	check(caps.OOB, desync.ErrOOBUnsupported, DesyncOption{Name: "oob", Split: "1+s", OOB: true})
+	check(caps.Ack.Sent || desyncConditional(caps, "split-wait-sent"), desync.ErrSplitWaitUnsupported, DesyncOption{Name: "sent", Split: "1+s", SplitWait: "sent"})
+	check(caps.Ack.Acked, desync.ErrSplitWaitUnsupported, DesyncOption{Name: "acked", Split: "1+s", SplitWait: "acked"})
+	if fake {
+		// with a fallback TTL auto-ttl loads wherever one family is observable
+		// with a fallback ttl auto-ttl loads wherever the fake exists (as in
+		// Citrus it only logs where the path cannot be observed); without
+		// one it needs an observable family
+		check(true, nil, DesyncOption{Name: "auto-ttl", Fake: &DesyncFakeOption{TTL: 4, AutoTTL: &DesyncAutoTTLOption{Delta: 2, Min: 3, Max: 12}}})
+		check(caps.AutoTTL.IPv4 || caps.AutoTTL.IPv6, desync.ErrAutoTTLUnsupported,
+			DesyncOption{Name: "auto-ttl only", Fake: &DesyncFakeOption{AutoTTL: &DesyncAutoTTLOption{}}})
+	}
+}
