+// What an OS cannot do is a configuration error that names the method, the
+// OS and why, with the library's sentinel error.
+func TestDesyncPlatformErrors(t *testing.T) {
+	old := desyncPlatform
+	t.Cleanup(func() { desyncPlatform = old })
+	for _, tc := range []struct {
+		os     string
+		option DesyncOption
+		is     error
+		says   string
+	}{
+		{"darwin", DesyncOption{TLSRec: "1+s", Fake: &DesyncFakeOption{TTL: 4}}, desync.ErrFakeUnsupported, "fake is not supported on darwin (no splice"},
+		{"darwin", DesyncOption{Split: "2", SplitWait: "sent"}, desync.ErrSplitWaitUnsupported, "split-wait sent is not supported on darwin (no sent observation through SO_NWRITE)"},
+		{"windows", DesyncOption{Fake: &DesyncFakeOption{TTL: 4, AutoTTL: true}}, desync.ErrAutoTTLUnsupported, "fake auto-ttl is not supported on windows (IPv4: no received TTL for TCP; IPv6: no received hop limit for TCP)"},
+		{"linux", DesyncOption{Fake: &DesyncFakeOption{AutoTTL: true}}, nil, "fake auto-ttl cannot observe IPv4 on linux (tcp_v4_do_rcv records no TTL): set ttl as the fallback or restrict ip-version"},
+		{"linux", DesyncOption{BasicOption: BasicOption{IPVersion: C.IPv4Only}, Fake: &DesyncFakeOption{TTL: 4, AutoTTL: true}}, desync.ErrAutoTTLUnsupported, "cannot observe IPv4 on linux"},
+		{"darwin", DesyncOption{BasicOption: BasicOption{IPVersion: C.IPv6Only}, Fake: &DesyncFakeOption{TTL: 4, AutoTTL: true}}, desync.ErrFakeUnsupported, "fake is not supported on darwin"},
+		{"plan9", DesyncOption{Split: "2", Disorder: true}, desync.ErrDisorderUnsupported, "disorder is not supported on plan9 (not implemented on plan9)"},
+		{"plan9", DesyncOption{Split: "2", OOB: true}, desync.ErrOOBUnsupported, "oob is not supported on plan9"},
+		{"plan9", DesyncOption{UDP: &DesyncUDPOption{TTL: 4}}, desync.ErrUDPFakeUnsupported, "udp is not supported on plan9"},
+	} {
+		desyncPlatform = func() desync.Capabilities { return fakePlatform(tc.os) }
+		tc.option.Name = tc.os
+		_, err := NewDesync(tc.option)
+		if assert.Error(t, err, tc.says) {
+			if tc.is != nil {
+				assert.ErrorIs(t, err, tc.is)
+			}
+			assert.Contains(t, err.Error(), tc.says)
+		}
+	}
+}
