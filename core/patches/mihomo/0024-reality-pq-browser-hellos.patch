@@ -0,0 +1,307 @@
+package tls
+
+import (
+	"errors"
+	"net"
+
+	utls "github.com/metacubex/utls"
+	"github.com/metacubex/utls/dicttls"
+)
+
+// Current-browser ClientHellos for the REALITY handshakes that need the
+// X25519MLKEM768 key share (Xray 26.9.8+ forwards a hello without it to the
+// cover site). In metacubex/utls v1.8.8 only the chrome parrot carries that
+// share: "firefox" is Firefox 120 and "safari" is Safari 16.0, both older than
+// post-quantum TLS. Without these specs a firefox or safari proxy has to borrow
+// chrome's hello for such a server, which changes the fingerprint the user
+// chose.
+//
+// The two specs are HelloFirefox_148 and HelloSafari_26_3 from metacubex/utls
+// branch v1.9.0-mod-meta (a6a364a), the same parrots Xray 26.10.x itself sends
+// as "firefox" and "safari". Only the data is carried here; the library stays on
+// the released v1.8.8. Delete this file when mihomo moves to a utls release
+// that ships them.
+
+type realityPQHello struct {
+	name string
+	spec func() *utls.ClientHelloSpec // a fresh spec per handshake: ApplyPreset fills it in
+	// reuseX25519: the standalone X25519 share repeats the X25519 half of the
+	// hybrid share (one key, as Firefox sends it). v1.8.8's ApplyPreset generates
+	// a separate key for each share, so the reuse is applied afterwards.
+	reuseX25519 bool
+}
+
+// realityPQHelloFor returns the post-quantum hello for a fingerprint family
+// whose v1.8.8 parrot cannot offer X25519MLKEM768, or false when there is none.
+func realityPQHelloFor(fingerprint UClientHelloID) (realityPQHello, bool) {
+	switch fingerprint.Client {
+	case utls.HelloFirefox_Auto.Client:
+		return realityPQHello{name: "Firefox 148", spec: realityFirefox148, reuseX25519: true}, true
+	case utls.HelloSafari_Auto.Client:
+		return realityPQHello{name: "Safari 26.3", spec: realitySafari26_3}, true
+	}
+	return realityPQHello{}, false
+}
+
+// realityPQConn builds the handshake state from a post-quantum hello.
+// HelloCustom keeps BuildHandshakeState from applying a preset of its own.
+func realityPQConn(conn net.Conn, config *utls.Config, hello realityPQHello) (*utls.UConn, error) {
+	uConn := utls.UClient(conn, config, utls.HelloCustom)
+	if err := uConn.ApplyPreset(hello.spec()); err != nil {
+		return nil, err
+	}
+	if hello.reuseX25519 {
+		if err := realityReuseX25519(uConn); err != nil {
+			return nil, err
+		}
+	}
+	if err := uConn.BuildHandshakeState(); err != nil {
+		return nil, err
+	}
+	return uConn, nil
+}
+
+// realityReuseX25519 makes the standalone X25519 share carry the X25519 key of
+// the hybrid share and points the classical private key at it, so whichever
+// share the server picks (and the REALITY auth key, derived from the X25519
+// share) uses the one key.
+func realityReuseX25519(uConn *utls.UConn) error {
+	keys := uConn.HandshakeState.State13.KeyShareKeys
+	if keys == nil || keys.MlkemEcdhe == nil {
+		return errors.New("REALITY: no X25519MLKEM768 key to reuse")
+	}
+	for _, ext := range uConn.Extensions {
+		ks, ok := ext.(*utls.KeyShareExtension)
+		if !ok {
+			continue
+		}
+		for i := range ks.KeyShares {
+			if ks.KeyShares[i].Group == utls.X25519 {
+				ks.KeyShares[i].Data = keys.MlkemEcdhe.PublicKey().Bytes()
+				keys.Ecdhe = keys.MlkemEcdhe
+				return nil
+			}
+		}
+	}
+	return errors.New("REALITY: no X25519 key share to reuse")
+}
+
