diff --git a/component/geodata/pin.go b/component/geodata/pin.go
new file mode 100644
index 00000000..0c94bd97
--- /dev/null
+++ b/component/geodata/pin.go
@@ -0,0 +1,120 @@
+package geodata
+
+// ClashFest core patch 0027: geox-sha256, Citrus' optional SHA-256 pins of the remote geodata
+// (getmikan/Citrus 395e8d4b, 85e07053, component/geodata/auth.go). A pinned database with another
+// SHA-256 is refused, whether it is downloaded at start, found on disk or fetched by the updater.
+// Without a pin (the key absent or empty) nothing is checked, as in mihomo: the publishers sign none
+// of these files.
+
+import (
+	"crypto/sha256"
+	"crypto/subtle"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+	"sync/atomic"
+)
+
+type AssetType string
+
+const (
+	AssetGeoIP   AssetType = "geoip"
+	AssetMMDB    AssetType = "mmdb"
+	AssetASN     AssetType = "asn"
+	AssetGeoSite AssetType = "geosite"
+)
+
+var ErrAssetPinMismatch = errors.New("remote geodata SHA-256 mismatch")
+
+// VerificationPolicy holds the per-type SHA-256 pins, lowercase hex; "" is no pin.
+type VerificationPolicy struct {
+	GeoIP, MMDB, ASN, GeoSite string
+}
+
+// IsZero reports whether no database is pinned.
+func (p VerificationPolicy) IsZero() bool { return p == VerificationPolicy{} }
+
+var verificationPolicy atomic.Pointer[VerificationPolicy]
+
+func SetVerificationPolicy(policy VerificationPolicy) {
+	policy.GeoIP = strings.ToLower(strings.TrimSpace(policy.GeoIP))
+	policy.MMDB = strings.ToLower(strings.TrimSpace(policy.MMDB))
+	policy.ASN = strings.ToLower(strings.TrimSpace(policy.ASN))
+	policy.GeoSite = strings.ToLower(strings.TrimSpace(policy.GeoSite))
+	verificationPolicy.Store(&policy)
+}
+
+func CurrentVerificationPolicy() VerificationPolicy {
+	if policy := verificationPolicy.Load(); policy != nil {
+		return *policy
+	}
+	return VerificationPolicy{}
+}
+
+// ValidatePin checks a geox-sha256 value: empty or 64 hex characters.
+func ValidatePin(pin string) error {
+	pin = strings.TrimSpace(pin)
+	if pin == "" {
+		return nil
+	}
+	if b, err := hex.DecodeString(pin); err != nil || len(b) != sha256.Size {
+		return errors.New("must be a 64-character SHA-256 hex digest")
+	}
+	return nil
+}
+
+func (p VerificationPolicy) pin(asset AssetType) string {
+	switch asset {
+	case AssetGeoIP:
+		return p.GeoIP
+	case AssetMMDB:
+		return p.MMDB
+	case AssetASN:
+		return p.ASN
+	case AssetGeoSite:
+		return p.GeoSite
+	default:
+		return ""
+	}
+}
+
+// pinned reports whether asset has a pin.
+func pinned(asset AssetType) bool {
+	return CurrentVerificationPolicy().pin(asset) != ""
+}
+
+// VerifyRemoteAsset checks data against the pin of asset; no pin passes.
+func VerifyRemoteAsset(asset AssetType, data []byte) error {
+	return VerifyRemoteDigest(asset, sha256.Sum256(data))
+}
+
+// VerifyRemoteDigest checks a SHA-256 digest against the pin of asset; no pin passes.
+func VerifyRemoteDigest(asset AssetType, digest [sha256.Size]byte) error {
+	pin := CurrentVerificationPolicy().pin(asset)
+	if pin == "" {
+		return nil
+	}
+	want, err := hex.DecodeString(pin)
+	if err != nil || len(want) != sha256.Size {
+		return fmt.Errorf("invalid configured SHA-256 pin for %s", asset)
+	}
+	if subtle.ConstantTimeCompare(digest[:], want) != 1 {
+		return fmt.Errorf("%w: %s", ErrAssetPinMismatch, asset)
+	}
+	return nil
+}
+
+// verifyExistingAsset checks the file at path against the pin of asset. Without a pin the file is
+// not read.
+func verifyExistingAsset(asset AssetType, path string) error {
+	if !pinned(asset) {
+		return nil
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return err
+	}
+	return VerifyRemoteAsset(asset, data)
+}
diff --git a/component/geodata/pin_test.go b/component/geodata/pin_test.go
new file mode 100644
index 00000000..d4ccf34c
--- /dev/null
+++ b/component/geodata/pin_test.go
@@ -0,0 +1,126 @@
+package geodata
+
+// ClashFest core patch 0027: geox-sha256 pins.
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func usePins(t *testing.T, policy VerificationPolicy) {
+	t.Helper()
+	old := CurrentVerificationPolicy()
+	t.Cleanup(func() { SetVerificationPolicy(old) })
+	SetVerificationPolicy(policy)
+}
+
+func pinOf(data []byte) string { return fmt.Sprintf("%x", sha256.Sum256(data)) }
+
+func TestValidatePin(t *testing.T) {
+	for _, ok := range []string{"", "  ", strings.Repeat("a", 64), strings.Repeat("F", 64)} {
+		if err := ValidatePin(ok); err != nil {
+			t.Errorf("%q: %v", ok, err)
+		}
+	}
+	for _, bad := range []string{"abc", strings.Repeat("a", 63), strings.Repeat("g", 64), strings.Repeat("a", 66)} {
+		if err := ValidatePin(bad); err == nil {
+			t.Errorf("%q accepted", bad)
+		}
+	}
+}
+
+func TestVerifyRemoteAsset(t *testing.T) {
+	data := []byte("geo")
+	pin := pinOf(data)
+	usePins(t, VerificationPolicy{GeoIP: pin, MMDB: pin, ASN: pin, GeoSite: strings.ToUpper(pin)})
+	for _, asset := range []AssetType{AssetGeoIP, AssetMMDB, AssetASN, AssetGeoSite} {
+		if err := VerifyRemoteAsset(asset, data); err != nil {
+			t.Errorf("%s correct pin: %v", asset, err)
+		}
+		if err := VerifyRemoteAsset(asset, []byte("tampered")); !errors.Is(err, ErrAssetPinMismatch) {
+			t.Errorf("%s accepted a wrong digest: %v", asset, err)
+		}
+	}
+	// no pin, the default: everything passes, as in mihomo
+	SetVerificationPolicy(VerificationPolicy{})
+	if err := VerifyRemoteAsset(AssetGeoIP, data); err != nil {
+		t.Fatalf("unpinned database rejected: %v", err)
+	}
+	// one pinned type does not pin the others
+	SetVerificationPolicy(VerificationPolicy{GeoSite: pin})
+	if err := VerifyRemoteAsset(AssetGeoIP, []byte("anything")); err != nil {
+		t.Fatalf("unpinned geoip rejected: %v", err)
+	}
+}
+
+func TestExistingAssetMustMatchCurrentPin(t *testing.T) {
+	data := []byte("existing")
+	path := filepath.Join(t.TempDir(), "GeoIP.dat")
+	if err := os.WriteFile(path, data, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	usePins(t, VerificationPolicy{})
+	// without a pin the file is not even read
+	if err := verifyExistingAsset(AssetGeoIP, filepath.Join(t.TempDir(), "missing")); err != nil {
+		t.Fatal(err)
+	}
+	SetVerificationPolicy(VerificationPolicy{GeoIP: pinOf(data)})
+	if err := verifyExistingAsset(AssetGeoIP, path); err != nil {
+		t.Fatal(err)
+	}
+	SetVerificationPolicy(VerificationPolicy{GeoIP: fmt.Sprintf("%064x", 1)})
+	if err := verifyExistingAsset(AssetGeoIP, path); err == nil {
+		t.Fatal("an existing file bypassed the pin")
+	}
+}
+
+func TestPinnedDownload(t *testing.T) {
+	payload := []byte("candidate database")
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) { _, _ = w.Write(payload) }))
+	defer srv.Close()
+	dir := t.TempDir()
+	path := filepath.Join(dir, "GeoSite.dat")
+	old := bytes.Repeat([]byte{'x'}, 100)
+	if err := os.WriteFile(path, old, 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	// a download with another SHA-256 leaves the old file and no temporary file
+	usePins(t, VerificationPolicy{GeoSite: fmt.Sprintf("%064x", 1)})
+	if err := downloadToPath(AssetGeoSite, srv.URL, path); !errors.Is(err, ErrAssetPinMismatch) {
+		t.Fatalf("want a pin mismatch, got %v", err)
+	}
+	if got, _ := os.ReadFile(path); !bytes.Equal(got, old) {
+		t.Fatal("a rejected download replaced the file")
+	}
+	if entries, _ := os.ReadDir(dir); len(entries) != 1 {
+		t.Fatalf("temporary files left behind: %v", entries)
+	}
+
+	// the matching one replaces the file as a whole
+	SetVerificationPolicy(VerificationPolicy{GeoSite: pinOf(payload)})
+	if err := downloadToPath(AssetGeoSite, srv.URL, path); err != nil {
+		t.Fatal(err)
+	}
+	if got, _ := os.ReadFile(path); !bytes.Equal(got, payload) {
+		t.Fatalf("file has %q", got)
+	}
+
+	// without a pin mihomo's download runs
+	SetVerificationPolicy(VerificationPolicy{})
+	fresh := filepath.Join(dir, "GeoIP.dat")
+	if err := downloadToPath(AssetGeoIP, srv.URL, fresh); err != nil {
+		t.Fatal(err)
+	}
+	if got, _ := os.ReadFile(fresh); !bytes.Equal(got, payload) {
+		t.Fatalf("file has %q", got)
+	}
+}
