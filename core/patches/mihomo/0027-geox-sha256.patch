+// geoXSHA256 returns the installed geox-sha256 pins, nil when there are none (ClashFest core patch 0027).
+func geoXSHA256() *config.GeoXSHA256 {
+	policy := geodata.CurrentVerificationPolicy()
+	if policy.IsZero() {
+		return nil
+	}
+	return &config.GeoXSHA256{GeoIp: policy.GeoIP, Mmdb: policy.MMDB, ASN: policy.ASN, GeoSite: policy.GeoSite}
+}
+
+// setGeoXSHA256 installs the geox-sha256 pins, nil clears them (ClashFest core patch 0027).
+func setGeoXSHA256(pins *config.GeoXSHA256) {
+	if pins == nil {
+		geodata.SetVerificationPolicy(geodata.VerificationPolicy{})
+		return
+	}
+	geodata.SetVerificationPolicy(geodata.VerificationPolicy{
+		GeoIP: pins.GeoIp, MMDB: pins.Mmdb, ASN: pins.ASN, GeoSite: pins.GeoSite,
+	})
+}
