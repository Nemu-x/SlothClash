--- /dev/null
+++ b/config/geox_sha256_test.go
@@ -0,0 +1,37 @@
+package config
+
+// ClashFest core patch 0027: geox-sha256 is optional and validated.
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestParseGeoXSHA256(t *testing.T) {
+	for _, doc := range []string{"", "geox-sha256: {}\n", "geox-sha256:\n  geoip: \"\"\n  geosite: \"\"\n  mmdb: \"\"\n  asn: \"\"\n"} {
+		raw, err := UnmarshalRawConfig([]byte(doc))
+		require.NoError(t, err)
+		general, err := parseGeneral(raw)
+		require.NoError(t, err)
+		// no pin: nothing is checked and /configs shows no geox-sha256
+		assert.Nil(t, general.GeoXSHA256, "%q", doc)
+	}
+
+	pin := strings.Repeat("AB", 32)
+	raw, err := UnmarshalRawConfig([]byte("geox-sha256:\n  geosite: " + pin + "\n"))
+	require.NoError(t, err)
+	general, err := parseGeneral(raw)
+	require.NoError(t, err)
+	require.NotNil(t, general.GeoXSHA256)
+	assert.Equal(t, GeoXSHA256{GeoSite: strings.ToLower(pin)}, *general.GeoXSHA256)
+
+	for _, bad := range []string{"abc", strings.Repeat("z", 64)} {
+		raw, err := UnmarshalRawConfig([]byte("geox-sha256:\n  mmdb: " + bad + "\n"))
+		require.NoError(t, err)
+		_, err = parseGeneral(raw)
+		assert.ErrorContains(t, err, "geox-sha256.mmdb")
+	}
+}
