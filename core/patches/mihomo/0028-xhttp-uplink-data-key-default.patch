+// GetNormalizedUplinkDataKey returns the name the uplink data chunks are
+// sent under (and looked for) for the given placement. Without an explicit
+// uplink-data-key it falls back to the Xray-core defaults, "X-Data" for
+// headers and "x_data" for cookies; an empty key would put the payload in
+// headers named "-0", "-1", ... that no Xray-compatible server reads.
+func (c *Config) GetNormalizedUplinkDataKey(placement string) string {
+	if c.UplinkDataKey != "" {
+		return c.UplinkDataKey
+	}
+	if placement == PlacementCookie {
+		return "x_data"
+	}
+	return "X-Data"
+}
