@@ -0,0 +1,117 @@
+package xhttp
+
+import (
+	"bytes"
+	"encoding/base64"
+	"fmt"
+	"net"
+	"strings"
+	"testing"
+
+	"github.com/metacubex/http"
+	"github.com/metacubex/http/httptest"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestUplinkDataKeyDefaults(t *testing.T) {
+	assert.Equal(t, "X-Data", (&Config{}).GetNormalizedUplinkDataKey(PlacementHeader))
+	assert.Equal(t, "x_data", (&Config{}).GetNormalizedUplinkDataKey(PlacementCookie))
+	assert.Equal(t, "X-Data", (&Config{}).GetNormalizedUplinkDataKey(PlacementAuto))
+
+	explicit := &Config{UplinkDataKey: "X-Custom"}
+	assert.Equal(t, "X-Custom", explicit.GetNormalizedUplinkDataKey(PlacementHeader))
+	assert.Equal(t, "X-Custom", explicit.GetNormalizedUplinkDataKey(PlacementCookie))
+}
+
+// packetRequest builds a packet-up upload the way the client does.
+func packetRequest(t *testing.T, cfg *Config, method string, data []byte) *http.Request {
+	t.Helper()
+	req := httptest.NewRequest(method, "https://example.com/xhttp/session-a/0", nil)
+	require.NoError(t, cfg.FillPacketRequest(req, "session-a", "0", data))
+	return req
+}
+
+func decodeChunks(t *testing.T, chunks []string) []byte {
+	t.Helper()
+	out, err := base64.RawURLEncoding.DecodeString(strings.Join(chunks, ""))
+	require.NoError(t, err)
+	return out
+}
+
+func TestUplinkDataInHeadersUsesDefaultKey(t *testing.T) {
+	data := bytes.Repeat([]byte("synthetic-uplink-"), 300) // several chunks
+	cfg := &Config{Path: "/xhttp", Mode: "packet-up", UplinkHTTPMethod: http.MethodGet, UplinkDataPlacement: PlacementHeader, UplinkChunkSize: "1000"}
+	req := packetRequest(t, cfg, http.MethodGet, data)
+
+	var chunks []string
+	for i := 0; ; i++ {
+		v := req.Header.Get(fmt.Sprintf("X-Data-%d", i))
+		if v == "" {
+			break
+		}
+		chunks = append(chunks, v)
+	}
+	require.Greater(t, len(chunks), 1)
+	assert.Equal(t, data, decodeChunks(t, chunks))
+	for name := range req.Header {
+		assert.False(t, strings.HasPrefix(name, "-"), "header with an empty key prefix: %q", name)
+	}
+}
+
+func TestUplinkDataInCookiesUsesDefaultKey(t *testing.T) {
+	data := []byte("synthetic-uplink")
+	cfg := &Config{Path: "/xhttp", Mode: "packet-up", UplinkDataPlacement: PlacementCookie}
+	req := packetRequest(t, cfg, http.MethodPost, data)
+
+	c, err := req.Cookie("x_data_0")
+	require.NoError(t, err)
+	assert.Equal(t, data, decodeChunks(t, []string{c.Value}))
+	_, err = req.Cookie("_0")
+	assert.Error(t, err)
+}
+
+func TestUplinkDataExplicitKeyIsKept(t *testing.T) {
+	data := []byte("synthetic-uplink")
+	cfg := &Config{Path: "/xhttp", Mode: "packet-up", UplinkDataPlacement: PlacementHeader, UplinkDataKey: "X-Custom"}
+	req := packetRequest(t, cfg, http.MethodPost, data)
+	assert.Equal(t, data, decodeChunks(t, []string{req.Header.Get("X-Custom-0")}))
+	assert.Empty(t, req.Header.Get("X-Data-0"))
+
+	cfg = &Config{Path: "/xhttp", Mode: "packet-up", UplinkDataPlacement: PlacementCookie, UplinkDataKey: "custom"}
+	req = packetRequest(t, cfg, http.MethodPost, data)
+	c, err := req.Cookie("custom_0")
+	require.NoError(t, err)
+	assert.Equal(t, data, decodeChunks(t, []string{c.Value}))
+}
+
+// The server reads the same defaults, so a client and server that both leave
+// uplink-data-key unset agree with each other and with Xray-core.
+func TestServerReadsUplinkDataUnderDefaultKey(t *testing.T) {
+	for _, placement := range []string{PlacementHeader, PlacementCookie} {
+		t.Run(placement, func(t *testing.T) {
+			cfg := Config{Path: "/xhttp", Mode: "packet-up", UplinkDataPlacement: placement}
+			handler, err := NewServerHandler(ServerOption{
+				Config:      cfg,
+				ConnHandler: func(conn net.Conn) { _ = conn.Close() },
+			})
+			require.NoError(t, err)
+
+			data := []byte("synthetic-uplink")
+			req := packetRequest(t, &cfg, http.MethodPost, data)
+			if placement == PlacementHeader {
+				require.NotEmpty(t, req.Header.Get("X-Data-0"))
+			}
+			rec := httptest.NewRecorder()
+			handler.ServeHTTP(rec, req)
+			require.Equal(t, http.StatusOK, rec.Result().StatusCode)
+
+			session := handler.(*requestHandler).getSession("session-a")
+			require.NotNil(t, session)
+			buf := make([]byte, 64)
+			n, err := session.uploadQueue.Read(buf)
+			require.NoError(t, err)
+			assert.Equal(t, data, buf[:n])
+		})
+	}
+}
