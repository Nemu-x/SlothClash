@@ -0,0 +1,534 @@
+package tls
+
+import (
+	"bytes"
+	"context"
+	"crypto/ecdh"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/sha256"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/binary"
+	"encoding/hex"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"io"
+	"io/fs"
+	"math/big"
+	"net"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	utls "github.com/metacubex/utls"
+)
+
+// SlothClash core patch 0029. testdata/chrome155_clienthello.hex is the first
+// TLS record of a fresh connection of Google Chrome 155.0.8059.40 to
+// www.example.com, from refraction-networking/utls 6ebdceb2
+// (testdata/chrome155_clienthello.md there; SHA-256 of the handshake message
+// 235618e3...439a). The comparison follows Rerowros/veles
+// chrome155_veles_test.go: everything must match except what Chrome randomizes
+// (extension order, GREASE values, random, key material, the GREASE ECH body).
+
+const chrome155CaptureSHA256 = "235618e3922e52a71a9f6593a71ec4ca182dab6b3ab4e90a2a1733133e97439a"
+
+type chrome155Hello struct {
+	version      uint16
+	sessionIDLen int
+	cipherSuites []uint16
+	compression  []byte
+	extensionIDs []uint16          // wire order, GREASE as 0x0a0a
+	extensions   map[uint16][]byte // extension_data by type
+}
+
+func isGREASEValue(v uint16) bool { return v>>8 == v&0xff && v&0xf == 0xa }
+
+// parseChrome155Hello reads a ClientHello handshake message (with its header).
+func parseChrome155Hello(t *testing.T, raw []byte) chrome155Hello {
+	t.Helper()
+	if len(raw) < 4 || raw[0] != 1 || int(raw[1])<<16|int(raw[2])<<8|int(raw[3]) != len(raw)-4 {
+		t.Fatalf("not a ClientHello handshake message, %d bytes", len(raw))
+	}
+	b := raw[4:]
+	next := func(n int) []byte {
+		t.Helper()
+		if len(b) < n {
+			t.Fatal("ClientHello truncated")
+		}
+		out := b[:n]
+		b = b[n:]
+		return out
+	}
+	var hello chrome155Hello
+	hello.version = binary.BigEndian.Uint16(next(2))
+	next(32) // random
+	hello.sessionIDLen = len(next(int(next(1)[0])))
+	suites := next(int(binary.BigEndian.Uint16(next(2))))
+	for i := 0; i+1 < len(suites); i += 2 {
+		hello.cipherSuites = append(hello.cipherSuites, binary.BigEndian.Uint16(suites[i:]))
+	}
+	hello.compression = next(int(next(1)[0]))
+	if extLen := int(binary.BigEndian.Uint16(next(2))); extLen != len(b) {
+		t.Fatalf("extensions length %d, %d bytes left", extLen, len(b))
+	}
+	hello.extensions = map[uint16][]byte{}
+	for len(b) > 0 {
+		id := binary.BigEndian.Uint16(next(2))
+		data := next(int(binary.BigEndian.Uint16(next(2))))
+		if isGREASEValue(id) {
+			id = 0x0a0a
+		}
+		hello.extensionIDs = append(hello.extensionIDs, id)
+		hello.extensions[id] = data
+	}
+	return hello
+}
+
+// ungreaseList replaces GREASE values in a uint16 list that starts at offset.
+func ungreaseList(data []byte, offset int) []byte {
+	out := bytes.Clone(data)
+	for i := offset; i+1 < len(out); i += 2 {
+		if isGREASEValue(binary.BigEndian.Uint16(out[i:])) {
+			out[i], out[i+1] = 0x0a, 0x0a
+		}
+	}
+	return out
+}
+
+// keyShareLayout returns "group:length" of every key share, GREASE as 0a0a.
+func keyShareLayout(t *testing.T, data []byte) []string {
+	t.Helper()
+	var out []string
+	for b := data[2:]; len(b) > 0; {
+		if len(b) < 4 {
+			t.Fatal("key_share truncated")
+		}
+		group, n := binary.BigEndian.Uint16(b), int(binary.BigEndian.Uint16(b[2:]))
+		if isGREASEValue(group) {
+			group = 0x0a0a
+		}
+		out = append(out, hex.EncodeToString([]byte{byte(group >> 8), byte(group), byte(n >> 8), byte(n)}))
+		b = b[4+n:]
+	}
+	return out
+}
+
+func chrome155Capture(t *testing.T) (record []byte, hello chrome155Hello) {
+	t.Helper()
+	fixture, err := os.ReadFile(filepath.Join("testdata", "chrome155_clienthello.hex"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	record, err = hex.DecodeString(strings.TrimSpace(string(fixture)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if sum := sha256.Sum256(record[5:]); hex.EncodeToString(sum[:]) != chrome155CaptureSHA256 {
+		t.Fatalf("capture SHA-256 %x, want %s", sum, chrome155CaptureSHA256)
+	}
+	return record, parseChrome155Hello(t, record[5:])
+}
+
+func buildHelloByName(t *testing.T, name string, config *utls.Config) []byte {
+	t.Helper()
+	id, ok := GetFingerprint(name)
+	if !ok {
+		t.Fatalf("fingerprint %q not found", name)
+	}
+	client, server := net.Pipe()
+	t.Cleanup(func() { client.Close(); server.Close() })
+	uConn := UClient(client, config, id)
+	if err := uConn.BuildHandshakeState(); err != nil {
+		t.Fatalf("BuildHandshakeState(%s): %v", name, err)
+	}
+	return uConn.HandshakeState.Hello.Raw
+}
+
+func TestChrome155MatchesBrowserCapture(t *testing.T) {
+	record, want := chrome155Capture(t)
+	const (
+		extSupportedGroups = 10
+		extSigAlgs         = 13
+		extSupportedVers   = 43
+		extKeyShare        = 51
+		extECH             = 0xfe0d
+	)
+	for _, name := range []string{"chrome155", "hellochrome_155", "HelloChrome_155", "hellochrome_auto"} {
+		t.Run(name, func(t *testing.T) {
+			for i := 0; i < 20; i++ { // extension order and GREASE values are random
+				raw := buildHelloByName(t, name, &utls.Config{ServerName: "www.example.com"})
+				got := parseChrome155Hello(t, raw)
+
+				if got.version != want.version || got.sessionIDLen != want.sessionIDLen {
+					t.Fatalf("version %04x, session ID %d bytes; Chrome sends %04x and %d", got.version, got.sessionIDLen, want.version, want.sessionIDLen)
+				}
+				gs, ws := slices.Clone(got.cipherSuites), slices.Clone(want.cipherSuites)
+				for _, s := range [][]uint16{gs, ws} {
+					for j := range s {
+						if isGREASEValue(s[j]) {
+							s[j] = 0x0a0a
+						}
+					}
+				}
+				if !slices.Equal(gs, ws) || !isGREASEValue(got.cipherSuites[0]) {
+					t.Fatalf("cipher suites %04x, Chrome sends %04x", got.cipherSuites, want.cipherSuites)
+				}
+				if !bytes.Equal(got.compression, want.compression) {
+					t.Fatalf("compression %x, Chrome sends %x", got.compression, want.compression)
+				}
+
+				// Chrome shuffles everything between the two GREASE extensions.
+				n := len(got.extensionIDs)
+				if n != len(want.extensionIDs) || got.extensionIDs[0] != 0x0a0a || got.extensionIDs[n-1] != 0x0a0a {
+					t.Fatalf("extensions %04x, Chrome sends %04x", got.extensionIDs, want.extensionIDs)
+				}
+				gotIDs, wantIDs := slices.Sorted(slices.Values(got.extensionIDs)), slices.Sorted(slices.Values(want.extensionIDs))
+				if !slices.Equal(gotIDs, wantIDs) {
+					t.Fatalf("extension set %04x, Chrome sends %04x", gotIDs, wantIDs)
+				}
+				for _, id := range wantIDs {
+					g, w := got.extensions[id], want.extensions[id]
+					switch id {
+					case 0x0a0a: // the two GREASE extensions differ in body; covered by the length check below
+						continue
+					case extSupportedGroups, extSigAlgs:
+						g, w = ungreaseList(g, 2), ungreaseList(w, 2)
+					case extSupportedVers:
+						g, w = ungreaseList(g, 1), ungreaseList(w, 1)
+					case extKeyShare:
+						if gl, wl := keyShareLayout(t, g), keyShareLayout(t, w); !slices.Equal(gl, wl) {
+							t.Fatalf("key shares %v, Chrome sends %v", gl, wl)
+						}
+						continue
+					case extECH:
+						// GREASE ECH: random config id, key and payload; BoringSSL
+						// picks the payload from 144/176/208/240 bytes.
+						if d := len(g) - len(w); d != -32 && d != 0 && d != 32 && d != 64 {
+							t.Fatalf("GREASE ECH is %d bytes, Chrome sends %d (+-32n)", len(g), len(w))
+						}
+						if !bytes.Equal(g[:5], w[:5]) {
+							t.Fatalf("GREASE ECH header %x, Chrome sends %x", g[:5], w[:5])
+						}
+						continue
+					}
+					if !bytes.Equal(g, w) {
+						t.Fatalf("extension %04x = %x, Chrome sends %x", id, g, w)
+					}
+				}
+				if sig := got.extensions[extSigAlgs]; !isGREASEValue(binary.BigEndian.Uint16(sig[2:])) {
+					t.Fatalf("signature_algorithms starts with %x, want GREASE", sig[2:4])
+				}
+				if d := len(raw) - (len(record) - 5); d != -32 && d != 0 && d != 32 && d != 64 {
+					t.Fatalf("ClientHello is %d bytes, Chrome sends %d (+-32n)", len(raw), len(record)-5)
+				}
+			}
+		})
+	}
+}
+
+// Stock names keep their stock meaning: "chrome" is Chrome 133 as in stock
+// mihomo, and so is "chrome133"; neither sends trust_anchors.
+func TestChromeStaysStock(t *testing.T) {
+	for name, want := range map[string]UClientHelloID{
+		"chrome":          utls.HelloChrome_Auto,
+		"chrome133":       utls.HelloChrome_133,
+		"hellochrome_133": utls.HelloChrome_133,
+		"chrome155":       HelloChrome155,
+		"hellochrome_155": HelloChrome155,
+	} {
+		if got, ok := GetFingerprint(name); !ok || got != want {
+			t.Errorf("GetFingerprint(%q) = %v, %v; want %v", name, got, ok, want)
+		}
+	}
+	if utls.HelloChrome_Auto != utls.HelloChrome_133 {
+		t.Fatalf("utls HelloChrome_Auto is %v: revisit 0029", utls.HelloChrome_Auto)
+	}
+	for _, name := range []string{"chrome", "chrome133"} {
+		if _, ok := parseChrome155Hello(t, buildHelloByName(t, name, &utls.Config{ServerName: "www.example.com"})).extensions[extensionTrustAnchors]; ok {
+			t.Errorf("%s sends trust_anchors: it must stay the Chrome 133 hello", name)
+		}
+	}
+	if _, ok := GetFingerprint("Chrome155"); ok {
+		t.Error("stock-style names match exactly: Chrome155 must stay unknown")
+	}
+}
+
+// Every spec is fresh: utls fills extensions in per connection, and the GREASE
+// signature scheme is drawn per hello.
+func TestChrome155SpecIsFresh(t *testing.T) {
+	a, b := chrome155Spec(), chrome155Spec()
+	if a == b || &a.Extensions[0] == &b.Extensions[0] {
+		t.Fatal("chrome155Spec returned shared state")
+	}
+	seen := map[uint16]bool{}
+	for i := 0; i < 64; i++ {
+		sig := parseChrome155Hello(t, buildHelloByName(t, "chrome155", &utls.Config{ServerName: "www.example.com"})).extensions[13]
+		seen[binary.BigEndian.Uint16(sig[2:])] = true
+	}
+	if len(seen) < 2 {
+		t.Fatalf("GREASE signature scheme never changed over 64 hellos: %v", seen)
+	}
+}
