+// A REALITY server (utls' own, as mihomo's inbound uses it) with a local cover
+// target authenticates a chrome155 client, with the classic and with the
+// hybrid key share, and the hello on the wire is Chrome 155's.
+func TestChrome155RealityHandshake(t *testing.T) {
+	defer ResetRealityMLKEMMemo()
+	defer SetRealityMLKEMPolicy(RealityMLKEMAuto)
+
+	target, err := tls.Listen("tcp", "127.0.0.1:0", &tls.Config{Certificates: []tls.Certificate{chrome155TestCert(t, "www.example.com")}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer target.Close()
+	go func() {
+		for {
+			c, err := target.Accept()
+			if err != nil {
+				return
+			}
+			go func() {
+				defer c.Close()
+				_ = c.(*tls.Conn).Handshake()
+				_, _ = io.Copy(io.Discard, c)
+			}()
+		}
+	}()
+
+	serverKey, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	shortID := [8]byte{0x0a, 0x1b}
+	serverConfig := &utls.RealityConfig{
+		Type:        "tcp",
+		Dest:        target.Addr().String(),
+		ServerNames: map[string]bool{"www.example.com": true},
+		PrivateKey:  serverKey.Bytes(),
+		ShortIds:    map[[8]byte]bool{shortID: true},
+		DialContext: func(ctx context.Context, network, address string) (net.Conn, error) {
+			return (&net.Dialer{}).DialContext(ctx, network, address)
+		},
+	}
+	serverConfig.SessionTicketsDisabled = true
+
+	for _, tc := range []struct {
+		name   string
+		policy RealityMLKEMPolicy
+		hybrid bool
+	}{
+		{"classic", RealityMLKEMOff, false},
+		{"X25519MLKEM768", RealityMLKEMOn, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			SetRealityMLKEMPolicy(tc.policy)
+			hello := make(chan []byte, 1)
+			addr := realityTestServer(t, func(c net.Conn) {
+				rc := &recordingConn{Conn: c}
+				_ = c.SetDeadline(time.Now().Add(5 * time.Second))
+				conn, err := utls.RealityServer(context.Background(), rc, serverConfig)
+				hello <- rc.buf
+				if err != nil {
+					return
+				}
+				defer conn.Close()
+				_, _ = io.Copy(conn, conn) // echo
+			})
+			conn, err := net.Dial("tcp", addr)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer conn.Close()
+			_ = conn.SetDeadline(time.Now().Add(5 * time.Second))
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			config := &RealityConfig{PublicKey: serverKey.PublicKey(), ShortID: shortID}
+			rconn, err := GetRealityConn(ctx, conn, HelloChrome155, "www.example.com", config)
+			if err != nil {
+				t.Fatalf("REALITY handshake: %v", err)
+			}
+			if _, err := rconn.Write([]byte("ping")); err != nil {
+				t.Fatal(err)
+			}
+			buf := make([]byte, 4)
+			if _, err := io.ReadFull(rconn, buf); err != nil || string(buf) != "ping" {
+				t.Fatalf("echo %q, %v", buf, err)
+			}
+			_ = rconn.Close()
+
+			record := <-hello
+			if len(record) < 5 || record[0] != 0x16 {
+				t.Fatal("no TLS record from the client")
+			}
+			n := int(binary.BigEndian.Uint16(record[3:5]))
+			got := parseChrome155Hello(t, record[5:5+n])
+			if _, ok := got.extensions[extensionTrustAnchors]; !ok {
+				t.Fatal("the REALITY hello is not Chrome 155")
+			}
+			if hasHybridShare(parseHelloKeyShares(record)) != tc.hybrid {
+				t.Fatalf("hello offered X25519MLKEM768 = %v, want %v", !tc.hybrid, tc.hybrid)
+			}
+		})
+	}
+}
