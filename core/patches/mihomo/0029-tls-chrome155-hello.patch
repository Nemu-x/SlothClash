+func TestRealityClientVersionDefaultIsXray26_11_9(t *testing.T) {
+	if DefaultRealityClientVersion() != [3]byte{26, 11, 9} {
+		t.Fatalf("default REALITY client version %v, want 26.11.9 (the Xray release 0029 was checked against)", DefaultRealityClientVersion())
+	}
+}
