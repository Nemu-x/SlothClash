+// A config with a session cache that holds a TLS 1.3 session: utls panics when
+// a HelloCustom spec without pre_shared_key meets it, unless resumption may be
+// skipped (as the built-in parrots do). The caller's config is left alone.
+func TestChrome155WithSessionCache(t *testing.T) {
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	cert := chrome155TestCert(t, "example.com")
+	go func() {
+		conn, err := ln.Accept()
+		if err != nil {
+			return
+		}
+		defer conn.Close()
+		server := tls.Server(conn, &tls.Config{Certificates: []tls.Certificate{cert}})
+		if server.Handshake() == nil {
+			_, _ = server.Write([]byte{1})
+			_, _ = io.Copy(io.Discard, server)
+		}
+	}()
+
+	cache := utls.NewLRUClientSessionCache(1)
+	config := &utls.Config{ServerName: "example.com", InsecureSkipVerify: true, ClientSessionCache: cache}
+	conn, err := net.Dial("tcp", ln.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = conn.SetDeadline(time.Now().Add(5 * time.Second))
+	first := UClient(conn, config, HelloChrome155)
+	if err := first.Handshake(); err != nil {
+		t.Fatalf("first handshake: %v", err)
+	}
+	if _, err := io.ReadFull(first, make([]byte, 1)); err != nil { // processes the session ticket
+		t.Fatalf("read: %v", err)
+	}
+	_ = first.Close()
+	if _, ok := cache.Get("example.com"); !ok {
+		t.Fatal("no TLS 1.3 session in the cache after the first connection")
+	}
+
+	client, server := net.Pipe()
+	defer client.Close()
+	defer server.Close()
+	func() {
+		defer func() {
+			if r := recover(); r != nil {
+				t.Fatalf("BuildHandshakeState with a cached session panicked: %v", r)
+			}
+		}()
+		uConn := UClient(client, config, HelloChrome155)
+		if err := uConn.BuildHandshakeState(); err != nil {
+			t.Fatalf("BuildHandshakeState with a cached session: %v", err)
+		}
+		if _, ok := parseChrome155Hello(t, uConn.HandshakeState.Hello.Raw).extensions[extensionTrustAnchors]; !ok {
+			t.Fatal("hello with a session cache is not Chrome 155")
+		}
+	}()
+	if config.PreferSkipResumptionOnNilExtension {
+		t.Fatal("UClient changed the caller's config")
+	}
+}
