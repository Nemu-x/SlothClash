+package tls
+
+// SlothClash core patch 0029: the Chrome 155 ClientHello as client-fingerprint
+// "chrome155" (Xray "hellochrome_155").
+//
+// Xray-core 26.11.9 sends Chrome 155 as its default fingerprint and Citrus
+// v1.0.0-beta.3 does the same for "chrome". metacubex/utls v1.9.0-alpha.1
+// (the version mihomo v1.19.34 pins) still stops at Chrome 133, so the profile
+// is carried here as data and applied through HelloCustom + ApplyPreset; the
+// library stays the one mihomo pins (no fork). The profile is
+// refraction-networking/utls 6ebdceb2 (HelloChrome_155, checked there against
+// a capture of Chrome 155.0.8059.40), the same one
+// getmikan/utls a6dee38a ships to Citrus. The wiring (an ID utls does not know,
+// routed through UClient) follows Rerowros/veles component/tls/chrome155.go
+// (GPL-3.0).
+//
+// Compared with Chrome 133 the hello gains a GREASE value and the three ML-DSA
+// schemes (only advertised: nothing in this core verifies them) at the head of
+// signature_algorithms, and the trust_anchors extension (0xca34) with 28 Chrome
+// Root Store IDs.
+//
+// Stock names keep their stock meaning: "chrome" is still utls.HelloChrome_Auto
+// (Chrome 133), as in stock mihomo. Delete this file when mihomo moves to a utls
+// release that ships HelloChrome_155.
+
+import (
+	randv2 "math/rand/v2"
+	"net"
+
+	"github.com/metacubex/mihomo/log"
+
+	utls "github.com/metacubex/utls"
+)
+
+// HelloChrome155 names the profile. utls does not know this version: the ID
+// reaches utls only through UClient in this package, which builds the hello
+// from chrome155Spec. utls.UClient with it fails to build a hello.
+var HelloChrome155 = UClientHelloID{Client: utls.HelloChrome_133.Client, Version: "155"}
+
+const (
+	extensionTrustAnchors uint16 = 0xca34 // draft-ietf-tls-trust-anchor-ids
+
+	sigSchemeMLDSA44 utls.SignatureScheme = 0x0904
+	sigSchemeMLDSA65 utls.SignatureScheme = 0x0905
+	sigSchemeMLDSA87 utls.SignatureScheme = 0x0906
+)
+
+// chrome155TrustAnchorIDs are the Chrome Root Store IDs a fresh Chrome
+// 155.0.8059.40 advertises, in the captured order.
+var chrome155TrustAnchorIDs = [][]byte{
+	{0x82, 0xdf, 0x13, 0x02, 0x01},
+	{0x82, 0xdf, 0x13, 0x02, 0x06},
+	{0x82, 0xdf, 0x13, 0x02, 0x0d},
+	{0x82, 0xdf, 0x13, 0x02, 0x0e},
+	{0x82, 0xdf, 0x13, 0x02, 0x0f},
+	{0x82, 0xdf, 0x13, 0x02, 0x12},
+	{0x82, 0xdf, 0x13, 0x02, 0x13},
+	{0x82, 0xdf, 0x13, 0x02, 0x14},
+	{0x83, 0x9a, 0x64, 0x8c, 0x9b, 0x2d, 0x01, 0x07},
+	{0x83, 0x9a, 0x64, 0x8c, 0x9b, 0x2d, 0x01, 0x08},
+	{0x83, 0x9a, 0x64, 0x8c, 0x9b, 0x2d, 0x01, 0x09},
+	{0x83, 0x9a, 0x64, 0x8c, 0x9b, 0x2d, 0x01, 0x0a},
+	{0x83, 0x9a, 0x64, 0x8c, 0x9b, 0x2d, 0x01, 0x0b},
+	{0x83, 0x9a, 0x64, 0x8c, 0x9b, 0x2d, 0x01, 0x0c},
+	{0x83, 0x9a, 0x64, 0x8c, 0x9b, 0x2d, 0x01, 0x0d},
+	{0x83, 0x9a, 0x64, 0x8c, 0x9b, 0x2d, 0x01, 0x12},
+	{0x83, 0x9a, 0x64, 0x8c, 0x9b, 0x2d, 0x01, 0x13},
+	{0xd6, 0x79, 0x09, 0x01},
+	{0xd6, 0x79, 0x09, 0x04},
+	{0xd6, 0x79, 0x09, 0x05},
+	{0xd6, 0x79, 0x09, 0x06},
+	{0xd6, 0x79, 0x09, 0x07},
+	{0xd6, 0x79, 0x09, 0x08},
+	{0xd6, 0x79, 0x09, 0x0a},
+	{0xd6, 0x79, 0x09, 0x0b},
+	{0xd6, 0x79, 0x09, 0x0c},
+	{0xd6, 0x79, 0x09, 0x0d},
+	{0xd6, 0x79, 0x09, 0x0f},
+}
+
+// chrome155TrustAnchorsData is the extension_data of trust_anchors: a two-byte
+// list length, then every ID behind its one-byte length.
+func chrome155TrustAnchorsData() []byte {
+	data := []byte{0, 0}
+	for _, id := range chrome155TrustAnchorIDs {
+		data = append(data, byte(len(id)))
+		data = append(data, id...)
+	}
+	listLen := len(data) - 2
+	data[0], data[1] = byte(listLen>>8), byte(listLen)
+	return data
+}
+
+// chrome155Spec returns a fresh spec: ApplyPreset fills it in per connection.
+func chrome155Spec() *utls.ClientHelloSpec {
+	// utls (v1.8.8 and v1.9.0-alpha.1 alike) replaces GREASE placeholders in
+	// cipher suites, groups, key shares and versions but not in
+	// signature_algorithms, so that value is drawn here. BoringSSL draws every
+	// GREASE value independently.
+	greaseSigScheme := utls.SignatureScheme(uint16(randv2.IntN(16))*0x1010 + 0x0a0a)
+
+	return &utls.ClientHelloSpec{
+		CipherSuites: []uint16{
+			utls.GREASE_PLACEHOLDER,
+			utls.TLS_AES_128_GCM_SHA256,
+			utls.TLS_AES_256_GCM_SHA384,
+			utls.TLS_CHACHA20_POLY1305_SHA256,
+			utls.TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,
+			utls.TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,
+			utls.TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384,
+			utls.TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,
+			utls.TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305,
+			utls.TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305,
+			utls.TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA,
+			utls.TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA,
+			utls.TLS_RSA_WITH_AES_128_GCM_SHA256,
+			utls.TLS_RSA_WITH_AES_256_GCM_SHA384,
+			utls.TLS_RSA_WITH_AES_128_CBC_SHA,
+			utls.TLS_RSA_WITH_AES_256_CBC_SHA,
+		},
+		CompressionMethods: []byte{0x00},
+		Extensions: utls.ShuffleChromeTLSExtensions([]utls.TLSExtension{
+			&utls.UtlsGREASEExtension{},
+			&utls.SNIExtension{},
+			&utls.ExtendedMasterSecretExtension{},
+			&utls.RenegotiationInfoExtension{Renegotiation: utls.RenegotiateOnceAsClient},
+			&utls.SupportedCurvesExtension{Curves: []utls.CurveID{
+				utls.GREASE_PLACEHOLDER,
+				utls.X25519MLKEM768,
+				utls.X25519,
+				utls.CurveP256,
+				utls.CurveP384,
+			}},
+			&utls.SupportedPointsExtension{SupportedPoints: []byte{0x00}},
+			&utls.SessionTicketExtension{},
+			&utls.ALPNExtension{AlpnProtocols: []string{"h2", "http/1.1"}},
+			&utls.StatusRequestExtension{},
+			&utls.SignatureAlgorithmsExtension{SupportedSignatureAlgorithms: []utls.SignatureScheme{
+				greaseSigScheme,
+				sigSchemeMLDSA44,
+				sigSchemeMLDSA65,
+				sigSchemeMLDSA87,
+				utls.ECDSAWithP256AndSHA256,
+				utls.PSSWithSHA256,
+				utls.PKCS1WithSHA256,
+				utls.ECDSAWithP384AndSHA384,
+				utls.PSSWithSHA384,
+				utls.PKCS1WithSHA384,
+				utls.PSSWithSHA512,
+				utls.PKCS1WithSHA512,
+			}},
+			&utls.SCTExtension{},
+			&utls.KeyShareExtension{KeyShares: []utls.KeyShare{
+				{Group: utls.CurveID(utls.GREASE_PLACEHOLDER), Data: []byte{0}},
+				{Group: utls.X25519MLKEM768},
+				{Group: utls.X25519},
+			}},
+			&utls.PSKKeyExchangeModesExtension{Modes: []uint8{utls.PskModeDHE}},
+			&utls.SupportedVersionsExtension{Versions: []uint16{
+				utls.GREASE_PLACEHOLDER,
+				utls.VersionTLS13,
+				utls.VersionTLS12,
+			}},
+			&utls.UtlsCompressCertExtension{Algorithms: []utls.CertCompressionAlgo{
+				utls.CertCompressionBrotli,
+			}},
+			&utls.ApplicationSettingsExtensionNew{SupportedProtocols: []string{"h2"}},
+			&utls.GenericExtension{Id: extensionTrustAnchors, Data: chrome155TrustAnchorsData()},
+			utls.BoringGREASEECH(),
+			&utls.UtlsGREASEExtension{},
+		}),
+	}
+}
+
+// fingerprintSpec is utls.UTLSIdToSpec that also knows HelloChrome155.
+func fingerprintSpec(id UClientHelloID) (utls.ClientHelloSpec, error) {
+	if id == HelloChrome155 {
+		return *chrome155Spec(), nil
+	}
+	return utls.UTLSIdToSpec(id)
+}
+
+// uClient is utls.UClient that also knows HelloChrome155. Every utls client of
+// the core is created through it (UClient below, REALITY, JLS).
+func uClient(c net.Conn, config *utls.Config, fingerprint UClientHelloID) *UConn {
+	if fingerprint != HelloChrome155 {
+		return utls.UClient(c, config, fingerprint)
+	}
+	customConfig := config
+	if config != nil && config.ClientSessionCache != nil && !config.SessionTicketsDisabled && !config.PreferSkipResumptionOnNilExtension {
+		// The spec has no pre_shared_key extension (neither has Chrome's first
+		// hello), and utls panics in BuildHandshakeState when a HelloCustom
+		// client finds a cached TLS 1.3 session. The built-in parrots skip
+		// resumption in that case; so does this one. A copy, so the caller's
+		// config is left as it was.
+		customConfig = config.Clone()
+		customConfig.PreferSkipResumptionOnNilExtension = true
+	}
+	uConn := utls.UClient(c, customConfig, utls.HelloCustom)
+	if err := uConn.ApplyPreset(chrome155Spec()); err != nil {
+		// ApplyPreset fails on a config no hello can be built from (no
+		// ServerName and no InsecureSkipVerify, an empty or oversized
+		// NextProtos entry) or a failing random source. Chrome 133 is the
+		// closest hello; the config error then comes back from its
+		// BuildHandshakeState.
+		log.Warnln("chrome155 fingerprint: %v, falling back to chrome133", err)
+		return utls.UClient(c, config, utls.HelloChrome_133)
+	}
+	return uConn
+}
