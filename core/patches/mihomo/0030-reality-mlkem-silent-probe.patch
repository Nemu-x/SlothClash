+// realityReportSilent records a handshake with mlkem that ended before the
+// server answered: a reset, EOF, timeout, cancelled request, an alert or a
+// non-TLS answer instead of a certificate chain (SlothClash 0030). It never
+// flips or unpins the verdict; it only counts towards the probe in
+// realityChooseMLKEMProbe. A server whose cover site is unreachable closes the
+// connection instead of relaying it, so without the probe Auto would never learn
+// that it wants the other key share.
+func realityReportSilent(key string, mlkem bool, remote net.Addr) {
+	realityMemo.Lock()
+	defer realityMemo.Unlock()
+	entry := realityMemo.entries[key]
+	if entry == nil {
+		entry = &realityMemoEntry{mlkem: mlkem}
+		realityMemo.entries[key] = entry
+	}
+	if entry.mlkem != mlkem {
+		return // a stale attempt or a failed probe
+	}
+	entry.silent++
+	if entry.silent == realityMemoFlipAfter {
+		log.Debugln("REALITY %v: %d handshakes with X25519MLKEM768=%v in a row ended before the server answered, the next one tries %v once", remote, entry.silent, mlkem, !mlkem)
+	}
+}
