@@ -0,0 +1,176 @@
+package tls
+
+import (
+	"context"
+	"encoding/binary"
+	"net"
+	"testing"
+	"time"
+
+	utls "github.com/metacubex/utls"
+)
+
+func mustFingerprint(t *testing.T, name string) UClientHelloID {
+	t.Helper()
+	id, ok := GetFingerprint(name)
+	if !ok {
+		t.Fatalf("GetFingerprint(%q) is unknown", name)
+	}
+	return id
+}
+
+func TestFingerprintSupportsX25519MLKEM768(t *testing.T) {
+	for name, want := range map[string]bool{
+		"chrome": true, "chrome155": true, "firefox": true, "safari": true, "hellochrome_131": true,
+		"ios": false, "edge": false, "chrome120": false, "firefox120": false, "safari16": false, "hellochrome_120": false,
+	} {
+		if got := FingerprintSupportsX25519MLKEM768(mustFingerprint(t, name)); got != want {
+			t.Errorf("FingerprintSupportsX25519MLKEM768(%s) = %v, want %v", name, got, want)
+		}
+	}
+}
+
+func TestParseRealityMLKEMFingerprint(t *testing.T) {
+	for _, name := range []string{"firefox", "safari", "chrome", "chrome155", "HelloFirefox_148"} {
+		got, err := ParseRealityMLKEMFingerprint(name)
+		if err != nil {
+			t.Fatalf("%s: %v", name, err)
+		}
+		if want := mustFingerprint(t, name); *got != want {
+			t.Fatalf("%s: got %s/%s, want %s/%s", name, got.Client, got.Version, want.Client, want.Version)
+		}
+	}
+	for _, name := range []string{"ios", "chrome120", "nope", "", "none", "Firefox"} {
+		if _, err := ParseRealityMLKEMFingerprint(name); err == nil {
+			t.Fatalf("%q was accepted", name)
+		}
+	}
+	got, err := ParseRealityMLKEMFingerprint("random")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !FingerprintSupportsX25519MLKEM768(*got) {
+		t.Fatalf("random resolved to %s/%s, which has no hybrid share", got.Client, got.Version)
+	}
+}
+
+// helloSite is coverSite that hands over the client's raw first record.
+func helloSite(t *testing.T, hello chan<- []byte) func(net.Conn) {
+	t.Helper()
+	inner := coverSite(t, nil)
+	return func(c net.Conn) {
+		rc := &recordingConn{Conn: c}
+		inner(rc)
+		hello <- rc.buf
+	}
+}
+
+// helloExtensions lists the extension types of the ClientHello in record.
+func helloExtensions(t *testing.T, record []byte) map[uint16]bool {
+	t.Helper()
+	fail := func() map[uint16]bool { t.Fatalf("malformed ClientHello record (%d bytes)", len(record)); return nil }
+	if len(record) < 5 {
+		return fail()
+	}
+	n := int(binary.BigEndian.Uint16(record[3:5]))
+	if len(record) < 5+n || n < 4+2+32+1 {
+		return fail()
+	}
+	b := record[5+4+2+32 : 5+n] // the hello only, not the records after it
+	skip := func(lenBytes int) bool {
+		if len(b) < lenBytes {
+			return false
+		}
+		n := 0
+		for _, x := range b[:lenBytes] {
+			n = n<<8 | int(x)
+		}
+		if len(b) < lenBytes+n {
+			return false
+		}
+		b = b[lenBytes+n:]
+		return true
+	}
+	if !skip(1) || !skip(2) || !skip(1) || len(b) < 2 {
+		return fail()
+	}
+	if int(binary.BigEndian.Uint16(b)) != len(b)-2 {
+		return fail()
+	}
+	b = b[2:]
+	exts := map[uint16]bool{}
+	for len(b) >= 4 {
+		exts[binary.BigEndian.Uint16(b)] = true
+		n := int(binary.BigEndian.Uint16(b[2:]))
+		if len(b) < 4+n {
+			return fail()
+		}
+		b = b[4+n:]
+	}
+	return exts
+}
+
+// The mlkem-client-fingerprint hello goes out only on a handshake that offers
+// the hybrid share; every other handshake keeps client-fingerprint.
+func TestRealityMLKEMFingerprintOnlyForHybrid(t *testing.T) {
+	const recordSizeLimit = 0x001c // sent by Firefox, not by iOS
+	defer ResetRealityMLKEMMemo()
+	defer SetRealityMLKEMPolicy(RealityMLKEMAuto)
+	SetRealityMLKEMFirst(false)
+	firefox := mustFingerprint(t, "firefox")
+	for _, tc := range []struct {
+		name         string
+		policy       RealityMLKEMPolicy
+		force        bool
+		learned      bool // the memo already says this server wants the hybrid share
+		wantFirefox  bool
+		wantHybrid   bool
+		mlkemPresent bool
+	}{
+		{"auto, first classic attempt", RealityMLKEMAuto, false, false, false, false, true},
+		{"auto, learned hybrid", RealityMLKEMAuto, false, true, true, true, true},
+		{"on", RealityMLKEMOn, false, false, true, true, true},
+		{"off", RealityMLKEMOff, false, false, false, false, true},
+		{"off, forced", RealityMLKEMOff, true, false, true, true, true},
+		{"on, no mlkem-client-fingerprint", RealityMLKEMOn, false, false, false, false, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ResetRealityMLKEMMemo()
+			SetRealityMLKEMPolicy(tc.policy)
+			config := realityMemoTestConfig(t, tc.force)
+			if tc.mlkemPresent {
+				config.MLKEMFingerprint = &firefox
+			}
+			hello := make(chan []byte, 1)
+			addr := realityTestServer(t, helloSite(t, hello))
+			if tc.learned {
+				realityReportMLKEM(addr+"|"+string(config.PublicKey.Bytes()), false, false, nil)
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			if _, err := realityTestHandshake(t, ctx, addr, utls.HelloIOS_Auto, config); err == nil {
+				t.Fatal("the cover site's certificate passed REALITY verification")
+			}
+			record := <-hello
+			if got := hasHybridShare(parseHelloKeyShares(record)); got != tc.wantHybrid {
+				t.Fatalf("hello offered X25519MLKEM768 = %v, want %v", got, tc.wantHybrid)
+			}
+			if got := helloExtensions(t, record)[recordSizeLimit]; got != tc.wantFirefox {
+				t.Fatalf("Firefox hello = %v, want %v", got, tc.wantFirefox)
+			}
+		})
+	}
+}
+
+// Old parrots share the client name of the current one (chrome120 is "Chrome"
+// like chrome) but have no hybrid share. Under a hybrid verdict they send their
+// classic hello unchanged and that handshake never reaches the memo: the check
+// looks at the key shares the hello really carries, not at the client name.
+func TestRealityOldParrotsUnderHybridVerdict(t *testing.T) {
+	var cases []realityFingerprintCase
+	for _, name := range []string{"chrome120", "hellochrome_120", "firefox120", "hellofirefox_105", "safari16", "hellosafari_16_0", "helloios_14"} {
+		cases = append(cases, realityFingerprintCase{"auto learned hybrid, " + name, RealityMLKEMAuto, false, mustFingerprint(t, name), false})
+	}
+	cases = append(cases, realityFingerprintCase{"auto learned hybrid, hellochrome_131", RealityMLKEMAuto, false, mustFingerprint(t, "hellochrome_131"), true})
+	runRealityFingerprintCases(t, cases)
+}
