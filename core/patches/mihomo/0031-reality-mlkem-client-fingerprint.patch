diff --git a/component/tls/reality_mlkem_fingerprint.go b/component/tls/reality_mlkem_fingerprint.go
new file mode 100644
index 00000000..ea6f83d9
--- /dev/null
+++ b/component/tls/reality_mlkem_fingerprint.go
@@ -0,0 +1,65 @@
+package tls
+
+// SlothClash core patch 0031: reality-opts.mlkem-client-fingerprint names the
+// ClientHello a REALITY proxy sends when the handshake offers X25519MLKEM768
+// (forced, policy on, or Auto after the server relayed a classic hello). The
+// classic handshakes keep client-fingerprint. A proxy whose own fingerprint has
+// no hybrid share (ios, edge, chrome120, ...) can so still reach an Xray 26.9.8+
+// server with a hello the user chose, instead of the core picking one; without
+// the key nothing changes (0002 never swaps a fingerprint).
+// Adapted from Rerowros/veles P7 (adapter/outbound/reality.go,
+// component/tls/reality.go, GPL-3.0).
+
+import (
+	"fmt"
+
+	utls "github.com/metacubex/utls"
+)
+
+// FingerprintSupportsX25519MLKEM768 reports whether the ClientHello of id
+// carries the hybrid X25519MLKEM768 key share.
+func FingerprintSupportsX25519MLKEM768(id UClientHelloID) bool {
+	spec, err := fingerprintSpec(id)
+	if err != nil {
+		return false
+	}
+	for _, extension := range spec.Extensions {
+		keyShare, ok := extension.(*utls.KeyShareExtension)
+		if !ok {
+			continue
+		}
+		for _, share := range keyShare.KeyShares {
+			if share.Group == utls.X25519MLKEM768 {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// ParseRealityMLKEMFingerprint checks mlkem-client-fingerprint: a name
+// GetFingerprint knows whose hello carries the hybrid share. "random" is one
+// pick per process and may land on ios, which has none; chrome (one of its
+// picks) is used then, so the config does not fail on some starts only.
+func ParseRealityMLKEMFingerprint(name string) (*UClientHelloID, error) {
+	fingerprint, ok := GetFingerprint(name)
+	if !ok {
+		return nil, fmt.Errorf("invalid REALITY mlkem-client-fingerprint %q", name)
+	}
+	if !FingerprintSupportsX25519MLKEM768(fingerprint) {
+		if name != "random" {
+			return nil, fmt.Errorf("REALITY mlkem-client-fingerprint %q has no X25519MLKEM768 key share", name)
+		}
+		fingerprint = utls.HelloChrome_Auto
+	}
+	return &fingerprint, nil
+}
+
+// realityFingerprint is the hello of one REALITY handshake: the configured
+// mlkem-client-fingerprint when it offers the hybrid share, else fingerprint.
+func realityFingerprint(useMLKEM bool, fingerprint UClientHelloID, config *RealityConfig) UClientHelloID {
+	if useMLKEM && config.MLKEMFingerprint != nil {
+		return *config.MLKEMFingerprint
+	}
+	return fingerprint
+}
