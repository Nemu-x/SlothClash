+package outbound
+
+import (
+	"strings"
+	"testing"
+)
+
+// SlothClash core patch 0031: reality-opts.mlkem-client-fingerprint.
+func TestRealityOptionsMLKEMClientFingerprint(t *testing.T) {
+	base := RealityOptions{PublicKey: "SuEmqx2lN3HPJCv0YBhmTc-B4MIlGiEfxv-gYTdkbAQ", ShortID: "a1"}
+
+	cfg, err := base.Parse()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.MLKEMFingerprint != nil {
+		t.Fatalf("without the key the configured fingerprint must stay: got %v", *cfg.MLKEMFingerprint)
+	}
+
+	withFirefox := base
+	withFirefox.MLKEMClientFingerprint = "firefox"
+	if cfg, err = withFirefox.Parse(); err != nil {
+		t.Fatal(err)
+	}
+	if cfg.MLKEMFingerprint == nil || cfg.MLKEMFingerprint.Client != "Firefox" {
+		t.Fatalf("mlkem-client-fingerprint not parsed: %v", cfg.MLKEMFingerprint)
+	}
+
+	for bad, msg := range map[string]string{"ios": "no X25519MLKEM768", "chrome120": "no X25519MLKEM768", "nope": "invalid"} {
+		o := base
+		o.MLKEMClientFingerprint = bad
+		if _, err := o.Parse(); err == nil || !strings.Contains(err.Error(), msg) {
+			t.Errorf("mlkem-client-fingerprint %q: err = %v, want one containing %q", bad, err, msg)
+		}
+	}
+}
