diff --git a/config/external_ui_test.go b/config/external_ui_test.go
new file mode 100644
index 00000000..18a33810
--- /dev/null
+++ b/config/external_ui_test.go
@@ -0,0 +1,79 @@
+package config
+
+import (
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/common/observable"
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/log"
+)
+
+func TestExternalUIRefusesCoreDirectories(t *testing.T) {
+	home := C.Path.HomeDir()
+	for _, tc := range []struct {
+		ui, name string
+		ok       bool
+	}{
+		{"", "", true},
+		{"ui", "", true},
+		{"ui", "zashboard", true},
+		{"", "metacubexd", true},
+		{".", "", false},
+		{"./", "", false},
+		{home, "", false},
+		{filepath.Dir(home), "", false},
+		{".", "ui", false}, // external-ui itself is served by /ui
+	} {
+		err := CheckExternalUI(tc.ui, tc.name)
+		if (err == nil) != tc.ok {
+			t.Errorf("CheckExternalUI(%q, %q) = %v, want ok=%v", tc.ui, tc.name, err, tc.ok)
+		}
+	}
+}
+
+// A config with an external-ui that holds the core files still loads (a
+// subscription may carry external-ui: ./): the UI is turned off with a warning.
+func TestExternalUICoreDirectoryDisablesUI(t *testing.T) {
+	home := C.Path.HomeDir()
+	for _, ui := range []string{".", "./", home} {
+		sub := log.Subscribe()
+		ctrl, err := parseController(&RawConfig{ExternalUI: ui})
+		warned := waitWarning(sub, "External UI disabled")
+		log.UnSubscribe(sub)
+		if err != nil {
+			t.Errorf("external-ui %q: config refused: %v", ui, err)
+			continue
+		}
+		if ctrl.ExternalUI != "" || ctrl.ExternalUIName != "" {
+			t.Errorf("external-ui %q: kept as %q/%q, want the UI off", ui, ctrl.ExternalUI, ctrl.ExternalUIName)
+		}
+		if !warned {
+			t.Errorf("external-ui %q: no warning in the log", ui)
+		}
+	}
+
+	ctrl, err := parseController(&RawConfig{ExternalUI: "ui", ExternalUIName: "zashboard"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if ctrl.ExternalUI != "ui" || ctrl.ExternalUIName != "zashboard" {
+		t.Errorf("safe external-ui = %q/%q, want it kept", ctrl.ExternalUI, ctrl.ExternalUIName)
+	}
+}
+
+func waitWarning(sub observable.Subscription[log.Event], text string) bool {
+	timeout := time.After(time.Second)
+	for {
+		select {
+		case event := <-sub:
+			if event.LogLevel == log.WARNING && strings.Contains(event.Payload, text) {
+				return true
+			}
+		case <-timeout:
+			return false
+		}
+	}
+}
diff --git a/constant/path.go b/constant/path.go
index f2463a4a..34491896 100644
--- a/constant/path.go
+++ b/constant/path.go
@@ -104,6 +104,24 @@ func (p *path) SafePaths() []string {
 	return append([]string{p.homeDir}, p.safePaths...) // add homedir to safePaths
 }
 
+// HoldsCoreState reports whether dir is the home directory, the directory of
+// the config file or a SAFE_PATHS root, or an ancestor of one of them: a
+// directory the core keeps its own files in. Such a directory must never be
+// emptied or served as a whole, whatever SKIP_SAFE_PATH_CHECK says.
+func (p *path) HoldsCoreState(dir string) bool {
+	dir = filepath.Clean(p.Resolve(dir))
+	roots := append([]string{filepath.Dir(p.Resolve(p.configFile))}, p.SafePaths()...)
+	for _, root := range roots {
+		if root == "" {
+			continue
+		}
+		if rel, err := filepath.Rel(dir, filepath.Clean(root)); err == nil && filepath.IsLocal(rel) {
+			return true
+		}
+	}
+	return false
+}
+
 func (p *path) ErrNotSafePath(path string) error {
 	return ErrNotSafePath{Path: path, SafePaths: p.SafePaths()}
 }
diff --git a/constant/path_state_test.go b/constant/path_state_test.go
new file mode 100644
index 00000000..0be65723
--- /dev/null
+++ b/constant/path_state_test.go
@@ -0,0 +1,42 @@
+package constant
+
+import (
+	"path/filepath"
+	"testing"
+)
+
+func TestHoldsCoreState(t *testing.T) {
+	base := t.TempDir()
+	home := filepath.Join(base, "home", "citrus")
+	extra := filepath.Join(base, "share", "ui-root")
+	p := &path{homeDir: home, configFile: "config.yaml", safePaths: []string{extra}}
+
+	for dir, want := range map[string]bool{
+		".":                                   true, // the home itself
+		home:                                  true,
+		home + string(filepath.Separator):     true,
+		filepath.Join(home, ".."):             true, // an ancestor of the home
+		base:                                  true,
+		extra:                                 true, // a SAFE_PATHS root
+		filepath.Join(base, "share"):          true,
+		"ui":                                  false,
+		filepath.Join(home, "ui"):             false,
+		filepath.Join(home, "ui", "zash"):     false,
+		filepath.Join(extra, "metacubexd"):    false,
+		filepath.Join(base, "elsewhere", "x"): false,
+	} {
+		if got := p.HoldsCoreState(dir); got != want {
+			t.Errorf("HoldsCoreState(%q) = %v, want %v", dir, got, want)
+		}
+	}
+
+	// The directory of a config file outside the home counts too.
+	etc := filepath.Join(base, "etc", "citrus")
+	p.configFile = filepath.Join(etc, "config.yaml")
+	if !p.HoldsCoreState(etc) || !p.HoldsCoreState(filepath.Join(base, "etc")) {
+		t.Error("the config directory or its parent is not protected")
+	}
+	if p.HoldsCoreState(filepath.Join(etc, "ui")) {
+		t.Error("a subdirectory of the config directory is protected")
+	}
+}
