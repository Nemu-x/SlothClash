+func TestIsHTTP1Transport(t *testing.T) {
+	h1 := pipelineTransport("127.0.0.1:1", []string{"http/1.1"})
+	h2 := pipelineTransport("127.0.0.1:1", nil)
+	assert.True(t, isHTTP1Transport(h1))
+	assert.True(t, isHTTP1Transport(onlyRoundTripper{h1}))
+	assert.True(t, isHTTP1Transport(&ReuseTransport{entry: &reuseEntry{transport: h1}}))
+	assert.False(t, isHTTP1Transport(h2))
+	assert.False(t, isHTTP1Transport(onlyRoundTripper{h2}))
+}
