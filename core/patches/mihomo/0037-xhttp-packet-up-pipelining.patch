+// startPipelineServer serves handler over HTTP/1.1 and h2c on loopback.
+func startPipelineServer(t *testing.T, handler http.Handler) string {
+	t.Helper()
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	protocols := new(http.Protocols)
+	protocols.SetHTTP1(true)
+	protocols.SetUnencryptedHTTP2(true)
+	server := &http.Server{Handler: handler, Protocols: protocols}
+	go func() { _ = server.Serve(ln) }()
+	t.Cleanup(func() { _ = server.Close() })
+	return ln.Addr().String()
+}
+
+func pipelineTransport(addr string, alpn []string) http.RoundTripper {
+	return NewTransport(
+		func(ctx context.Context) (net.Conn, error) {
+			var d net.Dialer
+			return d.DialContext(ctx, "tcp", addr)
+		},
+		func(ctx context.Context, conn net.Conn, isH2 bool) (net.Conn, error) { return conn, nil },
+		nil, alpn, 0)
+}
+
+// uploadSeq is the seq of a packet-up upload with the default seq placement
+// (the last path segment), or -1 for any other request.
+func uploadSeq(r *http.Request) int {
+	parts := strings.Split(strings.Trim(r.URL.Path, "/"), "/")
+	if r.Method == http.MethodGet || len(parts) != 3 {
+		return -1
+	}
+	seq, err := strconv.Atoi(parts[2])
+	if err != nil {
+		return -1
+	}
+	return seq
+}
+
+// uploadTracker counts the uploads a server is handling at the same time and
+// the widest seq span among them.
+type uploadTracker struct {
+	mu      sync.Mutex
+	active  map[int]bool
+	maxOpen int
+	maxSpan int
+	highest int
+}
+
+func (u *uploadTracker) begin(seq int) {
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	if u.active == nil {
+		u.active = map[int]bool{}
+	}
+	u.active[seq] = true
+	if seq > u.highest {
+		u.highest = seq
+	}
+	if len(u.active) > u.maxOpen {
+		u.maxOpen = len(u.active)
+	}
+	lowest := seq
+	for s := range u.active {
+		if s < lowest {
+			lowest = s
+		}
+	}
+	if seq-lowest+1 > u.maxSpan {
+		u.maxSpan = seq - lowest + 1
+	}
+}
+
+func (u *uploadTracker) end(seq int) {
+	u.mu.Lock()
+	delete(u.active, seq)
+	u.mu.Unlock()
+}
+
+func (u *uploadTracker) stats() (maxOpen, maxSpan int) {
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	return u.maxOpen, u.maxSpan
+}
+
+// laggingUploads holds every 16th upload back for 30 ms and the others up to
+// 1 ms, so the uploads after a held one overtake it, as far as the client lets
+// them.
+func laggingUploads(seq int) time.Duration {
+	if seq%16 == 0 {
+		return 30 * time.Millisecond
+	}
+	return time.Duration(mathrand.Int64N(int64(time.Millisecond)))
+}
+
+// hashEchoServer runs the mihomo packet-up server behind a middleware that
+// delays the uploads, so they reach the reassembly queue out of order. The
+// inner connection handler reads size bytes and answers their SHA-256.
+func hashEchoServer(t *testing.T, cfg Config, size int, delay func(seq int) time.Duration) (string, *uploadTracker) {
+	t.Helper()
+	handler, err := NewServerHandler(ServerOption{
+		Config: cfg,
+		ConnHandler: func(conn net.Conn) {
+			defer conn.Close()
+			h := sha256.New()
+			if _, err := io.CopyN(h, conn, int64(size)); err != nil {
+				return
+			}
+			_, _ = conn.Write([]byte(hex.EncodeToString(h.Sum(nil))))
+		},
+	})
+	require.NoError(t, err)
+	tracker := &uploadTracker{}
+	addr := startPipelineServer(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if seq := uploadSeq(r); seq >= 0 {
+			tracker.begin(seq)
+			defer tracker.end(seq)
+			time.Sleep(delay(seq))
+		}
+		handler.ServeHTTP(w, r)
+	}))
+	return addr, tracker
+}
+
+// uploadThroughClient sends data through a packet-up client in random-sized
+// writes and returns the hash the server answers.
+func uploadThroughClient(t *testing.T, cfg Config, addr string, alpn []string, data []byte) string {
+	t.Helper()
+	client, err := NewClient(&cfg, func() http.RoundTripper { return pipelineTransport(addr, alpn) }, nil, false)
+	require.NoError(t, err)
+	defer client.Close()
+	conn, err := client.Dial(context.Background())
+	require.NoError(t, err)
+	defer conn.Close()
+	require.NoError(t, conn.SetDeadline(time.Now().Add(30*time.Second)))
+	for rest := data; len(rest) > 0; {
+		n := 1 + mathrand.IntN(64<<10)
+		if n > len(rest) {
+			n = len(rest)
+		}
+		_, err := conn.Write(rest[:n])
+		require.NoError(t, err)
+		rest = rest[n:]
+	}
+	got := make([]byte, sha256.Size*2)
+	_, err = io.ReadFull(conn, got)
+	require.NoError(t, err)
+	return string(got)
+}
+
+// Uploads that reach the server out of order are put back in order, through
+// a server whose sc-max-buffered-posts is the smallest the window allows.
+func TestPacketUpPipelineReordersThroughLimitedServer(t *testing.T) {
+	for _, placement := range []string{PlacementBody, PlacementHeader} {
+		t.Run(placement, func(t *testing.T) {
+			cfg := Config{
+				Host:                 "example.com",
+				Path:                 "/xhttp",
+				Mode:                 "packet-up",
+				UplinkDataPlacement:  placement,
+				ScMaxEachPostBytes:   "16384",
+				ScMinPostsIntervalMs: "1",
+				// mihomo's queue fails a session once it holds more than this
+				// many uploads past the one it waits for; Xray's heap too.
+				ScMaxBufferedPosts: strconv.Itoa(packetUpWindow - 1),
+			}
+			size := 4 << 20
+			if placement == PlacementHeader {
+				size = 512 << 10 // base64 in headers is slow on both ends
+			}
+			data := make([]byte, size)
+			_, _ = rand.Read(data)
+			want := sha256.Sum256(data)
+
+			addr, tracker := hashEchoServer(t, cfg, size, laggingUploads)
+			got := uploadThroughClient(t, cfg, addr, nil, data)
+			assert.Equal(t, hex.EncodeToString(want[:]), got)
+
+			maxOpen, maxSpan := tracker.stats()
+			assert.Greater(t, maxOpen, 1, "uploads were not pipelined")
+			assert.Equal(t, packetUpWindow, maxSpan, "a held upload was not overtaken up to the window")
+		})
+	}
+}
+
+// HTTP/1.1 cannot multiplex: the client keeps waiting for each response.
+func TestPacketUpHTTP1StaysSequential(t *testing.T) {
+	cfg := Config{
+		Host:                 "example.com",
+		Path:                 "/xhttp",
+		Mode:                 "packet-up",
+		ScMaxEachPostBytes:   "16384",
+		ScMinPostsIntervalMs: "1",
+	}
+	size := 1 << 20
+	data := make([]byte, size)
+	_, _ = rand.Read(data)
+	want := sha256.Sum256(data)
+
+	addr, tracker := hashEchoServer(t, cfg, size, laggingUploads)
+	got := uploadThroughClient(t, cfg, addr, []string{"http/1.1"}, data)
+	assert.Equal(t, hex.EncodeToString(want[:]), got)
+	maxOpen, _ := tracker.stats()
+	assert.Equal(t, 1, maxOpen)
+}
