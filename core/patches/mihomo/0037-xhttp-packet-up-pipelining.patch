+// sc-min-posts-interval-ms paces the requests, not the writes: the first write
+// and a write after a pause go out at once, a write right after a request waits
+// for the rest of the interval.
+func TestPacketUpIntervalPacesRequests(t *testing.T) {
+	cfg := &Config{Host: "example.com", Path: "/xhttp", Mode: "packet-up"}
+	s := startPipeUploadServer(t, cfg)
+	var mu sync.Mutex
+	var arrivals []time.Time
+	s.delay = func(uint64) time.Duration {
+		mu.Lock()
+		arrivals = append(arrivals, time.Now())
+		mu.Unlock()
+		return 0
+	}
+	arrived := func(n int) time.Time {
+		require.Eventually(t, func() bool { mu.Lock(); defer mu.Unlock(); return len(arrivals) >= n },
+			5*time.Second, time.Millisecond)
+		mu.Lock()
+		defer mu.Unlock()
+		return arrivals[n-1]
+	}
+	const interval = 300 * time.Millisecond
+	w := newPipeWriter(t, cfg, s.addr, nil, 64<<10, Range{Min: 300, Max: 300}, packetUpMaxInFlight)
+
+	start := time.Now()
+	_, err := w.Write([]byte("first"))
+	require.NoError(t, err)
+	assert.Less(t, arrived(1).Sub(start), interval/2, "the first write waited for the interval")
+
+	_, err = w.Write([]byte("second"))
+	require.NoError(t, err)
+	assert.GreaterOrEqual(t, arrived(2).Sub(arrived(1)), interval-20*time.Millisecond, "a request came within the interval")
+
+	time.Sleep(interval + 100*time.Millisecond)
+	start = time.Now()
+	_, err = w.Write([]byte("after a pause"))
+	require.NoError(t, err)
+	assert.Less(t, arrived(3).Sub(start), interval/2, "a write after a pause waited for the interval")
+
+	require.NoError(t, w.Close())
+	assert.Equal(t, "firstsecondafter a pause", string(s.stream(t)))
+	requireNoWriterGoroutines(t)
+}
