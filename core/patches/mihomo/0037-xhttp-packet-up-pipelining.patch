+// With a 100 ms response time, sending without waiting for the responses is
+// several times faster than one request per round trip.
+func TestPacketUpThroughputWithLatency(t *testing.T) {
+	cfg := &Config{Host: "example.com", Path: "/xhttp", Mode: "packet-up"}
+	run := func(maxInFlight int) time.Duration {
+		s := startPipeUploadServer(t, cfg)
+		s.delay = func(uint64) time.Duration { return 100 * time.Millisecond }
+		w := newPipeWriter(t, cfg, s.addr, nil, 32<<10, Range{Min: 10, Max: 10}, maxInFlight)
+		data := randomBytes(t, 32*32<<10)
+		start := time.Now()
+		require.NoError(t, writeInPieces(w, data, 16<<10))
+		require.NoError(t, w.Close())
+		got := s.stream(t)
+		elapsed := time.Since(start)
+		require.Equal(t, sha256.Sum256(data), sha256.Sum256(got))
+		t.Logf("in flight %d: 1 MiB in %v (%.1f Mbit/s)", maxInFlight, elapsed.Round(time.Millisecond),
+			float64(len(data))*8/elapsed.Seconds()/1e6)
+		return elapsed
+	}
+	sequential := run(1)
+	pipelined := run(packetUpMaxInFlight)
+	assert.Less(t, pipelined*3, sequential, "pipelined %v, sequential %v", pipelined, sequential)
+	requireNoWriterGoroutines(t)
+}
