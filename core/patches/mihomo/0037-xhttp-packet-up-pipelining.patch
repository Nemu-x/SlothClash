+// While the server holds every response, exactly packetUpMaxInFlight requests
+// (one over HTTP/1.1) are sent and Write blocks; once the responses come the stream completes.
+func TestPacketUpInFlightCap(t *testing.T) {
+	for _, tc := range pipeCases()[:3] {
+		t.Run(tc.name, func(t *testing.T) {
+			cfg := tc.cfg()
+			s := startPipeUploadServer(t, cfg)
+			s.block = make(chan struct{})
+			postBytes := 4 << 10
+			w := newPipeWriter(t, cfg, s.addr, tc.alpn, postBytes, Range{Min: 1, Max: 1}, packetUpMaxInFlight)
+			data := randomBytes(t, 3*packetUpMaxInFlight*postBytes)
+			writeDone := make(chan error, 1)
+			go func() { writeDone <- writeInPieces(w, data, 1000) }()
+
+			require.Eventually(t, func() bool { return int(s.inFlight.Load()) == tc.window() },
+				5*time.Second, 5*time.Millisecond)
+			time.Sleep(200 * time.Millisecond) // nothing more is sent while all wait
+			assert.Equal(t, tc.window(), int(s.requests.Load()))
+			assert.Equal(t, tc.window(), int(s.maxInFlight.Load()))
+			select {
+			case err := <-writeDone:
+				t.Fatalf("Write returned while the window is full: %v", err)
+			default:
+			}
+
+			close(s.block)
+			select {
+			case err := <-writeDone:
+				require.NoError(t, err)
+			case <-time.After(10 * time.Second):
+				t.Fatal("Write did not finish after the responses came")
+			}
+			require.NoError(t, w.Close())
+			got := s.stream(t)
+			assert.Equal(t, sha256.Sum256(data), sha256.Sum256(got))
+			assert.Equal(t, tc.window(), int(s.maxInFlight.Load()))
+			requireNoWriterGoroutines(t)
+		})
+	}
+}
