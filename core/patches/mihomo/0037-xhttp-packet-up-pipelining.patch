+// Close sends the buffered tail and waits for the requests in flight.
+func TestPacketUpCloseDeliversTail(t *testing.T) {
+	cfg := &Config{Host: "example.com", Path: "/xhttp", Mode: "packet-up"}
+	s := startPipeUploadServer(t, cfg)
+	s.delay = func(uint64) time.Duration { return 100 * time.Millisecond }
+	w := newPipeWriter(t, cfg, s.addr, nil, 4<<10, Range{Min: 30, Max: 30}, packetUpMaxInFlight)
+	data := randomBytes(t, 20<<10+123)
+	require.NoError(t, writeInPieces(w, data, 1000))
+	require.NoError(t, w.Close())
+	assert.Equal(t, int32(0), s.inFlight.Load(), "Close returned before the responses")
+	assert.Equal(t, sha256.Sum256(data), sha256.Sum256(s.stream(t)))
+	requireNoWriterGoroutines(t)
+}
