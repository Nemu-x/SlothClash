+// Close returns while requests are stuck and Write is blocked on the full
+// window; the blocked Write and later ones fail, and no goroutine is left.
+func TestPacketUpCloseWhileInFlight(t *testing.T) {
+	for _, tc := range pipeCases()[:3] {
+		t.Run(tc.name, func(t *testing.T) {
+			cfg := tc.cfg()
+			s := startPipeUploadServer(t, cfg)
+			s.block = make(chan struct{}) // never closed: the server never answers
+			w := newPipeWriter(t, cfg, s.addr, tc.alpn, 4<<10, Range{Min: 1, Max: 1}, packetUpMaxInFlight)
+			writeDone := make(chan error, 1)
+			go func() { writeDone <- writeInPieces(w, randomBytes(t, 1<<20), 1000) }()
+			require.Eventually(t, func() bool { return int(s.inFlight.Load()) == tc.window() },
+				5*time.Second, 5*time.Millisecond)
+
+			start := time.Now()
+			require.NoError(t, w.Close())
+			assert.Less(t, time.Since(start), 3*time.Second)
+			select {
+			case err := <-writeDone:
+				assert.Error(t, err)
+			case <-time.After(5 * time.Second):
+				t.Fatal("the blocked Write did not return after Close")
+			}
+			_, err := w.Write([]byte("after close"))
+			assert.Error(t, err)
+			requireNoWriterGoroutines(t)
+			require.Eventually(t, func() bool { return s.inFlight.Load() == 0 }, 5*time.Second, 5*time.Millisecond)
+		})
+	}
+}
