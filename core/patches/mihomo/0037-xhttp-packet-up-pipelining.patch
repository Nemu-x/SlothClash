+// blockingUploads answers uploads only once released, or fails the ones fail
+// returns true for.
+type blockingUploads struct {
+	uploadTracker
+	release chan struct{}
+	fail    func(seq int) bool
+}
+
+func (b *blockingUploads) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	seq := uploadSeq(r)
+	if seq < 0 {
+		http.Error(w, "not an upload", http.StatusBadRequest)
+		return
+	}
+	_, _ = io.Copy(io.Discard, r.Body)
+	b.begin(seq)
+	defer b.end(seq)
+	if b.fail != nil && b.fail(seq) {
+		http.Error(w, "failed upload", http.StatusInternalServerError)
+		return
+	}
+	select {
+	case <-b.release:
+	case <-r.Context().Done():
+	}
+}
+
+func newTestWriter(addr string, maxEachPostBytes int, interval Range, window int) *PacketUpWriter {
+	cfg := &Config{Host: "example.com", Path: "/xhttp", Mode: "packet-up"}
+	return newPacketUpWriter(context.Background(), cfg, maxEachPostBytes, interval, "session", pipelineTransport(addr, nil), window)
+}
+
+// writeUntilBlocked writes in the background until Write blocks or fails.
+func writeUntilBlocked(w *PacketUpWriter) <-chan error {
+	done := make(chan error, 1)
+	go func() {
+		chunk := make([]byte, 1024)
+		for {
+			if _, err := w.Write(chunk); err != nil {
+				done <- err
+				return
+			}
+		}
+	}()
+	return done
+}
+
+// No more than the window of uploads waits for a response, whatever the
+// speed of the writer, and the writer blocks until a response frees a slot.
+func TestPacketUpWindowLimit(t *testing.T) {
+	server := &blockingUploads{release: make(chan struct{})}
+	addr := startPipelineServer(t, server)
+	w := newTestWriter(addr, 1024, Range{0, 0}, packetUpWindow)
+
+	done := writeUntilBlocked(w)
+	require.Eventually(t, func() bool {
+		maxOpen, _ := server.stats()
+		return maxOpen == packetUpWindow
+	}, 5*time.Second, 5*time.Millisecond)
+	time.Sleep(100 * time.Millisecond) // give an over-limit upload time to show up
+	maxOpen, maxSpan := server.stats()
+	assert.Equal(t, packetUpWindow, maxOpen)
+	assert.Equal(t, packetUpWindow, maxSpan)
+	select {
+	case err := <-done:
+		t.Fatalf("Write did not block on a full window: %v", err)
+	default:
+	}
+
+	close(server.release) // the writer goes on once responses come
+	require.Eventually(t, func() bool {
+		server.mu.Lock()
+		defer server.mu.Unlock()
+		return len(server.active) == 0 && server.highest > 4*packetUpWindow
+	}, 5*time.Second, 5*time.Millisecond)
+	_ = w.Close()
+	assert.ErrorIs(t, <-done, net.ErrClosed)
+}
+
+// A failed upload fails the next Write and cancels the uploads in flight.
+func TestPacketUpFailedUploadFailsWrite(t *testing.T) {
+	server := &blockingUploads{release: make(chan struct{}), fail: func(seq int) bool { return seq == 3 }}
+	addr := startPipelineServer(t, server)
+	w := newTestWriter(addr, 1024, Range{0, 0}, packetUpWindow)
+	defer w.Close()
+
+	select {
+	case err := <-writeUntilBlocked(w):
+		assert.ErrorContains(t, err, "500")
+	case <-time.After(5 * time.Second):
+		t.Fatal("Write did not fail after a failed upload")
+	}
+	require.Eventually(t, func() bool {
+		server.mu.Lock()
+		defer server.mu.Unlock()
+		return len(server.active) == 0
+	}, 5*time.Second, 5*time.Millisecond, "uploads in flight were not canceled")
+}
+
+func writerGoroutines() int {
+	buf := make([]byte, 1<<20)
+	buf = buf[:runtime.Stack(buf, true)]
+	return bytes.Count(buf, []byte("xhttp.(*PacketUpWriter)"))
+}
+
+// Close returns while uploads still wait for a response, and leaves no
+// upload behind.
+func TestPacketUpCloseCancelsUploads(t *testing.T) {
+	server := &blockingUploads{release: make(chan struct{})}
+	addr := startPipelineServer(t, server)
+	before := writerGoroutines()
+	w := newTestWriter(addr, 1024, Range{0, 0}, packetUpWindow)
+
+	done := writeUntilBlocked(w)
+	require.Eventually(t, func() bool {
+		maxOpen, _ := server.stats()
+		return maxOpen == packetUpWindow
+	}, 5*time.Second, 5*time.Millisecond)
+
+	start := time.Now()
+	require.NoError(t, w.Close())
+	assert.Less(t, time.Since(start), 3*time.Second)
+	assert.ErrorIs(t, <-done, net.ErrClosed)
+	_, err := w.Write([]byte("late"))
+	assert.ErrorIs(t, err, net.ErrClosed)
+	require.Eventually(t, func() bool { return writerGoroutines() == before }, 5*time.Second, 10*time.Millisecond)
+}
+
+// Close lets the uploads in flight finish, so the tail of the stream arrives.
+func TestPacketUpCloseFlushesTail(t *testing.T) {
+	var mu sync.Mutex
+	var got []byte
+	queue := NewUploadQueue(30)
+	addr := startPipelineServer(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		seq := uploadSeq(r)
+		body, _ := io.ReadAll(r.Body)
+		time.Sleep(20 * time.Millisecond)
+		_ = queue.Push(Packet{Seq: uint64(seq), Payload: body})
+	}))
+	read := make(chan struct{})
+	go func() {
+		defer close(read)
+		buf := make([]byte, 4096)
+		for {
+			n, err := queue.Read(buf)
+			mu.Lock()
+			got = append(got, buf[:n]...)
+			mu.Unlock()
+			if err != nil {
+				return
+			}
+		}
+	}()
+
+	w := newTestWriter(addr, 1000, Range{5, 5}, packetUpWindow)
+	data := make([]byte, 20000)
+	_, _ = rand.Read(data)
+	_, err := w.Write(data)
+	require.NoError(t, err)
+	require.NoError(t, w.Close())
+	require.Eventually(t, func() bool {
+		mu.Lock()
+		defer mu.Unlock()
+		return len(got) == len(data)
+	}, 5*time.Second, 5*time.Millisecond)
+	_ = queue.Close()
+	<-read
+	assert.Equal(t, data, got)
+}
+
+// Like Xray, the post interval paces the uploads: the first data of a
+// connection goes out at once instead of after the interval.
+func TestPacketUpFirstUploadNotDelayed(t *testing.T) {
+	arrived := make(chan time.Time, 16)
+	addr := startPipelineServer(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = io.Copy(io.Discard, r.Body)
+		arrived <- time.Now()
+	}))
+	w := newTestWriter(addr, 1<<20, Range{500, 500}, packetUpWindow)
+	defer w.Close()
+
+	start := time.Now()
+	_, err := w.Write([]byte("first"))
+	require.NoError(t, err)
+	_, err = w.Write([]byte("second"))
+	require.NoError(t, err)
+	first := <-arrived
+	assert.Less(t, first.Sub(start), 400*time.Millisecond)
+	second := <-arrived
+	assert.GreaterOrEqual(t, second.Sub(start), 450*time.Millisecond, "the interval no longer paces the uploads")
+}
