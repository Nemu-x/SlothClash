+// A request the server refuses fails the session: the other requests in flight
+// are aborted and Write returns the error.
+func TestPacketUpFailedUploadFailsSession(t *testing.T) {
+	cfg := &Config{Host: "example.com", Path: "/xhttp", Mode: "packet-up"}
+	s := startPipeUploadServer(t, cfg)
+	s.status = func(seq uint64) int {
+		if seq == 3 {
+			return http.StatusInternalServerError
+		}
+		return http.StatusOK
+	}
+	s.delay = func(seq uint64) time.Duration {
+		if seq == 3 {
+			return 50 * time.Millisecond
+		}
+		return 10 * time.Second // still in flight when seq 3 fails
+	}
+	w := newPipeWriter(t, cfg, s.addr, nil, 4<<10, Range{Min: 1, Max: 1}, packetUpMaxInFlight)
+	writeDone := make(chan error, 1)
+	go func() { writeDone <- writeInPieces(w, randomBytes(t, 1<<20), 1000) }()
+	select {
+	case err := <-writeDone:
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "bad status")
+	case <-time.After(5 * time.Second):
+		t.Fatal("Write did not fail after an upload was refused")
+	}
+	require.Eventually(t, func() bool { return s.inFlight.Load() == 0 }, 5*time.Second, 5*time.Millisecond,
+		"the other requests were not aborted")
+	assert.Greater(t, int(s.aborted.Load()), 0)
+	_, err := w.Write([]byte("more"))
+	assert.Error(t, err)
+	require.NoError(t, w.Close())
+	requireNoWriterGoroutines(t)
+}
