+// The window is one of seqs, not only of requests: while seq 0 is unanswered,
+// seqs 1-7 are sent and answered but seq 8 is not sent, so the server never
+// holds more than 7 uploads out of order however fast it answers the others.
+// The server's queue is sized like Xray's smallest sc-max-buffered-posts that
+// holds the window.
+func TestPacketUpSeqWindow(t *testing.T) {
+	for _, tc := range pipeCases()[:2] {
+		t.Run(tc.name, func(t *testing.T) {
+			cfg := tc.cfg()
+			s := startPipeUploadServerBuffering(t, cfg, packetUpMaxInFlight-1)
+			release := make(chan struct{})
+			s.delay = func(seq uint64) time.Duration {
+				if seq == 0 {
+					<-release
+				}
+				return 0
+			}
+			postBytes := 4 << 10
+			w := newPipeWriter(t, cfg, s.addr, tc.alpn, postBytes, Range{Min: 1, Max: 1}, packetUpMaxInFlight)
+			data := randomBytes(t, 4*packetUpMaxInFlight*postBytes)
+			writeDone := make(chan error, 1)
+			go func() { writeDone <- writeInPieces(w, data, 1000) }()
+
+			require.Eventually(t, func() bool { return int(s.requests.Load()) == packetUpMaxInFlight },
+				5*time.Second, 5*time.Millisecond)
+			time.Sleep(200 * time.Millisecond)
+			assert.Equal(t, packetUpMaxInFlight, int(s.requests.Load()), "a request beyond the seq window was sent")
+			assert.Equal(t, int32(1), s.inFlight.Load(), "only seq 0 should be unanswered")
+
+			close(release)
+			select {
+			case err := <-writeDone:
+				require.NoError(t, err)
+			case <-time.After(10 * time.Second):
+				t.Fatal("Write did not finish after seq 0 was answered")
+			}
+			require.NoError(t, w.Close())
+			assert.Equal(t, sha256.Sum256(data), sha256.Sum256(s.stream(t)))
+			requireNoWriterGoroutines(t)
+		})
+	}
+}
