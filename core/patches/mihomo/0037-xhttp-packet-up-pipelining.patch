+package xhttp
+
+// SlothClash core patch 0037 (ClashFest patch 0038): packet-up keeps up to
+// packetUpMaxInFlight upload requests in flight. The test server and helpers follow Rerowros/veles
+// (GPL-3.0) transport/xhttp/packet_up_veles_test.go.
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"fmt"
+	"io"
+	"math"
+	mathrand "math/rand"
+	"net"
+	"runtime"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/metacubex/http"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// pipeUploadServer is a packet-up upload endpoint. It puts the payloads back
+// in order by seq with the server's UploadQueue and counts the requests it is answering.
+type pipeUploadServer struct {
+	cfg    *Config
+	addr   string
+	delay  func(seq uint64) time.Duration // before the payload is pushed; nil: none
+	block  chan struct{}                  // when set, every request waits for it to close
+	status func(seq uint64) int           // nil: 200
+
+	queue    *UploadQueue
+	received chan []byte
+
+	inFlight    atomic.Int32
+	maxInFlight atomic.Int32
+	requests    atomic.Int32
+	aborted     atomic.Int32
+
+	mu   sync.Mutex
+	seqs []uint64 // in the order the requests arrived
+}
+
+func startPipeUploadServer(t *testing.T, cfg *Config) *pipeUploadServer {
+	t.Helper()
+	return startPipeUploadServerBuffering(t, cfg, 30) // the default sc-max-buffered-posts
+}
+
+func startPipeUploadServerBuffering(t *testing.T, cfg *Config, maxBufferedPosts int) *pipeUploadServer {
+	t.Helper()
+	s := &pipeUploadServer{cfg: cfg, queue: NewUploadQueue(maxBufferedPosts), received: make(chan []byte, 1)}
+	go func() {
+		var got bytes.Buffer
+		_, _ = io.Copy(&got, s.queue)
+		s.received <- got.Bytes()
+	}()
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	protocols := new(http.Protocols)
+	protocols.SetHTTP1(true)
+	protocols.SetUnencryptedHTTP2(true)
+	server := &http.Server{Handler: s, Protocols: protocols}
+	go func() { _ = server.Serve(ln) }()
+	t.Cleanup(func() {
+		_ = server.Close()
+		_ = s.queue.Close()
+	})
+	s.addr = ln.Addr().String()
+	return s
+}
+
+func (s *pipeUploadServer) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	n := s.inFlight.Add(1)
+	defer s.inFlight.Add(-1)
+	for m := s.maxInFlight.Load(); n > m && !s.maxInFlight.CompareAndSwap(m, n); m = s.maxInFlight.Load() {
+	}
+	s.requests.Add(1)
+
+	_, seqStr := s.cfg.ExtractMetaFromRequest(r, s.cfg.NormalizedPath())
+	seq, err := strconv.ParseUint(seqStr, 10, 64)
+	if err != nil {
+		http.Error(w, "no seq", http.StatusBadRequest)
+		return
+	}
+	s.mu.Lock()
+	s.seqs = append(s.seqs, seq)
+	s.mu.Unlock()
+
+	var payload []byte
+	if s.cfg.GetNormalizedUplinkDataPlacement() == PlacementHeader {
+		var encoded strings.Builder
+		for i := 0; ; i++ {
+			chunk := r.Header.Get(fmt.Sprintf("%s-%d", s.cfg.UplinkDataKey, i))
+			if chunk == "" {
+				break
+			}
+			encoded.WriteString(chunk)
+		}
+		payload, err = base64.RawURLEncoding.DecodeString(encoded.String())
+	} else {
+		payload, err = io.ReadAll(r.Body)
+	}
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+
+	if s.block != nil {
+		select {
+		case <-s.block:
+		case <-r.Context().Done():
+			s.aborted.Add(1)
+			return
+		}
+	}
+	if s.delay != nil {
+		select {
+		case <-time.After(s.delay(seq)):
+		case <-r.Context().Done():
+			s.aborted.Add(1)
+			return
+		}
+	}
+	if s.status != nil {
+		if status := s.status(seq); status != http.StatusOK {
+			w.WriteHeader(status)
+			return
+		}
+	}
+	if err := s.queue.Push(Packet{Seq: seq, Payload: payload}); err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	w.WriteHeader(http.StatusOK)
+}
+
+// stream waits until no request is in progress, closes the queue and returns
+// the reassembled stream.
+func (s *pipeUploadServer) stream(t *testing.T) []byte {
+	t.Helper()
+	require.Eventually(t, func() bool { return s.inFlight.Load() == 0 }, 10*time.Second, 5*time.Millisecond)
+	_ = s.queue.Close()
+	select {
+	case got := <-s.received:
+		return got
+	case <-time.After(5 * time.Second):
+		t.Fatal("upload queue reader did not finish")
+		return nil
+	}
+}
+
+func (s *pipeUploadServer) arrivalOrder() []uint64 {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return append([]uint64(nil), s.seqs...)
+}
+
+type pipeCase struct {
+	name string
+	cfg  func() *Config
+	alpn []string
+}
+
+// window is how many requests the case keeps unanswered: HTTP/1.1 waits for
+// each response.
+func (tc pipeCase) window() int {
+	if len(tc.alpn) == 1 && tc.alpn[0] == "http/1.1" {
+		return 1
+	}
+	return packetUpMaxInFlight
+}
+
+func pipeCases() []pipeCase {
+	postCfg := func() *Config { return &Config{Host: "example.com", Path: "/xhttp", Mode: "packet-up"} }
+	headerCfg := func() *Config {
+		// uplink in X-Data-N headers of GET requests, for a CDN that drops POST bodies
+		return &Config{Host: "example.com", Path: "/xhttp", Mode: "packet-up",
+			UplinkHTTPMethod: http.MethodGet, UplinkDataPlacement: PlacementHeader,
+			UplinkDataKey: "X-Data", UplinkChunkSize: "8192"}
+	}
+	return []pipeCase{
+		{name: "post-h2", cfg: postCfg},
+		{name: "get-header-h2", cfg: headerCfg},
+		{name: "post-h1", cfg: postCfg, alpn: []string{"http/1.1"}},
+		{name: "get-header-h1", cfg: headerCfg, alpn: []string{"http/1.1"}},
+	}
+}
+
+// newPipeWriter returns a writer to addr over HTTP/2 without TLS (alpn nil) or
+// HTTP/1.1, with up to maxInFlight requests waiting for a response.
+func newPipeWriter(t *testing.T, cfg *Config, addr string, alpn []string, maxEachPostBytes int, interval Range,
+	maxInFlight int) *PacketUpWriter {
+	t.Helper()
+	prev := packetUpMaxInFlight
+	packetUpMaxInFlight = maxInFlight
+	defer func() { packetUpMaxInFlight = prev }()
+	transport := NewTransport(
+		func(ctx context.Context) (net.Conn, error) {
+			var d net.Dialer
+			return d.DialContext(ctx, "tcp", addr)
+		},
+		func(ctx context.Context, conn net.Conn, isH2 bool) (net.Conn, error) { return conn, nil },
+		nil, alpn, 0)
+	return newPacketUpWriter(context.Background(), cfg, maxEachPostBytes, interval, "test-session", transport)
+}
+
+// writerGoroutines counts goroutines running PacketUpWriter code.
+func writerGoroutines() int {
+	buf := make([]byte, 1<<20)
+	for {
+		n := runtime.Stack(buf, true)
+		if n < len(buf) {
+			buf = buf[:n]
+			break
+		}
+		buf = make([]byte, 2*len(buf))
+	}
+	count := 0
+	for _, g := range strings.Split(string(buf), "\n\n") {
+		if strings.Contains(g, "xhttp.(*PacketUpWriter)") && !strings.Contains(g, "writerGoroutines") {
+			count++
+		}
+	}
+	return count
+}
+
+func requireNoWriterGoroutines(t *testing.T) {
+	t.Helper()
+	require.Eventually(t, func() bool { return writerGoroutines() == 0 }, 5*time.Second, 10*time.Millisecond,
+		"PacketUpWriter goroutines left after Close")
+}
+
+func randomBytes(t *testing.T, n int) []byte {
+	t.Helper()
+	b := make([]byte, n)
+	_, err := rand.Read(b)
+	require.NoError(t, err)
+	return b
+}
+
+func writeInPieces(w io.Writer, data []byte, piece int) error {
+	for len(data) > 0 {
+		n := piece
+		if n > len(data) {
+			n = len(data)
+		}
+		if _, err := w.Write(data[:n]); err != nil {
+			return err
+		}
+		data = data[n:]
+	}
+	return nil
+}
+
+// The requests carry consecutive seqs in the order they are sent, the server
+// answers them out of order, and the stream it reassembles is the one written.
+// Over HTTP/2 more than one request is in flight, never more than
+// packetUpMaxInFlight; over HTTP/1.1 one.
+func TestPacketUpPipelinedOrder(t *testing.T) {
+	for _, tc := range pipeCases() {
+		t.Run(tc.name, func(t *testing.T) {
+			cfg := tc.cfg()
+			s := startPipeUploadServer(t, cfg)
+			s.delay = func(seq uint64) time.Duration { return time.Duration(mathrand.Intn(40)) * time.Millisecond }
+			postBytes := 64 << 10
+			if cfg.GetNormalizedUplinkDataPlacement() == PlacementHeader {
+				postBytes = 4 << 10 // keep the headers within the server's limit
+			}
+			w := newPipeWriter(t, cfg, s.addr, tc.alpn, postBytes, Range{Min: 1, Max: 1}, packetUpMaxInFlight)
+			data := randomBytes(t, 64*postBytes)
+			require.NoError(t, writeInPieces(w, data, 3000))
+			require.NoError(t, w.Close())
+
+			got := s.stream(t)
+			assert.Equal(t, sha256.Sum256(data), sha256.Sum256(got))
+			order := s.arrivalOrder()
+			require.NotEmpty(t, order)
+			// every seq once, and never further from its place than the window:
+			// a request starts once the previous one's headers are written, but
+			// the server runs its handlers concurrently
+			seen := make([]bool, len(order))
+			for i, seq := range order {
+				require.Less(t, seq, uint64(len(order)))
+				assert.False(t, seen[seq], "seq %d twice", seq)
+				seen[seq] = true
+				assert.Less(t, int(math.Abs(float64(int(seq)-i))), tc.window(), "seq %d arrived as %d", seq, i)
+			}
+			t.Logf("%d requests, up to %d at the server at once", s.requests.Load(), s.maxInFlight.Load())
+			if tc.window() > 1 {
+				assert.Greater(t, int(s.maxInFlight.Load()), 1)
+			}
+			assert.LessOrEqual(t, int(s.maxInFlight.Load()), tc.window())
+			requireNoWriterGoroutines(t)
+		})
+	}
+}
