+		full,  // the other 2952 B, copyOnce; Vision is done after this read
+		full,  // 100 B: the choice carries over
+		full,  // 5000 B
+		full,  // 300 B
+		full,  // 200 B: two short reads in a row
+		small, // the EOF
+	}
+	assert.Equal(t, want, src.caps)
+}
