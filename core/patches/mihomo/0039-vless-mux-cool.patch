+// wrapMuxCool applies the opt-in "mux.cool" block of a vless proxy: TCP
+// streams and UDP (XUDP) share pooled VLESS Mux.Cool carriers, as Xray's
+// outbound "mux" does. A disabled block leaves the proxy untouched.
+func wrapMuxCool(mapping, muxCoolMapping map[string]any, proxy outbound.ProxyAdapter, decoder *structure.Decoder) (outbound.ProxyAdapter, error) {
+	option := outbound.MuxCoolOption{}
+	if err := decoder.Decode(muxCoolMapping, &option); err != nil {
+		_ = proxy.Close()
+		return nil, err
+	}
+	if !option.Enabled {
+		return proxy, nil
+	}
+	err := checkMuxCool(mapping, decoder)
+	var wrapped outbound.ProxyAdapter
+	if err == nil {
+		wrapped, err = outbound.NewMuxCool(option, proxy)
+	}
+	if err != nil {
+		_ = proxy.Close()
+		return nil, err
+	}
+	return wrapped, nil
+}
+
+func checkMuxCool(mapping map[string]any, decoder *structure.Decoder) error {
+	if proxyType := mapping["type"]; proxyType != "vless" {
+		// Only the VLESS outbound turns the carrier dial into the Mux command.
+		return fmt.Errorf("mux.cool is only supported for vless proxies, not %v", proxyType)
+	}
+	if mapping["network"] == "xdrive" {
+		return fmt.Errorf("xdrive already carries Mux.Cool and cannot be wrapped in mux.cool")
+	}
+	if flow, _ := mapping["flow"].(string); strings.HasPrefix(flow, vless.XRV) {
+		// Vision splices the inner TLS of one TCP connection, a carrier holds
+		// many sessions: Xray rejects mux with Vision for TCP.
+		return fmt.Errorf("mux.cool cannot be used with VLESS flow %s: disable mux.cool or remove flow", flow)
+	}
+	if smuxMapping, ok := mapping["smux"].(map[string]any); ok {
+		smux := outbound.SingMuxOption{}
+		if err := decoder.Decode(smuxMapping, &smux); err != nil {
+			return err
+		}
+		if smux.Enabled {
+			return fmt.Errorf("smux and mux.cool cannot be enabled together")
+		}
+	}
+	return nil
+}
+
