+package outbound
+
+import (
+	"context"
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/transport/vless"
+)
+
+// vlessRequestCommand streams a request through a plain VLESS outbound and
+// returns the command byte of the request header the server receives.
+func vlessRequestCommand(t *testing.T, ctx context.Context, metadata *C.Metadata) byte {
+	t.Helper()
+	v, err := NewVless(VlessOption{Name: "v", Server: "127.0.0.1", Port: 443, UUID: "b831381d-6324-4d53-ad4f-8cda48b30811"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer v.Close()
+	client, server := net.Pipe()
+	defer client.Close()
+	defer server.Close()
+	_ = server.SetDeadline(time.Now().Add(5 * time.Second))
+	header := make(chan []byte, 1)
+	go func() {
+		// version, UUID, addons length (0), command
+		buf := make([]byte, 1+16+1+1)
+		if _, err := io.ReadFull(server, buf); err != nil {
+			header <- nil
+			return
+		}
+		header <- buf
+		_, _ = io.Copy(io.Discard, server)
+	}()
+	conn, err := v.StreamConnContext(ctx, client, metadata)
+	if err != nil {
+		t.Fatal(err)
+	}
+	go func() { _, _ = conn.Write([]byte("x")) }()
+	got := <-header
+	if got == nil {
+		t.Fatal("no VLESS request header")
+	}
+	return got[18]
+}
+
+func TestVlessSendsMuxCommandOnlyForMarkedCarrier(t *testing.T) {
+	carrier := &C.Metadata{NetWork: C.TCP, Type: C.INNER, Host: muxCoolDestination, DstPort: muxCoolPort}
+	marked := context.WithValue(context.Background(), muxCoolCarrierKey{}, carrier)
+	if got := vlessRequestCommand(t, marked, carrier); got != vless.CommandMux {
+		t.Fatalf("carrier command = %d, want Mux", got)
+	}
+	// Without the mark a dial to v1.mux.cool stays a TCP request, as before.
+	unmarked := &C.Metadata{NetWork: C.TCP, Host: muxCoolDestination, DstPort: muxCoolPort}
+	if got := vlessRequestCommand(t, context.Background(), unmarked); got != vless.CommandTCP {
+		t.Fatalf("unmarked command = %d, want TCP", got)
+	}
+	// A dialer-proxy hop inherits the context but dials other metadata.
+	hop := &C.Metadata{NetWork: C.TCP, Host: "example.com", DstPort: 443}
+	if got := vlessRequestCommand(t, marked, hop); got != vless.CommandTCP {
+		t.Fatalf("inherited-context command = %d, want TCP", got)
+	}
+}
