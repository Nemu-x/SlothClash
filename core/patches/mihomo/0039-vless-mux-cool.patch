+func TestMuxCoolSharesPoolWhenXUDPConcurrencyIsZero(t *testing.T) {
+	base := newFakeMuxCoolAdapter()
+	wrapped, err := NewMuxCool(MuxCoolOption{Enabled: true}, base)
+	if err != nil {
