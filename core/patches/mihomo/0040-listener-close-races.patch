diff --git a/listener/close_race_test.go b/listener/close_race_test.go
new file mode 100644
index 0000000..df6fb4b
--- /dev/null
+++ b/listener/close_race_test.go
@@ -0,0 +1,129 @@
+package listener_test
+
+import (
+	"net"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/common/utils"
+	"github.com/metacubex/mihomo/component/ca"
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/listener/inbound"
+
+	"github.com/stretchr/testify/require"
+)
+
+// closeRaceTunnel drops whatever reaches it: the test only opens and closes
+// listeners.
+type closeRaceTunnel struct{}
+
+func (closeRaceTunnel) HandleTCPConn(conn net.Conn, _ *C.Metadata) { _ = conn.Close() }
+func (closeRaceTunnel) HandleUDPPacket(C.UDPPacket, *C.Metadata)   {}
+func (closeRaceTunnel) NatTable() C.NatTable                       { return nil }
+
+// SlothClash core patch 0040.
+// TestInboundCloseRace closes every inbound whose accept or read loop checks a
+// closed flag twice, with a pause between the calls. After the first Close the
+// loops wake up with an error and read the flag; the second Close writes it
+// again. time.Sleep orders nothing for the race detector, so with a plain bool
+// field `go test -race` reports the write in Close against the read in the
+// loop. The flag is an atomic.Bool, so the test passes under -race; without
+// -race it still checks that a second Close neither panics nor hangs.
+func TestInboundCloseRace(t *testing.T) {
+	userUUID := utils.NewUUIDV4().String()
+	tlsCertificate, tlsPrivateKey, _, err := ca.NewRandomTLSKeyPair(ca.KeyPairTypeP256)
+	require.NoError(t, err)
+	base := func(name string) inbound.BaseOption {
+		return inbound.BaseOption{NameStr: name, Listen: "127.0.0.1", Port: "0"}
+	}
+	tests := []struct {
+		name string
+		new  func(name string) (C.InboundListener, error)
+		// listening may need privileges the test has no right to ask for
+		// (tproxy: IP_TRANSPARENT needs CAP_NET_ADMIN on Linux, other
+		// systems have no tproxy); such a case is skipped, not failed
+		mayNotListen bool
+	}{
+		{name: "socks", new: func(n string) (C.InboundListener, error) {
+			return inbound.NewSocks(&inbound.SocksOption{BaseOption: base(n), UDP: true})
+		}},
+		{name: "http", new: func(n string) (C.InboundListener, error) {
+			return inbound.NewHTTP(&inbound.HTTPOption{BaseOption: base(n)})
+		}},
+		{name: "mixed", new: func(n string) (C.InboundListener, error) {
+			return inbound.NewMixed(&inbound.MixedOption{BaseOption: base(n), UDP: true})
+		}},
+		{name: "shadowsocks", new: func(n string) (C.InboundListener, error) {
+			return inbound.NewShadowSocks(&inbound.ShadowSocksOption{BaseOption: base(n),
+				Cipher: "aes-128-gcm", Password: userUUID, UDP: true})
+		}},
+		{name: "shadowsocks-stream", new: func(n string) (C.InboundListener, error) {
+			// a stream cipher is served by listener/shadowsocks, not sing
+			return inbound.NewShadowSocks(&inbound.ShadowSocksOption{BaseOption: base(n),
+				Cipher: "aes-128-ctr", Password: userUUID, UDP: true})
+		}},
+		{name: "vmess", new: func(n string) (C.InboundListener, error) {
+			return inbound.NewVmess(&inbound.VmessOption{BaseOption: base(n),
+				Users: []inbound.VmessUser{{UUID: userUUID}}})
+		}},
+		{name: "vless", new: func(n string) (C.InboundListener, error) {
+			return inbound.NewVless(&inbound.VlessOption{BaseOption: base(n),
+				Users: []inbound.VlessUser{{UUID: userUUID}}, AllowInsecure: true})
+		}},
+		{name: "trojan", new: func(n string) (C.InboundListener, error) {
+			return inbound.NewTrojan(&inbound.TrojanOption{BaseOption: base(n),
+				Users:       []inbound.TrojanUser{{Password: userUUID}},
+				Certificate: tlsCertificate, PrivateKey: tlsPrivateKey})
+		}},
+		{name: "snell", new: func(n string) (C.InboundListener, error) {
+			return inbound.NewSnell(&inbound.SnellOption{BaseOption: base(n), Psk: userUUID})
+		}},
+		{name: "anytls", new: func(n string) (C.InboundListener, error) {
+			return inbound.NewAnyTLS(&inbound.AnyTLSOption{BaseOption: base(n),
+				Users:       map[string]string{"test": userUUID},
+				Certificate: tlsCertificate, PrivateKey: tlsPrivateKey})
+		}},
+		{name: "sudoku", new: func(n string) (C.InboundListener, error) {
+			return inbound.NewSudoku(&inbound.SudokuOption{BaseOption: base(n), Key: "test_key"})
+		}},
+		{name: "tuic", new: func(n string) (C.InboundListener, error) {
+			return inbound.NewTuic(&inbound.TuicOption{BaseOption: base(n),
+				Users:       map[string]string{userUUID: userUUID},
+				Certificate: tlsCertificate, PrivateKey: tlsPrivateKey})
+		}},
+		{name: "shadowquic", new: func(n string) (C.InboundListener, error) {
+			return inbound.NewShadowQuic(&inbound.ShadowQuicOption{BaseOption: base(n),
+				ALPN:        []string{"h3"},
+				Users:       []inbound.ShadowQuicUser{{Username: "u", Password: userUUID}},
+				JLSUpstream: inbound.ShadowQuicJLSUpstream{Addr: "127.0.0.1:1"}})
+		}},
+		{name: "tunnel", new: func(n string) (C.InboundListener, error) {
+			return inbound.NewTunnel(&inbound.TunnelOption{BaseOption: base(n),
+				Network: []string{"tcp", "udp"}, Target: "127.0.0.1:1"})
+		}},
+		{name: "redir", new: func(n string) (C.InboundListener, error) {
+			return inbound.NewRedir(&inbound.RedirOption{BaseOption: base(n)})
+		}},
+		{name: "tproxy", new: func(n string) (C.InboundListener, error) {
+			return inbound.NewTProxy(&inbound.TProxyOption{BaseOption: base(n), UDP: true})
+		}, mayNotListen: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			in, err := tt.new(tt.name + "_close_race")
+			require.NoError(t, err)
+
+			if err := in.Listen(closeRaceTunnel{}); err != nil {
+				if tt.mayNotListen {
+					t.Skipf("cannot listen here: %v", err)
+				}
+				require.NoError(t, err)
+			}
+
+			_ = in.Close()
+			// let the loops see the closed socket and read the flag
+			time.Sleep(100 * time.Millisecond)
+			_ = in.Close()
+		})
+	}
+}
