diff --git a/listener/snell_unsafe_raw_test.go b/listener/snell_unsafe_raw_test.go
new file mode 100644
index 00000000..1290018d
--- /dev/null
+++ b/listener/snell_unsafe_raw_test.go
@@ -0,0 +1,77 @@
+package listener
+
+import (
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/log"
+)
+
+// An unsafe-raw Snell v6 listener stays accepted but warns once, at config
+// load, that it is an open proxy; other modes and versions do not warn.
+func TestSnellV6UnsafeRawListenerWarnsOnce(t *testing.T) {
+	listeners := []map[string]any{
+		{"name": "snell-in-warn-test-v4"},
+		{"name": "snell-in-warn-test-unset", "version": 6},
+		{"name": "snell-in-warn-test-default", "version": 6, "mode": "default"},
+		{"name": "snell-in-warn-test-unshaped", "version": 6, "mode": "unshaped"},
+		{"name": "snell-in-warn-test-raw", "version": 6, "mode": "unsafe-raw"},
+		// The log keeps order: once this one's warning arrives, every
+		// earlier listener's warning (if any) has arrived too.
+		{"name": "snell-in-warn-test-sentinel", "version": 6, "mode": "unsafe-raw"},
+	}
+
+	sub := log.Subscribe()
+	defer log.UnSubscribe(sub)
+	for _, mapping := range listeners {
+		mapping["type"] = "snell"
+		mapping["listen"] = "127.0.0.1"
+		mapping["port"] = 0
+		mapping["psk"] = "snell-v6-test-psk"
+		l, err := ParseListener(mapping)
+		if err != nil {
+			t.Fatalf("%s: mode %v must still be accepted: %v", mapping["name"], mapping["mode"], err)
+		}
+		if l.Name() != mapping["name"] {
+			t.Fatalf("listener name %q, want %q", l.Name(), mapping["name"])
+		}
+	}
+
+	counts := map[string]int{}
+	payloads := map[string]string{}
+	deadline := time.After(5 * time.Second)
+	for counts["snell-in-warn-test-sentinel"] == 0 {
+		select {
+		case event := <-sub:
+			if event.LogLevel != log.WARNING || !strings.HasPrefix(event.Payload, "snell inbound ") {
+				continue
+			}
+			rest := strings.TrimPrefix(event.Payload, "snell inbound ")
+			i := strings.Index(rest, ":")
+			if i < 0 {
+				continue
+			}
+			counts[rest[:i]]++
+			payloads[rest[:i]] = event.Payload
+		case <-deadline:
+			t.Fatal("no warning for the unsafe-raw sentinel listener")
+		}
+	}
+
+	for _, mapping := range listeners[:4] {
+		name := mapping["name"].(string)
+		if counts[name] != 0 {
+			t.Errorf("%s (version %v, mode %v) warned: %s", name, mapping["version"], mapping["mode"], payloads[name])
+		}
+	}
+	if counts["snell-in-warn-test-raw"] != 1 {
+		t.Fatalf("unsafe-raw listener warned %d times, want once", counts["snell-in-warn-test-raw"])
+	}
+	payload := payloads["snell-in-warn-test-raw"]
+	for _, want := range []string{"unsafe-raw", "does not use the psk", "no authentication and no encryption", "open proxy", "plaintext"} {
+		if !strings.Contains(payload, want) {
+			t.Errorf("warning %q lacks %q", payload, want)
+		}
+	}
+}
