diff --git a/adapter/outbound/snell_unsafe_raw_test.go b/adapter/outbound/snell_unsafe_raw_test.go
new file mode 100644
index 00000000..d3ab83f7
--- /dev/null
+++ b/adapter/outbound/snell_unsafe_raw_test.go
@@ -0,0 +1,108 @@
+package outbound
+
+import (
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/log"
+	"github.com/metacubex/mihomo/transport/snell"
+)
+
+// snellWarnings constructs the proxies in order and returns how many
+// "snell <name>: ..." warnings each name got. The last proxy must warn: the
+// log keeps order, so once its warning arrives every earlier proxy's warning
+// (if any) has arrived too.
+func snellWarnings(t *testing.T, build func(name string), names []string) (map[string]int, map[string]string) {
+	t.Helper()
+	sub := log.Subscribe()
+	defer log.UnSubscribe(sub)
+
+	for _, name := range names {
+		build(name)
+	}
+	last := names[len(names)-1]
+	counts := map[string]int{}
+	payloads := map[string]string{}
+	deadline := time.After(5 * time.Second)
+	for counts[last] == 0 {
+		select {
+		case event := <-sub:
+			if event.LogLevel != log.WARNING || !strings.HasPrefix(event.Payload, "snell ") {
+				continue
+			}
+			rest := strings.TrimPrefix(event.Payload, "snell ")
+			i := strings.Index(rest, ":")
+			if i < 0 {
+				continue
+			}
+			name := rest[:i]
+			counts[name]++
+			payloads[name] = event.Payload
+		case <-deadline:
+			t.Fatalf("no warning for %s", last)
+		}
+	}
+	return counts, payloads
+}
+
+func TestSnellV6UnsafeRawWarnsOnce(t *testing.T) {
+	modes := map[string]string{
+		"snell-warn-test-unset":    "",
+		"snell-warn-test-default":  "default",
+		"snell-warn-test-unshaped": "unshaped",
+		"snell-warn-test-raw":      "unsafe-raw",
+		"snell-warn-test-sentinel": "unsafe-raw",
+	}
+	names := []string{"snell-warn-test-unset", "snell-warn-test-default", "snell-warn-test-unshaped", "snell-warn-test-raw", "snell-warn-test-sentinel"}
+	counts, payloads := snellWarnings(t, func(name string) {
+		p, err := NewSnell(SnellOption{
+			Name:    name,
+			Server:  "127.0.0.1",
+			Port:    443,
+			Psk:     "snell-v6-test-psk",
+			Version: snell.Version6,
+			Mode:    modes[name],
+		})
+		if err != nil {
+			t.Fatalf("%s: mode %q must still be accepted: %v", name, modes[name], err)
+		}
+		want, _ := snell.ParseV6Mode(modes[name])
+		if p.v6Mode != want {
+			t.Fatalf("%s: v6 mode %v, want %v", name, p.v6Mode, want)
+		}
+	}, names)
+
+	for _, name := range []string{"snell-warn-test-unset", "snell-warn-test-default", "snell-warn-test-unshaped"} {
+		if counts[name] != 0 {
+			t.Errorf("%s (mode %q) warned: %s", name, modes[name], payloads[name])
+		}
+	}
+	if counts["snell-warn-test-raw"] != 1 {
+		t.Fatalf("unsafe-raw proxy warned %d times, want once", counts["snell-warn-test-raw"])
+	}
+	payload := payloads["snell-warn-test-raw"]
+	for _, want := range []string{"unsafe-raw", "does not use the psk", "no authentication and no encryption", "plaintext"} {
+		if !strings.Contains(payload, want) {
+			t.Errorf("warning %q lacks %q", payload, want)
+		}
+	}
+}
+
+func TestSnellV4NoUnsafeRawWarning(t *testing.T) {
+	names := []string{"snell-warn-test-v4", "snell-warn-test-v4-sentinel"}
+	counts, payloads := snellWarnings(t, func(name string) {
+		option := SnellOption{Name: name, Server: "127.0.0.1", Port: 443, Psk: "psk"}
+		if name == "snell-warn-test-v4-sentinel" {
+			option.Psk = "snell-v6-test-psk"
+			option.Version = snell.Version6
+			option.Mode = "unsafe-raw"
+		}
+		if _, err := NewSnell(option); err != nil {
+			t.Fatalf("%s: %v", name, err)
+		}
+	}, names)
+	if counts["snell-warn-test-v4"] != 0 {
+		t.Errorf("v4 proxy warned: %s", payloads["snell-warn-test-v4"])
+	}
+}
