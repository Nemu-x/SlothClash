+func requireMuxCoolIgnored(t *testing.T, mapping map[string]any, match string) {
+	t.Helper()
+	sub := log.Subscribe()
+	defer log.UnSubscribe(sub)
+	parsed, err := ParseProxy(mapping)
+	if err != nil {
+		t.Fatalf("ParseProxy: %v", err)
+	}
+	defer parsed.Close()
+	if wrapped, ok := unwrapAutoClose(t, parsed.Adapter()).(*outbound.MuxCool); ok {
+		t.Fatalf("adapter = %T, want no MuxCool wrapper", wrapped)
+	}
+	deadline := time.After(5 * time.Second)
+	for {
+		select {
+		case event := <-sub:
+			if event.LogLevel == log.WARNING && strings.Contains(event.Payload, "mux.cool") && strings.Contains(event.Payload, match) {
+				return
+			}
+		case <-deadline:
+			t.Fatalf("no mux.cool warning mentioning %q", match)
+		}
+	}
