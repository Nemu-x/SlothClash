diff --git a/adapter/parser_finalmask_test.go b/adapter/parser_finalmask_test.go
new file mode 100644
index 0000000..ddb38dc
--- /dev/null
+++ b/adapter/parser_finalmask_test.go
@@ -0,0 +1,144 @@
+package adapter
+
+import (
+	"context"
+	"strings"
+	"testing"
+	"time"
+
+	C "github.com/metacubex/mihomo/constant"
+)
+
+// requireUnusableFinalMask: SlothClash patch 0044 loads a proxy whose finalmask
+// cannot be used (the profile keeps working, as with patch 0043), and the
+// proxy then fails every dial instead of connecting without its masks.
+func requireUnusableFinalMask(t *testing.T, mapping map[string]any, want string) {
+	t.Helper()
+	proxy, err := ParseProxy(mapping)
+	if err != nil {
+		t.Fatalf("unusable finalmask failed the proxy: %v", err)
+	}
+	t.Cleanup(func() { proxy.Close() })
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	conn, err := proxy.DialContext(ctx, &C.Metadata{Host: "example.com", DstPort: 80})
+	if err == nil {
+		_ = conn.Close()
+		t.Fatal("a proxy with an unusable finalmask dialed")
+	}
+	if !strings.Contains(err.Error(), want) {
+		t.Fatalf("dial error %q, want %q", err, want)
+	}
+}
+
+// A vless proxy with the finalmask chains of an Xray-core client, written as
+// mihomo YAML would decode it.
+func TestParseVlessFinalMask(t *testing.T) {
+	proxy, err := ParseProxy(map[string]any{
+		"name":             "vless-finalmask",
+		"type":             "vless",
+		"server":           "127.0.0.1",
+		"port":             443,
+		"uuid":             "b831381d-6324-4d53-ad4f-8cda48b30811",
+		"network":          "xhttp",
+		"tls":              true,
+		"alpn":             []any{"h3"},
+		"skip-cert-verify": true,
+		"xhttp-opts":       map[string]any{"path": "/x"},
+		"finalmask": map[string]any{
+			"tcp": []any{
+				map[string]any{"type": "fragment", "packets": "tlshello", "length": "100-200", "delay": "10-20"},
+				map[string]any{"type": "header-custom", "clients": []any{[]any{
+					map[string]any{"packet": "GET / HTTP/1.1\r\n", "type": "str"},
+					map[string]any{"rand": 4, "rand-range": "48-57", "capture": "n"},
+				}}, "servers": []any{[]any{
+					map[string]any{"packet": "HTTP/1.1 200 OK\r\n", "type": "str"},
+					map[string]any{"reuse": "n"},
+				}}},
+				map[string]any{"type": "sudoku", "password": "sudoku", "ascii": "prefer_ascii"},
+			},
+			"udp": []any{
+				map[string]any{"type": "noise", "reset": "30-60", "noise": []any{
+					map[string]any{"type": "exp", "packet": "<b 0x0d0a0d0a> <t> <r 24>", "delay": "10-20"},
+					map[string]any{"rand": "40-60", "rand-range": "0-255"},
+				}},
+				map[string]any{"type": "udphop", "mode": "intervalLocal", "interval": "30-60"},
+			},
+		},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if proxy.Type() != C.Vless {
+		t.Fatalf("type %v", proxy.Type())
+	}
+
+	// UDP masks need xhttp over HTTP/3.
+	// udp masks accepted on a tcp vless
+	requireUnusableFinalMask(t, map[string]any{
+		"name": "bad", "type": "vless", "server": "127.0.0.1", "port": 443, "uuid": "b831381d-6324-4d53-ad4f-8cda48b30811",
+		"finalmask": map[string]any{"udp": []any{map[string]any{"type": "noise", "noise": []any{map[string]any{"rand": 8}}}}},
+	}, "finalmask.udp")
+	// mkcp-legacy accepted
+	requireUnusableFinalMask(t, map[string]any{
+		"name": "bad", "type": "vless", "server": "127.0.0.1", "port": 443, "uuid": "b831381d-6324-4d53-ad4f-8cda48b30811",
+		"finalmask": map[string]any{"tcp": []any{map[string]any{"type": "mkcp-legacy"}}},
+	}, "mkcp-legacy")
+}
+
+func TestParseTrojanFinalMask(t *testing.T) {
+	proxy, err := ParseProxy(map[string]any{
+		"name":             "trojan-finalmask",
+		"type":             "trojan",
+		"server":           "127.0.0.1",
+		"port":             443,
+		"password":         "secret",
+		"skip-cert-verify": true,
+		"finalmask": map[string]any{
+			"tcp": []any{
+				// Xray's nesting works too.
+				map[string]any{"type": "xmc", "settings": map[string]any{
+					"password": "p", "hostname": "mc.example.com",
+					"profiles": []any{map[string]any{
+						"username": "Steve", "uuid": "069a79f4-44e9-4726-a5be-fca90e38aaf5",
+						"textures-value": "v", "textures-signature": "s",
+					}},
+				}},
+			},
+		},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if proxy.Type() != C.Trojan {
+		t.Fatalf("type %v", proxy.Type())
+	}
+	// udp masks accepted on trojan
+	requireUnusableFinalMask(t, map[string]any{
+		"name": "bad", "type": "trojan", "server": "127.0.0.1", "port": 443, "password": "secret",
+		"finalmask": map[string]any{"udp": []any{map[string]any{"type": "sudoku"}}},
+	}, "finalmask.udp")
+}
+
+// SlothClash 0044: xicmp is refused on every platform (its ICMP sockets
+// would bypass interface binding and enter the core's own TUN), on the one
+// network that would use it.
+func TestParseVlessFinalMaskXICMPUnusable(t *testing.T) {
+	requireUnusableFinalMask(t, map[string]any{
+		"name": "xicmp", "type": "vless", "server": "127.0.0.1", "port": 443, "uuid": "b831381d-6324-4d53-ad4f-8cda48b30811",
+		"network": "xhttp", "tls": true, "alpn": []any{"h3"}, "xhttp-opts": map[string]any{"path": "/x"},
+		"finalmask": map[string]any{"udp": []any{map[string]any{"type": "xicmp", "settings": map[string]any{"dgram": true, "ips": []any{"127.0.0.1"}}}}},
+	}, "xicmp")
+}
+
+// SlothClash 0044: xdrive (0004) dials its storage service, which cannot take
+// masks off; the node loads and never goes out, with or without the masks.
+func TestParseVlessFinalMaskXDriveUnusable(t *testing.T) {
+	requireUnusableFinalMask(t, map[string]any{
+		"name": "xdrive", "type": "vless", "server": "127.0.0.1", "port": 443, "uuid": "27848739-7e62-4138-9fd3-098a63964b6b",
+		"network":     "xdrive",
+		"encryption":  "mlkem768x25519plus.native.0rtt.XKbaq1BuzJKKKPxZbwgRpn-gYQbnhrYketgezASCL1I",
+		"xdrive-opts": map[string]any{"service": "local", "remote-folder": t.TempDir()},
+		"finalmask":   map[string]any{"tcp": []any{map[string]any{"type": "fragment", "packets": "1-1", "length": "1-5"}}},
+	}, "xdrive")
+}
diff --git a/config/finalmask_test.go b/config/finalmask_test.go
new file mode 100644
index 0000000..4d7720e
--- /dev/null
+++ b/config/finalmask_test.go
@@ -0,0 +1,161 @@
+package config
+
+// Profile-level checks of SlothClash core patch 0044, the path a
+// subscription takes through the core (UnmarshalRawConfig, parseProxies, as
+// in Parse and `mihomo -t`): finalmask blocks are accepted with a working
+// chain; a block that cannot be used (UDP masks on another network, an
+// unknown mask, xicmp) keeps the profile loading, as patch 0043 does for other
+// options, and that proxy then fails every dial instead of connecting without
+// its masks. xdrive is covered in adapter (it needs a storage directory).
+
+import (
+	"context"
+	"strings"
+	"testing"
+	"time"
+
+	C "github.com/metacubex/mihomo/constant"
+
+	"github.com/stretchr/testify/require"
+)
+
+const finalMaskTestProxy = `
+  - name: NAME
+    type: TYPE
+    server: 127.0.0.1
+    port: 9
+CREDENTIALS
+    servername: www.example.com
+    client-fingerprint: FINGERPRINT
+FINALMASK
+`
+
+func finalMaskTestNode(name, typ, fingerprint, finalmask string) string {
+	credentials := "    uuid: 27848739-7e62-4138-9fd3-098a63964b6b\n    tls: true"
+	if typ == "trojan" {
+		credentials = "    password: dummy"
+	}
+	return strings.NewReplacer("NAME", name, "TYPE", typ, "CREDENTIALS", credentials, "FINGERPRINT", fingerprint, "FINALMASK", finalmask).Replace(finalMaskTestProxy)
+}
+
+func parseFinalMaskProfile(t *testing.T, nodes ...string) map[string]C.Proxy {
+	t.Helper()
+	rawCfg, err := UnmarshalRawConfig([]byte("proxies:" + strings.Join(nodes, "")))
+	require.NoError(t, err)
+	proxies, _, err := parseProxies(rawCfg)
+	require.NoError(t, err, "the profile failed to load")
+	return proxies
+}
+
+func TestFinalMaskProfileAccepted(t *testing.T) {
+	valid := map[string]string{
+		"fragment": `    finalmask:
+      tcp:
+        - type: fragment
+          packets: tlshello
+          length: 100-200
+          delay: 10-20`,
+		"header-custom+sudoku": `    finalmask:
+      tcp:
+        - type: header-custom
+          clients:
+            - - packet: "GET / HTTP/1.1\r\n"
+                type: str
+        - type: sudoku
+          password: sudoku`,
+		"xray-nesting-camelcase": `    finalmask:
+      tcp:
+        - type: fragment
+          settings:
+            packets: "1-1"
+            length: 10-20
+            maxSplit: 4`,
+	}
+	var nodes []string
+	for _, typ := range []string{"vless", "trojan"} {
+		for name, block := range valid {
+			nodes = append(nodes, finalMaskTestNode(typ+"-"+name, typ, "chrome", block))
+		}
+	}
+	nodes = append(nodes, `
+  - name: xhttp-h3
+    type: vless
+    server: 127.0.0.1
+    port: 9
+    uuid: 27848739-7e62-4138-9fd3-098a63964b6b
+    tls: true
+    servername: www.example.com
+    network: xhttp
+    alpn: [h3]
+    xhttp-opts:
+      path: /x
+    finalmask:
+      udp:
+        - type: noise
+          noise:
+            - rand: 10-20
+        - type: udphop
+          mode: intervalLocal
+          interval: 30-60
+`)
+	proxies := parseFinalMaskProfile(t, nodes...)
+	names := []string{"xhttp-h3"}
+	for name := range valid {
+		names = append(names, "vless-"+name, "trojan-"+name)
+	}
+	for _, name := range names {
+		requireUsableFinalMask(t, proxies, name)
+	}
+}
+
+// requireUsableFinalMask: the proxy loaded with a working chain, so its dial
+// to the closed test port fails in the network, not with the error of an
+// unusable (Broken) finalmask, which always names finalmask.
+func requireUsableFinalMask(t *testing.T, proxies map[string]C.Proxy, name string) {
+	t.Helper()
+	proxy, ok := proxies[name]
+	require.True(t, ok, "proxy %s missing", name)
+	ctx, cancel := context.WithTimeout(context.Background(), 500*time.Millisecond)
+	defer cancel()
+	conn, err := proxy.DialContext(ctx, &C.Metadata{Host: "example.com", DstPort: 80})
+	if err == nil {
+		_ = conn.Close()
+		return
+	}
+	require.NotContains(t, err.Error(), "finalmask", "%s: a valid finalmask was treated as unusable", name)
+}
+
+func TestFinalMaskProfileUnusableKeepsLoading(t *testing.T) {
+	unusable := map[string]struct{ block, want string }{
+		"udp-on-tcp": {`    finalmask:
+      udp:
+        - type: noise
+          noise:
+            - rand: 8`, "finalmask.udp"},
+		"unknown-mask": {`    finalmask:
+      tcp:
+        - type: no-such-mask`, "no-such-mask"},
+		"xicmp": {`    finalmask:
+      udp:
+        - type: xicmp
+          ips: [127.0.0.1]`, "xicmp"},
+	}
+	nodes := []string{finalMaskTestNode("plain", "vless", "chrome", "")}
+	for name, c := range unusable {
+		nodes = append(nodes, finalMaskTestNode(name, "vless", "chrome", c.block))
+	}
+	proxies := parseFinalMaskProfile(t, nodes...)
+	require.Contains(t, proxies, "plain")
+	for name, c := range unusable {
+		proxy, ok := proxies[name]
+		require.True(t, ok, "unusable finalmask %q dropped the proxy", name)
+		ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+		conn, err := proxy.DialContext(ctx, &C.Metadata{Host: "example.com", DstPort: 80})
+		cancel()
+		if err == nil {
+			_ = conn.Close()
+			t.Fatalf("%s: a proxy with an unusable finalmask dialed", name)
+		}
+		require.Contains(t, err.Error(), c.want, name)
+	}
+}
