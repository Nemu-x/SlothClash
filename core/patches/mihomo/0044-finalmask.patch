index 0000000..fba027f
--- /dev/null
+++ b/transport/finalmask/sudoku/sudoku_test.go
@@ -0,0 +1,172 @@
+package sudoku
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func configs() []Config {
+	return []Config{
+		{Password: "sudoku-mask"},
+		{Password: "sudoku-mask", ASCII: "prefer_ascii", PaddingMin: 10, PaddingMax: 30},
+		{Password: "sudoku-mask", CustomTable: "xpxvvpvv"},
+		{Password: "sudoku-mask", CustomTables: []string{"xpxvvpvv", "vxpvxvvp"}, PaddingMin: 100, PaddingMax: 100},
+	}
+}
+
+func TestConfig(t *testing.T) {
+	for _, c := range configs() {
+		_, err := New(c)
+		require.NoError(t, err)
+	}
+	for _, bad := range []Config{
+		{ASCII: "nope"},
+		{CustomTable: "xxxxxxxx"},
+		{CustomTable: "xpv"},
+		{CustomTables: []string{"xpxvvpvv", "abcdefgh"}},
+	} {
+		_, err := New(bad)
+		require.Error(t, err, "%+v", bad)
+	}
+}
+
+func TestCodecRoundTrip(t *testing.T) {
+	for _, c := range configs() {
+		tables, err := getTables(&c)
+		require.NoError(t, err)
+		pMin, pMax := normalizedPadding(&c)
+		data := make([]byte, 3000)
+		_, _ = rand.Read(data)
+		encoded, err := newCodec(tables, pMin, pMax).encode(data)
+		require.NoError(t, err)
+		tableIndex := 0
+		hints, decoded, err := decodeBytes(tables, &tableIndex, encoded, nil, nil)
+		require.NoError(t, err)
+		require.Empty(t, hints)
+		require.Equal(t, data, decoded)
+
+		enc := newPackedEncoder(tables, pMin, pMax)
+		packed, err := enc.encode(data)
+		require.NoError(t, err)
+		_, _, _, out, err := decodePackedBytes(tablesToLayouts(tables), packed, 0, 0, 0, nil)
+		require.NoError(t, err)
+		require.Equal(t, data, out)
+		require.Less(t, len(packed), len(encoded))
+	}
+}
+
+func TestASCIIModeStaysPrintable(t *testing.T) {
+	c := Config{Password: "p", ASCII: "ascii", PaddingMin: 50, PaddingMax: 50}
+	tables, err := getTables(&c)
+	require.NoError(t, err)
+	data := make([]byte, 512)
+	_, _ = rand.Read(data)
+	encoded, err := newCodec(tables, 50, 50).encode(data)
+	require.NoError(t, err)
+	for _, b := range encoded {
+		require.True(t, b == '\n' || (b >= 0x20 && b < 0x7f), "byte %x", b)
+	}
+}
+
+func tcpPair(t *testing.T, c *Config) (net.Conn, net.Conn) {
+	t.Helper()
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	t.Cleanup(func() { ln.Close() })
+	accepted := make(chan net.Conn, 1)
+	go func() {
+		conn, err := ln.Accept()
+		if err != nil {
+			accepted <- nil
+			return
+		}
+		accepted <- conn
+	}()
+	clientRaw, err := net.Dial("tcp", ln.Addr().String())
+	require.NoError(t, err)
+	serverRaw := <-accepted
+	require.NotNil(t, serverRaw)
+	t.Cleanup(func() { clientRaw.Close(); serverRaw.Close() })
+	client, err := c.WrapConnClient(context.Background(), clientRaw, nil, nil)
+	require.NoError(t, err)
+	server, err := c.WrapConnServer(serverRaw)
+	require.NoError(t, err)
+	_ = client.SetDeadline(time.Now().Add(5 * time.Second))
+	_ = server.SetDeadline(time.Now().Add(5 * time.Second))
+	return client, server
+}
+
+func TestTCPRoundTrip(t *testing.T) {
+	for _, c := range configs() {
+		cfg, err := New(c)
+		require.NoError(t, err)
+		client, server := tcpPair(t, cfg)
+		for _, size := range []int{1, 17, 1500, 70000} {
+			up := make([]byte, size)
+			_, _ = rand.Read(up)
+			down := make([]byte, size)
+			_, _ = rand.Read(down)
+			go func() {
+				_, _ = client.Write(up)
+			}()
+			got := make([]byte, size)
+			_, err := io.ReadFull(server, got)
+			require.NoError(t, err)
+			require.True(t, bytes.Equal(up, got))
+			go func() {
+				_, _ = server.Write(down)
+			}()
+			_, err = io.ReadFull(client, got)
+			require.NoError(t, err)
+			require.True(t, bytes.Equal(down, got))
+		}
+		require.Error(t, func() error {
+			if cw, ok := client.(interface{ CloseWrite() error }); ok {
+				_ = cw.CloseWrite()
+				_, err := server.Read(make([]byte, 1))
+				return err
+			}
+			return nil
+		}())
+	}
+}
+
+func TestUDPRoundTrip(t *testing.T) {
+	for _, c := range configs() {
+		cfg, err := New(c)
+		require.NoError(t, err)
+		clientRaw, err := net.ListenPacket("udp", "127.0.0.1:0")
+		require.NoError(t, err)
+		serverRaw, err := net.ListenPacket("udp", "127.0.0.1:0")
+		require.NoError(t, err)
+		client, err := cfg.WrapPacketConnClient(context.Background(), clientRaw, nil, nil)
+		require.NoError(t, err)
+		server, err := cfg.WrapPacketConnServer(serverRaw)
+		require.NoError(t, err)
+		_ = client.SetDeadline(time.Now().Add(2 * time.Second))
+		_ = server.SetDeadline(time.Now().Add(2 * time.Second))
+		for _, msg := range [][]byte{[]byte("client -> server"), make([]byte, 700), {}} {
+			_, _ = rand.Read(msg)
+			_, err = client.WriteTo(msg, serverRaw.LocalAddr())
+			require.NoError(t, err)
+			buf := make([]byte, 4096)
+			n, from, err := server.ReadFrom(buf)
+			require.NoError(t, err)
+			require.Equal(t, msg, buf[:n])
+			_, err = server.WriteTo(msg, from)
+			require.NoError(t, err)
+			n, _, err = client.ReadFrom(buf)
+			require.NoError(t, err)
+			require.Equal(t, msg, buf[:n])
+		}
+		client.Close()
+		server.Close()
+	}
+}
diff --git a/transport/finalmask/sudoku/table.go b/transport/finalmask/sudoku/table.go
new file mode 100644
index 0000000..45ce526
--- /dev/null
+++ b/transport/finalmask/sudoku/table.go
@@ -0,0 +1,567 @@
+package sudoku
+
+import (
+	crypto_rand "crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"fmt"
+	rand_v2 "github.com/metacubex/randv2"
+	"math/bits"
+	"math/rand"
+	"sort"
+	"strings"
+	"sync"
+)
+
+type table struct {
+	encode [256][][4]byte
+	decode map[uint32]byte
+	layout *byteLayout
+}
+
+type tableCacheKey struct {
+	password    string
+	ascii       string
+	customTable string
+}
+
+var (
+	tableSetCache sync.Map
+
+	basePatternsOnce sync.Once
+	basePatterns     [][][4]byte
+	basePatternsErr  error
+)
+
+type byteLayout struct {
+	hintMask    byte
+	hintValue   byte
+	padMarker   byte
+	paddingPool []byte
+	encodeHint  func(group byte) byte
+	encodeGroup func(group byte) byte
+	decodeGroup func(b byte) (byte, bool)
+}
+
+func (l *byteLayout) isHint(b byte) bool {
+	if (b & l.hintMask) == l.hintValue {
+		return true
+	}
+	// ASCII layout maps 0x7f to '\n' to avoid DEL on the wire.
+	return l.hintMask == 0x40 && b == '\n'
+}
+
+func getTables(config *Config) ([]*table, error) {
+	if config == nil {
+		return nil, fmt.Errorf("nil sudoku config")
+	}
+
+	mode, err := normalizeASCII(config.ASCII)
+	if err != nil {
+		return nil, err
+	}
+
+	patterns, err := normalizedCustomPatterns(config, mode)
+	if err != nil {
+		return nil, err
+	}
+
+	cacheKey := tableCacheKey{
+		password:    config.Password,
+		ascii:       mode,
+		customTable: strings.Join(patterns, "\x00"),
+	}
+	if cached, ok := tableSetCache.Load(cacheKey); ok {
+		return cached.([]*table), nil
+	}
+
+	tables := make([]*table, 0, len(patterns))
+	for _, pattern := range patterns {
+		layout, err := resolveLayout(mode, pattern)
+		if err != nil {
+			return nil, err
+		}
+		t, err := buildTable(config.Password, layout)
+		if err != nil {
+			return nil, err
+		}
+		tables = append(tables, t)
+	}
+
+	actual, _ := tableSetCache.LoadOrStore(cacheKey, tables)
+	return actual.([]*table), nil
+}
+
+func normalizedCustomPatterns(config *Config, mode string) ([]string, error) {
+	if config == nil {
+		return []string{""}, nil
+	}
+	if mode == "prefer_ascii" {
+		return []string{""}, nil
+	}
+
+	rawPatterns := config.CustomTables
+	if len(rawPatterns) == 0 {
+		rawPatterns = []string{config.CustomTable}
+	}
+
+	patterns := make([]string, 0, len(rawPatterns))
+	seen := make(map[string]struct{}, len(rawPatterns))
+	for _, raw := range rawPatterns {
+		pattern := strings.TrimSpace(raw)
+		if pattern != "" {
+			var err error
+			pattern, err = normalizeCustomTable(pattern)
+			if err != nil {
+				return nil, err
+			}
+		}
+		if _, ok := seen[pattern]; ok {
+			continue
+		}
+		seen[pattern] = struct{}{}
+		patterns = append(patterns, pattern)
+	}
+
+	if len(patterns) == 0 {
+		return []string{""}, nil
+	}
+
+	return patterns, nil
+}
+
+func normalizedPadding(config *Config) (int, int) {
+	if config == nil {
+		return 0, 0
+	}
+
+	pMin := int(config.PaddingMin)
+	pMax := int(config.PaddingMax)
+
+	if pMin > 100 {
+		pMin = 100
+	}
+	if pMax > 100 {
+		pMax = 100
+	}
+	if pMax < pMin {
+		pMax = pMin
+	}
+	return pMin, pMax
+}
+
+func normalizeASCII(mode string) (string, error) {
+	switch strings.ToLower(strings.TrimSpace(mode)) {
+	case "", "entropy", "prefer_entropy":
+		return "prefer_entropy", nil
+	case "ascii", "prefer_ascii":
+		return "prefer_ascii", nil
+	default:
+		return "", fmt.Errorf("invalid sudoku ascii mode: %s", mode)
+	}
+}
+
+func normalizeCustomTable(pattern string) (string, error) {
+	cleaned := strings.ToLower(strings.TrimSpace(pattern))
+	cleaned = strings.ReplaceAll(cleaned, " ", "")
+	if len(cleaned) != 8 {
+		return "", fmt.Errorf("customTable must be 8 chars, got %d", len(cleaned))
+	}
+
+	var xCount, pCount, vCount int
+	for _, ch := range cleaned {
+		switch ch {
+		case 'x':
+			xCount++
+		case 'p':
+			pCount++
+		case 'v':
+			vCount++
+		default:
+			return "", fmt.Errorf("customTable has invalid char %q", ch)
+		}
+	}
+	if xCount != 2 || pCount != 2 || vCount != 4 {
+		return "", fmt.Errorf("customTable must contain exactly 2 x, 2 p and 4 v")
+	}
+	return cleaned, nil
+}
+
+func resolveLayout(mode, customTable string) (*byteLayout, error) {
+	if mode == "prefer_ascii" {
+		return asciiLayout(), nil
+	}
+
+	if customTable != "" {
+		return customLayout(customTable)
+	}
+	return entropyLayout(), nil
+}
+
+func asciiLayout() *byteLayout {
+	padding := make([]byte, 0, 32)
+	for i := 0; i < 32; i++ {
+		padding = append(padding, byte(0x20+i))
+	}
+
+	encodeGroup := func(group byte) byte {
+		b := byte(0x40 | (group & 0x3f))
+		if b == 0x7f {
+			return '\n'
+		}
+		return b
+	}
+
+	return &byteLayout{
+		hintMask:    0x40,
+		hintValue:   0x40,
+		padMarker:   0x3f,
+		paddingPool: padding,
+		encodeHint:  encodeGroup,
+		encodeGroup: encodeGroup,
+		decodeGroup: func(b byte) (byte, bool) {
+			if b == '\n' {
+				return 0x3f, true
+			}
+			if (b & 0x40) == 0 {
+				return 0, false
+			}
+			return b & 0x3f, true
+		},
+	}
+}
+
+func entropyLayout() *byteLayout {
+	padding := make([]byte, 0, 16)
+	for i := 0; i < 8; i++ {
+		padding = append(padding, byte(0x80+i), byte(0x10+i))
+	}
+
+	encodeGroup := func(group byte) byte {
+		v := group & 0x3f
+		return ((v & 0x30) << 1) | (v & 0x0f)
+	}
+
+	return &byteLayout{
+		hintMask:    0x90,
+		hintValue:   0x00,
+		padMarker:   0x80,
+		paddingPool: padding,
+		encodeHint:  encodeGroup,
+		encodeGroup: encodeGroup,
+		decodeGroup: func(b byte) (byte, bool) {
+			if (b & 0x90) != 0 {
+				return 0, false
+			}
+			return ((b >> 1) & 0x30) | (b & 0x0f), true
+		},
+	}
+}
+
+func customLayout(pattern string) (*byteLayout, error) {
+	pattern, err := normalizeCustomTable(pattern)
+	if err != nil {
+		return nil, err
+	}
+
+	var xBits, pBits, vBits []uint8
+	for i, c := range pattern {
+		bit := uint8(7 - i)
+		switch c {
+		case 'x':
+			xBits = append(xBits, bit)
+		case 'p':
+			pBits = append(pBits, bit)
+		case 'v':
+			vBits = append(vBits, bit)
+		}
+	}
+
+	xMask := byte(0)
+	for _, bit := range xBits {
+		xMask |= 1 << bit
+	}
+
+	encodeGroupWithDropX := func(group byte, dropX int) byte {
+		out := xMask
+		if dropX >= 0 {
+			out &^= 1 << xBits[dropX]
+		}
+
+		val := (group >> 4) & 0x03
+		pos := group & 0x0f
+
+		if (val & 0x02) != 0 {
+			out |= 1 << pBits[0]
+		}
+		if (val & 0x01) != 0 {
+			out |= 1 << pBits[1]
+		}
+		for i, bit := range vBits {
+			if (pos>>(3-uint8(i)))&0x01 == 1 {
+				out |= 1 << bit
+			}
+		}
+
+		return out
+	}
+
+	paddingSet := make(map[byte]struct{}, 64)
+	padding := make([]byte, 0, 64)
+	for drop := range xBits {
+		for val := byte(0); val < 4; val++ {
+			for pos := byte(0); pos < 16; pos++ {
+				group := (val << 4) | pos
+				b := encodeGroupWithDropX(group, drop)
+				if bits.OnesCount8(b) >= 5 {
+					if _, exists := paddingSet[b]; !exists {
+						paddingSet[b] = struct{}{}
+						padding = append(padding, b)
+					}
+				}
+			}
+		}
+	}
+	sort.Slice(padding, func(i, j int) bool { return padding[i] < padding[j] })
+	if len(padding) == 0 {
+		return nil, fmt.Errorf("customTable produced empty padding pool")
+	}
+
+	decodeGroup := func(b byte) (byte, bool) {
+		if (b & xMask) != xMask {
+			return 0, false
+		}
+
+		var val, pos byte
+		if b&(1<<pBits[0]) != 0 {
+			val |= 0x02
+		}
+		if b&(1<<pBits[1]) != 0 {
+			val |= 0x01
+		}
+		for i, bit := range vBits {
+			if b&(1<<bit) != 0 {
+				pos |= 1 << (3 - uint8(i))
+			}
+		}
+
+		return ((val & 0x03) << 4) | (pos & 0x0f), true
+	}
+	encodeGroup := func(group byte) byte {
+		return encodeGroupWithDropX(group, -1)
+	}
+
+	return &byteLayout{
+		hintMask:    xMask,
+		hintValue:   xMask,
+		padMarker:   padding[0],
+		paddingPool: padding,
+		encodeHint:  encodeGroup,
+		encodeGroup: encodeGroup,
+		decodeGroup: decodeGroup,
+	}, nil
+}
+
+func buildTable(password string, layout *byteLayout) (*table, error) {
+	patterns, err := getBasePatterns()
+	if err != nil {
+		return nil, err
+	}
+	if len(patterns) < 256 {
+		return nil, fmt.Errorf("not enough sudoku grids: %d", len(patterns))
+	}
+
+	order := make([]int, len(patterns))
+	for i := range order {
+		order[i] = i
+	}
+
+	hash := sha256.Sum256([]byte(password))
+	seed := int64(binary.BigEndian.Uint64(hash[:8]))
+	rng := rand.New(rand.NewSource(seed))
+	rng.Shuffle(len(order), func(i, j int) {
+		order[i], order[j] = order[j], order[i]
+	})
+
+	t := &table{
+		decode: make(map[uint32]byte, 1<<16),
+		layout: layout,
+	}
+	for b := 0; b < 256; b++ {
+		patList := patterns[order[b]]
+		if len(patList) == 0 {
+			return nil, fmt.Errorf("grid %d has no valid clue set", order[b])
+		}
+
+		enc := make([][4]byte, 0, len(patList))
+		for _, groups := range patList {
+			hints := [4]byte{
+				layout.encodeHint(groups[0]),
+				layout.encodeHint(groups[1]),
+				layout.encodeHint(groups[2]),
+				layout.encodeHint(groups[3]),
+			}
+			sortedHints := sort4(hints)
+			key := packKey(sortedHints)
+			if old, exists := t.decode[key]; exists && old != byte(b) {
+				return nil, fmt.Errorf("decode key collision for byte %d and %d", old, b)
+			}
+			t.decode[key] = byte(b)
+			enc = append(enc, hints)
+		}
+
+		t.encode[b] = enc
+	}
+
+	return t, nil
+}
+
+func getBasePatterns() ([][][4]byte, error) {
+	basePatternsOnce.Do(func() {
+		basePatterns, basePatternsErr = buildBasePatterns()
+	})
+	return basePatterns, basePatternsErr
+}
+
+type grid [16]byte
+
+func buildBasePatterns() ([][][4]byte, error) {
+	grids := generateAllGrids()
+	positions := hintPositions()
+
+	patterns := make([][][4]byte, len(grids))
+	for _, ps := range positions {
+		counts := make(map[uint32]uint16, len(grids))
+		keys := make([]uint32, len(grids))
+		groupsByGrid := make([][4]byte, len(grids))
+
+		for gi, g := range grids {
+			groups := [4]byte{
+				clueGroup(g, ps[0]),
+				clueGroup(g, ps[1]),
+				clueGroup(g, ps[2]),
+				clueGroup(g, ps[3]),
+			}
+			groups = sort4(groups)
+			key := packKey(groups)
+			keys[gi] = key
+			groupsByGrid[gi] = groups
+			counts[key]++
+		}
+
+		for gi, key := range keys {
+			if counts[key] == 1 {
+				patterns[gi] = append(patterns[gi], groupsByGrid[gi])
+			}
+		}
+	}
+
+	for gi, list := range patterns {
+		if len(list) == 0 {
+			return nil, fmt.Errorf("grid %d has no uniquely decodable clue set", gi)
+		}
+	}
+
+	return patterns, nil
+}
+
+func clueGroup(g grid, pos byte) byte {
+	// 2 bits of value + 4 bits of position.
+	return ((g[pos] - 1) << 4) | (pos & 0x0f)
+}
+
+func generateAllGrids() []grid {
+	grids := make([]grid, 0, 288)
+	var g grid
+
+	var dfs func(idx int)
+	dfs = func(idx int) {
+		if idx == 16 {
+			grids = append(grids, g)
+			return
+		}
+
+		row := idx / 4
+		col := idx % 4
+		boxRow := (row / 2) * 2
+		boxCol := (col / 2) * 2
+
+		for num := byte(1); num <= 4; num++ {
+			valid := true
+			for i := 0; i < 4; i++ {
+				if g[row*4+i] == num || g[i*4+col] == num {
+					valid = false
+					break
+				}
+			}
+			if !valid {
+				continue
+			}
+
+			for r := 0; r < 2 && valid; r++ {
+				for c := 0; c < 2; c++ {
+					if g[(boxRow+r)*4+(boxCol+c)] == num {
+						valid = false
+						break
+					}
+				}
+			}
+			if !valid {
+				continue
+			}
+
+			g[idx] = num
+			dfs(idx + 1)
+			g[idx] = 0
+		}
+	}
+
+	dfs(0)
+	return grids
+}
+
+func hintPositions() [][4]byte {
+	// C(16, 4) = 1820.
+	positions := make([][4]byte, 0, 1820)
+	for a := 0; a < 13; a++ {
+		for b := a + 1; b < 14; b++ {
+			for c := b + 1; c < 15; c++ {
+				for d := c + 1; d < 16; d++ {
+					positions = append(positions, [4]byte{byte(a), byte(b), byte(c), byte(d)})
+				}
+			}
+		}
+	}
+	return positions
+}
+
+func packKey(in [4]byte) uint32 {
+	return uint32(in[0])<<24 | uint32(in[1])<<16 | uint32(in[2])<<8 | uint32(in[3])
+}
+
+func sort4(in [4]byte) [4]byte {
+	if in[0] > in[1] {
+		in[0], in[1] = in[1], in[0]
+	}
+	if in[2] > in[3] {
+		in[2], in[3] = in[3], in[2]
+	}
+	if in[0] > in[2] {
+		in[0], in[2] = in[2], in[0]
+	}
+	if in[1] > in[3] {
+		in[1], in[3] = in[3], in[1]
+	}
+	if in[1] > in[2] {
+		in[1], in[2] = in[2], in[1]
+	}
+	return in
+}
+
+func newSeededRand() *rand_v2.Rand {
+	var seedBytes [32]byte
+	if _, err := crypto_rand.Read(seedBytes[:]); err != nil {
+		panic(err)
+	}
+	return rand_v2.New(rand_v2.NewChaCha8(seedBytes))
+}
diff --git a/transport/finalmask/udphop/udphop.go b/transport/finalmask/udphop/udphop.go
new file mode 100644
index 0000000..16f19f8
--- /dev/null
+++ b/transport/finalmask/udphop/udphop.go
@@ -0,0 +1,396 @@
+// Package udphop is the "udphop" finalmask of Xray-core: the client changes
+// its local UDP socket, the remote address or both at random intervals, so
+// one QUIC connection does not stay on one 5-tuple.
+package udphop
+
+import (
+	"context"
+	"crypto/rand"
+	goerrors "errors"
+	"fmt"
+	mrand "github.com/metacubex/randv2"
+	"io"
+	"net"
+	"net/netip"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/metacubex/mihomo/common/contextutils"
+	"github.com/metacubex/mihomo/log"
+	"github.com/metacubex/mihomo/transport/finalmask"
+)
+
+// Config is the built mask.
+type Config struct {
+	Local       bool // open a new local socket on every hop
+	Remote      bool // pick a new remote IP and port on every hop
+	RemoteOnce  bool // pick a remote IP and port once per connection
+	IntervalMin int64
+	IntervalMax int64 // seconds
+	RemoteIPs   []netip.Prefix
+	RemotePorts []uint16
+}
+
+// Option is the mask's settings as written in the config. Mode is a
+// comma-separated set of intervalLocal, intervalRemote and perConnRemote.
+type Option struct {
+	Mode        string          `proxy:"mode,omitempty"`
+	Interval    finalmask.Range `proxy:"interval,omitempty"` // seconds, 30 by default, at least 5
+	RemoteIPs   []string        `proxy:"remote-ips,omitempty"`
+	RemotePorts []string        `proxy:"remote-ports,omitempty"` // "443", "20000-30000"
+}
+
+func New(o Option) (*Config, error) {
+	c := &Config{}
+	for _, mode := range strings.Split(o.Mode, ",") {
+		switch strings.ToLower(strings.TrimSpace(mode)) {
+		case "":
+		case "intervallocal":
+			c.Local = true
+		case "intervalremote":
+			c.Remote = true
+		case "perconnremote":
+			c.RemoteOnce = true
+		default:
+			return nil, fmt.Errorf("udphop: invalid mode %q, want intervalLocal, intervalRemote or perConnRemote", mode)
+		}
+	}
+	if !c.Local && !c.Remote && !c.RemoteOnce {
+		return nil, goerrors.New("udphop: mode is required")
+	}
+	for _, ip := range o.RemoteIPs {
+		if prefix, err := netip.ParsePrefix(ip); err == nil {
+			c.RemoteIPs = append(c.RemoteIPs, prefix.Masked())
+			continue
+		}
+		if addr, err := netip.ParseAddr(ip); err == nil {
+			c.RemoteIPs = append(c.RemoteIPs, netip.PrefixFrom(addr, addr.BitLen()))
+			continue
+		}
+		return nil, fmt.Errorf("udphop: invalid ip %q", ip)
+	}
+	for _, ports := range o.RemotePorts {
+		from, to, err := finalmask.ParseRange(ports)
+		if err != nil || from < 1 || to > 65535 {
+			return nil, fmt.Errorf("udphop: invalid port range %q", ports)
+		}
+		if from > to {
+			from, to = to, from
+		}
+		if to-from > 65535 {
+			return nil, fmt.Errorf("udphop: invalid port range %q", ports)
+		}
+		for p := from; p <= to; p++ {
+			c.RemotePorts = append(c.RemotePorts, uint16(p))
+		}
+	}
+	if (c.Remote || c.RemoteOnce) && len(c.RemoteIPs) == 0 && len(c.RemotePorts) == 0 {
+		return nil, goerrors.New("udphop: a remote mode needs remote-ips or remote-ports")
+	}
+	from, to := o.Interval.From, o.Interval.To
+	if from == 0 && to == 0 {
+		from, to = 30, 30
+	}
+	if from > to {
+		from, to = to, from
+	}
+	if from < 5 {
+		return nil, goerrors.New("udphop: interval must be at least 5 seconds")
+	}
+	c.IntervalMin, c.IntervalMax = int64(from), int64(to)
+	return c, nil
+}
+
+func (c *Config) HandleDial() {}
+
+func (c *Config) WrapPacketConnClient(ctx context.Context, _ net.PacketConn, dest *finalmask.Destination, dialer *finalmask.Dialer) (net.PacketConn, error) {
+	return NewConn(ctx, c, dest, dialer)
+}
+
+func (c *Config) WrapPacketConnServer(net.PacketConn) (net.PacketConn, error) {
+	return nil, goerrors.New("udphop: client only")
+}
+
+var pool = sync.Pool{
+	New: func() any {
+		return make([]byte, finalmask.UDPSize)
+	},
+}
+
+type packet struct {
+	p    []byte
+	addr net.Addr
+	err  error
+}
+
+type hopConn struct {
+	ctx    context.Context
+	dialer *finalmask.Dialer
+	config *Config
+
+	deadline      time.Time
+	readDeadline  time.Time
+	writeDeadline time.Time
+
+	pre     net.PacketConn
+	cur     net.PacketConn
+	addr    *net.UDPAddr
+	readCh  chan packet
+	closeCh chan struct{}
+	wg      sync.WaitGroup
+	mu      sync.RWMutex
+}
+
+// NewConn opens the first socket to dest, which it changes to a random
+// remote when the config asks for one, and starts hopping.
+func NewConn(ctx context.Context, c *Config, dest *finalmask.Destination, dialer *finalmask.Dialer) (net.PacketConn, error) {
+	if c.IntervalMin < 5 || c.IntervalMax < 5 {
+		return nil, goerrors.New("udphop: invalid interval")
+	}
+	if c.Remote || c.RemoteOnce {
+		if len(c.RemoteIPs) > 0 {
+			dest.Host = randPrefix(c.RemoteIPs[mrand.IntN(len(c.RemoteIPs))]).String()
+		}
+		if len(c.RemotePorts) > 0 {
+			dest.Port = c.RemotePorts[mrand.IntN(len(c.RemotePorts))]
+		}
+	}
+	conn, raddr, err := dialer.DialUDP(ctx, dest.Addr())
+	if err != nil {
+		return nil, err
+	}
+	addr, ok := raddr.(*net.UDPAddr)
+	if !ok {
+		_ = conn.Close()
+		return nil, fmt.Errorf("udphop: remote address is %T, not UDP", raddr)
+	}
+	hop := &hopConn{
+		ctx:     contextutils.WithoutCancel(ctx),
+		dialer:  dialer,
+		config:  c,
+		cur:     conn,
+		addr:    addr,
+		readCh:  make(chan packet),
+		closeCh: make(chan struct{}),
+	}
+	go hop.run()
+	hop.wg.Add(1)
+	go hop.recv(hop.cur)
+	return hop, nil
+}
+
+func (c *hopConn) closed() bool {
+	select {
+	case <-c.closeCh:
+		return true
+	default:
+		return false
+	}
+}
+
+func (c *hopConn) interval() time.Duration {
+	return time.Second * time.Duration(finalmask.RandBetween(c.config.IntervalMin, c.config.IntervalMax+1))
+}
+
+func (c *hopConn) run() {
+	ticker := time.NewTicker(c.interval())
+	defer ticker.Stop()
+	for {
+		select {
+		case <-c.closeCh:
+			return
+		case <-ticker.C:
+			ticker.Reset(c.interval())
+			c.hop()
+		}
+	}
+}
+
+func (c *hopConn) hop() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed() {
+		return
+	}
+	oldIP := c.addr.IP
+	oldPort := c.addr.Port
+	if c.config.Remote {
+		if len(c.config.RemoteIPs) > 0 {
+			c.addr.IP = randPrefix(c.config.RemoteIPs[mrand.IntN(len(c.config.RemoteIPs))]).AsSlice()
+		}
+		if len(c.config.RemotePorts) > 0 {
+			c.addr.Port = int(c.config.RemotePorts[mrand.IntN(len(c.config.RemotePorts))])
+		}
+	}
+	if c.config.Local {
+		conn, _, err := c.dialer.DialUDP(c.ctx, net.JoinHostPort(c.addr.IP.String(), strconv.Itoa(c.addr.Port)))
+		if err != nil {
+			c.addr.IP = oldIP
+			c.addr.Port = oldPort
+			log.Warnln("[finalmask] udphop: hop failed: %v", err)
+			return
+		}
+		_ = conn.SetDeadline(c.deadline)
+		_ = conn.SetReadDeadline(c.readDeadline)
+		_ = conn.SetWriteDeadline(c.writeDeadline)
+		if c.pre != nil {
+			_ = c.pre.Close()
+		}
+		c.pre = c.cur
+		c.cur = conn
+		c.wg.Add(1)
+		go c.recv(c.cur)
+	}
+}
+
+func (c *hopConn) recv(conn net.PacketConn) {
+	defer c.wg.Done()
+
+	for {
+		p := pool.Get().([]byte)
+		n, addr, err := conn.ReadFrom(p)
+		if err != nil {
+			pool.Put(p[:cap(p)])
+			if c.closed() {
+				return
+			}
+			var netErr net.Error
+			if goerrors.As(err, &netErr) && netErr.Timeout() {
+				select {
+				case c.readCh <- packet{err: err}:
+				case <-c.closeCh:
+					return
+				}
+				continue
+			}
+			// The previous socket of a hop is closed by hop(); any other
+			// error ends this socket's reads.
+			c.mu.RLock()
+			current := conn == c.cur
+			c.mu.RUnlock()
+			if current {
+				log.Warnln("[finalmask] udphop: recv failed: %v", err)
+			}
+			return
+		}
+		select {
+		case c.readCh <- packet{p: p[:n], addr: addr}:
+		case <-c.closeCh:
+			pool.Put(p[:cap(p)])
+			return
+		}
+	}
+}
+
+func (c *hopConn) ReadFrom(p []byte) (n int, addr net.Addr, err error) {
+	packet, ok := <-c.readCh
+	if ok {
+		if packet.p != nil {
+			n = copy(p, packet.p)
+			pool.Put(packet.p[:cap(packet.p)])
+		}
+		return n, packet.addr, packet.err
+	}
+	return 0, nil, io.ErrClosedPipe
+}
+
+// WriteTo sends to the current remote whatever addr says: the hop decides
+// where the peer is.
+func (c *hopConn) WriteTo(p []byte, _ net.Addr) (n int, err error) {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	if c.closed() {
+		return 0, io.ErrClosedPipe
+	}
+	_, err = c.cur.WriteTo(p, c.addr)
+	if err != nil {
+		return 0, err
+	}
+	return len(p), nil
+}
+
+func (c *hopConn) Close() error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed() {
+		return nil
+	}
+	close(c.closeCh)
+	if c.pre != nil {
+		_ = c.pre.Close()
+	}
+	_ = c.cur.Close()
+	c.wg.Wait()
+	close(c.readCh)
+	return nil
+}
+
+func (c *hopConn) LocalAddr() net.Addr {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	return c.cur.LocalAddr()
+}
+
+// RemoteAddr is the current remote, for the layers that want to know it.
+func (c *hopConn) RemoteAddr() net.Addr {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	addr := *c.addr
+	return &addr
+}
+
+func (c *hopConn) SetDeadline(t time.Time) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.deadline = t
+	if c.pre != nil {
+		_ = c.pre.SetDeadline(t)
+	}
+	return c.cur.SetDeadline(t)
+}
+
+func (c *hopConn) SetReadDeadline(t time.Time) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.readDeadline = t
+	if c.pre != nil {
+		_ = c.pre.SetReadDeadline(t)
+	}
+	return c.cur.SetReadDeadline(t)
+}
+
+func (c *hopConn) SetWriteDeadline(t time.Time) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.writeDeadline = t
+	if c.pre != nil {
+		_ = c.pre.SetWriteDeadline(t)
+	}
+	return c.cur.SetWriteDeadline(t)
+}
+
+// randPrefix draws a random address inside p.
+func randPrefix(p netip.Prefix) netip.Addr {
+	if p.IsSingleIP() {
+		return p.Addr()
+	}
+	b := p.Addr().AsSlice()
+	bits := p.Bits()
+	var random [16]byte
+	if _, err := rand.Read(random[:len(b)]); err != nil {
+		panic(err)
+	}
+	i := bits / 8
+	j := bits % 8
+	if i+1 < len(b) {
+		copy(b[i+1:], random[i+1:len(b)])
+	}
+	if i < len(b) {
+		mask := byte(0xff << (8 - j))
+		b[i] = (b[i] & mask) | (random[i] &^ mask)
+	}
+	addr, _ := netip.AddrFromSlice(b)
+	return addr
+}
diff --git a/transport/finalmask/udphop/udphop_test.go b/transport/finalmask/udphop/udphop_test.go
new file mode 100644
index 0000000..e8710c0
--- /dev/null
+++ b/transport/finalmask/udphop/udphop_test.go
@@ -0,0 +1,126 @@
+package udphop
+
+import (
+	"context"
+	"net"
+	"net/netip"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/transport/finalmask"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestOption(t *testing.T) {
+	c, err := New(Option{Mode: "intervalLocal,intervalRemote", Interval: finalmask.Range{From: 10, To: 20}, RemoteIPs: []string{"10.0.0.0/30", "192.168.1.1"}, RemotePorts: []string{"443", "20000-20003"}})
+	require.NoError(t, err)
+	require.True(t, c.Local)
+	require.True(t, c.Remote)
+	require.False(t, c.RemoteOnce)
+	require.Equal(t, int64(10), c.IntervalMin)
+	require.Equal(t, int64(20), c.IntervalMax)
+	require.Len(t, c.RemoteIPs, 2)
+	require.Equal(t, []uint16{443, 20000, 20001, 20002, 20003}, c.RemotePorts)
+
+	c, err = New(Option{Mode: "perConnRemote", RemotePorts: []string{"1000"}})
+	require.NoError(t, err)
+	require.Equal(t, int64(30), c.IntervalMin)
+
+	for _, bad := range []Option{
+		{},
+		{Mode: "nope"},
+		{Mode: "intervalLocal", Interval: finalmask.Range{From: 1, To: 1}},
+		{Mode: "intervalRemote"},
+		{Mode: "intervalRemote", RemoteIPs: []string{"x"}},
+		{Mode: "intervalRemote", RemotePorts: []string{"70000"}},
+	} {
+		_, err := New(bad)
+		require.Error(t, err, "%+v", bad)
+	}
+}
+
+func TestRandPrefix(t *testing.T) {
+	p := netip.MustParsePrefix("10.1.2.0/24")
+	for i := 0; i < 50; i++ {
+		require.True(t, p.Contains(randPrefix(p)))
+	}
+	p = netip.MustParsePrefix("2001:db8::/32")
+	for i := 0; i < 50; i++ {
+		require.True(t, p.Contains(randPrefix(p)))
+	}
+	require.Equal(t, netip.MustParseAddr("1.2.3.4"), randPrefix(netip.MustParsePrefix("1.2.3.4/32")))
+}
+
+func TestHopKeepsExchangingPackets(t *testing.T) {
+	server, err := net.ListenPacket("udp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer server.Close()
+
+	var dials atomic.Int32
+	dialer := &finalmask.Dialer{
+		DialUDP: func(ctx context.Context, addr string) (net.PacketConn, net.Addr, error) {
+			dials.Add(1)
+			udpAddr, err := net.ResolveUDPAddr("udp", addr)
+			if err != nil {
+				return nil, nil, err
+			}
+			conn, err := net.ListenPacket("udp", "127.0.0.1:0")
+			return conn, udpAddr, err
+		},
+	}
+	cfg := &Config{Local: true, IntervalMin: 5, IntervalMax: 5}
+	dest, _ := finalmask.ParseDestination(server.LocalAddr().String())
+	conn, err := NewConn(context.Background(), cfg, &dest, dialer)
+	require.NoError(t, err)
+	defer conn.Close()
+	hop := conn.(*hopConn)
+
+	echo := func() {
+		_, err := conn.WriteTo([]byte("ping"), nil)
+		require.NoError(t, err)
+		buf := make([]byte, 64)
+		_ = server.SetReadDeadline(time.Now().Add(2 * time.Second))
+		n, from, err := server.ReadFrom(buf)
+		require.NoError(t, err)
+		require.Equal(t, "ping", string(buf[:n]))
+		_, err = server.WriteTo([]byte("pong"), from)
+		require.NoError(t, err)
+		n, _, err = conn.ReadFrom(buf)
+		require.NoError(t, err)
+		require.Equal(t, "pong", string(buf[:n]))
+	}
+	echo()
+	first := conn.LocalAddr().String()
+	hop.hop()
+	require.Equal(t, int32(2), dials.Load())
+	require.NotEqual(t, first, conn.LocalAddr().String())
+	echo()
+	hop.hop()
+	echo()
+}
+
+func TestRemoteOncePicksAddress(t *testing.T) {
+	var dialed string
+	dialer := &finalmask.Dialer{
+		DialUDP: func(ctx context.Context, addr string) (net.PacketConn, net.Addr, error) {
+			dialed = addr
+			udpAddr, _ := net.ResolveUDPAddr("udp", addr)
+			conn, err := net.ListenPacket("udp", "127.0.0.1:0")
+			return conn, udpAddr, err
+		},
+	}
+	cfg, err := New(Option{Mode: "perConnRemote", RemoteIPs: []string{"127.0.0.0/8"}, RemotePorts: []string{"40000-40010"}})
+	require.NoError(t, err)
+	dest := finalmask.Destination{Host: "example.com", Port: 443}
+	conn, err := cfg.WrapPacketConnClient(context.Background(), nil, &dest, dialer)
+	require.NoError(t, err)
+	defer conn.Close()
+	host, port, err := net.SplitHostPort(dialed)
+	require.NoError(t, err)
+	require.True(t, netip.MustParsePrefix("127.0.0.0/8").Contains(netip.MustParseAddr(host)))
+	require.GreaterOrEqual(t, port, "40000")
+	require.LessOrEqual(t, port, "40010")
+	require.Equal(t, dest.Addr(), dialed)
+}
diff --git a/transport/finalmask/util.go b/transport/finalmask/util.go
new file mode 100644
index 0000000..f9328e5
--- /dev/null
+++ b/transport/finalmask/util.go
@@ -0,0 +1,86 @@
+package finalmask
+
+import (
+	"crypto/rand"
+	"fmt"
+	"math/big"
+	"strconv"
+	"strings"
+)
+
+// RandBetween returns a value in [from, to), or from when the range holds at
+// most one value, as Xray's crypto.RandBetween.
+func RandBetween(from, to int64) int64 {
+	if from > to {
+		from, to = to, from
+	}
+	if d := to - from; d == 0 || d == 1 {
+		return from
+	}
+	n, _ := rand.Int(rand.Reader, big.NewInt(to-from))
+	return from + n.Int64()
+}
+
+// RandBytesBetween fills b with random bytes in [from, to].
+func RandBytesBetween(b []byte, from, to byte) {
+	if _, err := rand.Read(b); err != nil {
+		panic(err)
+	}
+	if from > to {
+		from, to = to, from
+	}
+	if to-from == 255 {
+		return
+	}
+	for i := range b {
+		b[i] = from + b[i]%(to-from+1)
+	}
+}
+
+// Range is a value or an "a-b" range as Xray writes them in its JSON config:
+// "10" and 10 are [10, 10], "10-20" is [10, 20]. The bounds are kept in the
+// order given; a mask that draws from the range swaps them if needed.
+type Range struct {
+	From, To int
+}
+
+func (r Range) String() string {
+	if r.From == r.To {
+		return strconv.Itoa(r.From)
+	}
+	return fmt.Sprintf("%d-%d", r.From, r.To)
+}
+
+// IsZero reports whether the range was left out of the config.
+func (r Range) IsZero() bool { return r.From == 0 && r.To == 0 }
+
+func (r *Range) UnmarshalText(text []byte) error {
+	from, to, err := ParseRange(string(text))
+	if err != nil {
+		return err
+	}
+	r.From, r.To = from, to
+	return nil
+}
+
+// ParseRange reads "N" or "N-M" (negative numbers included, as "-1" or
+// "-5--1"); "" is 0.
+func ParseRange(s string) (int, int, error) {
+	s = strings.TrimSpace(s)
+	if s == "" {
+		return 0, 0, nil
+	}
+	if v, err := strconv.Atoi(s); err == nil {
+		return v, v, nil
+	}
+	// A leading minus belongs to the first number: "-5--1".
+	cut := strings.Index(s[1:], "-")
+	if cut >= 0 {
+		left, err1 := strconv.Atoi(s[:cut+1])
+		right, err2 := strconv.Atoi(s[cut+2:])
+		if err1 == nil && err2 == nil {
+			return left, right, nil
+		}
+	}
+	return 0, 0, fmt.Errorf("invalid range %q", s)
+}
diff --git a/transport/finalmask/xdns/client.go b/transport/finalmask/xdns/client.go
new file mode 100644
index 0000000..615aae9
--- /dev/null
+++ b/transport/finalmask/xdns/client.go
@@ -0,0 +1,443 @@
+// Package xdns is the "xdns" finalmask of Xray-core: datagrams travel as DNS
+// queries and answers for a zone the server is authoritative for, through
+// the resolvers the client is given. It reads and writes plain DNS on the
+// wire, so it is the innermost UDP mask.
+package xdns
+
+import (
+	"context"
+	"crypto/rand"
+	"errors"
+	"io"
+	"net"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/metacubex/mihomo/log"
+	"github.com/metacubex/mihomo/transport/finalmask"
+	"github.com/metacubex/randv2"
+
+	"golang.org/x/net/dns/dnsmessage"
+)
+
+const (
+	initPollDelay       = 500 * time.Millisecond
+	maxPollDelay        = 10 * time.Second
+	pollDelayMultiplier = 2.0
+	pollLimit           = 16
+)
+
+var pool4K = sync.Pool{
+	New: func() any {
+		return make([]byte, 4096)
+	},
+}
+
+type packet struct {
+	p    []byte
+	addr net.Addr
+}
+
+type xdnsClient struct {
+	dialer *finalmask.Dialer
+
+	clientID  ClientID
+	fragID    atomic.Uint32
+	domains   []*Domain
+	extraPoll int32
+
+	resolvers     []Resolver
+	resolverSends []atomic.Uint32
+	resolverIndex atomic.Uint32
+
+	readCh  chan packet
+	poolCh  chan struct{}
+	closeCh chan struct{}
+	wg      sync.WaitGroup
+	mu      sync.Mutex
+}
+
+// NewClient opens the resolvers and starts polling the server for downlink
+// data.
+func NewClient(ctx context.Context, c *Config, dialer *finalmask.Dialer) (net.PacketConn, error) {
+	if len(c.Domains) == 0 {
+		return nil, errors.New("xdns: empty domains")
+	}
+	if len(c.Resolvers) == 0 {
+		return nil, errors.New("xdns: empty resolvers")
+	}
+	if c.ExtraPoll < 0 || c.ExtraPoll > 3 {
+		return nil, errors.New("xdns: extra-poll must be between 0 and 3")
+	}
+	domains := make([]*Domain, 0, len(c.Domains))
+	for i := range c.Domains {
+		types := c.Domains[i].Types
+		if len(types) == 0 {
+			types = []uint16{TypeTXT}
+		}
+		domain, err := NewDomain(c.Domains[i].Name, c.Domains[i].LenLimit, c.Domains[i].LabelLimit, types, c.Domains[i].EDNS0)
+		if err != nil {
+			return nil, err
+		}
+		domains = append(domains, domain)
+	}
+	resolvers := make([]Resolver, 0, len(c.Resolvers))
+	for i := range c.Resolvers {
+		resolver, err := NewResolver(ctx, c.Resolvers[i], dialer)
+		if err != nil {
+			for _, resolver := range resolvers {
+				resolver.Close()
+			}
+			return nil, err
+		}
+		resolvers = append(resolvers, resolver)
+	}
+	client := &xdnsClient{
+		dialer: dialer,
+
+		clientID:  NewClientID(),
+		domains:   domains,
+		extraPoll: c.ExtraPoll,
+
+		resolvers:     resolvers,
+		resolverSends: make([]atomic.Uint32, len(c.Resolvers)),
+
+		readCh:  make(chan packet),
+		poolCh:  make(chan struct{}, pollLimit),
+		closeCh: make(chan struct{}),
+	}
+	go client.run()
+	return client, nil
+}
+
+func (c *xdnsClient) closed() bool {
+	select {
+	case <-c.closeCh:
+		return true
+	default:
+		return false
+	}
+}
+
+// send packs p into one or more queries; an empty p is a poll.
+func (c *xdnsClient) send(p []byte) {
+	domain := c.domains[randv2.IntN(len(c.domains))]
+	qtype := domain.types[randv2.IntN(len(domain.types))]
+
+	var buf [512]byte
+	var data [255]byte
+
+	send := func(p []byte) {
+		msg := dnsmessage.Message{
+			Header: dnsmessage.Header{
+				RecursionDesired: true,
+			},
+			Questions: []dnsmessage.Question{
+				{
+					Name:  domain.Encode(p),
+					Type:  dnsmessage.Type(qtype),
+					Class: dnsmessage.ClassINET,
+				},
+			},
+		}
+		if domain.edns0 > 0 {
+			msg.Additionals = []dnsmessage.Resource{
+				{
+					Header: dnsmessage.ResourceHeader{
+						Name:  dnsmessage.MustNewName("."),
+						Type:  dnsmessage.TypeOPT,
+						Class: dnsmessage.Class(domain.edns0),
+						TTL:   0,
+					},
+					Body: &dnsmessage.OPTResource{},
+				},
+			}
+		}
+		pack, err := msg.AppendPack(buf[:0])
+		if err != nil {
+			panic(err)
+		}
+		mustRead(pack[:2])
+
+		// Spread the queries over the resolvers, favouring those that
+		// answered recently.
+		index := c.resolverIndex.Load()
+		cur := c.resolverSends[index].Add(1)
+		i := index
+		for {
+			i++
+			if i == uint32(len(c.resolvers)) {
+				i = 0
+			}
+			if i == index {
+				break
+			}
+			if cur > c.resolverSends[i].Load() {
+				break
+			}
+		}
+		c.resolverIndex.Store(i)
+		c.resolvers[index].Send(pack)
+	}
+
+	if len(p) == 0 {
+		copy(data[:], c.clientID[:])
+		data[0] |= typeMap[qtype]
+		data[8] = 8
+		mustRead(data[9:17])
+		send(data[:17])
+		return
+	}
+
+	if len(p) <= domain.cap-12 {
+		copy(data[:], c.clientID[:])
+		data[0] |= typeMap[qtype]
+		data[8] = 3
+		mustRead(data[9:12])
+		copy(data[12:], p)
+		send(data[:12+len(p)])
+		return
+	}
+
+	if len(p) <= 255*(domain.cap-15) {
+		copy(data[:], c.clientID[:])
+		data[0] |= typeMap[qtype]
+		data[8] = 3 | 0xC0
+		mustRead(data[9:12])
+
+		fragID := byte(c.fragID.Add(1))
+		fragN := len(p) / (domain.cap - 15)
+		if len(p)%(domain.cap-15) > 0 {
+			fragN++
+		}
+
+		for i := 0; i < fragN; i++ {
+			data[12] = fragID
+			data[13] = byte(i)
+			data[14] = byte(fragN)
+			size := len(p)
+			if size > domain.cap-15 {
+				size = domain.cap - 15
+			}
+			copy(data[15:], p[:size])
+			send(data[:15+size])
+			p = p[size:]
+		}
+		return
+	}
+
+	log.Warnln("[finalmask] xdns: dropping a %d-byte packet, too large for the domain", len(p))
+}
+
+func mustRead(b []byte) {
+	if _, err := rand.Read(b); err != nil {
+		panic(err)
+	}
+}
+
+// read unpacks an answer; true when it carried data.
+func (c *xdnsClient) read(buf []byte, addr net.Addr) bool {
+	msg := dnsmessage.Message{}
+	if err := msg.Unpack(buf); err != nil {
+		return false
+	}
+	if !msg.Header.Response || msg.Header.Truncated || msg.Header.RCode != dnsmessage.RCodeSuccess || len(msg.Questions) != 1 {
+		return false
+	}
+
+	var domain *Domain
+	for i := range c.domains {
+		if c.domains[i].IsDomain(msg.Questions[0].Name) {
+			domain = c.domains[i]
+			break
+		}
+	}
+	if domain == nil || !domain.HasType(uint16(msg.Questions[0].Type)) {
+		return false
+	}
+
+	resp := NewResp(msg, domain, 0)
+
+	p := pool4K.Get().([]byte)
+	n := resp.Decode(p)
+	p = p[:n]
+
+	b := p
+	var bs [][]byte
+	for len(b) > 1 {
+		last := b[0]&0xC0 == 0xC0
+		length := int(b[0]&0x3F)<<8 | int(b[1])
+		b = b[2:]
+		if length > len(b) {
+			bs = nil
+			break
+		}
+		packet := make([]byte, length)
+		copy(packet, b)
+		bs = append(bs, packet)
+		if last {
+			break
+		}
+		b = b[length:]
+		if len(b) < 2 {
+			bs = nil
+		}
+	}
+	pool4K.Put(p[:cap(p)])
+
+	for i := range bs {
+		select {
+		case <-c.closeCh:
+			return true
+		case c.readCh <- packet{p: bs[i], addr: addr}:
+		}
+	}
+	return len(bs) > 0
+}
+
+func (c *xdnsClient) run() {
+	for i := range c.resolvers {
+		c.wg.Add(1)
+		go c.recv(i)
+	}
+
+	c.wg.Add(1)
+	go c.poll()
+
+	c.wg.Wait()
+	close(c.readCh)
+	close(c.poolCh)
+}
+
+func (c *xdnsClient) recv(i int) {
+	defer c.wg.Done()
+
+	var buf [4096]byte
+	for {
+		n, err := c.resolvers[i].Read(buf[:])
+		if err != nil {
+			if c.closed() {
+				return
+			}
+			log.Warnln("[finalmask] xdns: resolver %d stopped: %v", i, err)
+			return
+		}
+		if c.read(buf[:n], c.resolvers[i].Addr()) {
+			c.resolverSends[i].Store(0)
+			select {
+			case c.poolCh <- struct{}{}:
+			default:
+			}
+		}
+	}
+}
+
+// poll asks the server for downlink data, quickly after data came and more
+// slowly while nothing does.
+func (c *xdnsClient) poll() {
+	defer c.wg.Done()
+
+	select {
+	case <-c.closeCh:
+	case <-c.poolCh:
+	}
+	delay := initPollDelay
+	ticker := time.NewTicker(delay)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-c.closeCh:
+			return
+		case <-c.poolCh:
+			delay = initPollDelay
+		case <-ticker.C:
+			delay *= pollDelayMultiplier
+			if delay > maxPollDelay {
+				delay = maxPollDelay
+			}
+		}
+		if c.closed() {
+			return
+		}
+		ticker.Reset(delay)
+		c.send(nil)
+		for i := int32(0); i < c.extraPoll; i++ {
+			c.send(nil)
+		}
+	}
+}
+
+func (c *xdnsClient) ReadFrom(p []byte) (n int, addr net.Addr, err error) {
+	packet, ok := <-c.readCh
+	if ok {
+		return copy(p, packet.p), packet.addr, nil
+	}
+	return 0, nil, io.ErrClosedPipe
+}
+
+func (c *xdnsClient) WriteTo(p []byte, addr net.Addr) (n int, err error) {
+	// Send without c.mu: a resolver write can block until Close closes the
+	// resolver, and Close needs c.mu to reach it. A write that races Close
+	// reaches a closed resolver, which drops it.
+	if c.closed() {
+		return 0, io.ErrClosedPipe
+	}
+	if len(p) == 0 || len(p) > 4096 {
+		return 0, errors.New("xdns: invalid packet size")
+	}
+	c.send(p)
+	for i := int32(0); i < c.extraPoll; i++ {
+		c.send(nil)
+	}
+	return len(p), nil
+}
+
+func (c *xdnsClient) Close() error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed() {
+		return nil
+	}
+	close(c.closeCh)
+	for i := range c.resolvers {
+		c.resolvers[i].Close()
+	}
+	return nil
+}
+
+func (c *xdnsClient) LocalAddr() net.Addr { return &net.UDPAddr{IP: net.IPv4zero} }
+
+func (c *xdnsClient) SetDeadline(t time.Time) error { return nil }
+
+func (c *xdnsClient) SetReadDeadline(t time.Time) error { return nil }
+
+func (c *xdnsClient) SetWriteDeadline(t time.Time) error { return nil }
+
+// ClientID identifies a client to the server; it travels in every query.
+type ClientID [8]byte
+
+func NewClientID() ClientID {
+	var id ClientID
+	mustRead(id[:])
+	id[0] &= 0xFC
+	return id
+}
+
+func ClientIDFromRaw(id [8]byte) ClientID {
+	id[0] &= 0xFC
+	return id
+}
+
+func ClientIDFromAddr(addr *net.UDPAddr) ClientID {
+	return ClientID(addr.IP[8:])
+}
+
+// Addr is the fake address the server's packet connection reports for the
+// client: fd00::/64 with the ID in the host part.
+func (id ClientID) Addr() *net.UDPAddr {
+	var ip [16]byte
+	ip[0] = 0xFD
+	copy(ip[8:], id[:])
+	return &net.UDPAddr{IP: ip[:]}
+}
diff --git a/transport/finalmask/xdns/config.go b/transport/finalmask/xdns/config.go
new file mode 100644
index 0000000..4cd7c13
--- /dev/null
+++ b/transport/finalmask/xdns/config.go
@@ -0,0 +1,156 @@
+package xdns
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"net/url"
+	"strconv"
+	"strings"
+
+	"github.com/metacubex/mihomo/transport/finalmask"
+)
+
+// DomainConfig is one zone of the tunnel.
+type DomainConfig struct {
+	Name       string
+	LenLimit   int      // longest query name, 255 by default
+	LabelLimit int      // longest label, 63 by default
+	Types      []uint16 // query types, TXT by default on the client
+	EDNS0      uint16   // EDNS0 payload size to advertise, 0 for none
+}
+
+// Config is the built mask.
+type Config struct {
+	Domains   []DomainConfig
+	Resolvers []ResolverConfig
+	ExtraPoll int32 // extra polls after every write, 0 to 3
+}
+
+// Option is the mask's settings as written in the config.
+type Option struct {
+	Domains   []DomainOption   `proxy:"domains"`
+	Resolvers []ResolverOption `proxy:"resolvers"`
+	ExtraPoll int              `proxy:"extra-poll,omitempty"`
+}
+
+type DomainOption struct {
+	Names      []string `proxy:"names"`
+	LenLimit   int      `proxy:"len-limit,omitempty"`
+	LabelLimit int      `proxy:"label-limit,omitempty"`
+	// Types are DNS record types by number: 1 (A), 5 (CNAME), 16 (TXT), 28
+	// (AAAA); TXT by default.
+	Types []int `proxy:"types,omitempty"`
+	EDNS0 int   `proxy:"edns0,omitempty"`
+}
+
+// ResolverOption lists resolver addresses: "udp://1.1.1.1:53",
+// "tcp://1.1.1.1", or "1.1.1.1" for UDP on port 53.
+type ResolverOption struct {
+	Addrs []string `proxy:"addrs"`
+}
+
+func New(o Option) (*Config, error) {
+	c := &Config{}
+	for _, d := range o.Domains {
+		lenLimit := d.LenLimit
+		if lenLimit == 0 {
+			lenLimit = 255
+		}
+		labelLimit := d.LabelLimit
+		if labelLimit == 0 {
+			labelLimit = 63
+		}
+		types := make([]uint16, 0, len(d.Types))
+		for _, t := range d.Types {
+			if t < 0 || t > 65535 {
+				return nil, fmt.Errorf("xdns: invalid type %d", t)
+			}
+			types = append(types, uint16(t))
+		}
+		if d.EDNS0 < 0 || d.EDNS0 > 65535 {
+			return nil, fmt.Errorf("xdns: invalid edns0 %d", d.EDNS0)
+		}
+		for _, name := range d.Names {
+			checkTypes := types
+			if len(checkTypes) == 0 {
+				checkTypes = []uint16{TypeA, TypeCNAME, TypeTXT, TypeAAAA}
+			}
+			if _, err := NewDomain(name, lenLimit, labelLimit, checkTypes, uint16(d.EDNS0)); err != nil {
+				return nil, fmt.Errorf("xdns: %w", err)
+			}
+			c.Domains = append(c.Domains, DomainConfig{
+				Name:       name,
+				LenLimit:   lenLimit,
+				LabelLimit: labelLimit,
+				Types:      types,
+				EDNS0:      uint16(d.EDNS0),
+			})
+		}
+	}
+	if len(c.Domains) == 0 {
+		return nil, errors.New("xdns: domains are required")
+	}
+	for _, r := range o.Resolvers {
+		for _, addr := range r.Addrs {
+			resolver, err := ParseResolver(addr)
+			if err != nil {
+				return nil, err
+			}
+			c.Resolvers = append(c.Resolvers, resolver)
+		}
+	}
+	if len(c.Resolvers) == 0 {
+		return nil, errors.New("xdns: resolvers are required")
+	}
+	if o.ExtraPoll < 0 || o.ExtraPoll > 3 {
+		return nil, errors.New("xdns: extra-poll must be between 0 and 3")
+	}
+	c.ExtraPoll = int32(o.ExtraPoll)
+	return c, nil
+}
+
+// ParseResolver reads a resolver address, see ResolverOption.
+func ParseResolver(addr string) (ResolverConfig, error) {
+	var u *url.URL
+	var err error
+	if !strings.Contains(addr, "://") {
+		u, err = url.Parse("udp://" + addr)
+	} else {
+		u, err = url.Parse(addr)
+	}
+	if err != nil {
+		return ResolverConfig{}, fmt.Errorf("xdns: resolver %q: %w", addr, err)
+	}
+	switch u.Scheme {
+	case "tcp", "udp":
+	default:
+		return ResolverConfig{}, fmt.Errorf("xdns: resolver %q: unknown scheme %q, want udp or tcp", addr, u.Scheme)
+	}
+	host, port := u.Hostname(), u.Port()
+	// An address without a host, like ":53", reaches the resolver on this
+	// machine; one with neither host nor port names nothing.
+	if host == "" && port == "" {
+		return ResolverConfig{}, fmt.Errorf("xdns: resolver address %q is empty", addr)
+	}
+	if port == "" {
+		port = "53"
+	}
+	if p, err := strconv.ParseUint(port, 10, 16); err != nil || p == 0 {
+		return ResolverConfig{}, fmt.Errorf("xdns: resolver address %q has no valid port", addr)
+	}
+	return ResolverConfig{Type: u.Scheme, Addr: net.JoinHostPort(host, port)}, nil
+}
+
+// HandleDial marks XDNS as a mask that reaches the network only through its
+// own resolvers, so the chain does not open a base socket for it.
+func (c *Config) HandleDial() {}
+
+func (c *Config) WrapPacketConnClient(ctx context.Context, _ net.PacketConn, _ *finalmask.Destination, dialer *finalmask.Dialer) (net.PacketConn, error) {
+	return NewClient(ctx, c, dialer)
+}
+
+func (c *Config) WrapPacketConnServer(conn net.PacketConn) (net.PacketConn, error) {
+	return NewServer(c, conn)
+}
diff --git a/transport/finalmask/xdns/domain.go b/transport/finalmask/xdns/domain.go
new file mode 100644
index 0000000..73c5b84
--- /dev/null
+++ b/transport/finalmask/xdns/domain.go
@@ -0,0 +1,249 @@
+package xdns
+
+import (
+	"encoding/base32"
+	"errors"
+	"fmt"
+	"strings"
+
+	"golang.org/x/net/dns/dnsmessage"
+	"golang.org/x/net/idna"
+)
+
+func lower(c byte) byte {
+	if c >= 'A' && c <= 'Z' {
+		return c + ('a' - 'A')
+	}
+	return c
+}
+
+func toUpper(b []byte) {
+	for i, c := range b {
+		if c >= 'a' && c <= 'z' {
+			b[i] = c - 'a' + 'A'
+		}
+	}
+}
+
+func toLower(b []byte) {
+	for i, c := range b {
+		if c >= 'A' && c <= 'Z' {
+			b[i] = c - 'A' + 'a'
+		}
+	}
+}
+
+func newTable() ([256]int, [256]int) {
+	var t, t_ [256]int
+	for i := range t {
+		t[i] = base32Encoding.DecodedLen(i)
+	}
+	for i := range t_ {
+		t_[i] = base32Encoding.EncodedLen(i)
+	}
+	return t, t_
+}
+
+const (
+	TypeA     uint16 = 1
+	TypeCNAME uint16 = 5
+	TypeTXT   uint16 = 16
+	TypeAAAA  uint16 = 28
+)
+
+var (
+	base32Encoding = base32.StdEncoding.WithPadding(base32.NoPadding)
+	// table maps an encoded length to the decoded one, table_ the reverse.
+	table, table_ = newTable()
+	typeMap       = map[uint16]byte{
+		TypeA:     0,
+		TypeCNAME: 1,
+		TypeTXT:   2,
+		TypeAAAA:  3,
+	}
+	typeMap_ = map[byte]uint16{
+		0: TypeA,
+		1: TypeCNAME,
+		2: TypeTXT,
+		3: TypeAAAA,
+	}
+)
+
+// Domain is a zone the tunnel's queries live under, with the limits of the
+// names that can be packed into it.
+type Domain struct {
+	name       dnsmessage.Name
+	lenLimit   int
+	labelLimit int
+	types      []uint16
+	edns0      uint16
+
+	cap    int // bytes of payload one query name carries
+	lenMax int
+}
+
+// absoluteASCIIName converts a configured domain, with or without a trailing
+// dot and possibly internationalised, into the absolute ASCII name that is
+// packed into queries. Every label must be non-empty and fit a DNS label, or
+// the client could not pack its first poll.
+func absoluteASCIIName(domain string) (dnsmessage.Name, error) {
+	ascii, err := idna.ToASCII(strings.TrimSuffix(domain, "."))
+	if err != nil {
+		return dnsmessage.Name{}, err
+	}
+	for _, label := range strings.Split(ascii, ".") {
+		if len(label) == 0 {
+			return dnsmessage.Name{}, errors.New("empty label")
+		}
+		if len(label) > 63 {
+			return dnsmessage.Name{}, fmt.Errorf("label %q is longer than 63 bytes", label)
+		}
+	}
+	if len(ascii)+1 > 255 {
+		return dnsmessage.Name{}, fmt.Errorf("ASCII name of %d bytes is longer than 255 bytes", len(ascii)+1)
+	}
+	return dnsmessage.NewName(ascii + ".")
+}
+
+func NewDomain(domain string, lenLimit int, labelLimit int, types []uint16, edns0 uint16) (*Domain, error) {
+	if lenLimit < 0 || lenLimit > 255 {
+		return nil, errors.New("lenLimit < 0 || lenLimit > 255")
+	}
+	if labelLimit < 0 || labelLimit > 63 {
+		return nil, errors.New("labelLimit < 0 || labelLimit > 63")
+	}
+	if len(types) == 0 {
+		return nil, errors.New("empty types")
+	}
+	for i := range types {
+		switch types[i] {
+		case TypeA, TypeCNAME, TypeTXT, TypeAAAA:
+		default:
+			return nil, errors.New("unknown types")
+		}
+	}
+	if edns0 != 0 && (edns0 < 512 || edns0 > 4096) {
+		return nil, errors.New("edns0 != 0 && (edns0 < 512 || edns0 > 4096)")
+	}
+
+	name, err := absoluteASCIIName(domain)
+	if err != nil {
+		return nil, fmt.Errorf("invalid domain %q: %w", domain, err)
+	}
+
+	if lenLimit < int(name.Length)+1 {
+		return nil, fmt.Errorf("domain %q needs a lenLimit of at least %d, got lenLimit %d", domain, int(name.Length)+1, lenLimit)
+	}
+	n := (lenLimit - int(name.Length) - 1) / (labelLimit + 1)
+	left := (lenLimit - int(name.Length) - 1) % (labelLimit + 1)
+	total := n * labelLimit
+	if left > 1 {
+		total += left - 1
+	}
+	cap := table[total]
+	if cap < 17 {
+		return nil, fmt.Errorf("domain %q leaves room for %d bytes of data per query with lenLimit %d and labelLimit %d, fewer than 17", domain, cap, lenLimit, labelLimit)
+	}
+	total = table_[cap]
+	lenMax := int(name.Length) + 1 + total + total/labelLimit
+	if total%labelLimit > 0 {
+		lenMax += 1
+	}
+	return &Domain{
+		name:       name,
+		lenLimit:   lenLimit,
+		labelLimit: labelLimit,
+		types:      types,
+		edns0:      edns0,
+
+		cap:    cap,
+		lenMax: lenMax,
+	}, nil
+}
+
+func (d *Domain) String() string {
+	return fmt.Sprintf("%s (%d bytes per query)", d.name.String(), d.cap)
+}
+
+// IsDomain reports whether name is a strict subdomain of d: d must end name
+// at a label boundary, so siblings sharing a suffix do not match.
+func (d *Domain) IsDomain(name dnsmessage.Name) bool {
+	if d.name.Length >= name.Length || name.Data[name.Length-d.name.Length-1] != '.' {
+		return false
+	}
+	return d.endsName(name)
+}
+
+// IsApex reports whether name is d itself, the apex of the zone the server
+// answers for. The apex carries no tunnel data, so IsDomain excludes it.
+func (d *Domain) IsApex(name dnsmessage.Name) bool {
+	return d.name.Length == name.Length && d.endsName(name)
+}
+
+// endsName reports whether name ends with d's name, ignoring ASCII case. name
+// must be at least as long as d's name.
+func (d *Domain) endsName(name dnsmessage.Name) bool {
+	offset := name.Length - d.name.Length
+	for i := 0; i < int(d.name.Length); i++ {
+		if lower(d.name.Data[i]) != lower(name.Data[int(offset)+i]) {
+			return false
+		}
+	}
+	return true
+}
+
+func (d *Domain) HasType(qtype uint16) bool {
+	for i := range d.types {
+		if d.types[i] == qtype {
+			return true
+		}
+	}
+	return false
+}
+
+// Encode packs data into base32 labels under d.
+func (d *Domain) Encode(data []byte) dnsmessage.Name {
+	var name dnsmessage.Name
+	var encoded [255]byte
+	base32Encoding.Encode(encoded[:], data)
+	toLower(encoded[:table_[len(data)]])
+	b1 := name.Data[:0]
+	b2 := encoded[:table_[len(data)]]
+	for len(b2) > 0 {
+		size := len(b2)
+		if size > d.labelLimit {
+			size = d.labelLimit
+		}
+		b1 = append(b1, b2[:size]...)
+		b1 = append(b1, '.')
+		b2 = b2[size:]
+	}
+	b1 = append(b1, d.name.Data[:d.name.Length]...)
+	if len(b1) > 254 {
+		panic("len(b1) > 254")
+	}
+	name.Length = byte(len(b1))
+	return name
+}
+
+// Decode unpacks the labels of name under d into decoded; 0 when name is not
+// under d or not base32.
+func (d *Domain) Decode(decoded *[255]byte, name dnsmessage.Name) int {
+	if !d.IsDomain(name) {
+		return 0
+	}
+	var encoded [255]byte
+	b1 := encoded[:0]
+	b2 := name.Data[:name.Length-d.name.Length]
+	for i := range b2 {
+		if b2[i] != '.' {
+			b1 = append(b1, b2[i])
+		}
+	}
+	toUpper(b1)
+	n, err := base32Encoding.Decode(decoded[:], b1)
+	if err != nil {
+		return 0
+	}
+	return n
+}
diff --git a/transport/finalmask/xdns/frag.go b/transport/finalmask/xdns/frag.go
new file mode 100644
index 0000000..37e0618
--- /dev/null
+++ b/transport/finalmask/xdns/frag.go
@@ -0,0 +1,171 @@
+package xdns
+
+import (
+	"sync"
+	"time"
+)
+
+const (
+	fragTTL   = 4 * time.Second
+	fragSize  = 4096
+	fragCount = 4096
+)
+
+// FragKey identifies one fragmented packet. The one-byte fragment ID repeats
+// every 256 packets, well within fragTTL on a busy client, so the key also
+// carries the 3-byte nonce the client draws once per packet and repeats in
+// each of its fragments; without it a later packet completes an earlier one
+// that lost a fragment.
+type FragKey struct {
+	clientID ClientID
+	nonce    [3]byte
+	fragID   byte
+}
+
+type FragEntry struct {
+	data     [][]byte
+	size     int
+	len      int
+	total    byte
+	deadline time.Time
+}
+
+// FragManager reassembles the upload packets a client split over several
+// queries.
+type FragManager struct {
+	m  map[FragKey]*FragEntry
+	ch chan struct{}
+	mu sync.Mutex
+}
+
+func NewFragManager() *FragManager {
+	m := &FragManager{
+		m:  make(map[FragKey]*FragEntry),
+		ch: make(chan struct{}),
+	}
+	go m.gc()
+	return m
+}
+
+func (m *FragManager) closed() bool {
+	select {
+	case <-m.ch:
+		return true
+	default:
+		return false
+	}
+}
+
+func (m *FragManager) remove(key FragKey) {
+	delete(m.m, key)
+}
+
+func (m *FragManager) tryRemove() {
+	if len(m.m) < fragCount {
+		return
+	}
+	var key FragKey
+	var entry *FragEntry
+	first := true
+	for k, e := range m.m {
+		if first || e.deadline.Before(entry.deadline) {
+			key = k
+			entry = e
+			first = false
+		}
+	}
+	m.remove(key)
+}
+
+func (m *FragManager) gc() {
+	ticker := time.NewTicker(fragTTL / 2)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-m.ch:
+			return
+		case now := <-ticker.C:
+			m.mu.Lock()
+			for k, e := range m.m {
+				if now.After(e.deadline) {
+					m.remove(k)
+				}
+			}
+			m.mu.Unlock()
+		}
+	}
+}
+
+// Feed adds a fragment and, when it completes its packet, writes the packet
+// into out and returns its length.
+func (m *FragManager) Feed(out []byte, key FragKey, fragIdx, fragN byte, data []byte) int {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.closed() {
+		return 0
+	}
+
+	if fragN < 2 {
+		return 0
+	}
+
+	now := time.Now()
+	entry := m.m[key]
+	if entry == nil || now.After(entry.deadline) {
+		if entry == nil {
+			m.tryRemove()
+		} else {
+			m.remove(key)
+		}
+		entry = &FragEntry{
+			data:     make([][]byte, fragN),
+			total:    fragN,
+			deadline: now.Add(fragTTL),
+		}
+		m.m[key] = entry
+	}
+
+	if fragN != entry.total {
+		return 0
+	}
+	if fragIdx >= entry.total {
+		return 0
+	}
+	if entry.data[fragIdx] != nil {
+		return 0
+	}
+	if entry.size+len(data) > fragSize {
+		return 0
+	}
+
+	cp := make([]byte, len(data))
+	copy(cp, data)
+
+	entry.data[fragIdx] = cp
+	entry.size += len(data)
+	entry.len++
+	entry.deadline = now.Add(fragTTL)
+
+	if entry.len < int(entry.total) {
+		return 0
+	}
+
+	out = out[:0]
+	for i := range entry.data {
+		out = append(out, entry.data[i]...)
+	}
+	m.remove(key)
+	return len(out)
+}
+
+func (m *FragManager) Close() {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.closed() {
+		return
+	}
+	close(m.ch)
+	for k := range m.m {
+		delete(m.m, k)
+	}
+}
diff --git a/transport/finalmask/xdns/resolver.go b/transport/finalmask/xdns/resolver.go
new file mode 100644
index 0000000..077b0bb
--- /dev/null
+++ b/transport/finalmask/xdns/resolver.go
@@ -0,0 +1,323 @@
+package xdns
+
+import (
+	"context"
+	"encoding/binary"
+	"errors"
+	"io"
+	"net"
+	"sync"
+	"sync/atomic"
+
+	"github.com/metacubex/mihomo/common/contextutils"
+	"github.com/metacubex/mihomo/transport/finalmask"
+)
+
+// Resolver is a DNS server the client sends its queries to, over UDP or TCP.
+type Resolver interface {
+	Addr() *net.UDPAddr
+	Read(p []byte) (int, error)
+	Send(p []byte)
+	Close()
+}
+
+// ResolverConfig is one resolver: Type "udp" or "tcp", Addr host:port.
+type ResolverConfig struct {
+	Type string
+	Addr string
+}
+
+func NewResolver(ctx context.Context, config ResolverConfig, dialer *finalmask.Dialer) (Resolver, error) {
+	switch config.Type {
+	case "tcp":
+		return NewTCPResolver(ctx, config, dialer)
+	case "udp":
+		return NewUDPResolver(ctx, config, dialer)
+	default:
+		return nil, errors.New("unknown type")
+	}
+}
+
+type TCPResolver struct {
+	ctx    context.Context
+	addr   string
+	dialer *finalmask.Dialer
+
+	conn    net.Conn
+	udpAddr atomic.Pointer[net.UDPAddr]
+
+	readCh  chan []byte
+	closeCh chan struct{}
+	wg      sync.WaitGroup
+	mu      sync.Mutex
+	// writeMu keeps frames whole without holding mu, so Close can interrupt
+	// a write stalled on a peer that stopped reading.
+	writeMu sync.Mutex
+}
+
+func NewTCPResolver(ctx context.Context, config ResolverConfig, dialer *finalmask.Dialer) (Resolver, error) {
+	r := &TCPResolver{
+		ctx:     contextutils.WithoutCancel(ctx),
+		addr:    config.Addr,
+		dialer:  dialer,
+		readCh:  make(chan []byte),
+		closeCh: make(chan struct{}),
+	}
+	if err := r.dial(); err != nil {
+		r.Close()
+		return nil, err
+	}
+	return r, nil
+}
+
+func (r *TCPResolver) closed() bool {
+	select {
+	case <-r.closeCh:
+		return true
+	default:
+		return false
+	}
+}
+
+func (r *TCPResolver) dial() error {
+	if r.closed() {
+		return errors.New("closed")
+	}
+	if r.conn != nil {
+		return nil
+	}
+	conn, err := r.dialer.DialTCP(r.ctx, r.addr)
+	if err != nil {
+		return err
+	}
+	r.conn = conn
+	if tcpAddr, ok := conn.RemoteAddr().(*net.TCPAddr); ok {
+		r.udpAddr.Store(&net.UDPAddr{IP: tcpAddr.IP, Port: tcpAddr.Port})
+	} else if udpAddr, err := net.ResolveUDPAddr("udp", r.addr); err == nil {
+		r.udpAddr.Store(udpAddr)
+	} else {
+		r.udpAddr.Store(&net.UDPAddr{IP: net.IPv4zero})
+	}
+	r.wg.Add(1)
+	go r.recv(conn)
+	return nil
+}
+
+func (r *TCPResolver) recv(conn net.Conn) {
+	defer r.wg.Done()
+
+	var buf [4096]byte
+	for {
+		_, err := io.ReadFull(conn, buf[:2])
+		if err != nil {
+			break
+		}
+		n := binary.BigEndian.Uint16(buf[:2])
+		if n == 0 || n > 4096 {
+			_, _ = io.CopyN(io.Discard, conn, int64(n))
+			continue
+		}
+		_, err = io.ReadFull(conn, buf[:n])
+		if err != nil {
+			break
+		}
+		p := pool4K.Get().([]byte)
+		copy(p, buf[:n])
+		select {
+		case <-r.closeCh:
+			pool4K.Put(p[:cap(p)])
+		case r.readCh <- p[:n]:
+		}
+	}
+
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	_ = conn.Close()
+	if r.conn == conn {
+		r.conn = nil
+	}
+}
+
+func (r *TCPResolver) Addr() *net.UDPAddr {
+	return r.udpAddr.Load()
+}
+
+func (r *TCPResolver) Read(p []byte) (n int, err error) {
+	packet, ok := <-r.readCh
+	if ok {
+		n = copy(p, packet)
+		pool4K.Put(packet[:cap(packet)])
+		return n, nil
+	}
+	return 0, io.ErrClosedPipe
+}
+
+func (r *TCPResolver) Send(p []byte) {
+	r.mu.Lock()
+	if r.dial() != nil {
+		r.mu.Unlock()
+		return
+	}
+	conn := r.conn
+	r.mu.Unlock()
+
+	// DNS over TCP prefixes each message with its length (RFC 1035 4.2.2).
+	frame := make([]byte, 2+len(p))
+	binary.BigEndian.PutUint16(frame, uint16(len(p)))
+	copy(frame[2:], p)
+	r.writeMu.Lock()
+	_, err := conn.Write(frame)
+	r.writeMu.Unlock()
+	if err != nil {
+		// recv sees the closed conn and resets it, so the next Send redials.
+		_ = conn.Close()
+	}
+}
+
+func (r *TCPResolver) Close() {
+	r.mu.Lock()
+	if r.closed() {
+		r.mu.Unlock()
+		return
+	}
+	close(r.closeCh)
+	conn := r.conn
+	r.mu.Unlock()
+	if conn != nil {
+		_ = conn.Close()
+	}
+	r.wg.Wait()
+	close(r.readCh)
+}
+
+type UDPResolver struct {
+	ctx    context.Context
+	addr   string
+	dialer *finalmask.Dialer
+
+	conn    net.PacketConn
+	udpAddr atomic.Pointer[net.UDPAddr]
+
+	readCh  chan []byte
+	closeCh chan struct{}
+	wg      sync.WaitGroup
+	mu      sync.Mutex
+}
+
+func NewUDPResolver(ctx context.Context, config ResolverConfig, dialer *finalmask.Dialer) (Resolver, error) {
+	r := &UDPResolver{
+		ctx:     contextutils.WithoutCancel(ctx),
+		addr:    config.Addr,
+		dialer:  dialer,
+		readCh:  make(chan []byte),
+		closeCh: make(chan struct{}),
+	}
+	if err := r.dial(); err != nil {
+		r.Close()
+		return nil, err
+	}
+	return r, nil
+}
+
+func (r *UDPResolver) closed() bool {
+	select {
+	case <-r.closeCh:
+		return true
+	default:
+		return false
+	}
+}
+
+func (r *UDPResolver) dial() error {
+	if r.closed() {
+		return errors.New("closed")
+	}
+	if r.conn != nil {
+		return nil
+	}
+	conn, addr, err := r.dialer.DialUDP(r.ctx, r.addr)
+	if err != nil {
+		return err
+	}
+	udpAddr, ok := addr.(*net.UDPAddr)
+	if !ok {
+		_ = conn.Close()
+		return errors.New("xdns: resolver address is not UDP")
+	}
+	r.conn = conn
+	r.udpAddr.Store(udpAddr)
+	r.wg.Add(1)
+	go r.recv(conn)
+	return nil
+}
+
+func (r *UDPResolver) recv(conn net.PacketConn) {
+	defer r.wg.Done()
+
+	var buf [4096]byte
+	for {
+		n, _, err := conn.ReadFrom(buf[:])
+		if err != nil {
+			break
+		}
+		p := pool4K.Get().([]byte)
+		copy(p, buf[:n])
+		select {
+		case <-r.closeCh:
+			pool4K.Put(p[:cap(p)])
+		case r.readCh <- p[:n]:
+		}
+	}
+
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	_ = conn.Close()
+	if r.conn == conn {
+		r.conn = nil
+	}
+}
+
+func (r *UDPResolver) Addr() *net.UDPAddr {
+	return r.udpAddr.Load()
+}
+
+func (r *UDPResolver) Read(p []byte) (n int, err error) {
+	packet, ok := <-r.readCh
+	if ok {
+		n = copy(p, packet)
+		pool4K.Put(packet[:cap(packet)])
+		return n, nil
+	}
+	return 0, io.ErrClosedPipe
+}
+
+func (r *UDPResolver) Send(p []byte) {
+	r.mu.Lock()
+	if err := r.dial(); err != nil {
+		r.mu.Unlock()
+		return
+	}
+	conn := r.conn
+	r.mu.Unlock()
+	// Write outside mu: a conn behind a dialer-proxy can block until Close
+	// closes it, and Close needs mu to reach it.
+	_, _ = conn.WriteTo(p, r.udpAddr.Load())
+}
+
+func (r *UDPResolver) Close() {
+	r.mu.Lock()
+	if r.closed() {
+		r.mu.Unlock()
+		return
+	}
+	close(r.closeCh)
+	conn := r.conn
+	r.mu.Unlock()
+	if conn != nil {
+		_ = conn.Close()
+	}
+	r.wg.Wait()
+	close(r.readCh)
+}
diff --git a/transport/finalmask/xdns/resp.go b/transport/finalmask/xdns/resp.go
new file mode 100644
index 0000000..e825634
--- /dev/null
+++ b/transport/finalmask/xdns/resp.go
@@ -0,0 +1,411 @@
+package xdns
+
+import (
+	"container/list"
+	"sort"
+	"sync"
+	"time"
+
+	"golang.org/x/net/dns/dnsmessage"
+)
+
+const (
+	sendTTL = 4 * time.Second
+	// sendClientCount caps the per-client queues, whose keys come from
+	// unauthenticated queries.
+	sendClientCount = 4096
+)
+
+// Resp builds and reads the answers that carry downlink data.
+type Resp struct {
+	msg    dnsmessage.Message
+	domain *Domain
+	edns0  uint16
+
+	cap int
+}
+
+func NewResp(msg dnsmessage.Message, domain *Domain, edns0 uint16) *Resp {
+	if msg.Header.Response {
+		return &Resp{
+			msg:    msg,
+			domain: domain,
+		}
+	}
+
+	size := minInt(maxInt(int(edns0), 512), maxInt(int(domain.edns0), 512))
+
+	left := size - 12 - int(msg.Questions[0].Name.Length) - 1 - 2 - 2
+	if edns0 > 0 {
+		left -= 1 + 2 + 2 + 4 + 2 + 0
+	}
+	cap := 0
+	switch msg.Questions[0].Type {
+	case dnsmessage.TypeA:
+		single := 2 + 2 + 2 + 4 + 2 + 4
+		n := left / single
+		if n > 255 {
+			n = 255
+		}
+		cap = 4*n - n - 1
+	case dnsmessage.TypeCNAME:
+		single := 2 + 2 + 2 + 4 + 2 + domain.lenMax
+		n := left / single
+		if n > 255 {
+			n = 255
+		}
+		cap = domain.cap*n - n - 1
+	case dnsmessage.TypeTXT:
+		left -= 2 + 2 + 2 + 4 + 2
+		single := 255
+		n := left / single
+		m := left % single
+		cap = 255*n - n
+		if m > 1 {
+			cap += m - 1
+		}
+	case dnsmessage.TypeAAAA:
+		single := 2 + 2 + 2 + 4 + 2 + 16
+		n := left / single
+		if n > 255 {
+			n = 255
+		}
+		cap = 16*n - n - 1
+	}
+
+	return &Resp{
+		msg:    msg,
+		domain: domain,
+		edns0:  edns0,
+
+		cap: cap,
+	}
+}
+
+func minInt(a, b int) int {
+	if a < b {
+		return a
+	}
+	return b
+}
+
+func maxInt(a, b int) int {
+	if a > b {
+		return a
+	}
+	return b
+}
+
+func (r *Resp) Encode(encoded []byte, data []byte) []byte {
+	msg := r.msg
+	msg.Header = dnsmessage.Header{
+		ID:            msg.Header.ID,
+		Response:      true,
+		Authoritative: true,
+		RCode:         dnsmessage.RCodeSuccess,
+	}
+	msg.Answers = nil
+	msg.Authorities = nil
+	msg.Additionals = nil
+	header := dnsmessage.ResourceHeader{
+		Name:  msg.Questions[0].Name,
+		Type:  msg.Questions[0].Type,
+		Class: dnsmessage.ClassINET,
+		TTL:   60,
+	}
+	switch msg.Questions[0].Type {
+	case dnsmessage.TypeA:
+		for i, fragN := 0, fragCountFor(len(data), 4); i < fragN; i++ {
+			A := [4]byte{byte(i)}
+			if i == 0 {
+				A[1] = byte(fragN)
+				n := copy(A[2:], data)
+				data = data[n:]
+			} else {
+				n := copy(A[1:], data)
+				data = data[n:]
+			}
+			msg.Answers = append(msg.Answers, dnsmessage.Resource{Header: header, Body: &dnsmessage.AResource{A: A}})
+		}
+	case dnsmessage.TypeCNAME:
+		DATA := make([]byte, r.domain.cap)
+		for i, fragN := 0, fragCountFor(len(data), r.domain.cap); i < fragN; i++ {
+			DATA[0] = byte(i)
+			if i == 0 {
+				DATA[1] = byte(fragN)
+				n := copy(DATA[2:], data)
+				data = data[n:]
+				msg.Answers = append(msg.Answers, dnsmessage.Resource{Header: header, Body: &dnsmessage.CNAMEResource{CNAME: r.domain.Encode(DATA[:2+n])}})
+			} else {
+				n := copy(DATA[1:], data)
+				data = data[n:]
+				msg.Answers = append(msg.Answers, dnsmessage.Resource{Header: header, Body: &dnsmessage.CNAMEResource{CNAME: r.domain.Encode(DATA[:1+n])}})
+			}
+		}
+	case dnsmessage.TypeTXT:
+		var txt []string
+		for len(data) > 0 {
+			size := len(data)
+			if size > 255 {
+				size = 255
+			}
+			txt = append(txt, string(data[:size]))
+			data = data[size:]
+		}
+		msg.Answers = append(msg.Answers, dnsmessage.Resource{Header: header, Body: &dnsmessage.TXTResource{TXT: txt}})
+	case dnsmessage.TypeAAAA:
+		for i, fragN := 0, fragCountFor(len(data), 16); i < fragN; i++ {
+			AAAA := [16]byte{byte(i)}
+			if i == 0 {
+				AAAA[1] = byte(fragN)
+				n := copy(AAAA[2:], data)
+				data = data[n:]
+			} else {
+				n := copy(AAAA[1:], data)
+				data = data[n:]
+			}
+			msg.Answers = append(msg.Answers, dnsmessage.Resource{Header: header, Body: &dnsmessage.AAAAResource{AAAA: AAAA}})
+		}
+	}
+	if r.edns0 > 0 {
+		msg.Additionals = append(msg.Additionals, dnsmessage.Resource{
+			Header: dnsmessage.ResourceHeader{
+				Name:  dnsmessage.MustNewName("."),
+				Type:  dnsmessage.TypeOPT,
+				Class: dnsmessage.Class(r.edns0),
+				TTL:   0,
+			},
+			Body: &dnsmessage.OPTResource{},
+		})
+	}
+	packed, err := msg.AppendPack(encoded[:0])
+	if err != nil {
+		panic(err)
+	}
+	return packed
+}
+
+// fragCountFor is how many records of size bytes carry n bytes of data: the
+// first record holds an index, the count and size-2 bytes, every later one an
+// index and size-1 bytes.
+func fragCountFor(n, size int) int {
+	fragN := 0
+	if n > 0 {
+		fragN = 1
+	}
+	if n-(size-2) > 0 {
+		fragN += (n - (size - 2)) / (size - 1)
+		if (n-(size-2))%(size-1) > 0 {
+			fragN++
+		}
+	}
+	return fragN
+}
+
+// Decode writes the payload carried by the answers into decoded and returns
+// its length. The caller reslices its buffer with the result, so a payload
+// that does not fit len(decoded) is rejected instead of growing past it.
+func (r *Resp) Decode(decoded []byte) int {
+	limit := len(decoded)
+	decoded = decoded[:0]
+	fits := func(n int) bool {
+		return len(decoded)+n <= limit
+	}
+	msg := r.msg
+	if msg.Questions[0].Type == dnsmessage.TypeTXT {
+		if len(msg.Answers) == 1 && r.domain.IsDomain(msg.Answers[0].Header.Name) && msg.Answers[0].Header.Type == dnsmessage.TypeTXT {
+			for _, txt := range msg.Answers[0].Body.(*dnsmessage.TXTResource).TXT {
+				if !fits(len(txt)) {
+					return 0
+				}
+				decoded = append(decoded, txt...)
+			}
+		}
+		return len(decoded)
+	}
+	var frags [][]byte
+	for i := range msg.Answers {
+		if !r.domain.IsDomain(msg.Answers[i].Header.Name) || msg.Answers[i].Header.Type != msg.Questions[0].Type {
+			continue
+		}
+		switch msg.Questions[0].Type {
+		case dnsmessage.TypeA:
+			frags = append(frags, msg.Answers[i].Body.(*dnsmessage.AResource).A[:])
+		case dnsmessage.TypeCNAME:
+			var decoded [255]byte
+			n := r.domain.Decode(&decoded, msg.Answers[i].Body.(*dnsmessage.CNAMEResource).CNAME)
+			if n == 0 {
+				continue
+			}
+			frags = append(frags, decoded[:n])
+		case dnsmessage.TypeAAAA:
+			frags = append(frags, msg.Answers[i].Body.(*dnsmessage.AAAAResource).AAAA[:])
+		}
+	}
+	sort.Slice(frags, func(i, j int) bool {
+		return frags[i][0] < frags[j][0]
+	})
+	if len(frags) < 1 || len(frags[0]) < 2 || int(frags[0][1]) > len(frags) {
+		return 0
+	}
+	if !fits(len(frags[0]) - 2) {
+		return 0
+	}
+	decoded = append(decoded, frags[0][2:]...)
+	for i := range frags {
+		if i > 0 {
+			if frags[i][0] == frags[i-1][0] || !fits(len(frags[i])-1) {
+				return 0
+			}
+			decoded = append(decoded, frags[i][1:]...)
+		}
+	}
+	return len(decoded)
+}
+
+type SendInfo struct {
+	stash    chan []byte
+	ch       chan []byte
+	deadline time.Time
+	// elem is the client's place in SendManager.lru.
+	elem *list.Element
+}
+
+// SendManager queues the downlink packets of every client until a query of
+// that client comes to carry them.
+type SendManager struct {
+	m map[ClientID]*SendInfo
+	// lru orders the tracked clients from most to least recently used.
+	lru *list.List
+	ch  chan struct{}
+	mu  sync.Mutex
+}
+
+func NewSendManager() *SendManager {
+	m := &SendManager{
+		m:   make(map[ClientID]*SendInfo),
+		lru: list.New(),
+		ch:  make(chan struct{}),
+	}
+	go m.gc()
+	return m
+}
+
+func (m *SendManager) closed() bool {
+	select {
+	case <-m.ch:
+		return true
+	default:
+		return false
+	}
+}
+
+func (m *SendManager) gc() {
+	ticker := time.NewTicker(sendTTL)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-m.ch:
+			return
+		case now := <-ticker.C:
+			m.mu.Lock()
+			for key, info := range m.m {
+				if now.After(info.deadline) {
+					m.remove(key, info)
+				}
+			}
+			m.mu.Unlock()
+			ticker.Reset(sendTTL)
+		}
+	}
+}
+
+// remove closes the queues of clientID and stops tracking it. m.mu must be
+// held.
+func (m *SendManager) remove(clientID ClientID, info *SendInfo) {
+	close(info.stash)
+	close(info.ch)
+	m.lru.Remove(info.elem)
+	delete(m.m, clientID)
+}
+
+// entry returns the queues of clientID, creating them if needed, and marks
+// it the most recently used client. A new client beyond sendClientCount
+// evicts the least recently used one. entry returns nil once the manager is
+// closed. m.mu must be held.
+func (m *SendManager) entry(clientID ClientID) *SendInfo {
+	if info := m.m[clientID]; info != nil {
+		m.lru.MoveToFront(info.elem)
+		return info
+	}
+	if m.closed() {
+		return nil
+	}
+	if len(m.m) >= sendClientCount {
+		oldest := m.lru.Back().Value.(ClientID)
+		m.remove(oldest, m.m[oldest])
+	}
+	info := &SendInfo{
+		stash:    make(chan []byte, 1),
+		ch:       make(chan []byte, 128),
+		deadline: time.Now().Add(sendTTL),
+	}
+	info.elem = m.lru.PushFront(clientID)
+	m.m[clientID] = info
+	return info
+}
+
+func (m *SendManager) Push(clientID ClientID, p []byte) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	info := m.entry(clientID)
+	if info == nil {
+		return
+	}
+	b := make([]byte, len(p))
+	copy(b, p)
+	select {
+	case info.ch <- b:
+	default:
+	}
+}
+
+func (m *SendManager) Stash(clientID ClientID, p []byte) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	info := m.m[clientID]
+	if info == nil {
+		return
+	}
+	m.lru.MoveToFront(info.elem)
+	info.deadline = time.Now().Add(sendTTL)
+	select {
+	case info.stash <- p:
+	default:
+	}
+}
+
+// Pop returns the queues of clientID and refreshes their deadline. ok is
+// false once the manager is closed.
+func (m *SendManager) Pop(clientID ClientID) (ch chan []byte, stash chan []byte, ok bool) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	info := m.entry(clientID)
+	if info == nil {
+		return nil, nil, false
+	}
+	info.deadline = time.Now().Add(sendTTL)
+	return info.ch, info.stash, true
+}
+
+func (m *SendManager) Close() {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.closed() {
+		return
+	}
+	close(m.ch)
+	for key, info := range m.m {
+		m.remove(key, info)
+	}
+}
diff --git a/transport/finalmask/xdns/server.go b/transport/finalmask/xdns/server.go
new file mode 100644
index 0000000..301334c
--- /dev/null
+++ b/transport/finalmask/xdns/server.go
@@ -0,0 +1,464 @@
+package xdns
+
+import (
+	goerrors "errors"
+	"io"
+	"net"
+	"sync"
+	"time"
+
+	"github.com/metacubex/mihomo/log"
+
+	"golang.org/x/net/dns/dnsmessage"
+)
+
+const (
+	maxResponseDelay = time.Second
+
+	recvBackoffMin = 10 * time.Millisecond
+	recvBackoffMax = time.Second
+
+	// rcodeBadVersion is BADVERS, whose upper bits travel in the OPT record
+	// (RFC 6891).
+	rcodeBadVersion dnsmessage.RCode = 16
+)
+
+type resp struct {
+	msg  dnsmessage.Message
+	addr net.Addr
+	// limit is the length of the query; the reply must not outgrow it.
+	limit int
+}
+
+type Rec struct {
+	resp     *Resp
+	clientID ClientID
+	addr     net.Addr
+}
+
+// xdnsServer answers the tunnel queries of a zone; it is here for the tests
+// and for symmetry with the client; the port has no xdns inbound.
+type xdnsServer struct {
+	net.PacketConn
+
+	domains     []*Domain
+	fragManager *FragManager
+	sendManager *SendManager
+
+	readCh  chan packet
+	recCh   chan *Rec
+	drCh    chan resp
+	closeCh chan struct{}
+	wg      sync.WaitGroup
+	mu      sync.RWMutex
+}
+
+func NewServer(c *Config, raw net.PacketConn) (net.PacketConn, error) {
+	if len(c.Domains) == 0 {
+		return nil, goerrors.New("xdns: empty domains")
+	}
+	domains := make([]*Domain, 0, len(c.Domains))
+	for i := range c.Domains {
+		types := c.Domains[i].Types
+		if len(types) == 0 {
+			types = []uint16{TypeA, TypeCNAME, TypeTXT, TypeAAAA}
+		}
+		domain, err := NewDomain(c.Domains[i].Name, c.Domains[i].LenLimit, c.Domains[i].LabelLimit, types, c.Domains[i].EDNS0)
+		if err != nil {
+			return nil, err
+		}
+		domains = append(domains, domain)
+	}
+	server := &xdnsServer{
+		PacketConn: raw,
+
+		domains:     domains,
+		fragManager: NewFragManager(),
+		sendManager: NewSendManager(),
+
+		readCh: make(chan packet),
+		recCh:  make(chan *Rec, 255),
+		// queueReply never blocks the receive loop; buffer error replies so a
+		// busy writer drops them only when this bounded queue is full.
+		drCh:    make(chan resp, 128),
+		closeCh: make(chan struct{}),
+	}
+	go server.run()
+	return server, nil
+}
+
+func (c *xdnsServer) closed() bool {
+	select {
+	case <-c.closeCh:
+		return true
+	default:
+		return false
+	}
+}
+
+// queueReply queues the reply to a query the server answers without tunnel
+// data. The reply carries only the header, the single question and, when the
+// query used EDNS, an OPT record of the server's; a reply that would outgrow
+// the query is sent as a FORMERR without the question.
+func (c *xdnsServer) queueReply(query *dnsmessage.Message, rcode dnsmessage.RCode, authoritative bool, limit int, addr net.Addr) {
+	reply := dnsmessage.Message{Header: dnsmessage.Header{
+		ID:               query.Header.ID,
+		Response:         true,
+		OpCode:           query.Header.OpCode,
+		Authoritative:    authoritative,
+		RecursionDesired: query.Header.RecursionDesired,
+		CheckingDisabled: query.Header.CheckingDisabled,
+		RCode:            rcode & 0xF,
+	}}
+	if len(query.Questions) == 1 {
+		reply.Questions = query.Questions
+	}
+	for i := range query.Additionals {
+		if query.Additionals[i].Header.Type != dnsmessage.TypeOPT {
+			continue
+		}
+		var opt dnsmessage.ResourceHeader
+		size := minInt(maxInt(int(query.Additionals[i].Header.Class), 512), 4096)
+		if err := opt.SetEDNS0(size, rcode, query.Additionals[i].Header.DNSSECAllowed()); err == nil {
+			reply.Additionals = []dnsmessage.Resource{{Header: opt, Body: &dnsmessage.OPTResource{}}}
+		}
+		break
+	}
+	select {
+	case c.drCh <- resp{msg: reply, addr: addr, limit: limit}:
+	default:
+	}
+}
+
+func (c *xdnsServer) read(buf []byte, addr net.Addr) {
+	msg := dnsmessage.Message{}
+	if err := msg.Unpack(buf); err != nil {
+		return
+	}
+	if msg.Header.Response {
+		return
+	}
+	answer := func(rcode dnsmessage.RCode, authoritative bool) {
+		c.queueReply(&msg, rcode, authoritative, len(buf), addr)
+	}
+
+	if msg.Header.OpCode != 0 {
+		answer(dnsmessage.RCodeNotImplemented, false)
+		return
+	}
+
+	if len(msg.Questions) != 1 {
+		answer(dnsmessage.RCodeFormatError, false)
+		return
+	}
+
+	opt := false
+	edns0 := uint16(0)
+	for i := range msg.Additionals {
+		if msg.Additionals[i].Header.Type == dnsmessage.TypeOPT {
+			if opt {
+				answer(dnsmessage.RCodeFormatError, false)
+				return
+			}
+			opt = true
+			edns0 = uint16(msg.Additionals[i].Header.Class)
+			if ver := (msg.Additionals[i].Header.TTL >> 16) & 0xFF; ver != 0 {
+				answer(rcodeBadVersion, false)
+				return
+			}
+		}
+	}
+	if opt {
+		if edns0 < 512 {
+			edns0 = 512
+		}
+		if edns0 > 4096 {
+			edns0 = 4096
+		}
+	}
+
+	var domain *Domain
+	for i := range c.domains {
+		if c.domains[i].IsDomain(msg.Questions[0].Name) {
+			domain = c.domains[i]
+			break
+		}
+	}
+	if domain == nil {
+		for i := range c.domains {
+			if c.domains[i].IsApex(msg.Questions[0].Name) {
+				// The apex exists like every name in the zone; NXDOMAIN
+				// would deny the whole zone below it (RFC 8020).
+				answer(dnsmessage.RCodeSuccess, true)
+				return
+			}
+		}
+		answer(dnsmessage.RCodeNameError, false)
+		return
+	}
+	if !domain.HasType(uint16(msg.Questions[0].Type)) {
+		answer(dnsmessage.RCodeSuccess, true)
+		return
+	}
+
+	var decoded [255]byte
+	n := domain.Decode(&decoded, msg.Questions[0].Name)
+	if n < 9 {
+		answer(dnsmessage.RCodeSuccess, true)
+		return
+	}
+	if typeMap_[decoded[0]&3] != uint16(msg.Questions[0].Type) || (decoded[8]&0x3F != 3 && decoded[8]&0x3F != 8) || (decoded[8]&0x3F == 3 && n < 9+3+1) || (decoded[8]&0xC0 == 0xC0 && n < 9+3+3+1) || (decoded[8]&0x3F == 8 && n != 9+8) {
+		answer(dnsmessage.RCodeSuccess, true)
+		return
+	}
+	var raw [8]byte
+	copy(raw[:], decoded[:8])
+	clientID := ClientIDFromRaw(raw)
+
+	r := NewResp(msg, domain, edns0)
+	select {
+	case c.recCh <- &Rec{resp: r, clientID: clientID, addr: addr}:
+	default:
+		answer(dnsmessage.RCodeSuccess, true)
+	}
+
+	if decoded[8]&0x3F == 8 {
+		return
+	}
+	p := pool4K.Get().([]byte)
+	p = p[:0]
+	if decoded[8]&0xC0 == 0xC0 {
+		out := pool4K.Get().([]byte)
+		var nonce [3]byte
+		copy(nonce[:], decoded[9:12])
+		key := FragKey{clientID: clientID, nonce: nonce, fragID: decoded[12]}
+		n := c.fragManager.Feed(out, key, decoded[13], decoded[14], decoded[15:n])
+		pool4K.Put(p[:cap(p)])
+		if n > 0 {
+			p = out[:n]
+		} else {
+			pool4K.Put(out[:cap(out)])
+			return
+		}
+	} else {
+		p = append(p, decoded[12:n]...)
+	}
+	select {
+	case <-c.closeCh:
+		pool4K.Put(p[:cap(p)])
+		return
+	case c.readCh <- packet{p: p, addr: clientID.Addr()}:
+		return
+	}
+}
+
+func (c *xdnsServer) run() {
+	c.wg.Add(1)
+	go c.recv()
+
+	c.wg.Add(1)
+	go c.send()
+
+	c.wg.Add(1)
+	go c.dr()
+
+	c.wg.Wait()
+	close(c.readCh)
+	close(c.recCh)
+	close(c.drCh)
+	c.fragManager.Close()
+	c.sendManager.Close()
+}
+
+func (c *xdnsServer) recv() {
+	defer c.wg.Done()
+
+	var buf [512]byte
+	backoff := time.Duration(0)
+	for {
+		n, addr, err := c.PacketConn.ReadFrom(buf[:])
+		if err != nil {
+			if c.closed() || goerrors.Is(err, net.ErrClosed) {
+				return
+			}
+			// One failed read must not stop the server; back off so a
+			// persistent error cannot spin a core.
+			backoff = backoff * 2
+			if backoff < recvBackoffMin {
+				backoff = recvBackoffMin
+			}
+			if backoff > recvBackoffMax {
+				backoff = recvBackoffMax
+			}
+			log.Warnln("[finalmask] xdns: recv failed, retrying in %s: %v", backoff, err)
+			select {
+			case <-c.closeCh:
+				return
+			case <-time.After(backoff):
+			}
+			continue
+		}
+		backoff = 0
+		c.read(buf[:n], addr)
+	}
+}
+
+func (c *xdnsServer) send() {
+	defer c.wg.Done()
+
+	timer := time.NewTimer(maxResponseDelay)
+	timer.Stop()
+	var buf [4096]byte
+	var data [4096]byte
+	var nextRec *Rec
+	for {
+		rec := nextRec
+		nextRec = nil
+
+		if rec == nil {
+			select {
+			case rec = <-c.recCh:
+			case <-c.closeCh:
+				return
+			}
+		}
+
+		ch, stash, ok := c.sendManager.Pop(rec.clientID)
+		if !ok {
+			// The queues are closed: answer at once without data.
+			_, _ = c.PacketConn.WriteTo(rec.resp.Encode(buf[:0], nil), rec.addr)
+			continue
+		}
+		left := rec.resp.cap
+		timer.Reset(maxResponseDelay)
+		var ps [][]byte
+		for {
+			var p []byte
+			select {
+			case p = <-stash:
+			default:
+				select {
+				case p = <-stash:
+				case p = <-ch:
+				default:
+					select {
+					case p = <-stash:
+					case p = <-ch:
+					case <-timer.C:
+					case nextRec = <-c.recCh:
+					}
+				}
+			}
+			if len(p) == 0 {
+				break
+			}
+			timer.Reset(0)
+			left -= 2 + len(p)
+			if left < 0 {
+				if len(ps) == 0 {
+					log.Warnln("[finalmask] xdns: dropping a %d-byte packet, too large for the answer", len(p))
+					break
+				}
+				c.sendManager.Stash(rec.clientID, p)
+				break
+			}
+			ps = append(ps, p)
+		}
+		timer.Stop()
+
+		d := data[:0]
+		for i := range ps {
+			l := len(ps[i])
+			if i == len(ps)-1 {
+				l |= 0xC000
+			}
+			d = append(d, byte(l>>8), byte(l))
+			d = append(d, ps[i]...)
+		}
+		_, _ = c.PacketConn.WriteTo(rec.resp.Encode(buf[:0], d), rec.addr)
+	}
+}
+
+func (c *xdnsServer) dr() {
+	defer c.wg.Done()
+
+	var buf [512]byte
+	for {
+		select {
+		case <-c.closeCh:
+			return
+		case r := <-c.drCh:
+			b, err := r.msg.AppendPack(buf[:0])
+			if err != nil || len(b) > r.limit {
+				// Unpack expands compressed names, so a question compressed
+				// against bytes that hold no earlier name packs longer than
+				// it was in the query. Answer such a query too, without the
+				// question.
+				formErr := formatError(&r.msg)
+				if b, err = formErr.AppendPack(buf[:0]); err != nil || len(b) > r.limit {
+					continue
+				}
+			}
+			_, _ = c.PacketConn.WriteTo(b, r.addr)
+		}
+	}
+}
+
+// formatError returns the FORMERR sent in place of reply when reply does not
+// fit within its query.
+func formatError(reply *dnsmessage.Message) dnsmessage.Message {
+	formErr := dnsmessage.Message{Header: reply.Header}
+	formErr.Header.RCode = dnsmessage.RCodeFormatError
+	formErr.Header.Authoritative = false
+	for _, additional := range reply.Additionals {
+		if additional.Header.Type == dnsmessage.TypeOPT {
+			opt := additional.Header
+			opt.TTL &^= 0xFF << 24
+			formErr.Additionals = []dnsmessage.Resource{{Header: opt, Body: &dnsmessage.OPTResource{}}}
+			break
+		}
+	}
+	return formErr
+}
+
+func (c *xdnsServer) ReadFrom(p []byte) (n int, addr net.Addr, err error) {
+	packet, ok := <-c.readCh
+	if ok {
+		n = copy(p, packet.p)
+		pool4K.Put(packet.p[:cap(packet.p)])
+		return n, packet.addr, nil
+	}
+	return 0, nil, io.ErrClosedPipe
+}
+
+func (c *xdnsServer) WriteTo(p []byte, addr net.Addr) (n int, err error) {
+	if c.closed() {
+		return 0, io.ErrClosedPipe
+	}
+	if len(p) == 0 || len(p) > 4096 {
+		return 0, goerrors.New("xdns: invalid packet size")
+	}
+	udpAddr, ok := addr.(*net.UDPAddr)
+	if !ok || len(udpAddr.IP) != 16 {
+		return 0, goerrors.New("xdns: not a client address")
+	}
+	c.sendManager.Push(ClientIDFromAddr(udpAddr), p)
+	return len(p), nil
+}
+
+func (c *xdnsServer) Close() error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed() {
+		return nil
+	}
+	close(c.closeCh)
+	_ = c.PacketConn.Close()
+	return nil
+}
+
+func (c *xdnsServer) SetDeadline(t time.Time) error { return nil }
+
+func (c *xdnsServer) SetReadDeadline(t time.Time) error { return nil }
+
+func (c *xdnsServer) SetWriteDeadline(t time.Time) error { return nil }
diff --git a/transport/finalmask/xdns/xdns_test.go b/transport/finalmask/xdns/xdns_test.go
