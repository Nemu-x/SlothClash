+		defer conn.Close()
+		_ = conn.SetDeadline(time.Now().Add(5 * time.Second))
+		go func() { _, _ = conn.Write([]byte("ping")) }()
+		buf := make([]byte, 4)
+		if _, err := io.ReadFull(conn, buf); err == nil && string(buf) == "ping" {
+			t.Fatal("the echo came through a mismatched mask")
+		}
+	})
