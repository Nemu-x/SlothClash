+func TestTCPHandshakeRoundTrip(t *testing.T) {
+	cfg := &TCPConfig{
+		Clients: []*TCPSequence{{Sequence: []*TCPItem{
+			{Packet: []byte("cli")},
+			{Rand: 2, RandMin: 0x10, RandMax: 0x20},
