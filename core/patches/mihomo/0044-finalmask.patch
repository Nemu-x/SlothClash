+package custom
+
+import (
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"net"
+
+	"github.com/metacubex/mihomo/transport/finalmask"
+)
+
+type evalValue struct {
+	bytes   []byte
+	u64     *uint64
+	isBytes bool
+}
+
+type evalContext struct {
+	vars     map[string][]byte
+	metadata map[string]evalValue
+}
+
+func newEvalContext() *evalContext {
+	return &evalContext{
+		vars:     make(map[string][]byte),
+		metadata: make(map[string]evalValue),
+	}
+}
+
+func newEvalContextWithAddrs(local, remote net.Addr) *evalContext {
+	ctx := newEvalContext()
+	loadMetadata(ctx.metadata, "local", local)
+	loadMetadata(ctx.metadata, "remote", remote)
+	return ctx
+}
+
+func evaluateUDPItems(items []*UDPItem) ([]byte, error) {
+	return evaluateUDPItemsWithContext(items, newEvalContext())
+}
+
+func evaluateUDPItemsWithContext(items []*UDPItem, ctx *evalContext) ([]byte, error) {
+	var out []byte
+	for _, item := range items {
+		value, err := evaluateItem(item.Rand, item.RandMin, item.RandMax, item.Packet, item.Save, item.Var, item.Expr, ctx)
+		if err != nil {
+			return nil, err
+		}
+		out = append(out, value...)
+	}
+	return out, nil
+}
+
+func measureUDPItems(items []*UDPItem) (int, error) {
+	return measureUDPItemsWithFallback(items, nil)
+}
+
+func measureUDPItemsWithFallback(items []*UDPItem, fallback map[string]int) (int, error) {
+	sizeCtx := make(map[string]int)
+	for key, value := range fallback {
+		sizeCtx[key] = value
+	}
+	total := 0
+	for _, item := range items {
+		itemSize, err := measureItem(item.Rand, item.Packet, item.Save, item.Var, item.Expr, sizeCtx)
+		if err != nil {
+			return 0, err
+		}
+		total += itemSize
+	}
+	return total, nil
+}
+
+func collectSavedUDPSizes(items []*UDPItem) map[string]int {
+	sizeCtx := make(map[string]int)
+	for _, item := range items {
+		itemSize, err := measureItem(item.Rand, item.Packet, item.Save, item.Var, item.Expr, sizeCtx)
+		if err != nil {
+			continue
+		}
+		if item.Save != "" {
+			sizeCtx[item.Save] = itemSize
+		}
+	}
+	return sizeCtx
+}
+
+func measureItem(randLen int32, packet []byte, save, varName string, expr *Expr, sizeCtx map[string]int) (int, error) {
+	var size int
+	switch {
+	case randLen > 0:
+		size = int(randLen)
+	case len(packet) > 0:
+		size = len(packet)
+	case varName != "":
+		length, ok := sizeCtx[varName]
+		if !ok {
+			return 0, fmt.Errorf("unknown variable: %s", varName)
+		}
+		size = length
+	case expr != nil:
+		exprSize, err := measureExpr(expr, sizeCtx)
+		if err != nil {
+			return 0, err
+		}
+		size = exprSize
+	default:
+		size = 0
+	}
+
+	if save != "" {
+		sizeCtx[save] = size
+	}
+
+	return size, nil
+}
+
+func evaluateItem(randLen, randMin, randMax int32, packet []byte, save, varName string, expr *Expr, ctx *evalContext) ([]byte, error) {
+	var value []byte
+	switch {
+	case randLen > 0:
+		value = make([]byte, randLen)
+		finalmask.RandBytesBetween(value, byte(randMin), byte(randMax))
+	case len(packet) > 0:
+		value = append([]byte(nil), packet...)
+	case varName != "":
+		saved, ok := ctx.vars[varName]
+		if !ok {
+			return nil, fmt.Errorf("unknown variable: %s", varName)
+		}
+		value = append([]byte(nil), saved...)
+	case expr != nil:
+		evaluated, err := evaluateExpr(expr, ctx)
+		if err != nil {
+			return nil, err
+		}
+		bytesValue, err := evaluated.asBytes()
+		if err != nil {
+			return nil, err
+		}
+		value = bytesValue
+	default:
+		value = nil
+	}
+
+	if save != "" {
+		ctx.vars[save] = append([]byte(nil), value...)
+	}
+
+	return value, nil
+}
+
+func evaluateExpr(expr *Expr, ctx *evalContext) (evalValue, error) {
+	switch expr.Op {
+	case "concat":
+		var out []byte
+		for _, arg := range expr.Args {
+			value, err := evaluateExprArg(arg, ctx)
+			if err != nil {
+				return evalValue{}, err
+			}
+			bytesValue, err := value.asBytes()
+			if err != nil {
+				return evalValue{}, err
+			}
+			out = append(out, bytesValue...)
+		}
+		return evalValue{bytes: out, isBytes: true}, nil
+	case "slice":
+		if len(expr.Args) != 3 {
+			return evalValue{}, errors.New("slice expects 3 args")
+		}
+		source, err := evaluateExprArg(expr.Args[0], ctx)
+		if err != nil {
+			return evalValue{}, err
+		}
+		offset, err := evaluateExprArg(expr.Args[1], ctx)
+		if err != nil {
+			return evalValue{}, err
+		}
+		length, err := evaluateExprArg(expr.Args[2], ctx)
+		if err != nil {
+			return evalValue{}, err
+		}
+		sourceBytes, err := source.asBytes()
+		if err != nil {
+			return evalValue{}, err
+		}
+		offsetU64, err := offset.asU64()
+		if err != nil {
+			return evalValue{}, err
+		}
+		lengthU64, err := length.asU64()
+		if err != nil {
+			return evalValue{}, err
+		}
+		end := offsetU64 + lengthU64
+		if end < offsetU64 || end > uint64(len(sourceBytes)) {
+			return evalValue{}, errors.New("slice out of bounds")
+		}
+		return evalValue{bytes: append([]byte(nil), sourceBytes[offsetU64:end]...), isBytes: true}, nil
+	case "xor16":
+		return evaluateXor(expr.Args, 0xFFFF, 2, ctx)
+	case "xor32":
+		return evaluateXor(expr.Args, 0xFFFFFFFF, 4, ctx)
+	case "be16":
+		return evaluatePack(expr.Args, "be16", 2, binary.BigEndian, ctx)
+	case "be32":
+		return evaluatePack(expr.Args, "be32", 4, binary.BigEndian, ctx)
+	case "le16":
+		return evaluatePack(expr.Args, "le16", 2, binary.LittleEndian, ctx)
+	case "le32":
+		return evaluatePack(expr.Args, "le32", 4, binary.LittleEndian, ctx)
+	case "le64":
+		return evaluatePack(expr.Args, "le64", 8, binary.LittleEndian, ctx)
+	case "pad":
+		return evaluatePad(expr.Args, ctx)
+	case "truncate":
+		return evaluateTruncate(expr.Args, ctx)
+	case "add":
+		return evaluateBinaryU64Op(expr.Args, "add", ctx, func(left, right uint64) (uint64, error) {
+			if left > ^uint64(0)-right {
+				return 0, errors.New("add overflow")
+			}
+			return left + right, nil
+		})
+	case "sub":
+		return evaluateBinaryU64Op(expr.Args, "sub", ctx, func(left, right uint64) (uint64, error) {
+			if left < right {
+				return 0, errors.New("sub underflow")
+			}
+			return left - right, nil
+		})
+	case "and":
+		return evaluateBinaryU64Op(expr.Args, "and", ctx, func(left, right uint64) (uint64, error) {
+			return left & right, nil
+		})
+	case "or":
+		return evaluateBinaryU64Op(expr.Args, "or", ctx, func(left, right uint64) (uint64, error) {
+			return left | right, nil
+		})
+	case "shl":
+		return evaluateShift(expr.Args, "shl", ctx, func(value uint64, shift uint) (uint64, error) {
+			if shift >= 64 {
+				return 0, errors.New("shift out of range")
+			}
+			if value > (^uint64(0) >> shift) {
+				return 0, errors.New("shl overflow")
+			}
+			return value << shift, nil
+		})
+	case "shr":
+		return evaluateShift(expr.Args, "shr", ctx, func(value uint64, shift uint) (uint64, error) {
+			if shift >= 64 {
+				return 0, errors.New("shift out of range")
+			}
+			return value >> shift, nil
+		})
+	default:
+		return evalValue{}, fmt.Errorf("unsupported expr op: %s", expr.Op)
+	}
+}
+
+func evaluatePack(args []*ExprArg, name string, width int, order binary.ByteOrder, ctx *evalContext) (evalValue, error) {
+	if len(args) != 1 {
+		return evalValue{}, fmt.Errorf("%s expects 1 arg", name)
+	}
+	value, err := evaluateExprArg(args[0], ctx)
+	if err != nil {
+		return evalValue{}, err
+	}
+	u64Value, err := value.asU64()
+	if err != nil {
+		return evalValue{}, err
+	}
+
+	switch width {
+	case 2:
+		if u64Value > 0xFFFF {
+			return evalValue{}, fmt.Errorf("%s overflow", name)
+		}
+		out := make([]byte, 2)
+		order.PutUint16(out, uint16(u64Value))
+		return evalValue{bytes: out, isBytes: true}, nil
+	case 4:
+		if u64Value > 0xFFFFFFFF {
+			return evalValue{}, fmt.Errorf("%s overflow", name)
+		}
+		out := make([]byte, 4)
+		order.PutUint32(out, uint32(u64Value))
+		return evalValue{bytes: out, isBytes: true}, nil
+	case 8:
+		out := make([]byte, 8)
+		order.PutUint64(out, u64Value)
+		return evalValue{bytes: out, isBytes: true}, nil
+	default:
+		return evalValue{}, errors.New("unsupported pack width")
+	}
+}
+
+func evaluatePad(args []*ExprArg, ctx *evalContext) (evalValue, error) {
+	if len(args) != 3 {
+		return evalValue{}, errors.New("pad expects 3 args")
+	}
+	source, err := evaluateExprArg(args[0], ctx)
+	if err != nil {
+		return evalValue{}, err
+	}
+	target, err := evaluateExprArg(args[1], ctx)
+	if err != nil {
+		return evalValue{}, err
+	}
+	fill, err := evaluateExprArg(args[2], ctx)
+	if err != nil {
+		return evalValue{}, err
+	}
+	sourceBytes, err := source.asBytes()
+	if err != nil {
+		return evalValue{}, err
+	}
+	targetU64, err := target.asU64()
+	if err != nil {
+		return evalValue{}, err
+	}
+	fillBytes, err := fill.asBytes()
+	if err != nil {
+		return evalValue{}, err
+	}
+	if len(fillBytes) == 0 {
+		return evalValue{}, errors.New("pad fill must not be empty")
+	}
+	if targetU64 < uint64(len(sourceBytes)) {
+		return evalValue{}, errors.New("pad target shorter than source")
+	}
+	if targetU64 > finalmask.UDPSize*16 {
+		return evalValue{}, errors.New("pad target too large")
+	}
+
+	out := append([]byte(nil), sourceBytes...)
+	for uint64(len(out)) < targetU64 {
+		remaining := int(targetU64) - len(out)
+		if remaining >= len(fillBytes) {
+			out = append(out, fillBytes...)
+			continue
+		}
+		out = append(out, fillBytes[:remaining]...)
+	}
+	return evalValue{bytes: out, isBytes: true}, nil
+}
+
+func evaluateTruncate(args []*ExprArg, ctx *evalContext) (evalValue, error) {
+	if len(args) != 2 {
+		return evalValue{}, errors.New("truncate expects 2 args")
+	}
+	source, err := evaluateExprArg(args[0], ctx)
+	if err != nil {
+		return evalValue{}, err
+	}
+	length, err := evaluateExprArg(args[1], ctx)
+	if err != nil {
+		return evalValue{}, err
+	}
+	sourceBytes, err := source.asBytes()
+	if err != nil {
+		return evalValue{}, err
+	}
+	lengthU64, err := length.asU64()
+	if err != nil {
+		return evalValue{}, err
+	}
+	if lengthU64 > uint64(len(sourceBytes)) {
+		return evalValue{}, errors.New("truncate out of bounds")
+	}
+	return evalValue{bytes: append([]byte(nil), sourceBytes[:lengthU64]...), isBytes: true}, nil
+}
+
+func evaluateBinaryU64Op(args []*ExprArg, name string, ctx *evalContext, op func(left, right uint64) (uint64, error)) (evalValue, error) {
+	if len(args) != 2 {
+		return evalValue{}, fmt.Errorf("%s expects 2 args", name)
+	}
+	left, err := evaluateExprArg(args[0], ctx)
+	if err != nil {
+		return evalValue{}, err
+	}
+	right, err := evaluateExprArg(args[1], ctx)
+	if err != nil {
+		return evalValue{}, err
+	}
+	leftU64, err := left.asU64()
+	if err != nil {
+		return evalValue{}, err
+	}
+	rightU64, err := right.asU64()
+	if err != nil {
+		return evalValue{}, err
+	}
+	result, err := op(leftU64, rightU64)
+	if err != nil {
+		return evalValue{}, err
+	}
+	return evalValue{u64: &result}, nil
+}
+
+func evaluateShift(args []*ExprArg, name string, ctx *evalContext, op func(value uint64, shift uint) (uint64, error)) (evalValue, error) {
+	if len(args) != 2 {
+		return evalValue{}, fmt.Errorf("%s expects 2 args", name)
+	}
+	value, err := evaluateExprArg(args[0], ctx)
+	if err != nil {
+		return evalValue{}, err
+	}
+	shift, err := evaluateExprArg(args[1], ctx)
+	if err != nil {
+		return evalValue{}, err
+	}
+	valueU64, err := value.asU64()
+	if err != nil {
+		return evalValue{}, err
+	}
+	shiftU64, err := shift.asU64()
+	if err != nil {
+		return evalValue{}, err
+	}
+	if shiftU64 >= 64 {
+		return evalValue{}, errors.New("shift out of range")
+	}
+	result, err := op(valueU64, uint(shiftU64))
+	if err != nil {
+		return evalValue{}, err
+	}
+	return evalValue{u64: &result}, nil
+}
+
+func evaluateXor(args []*ExprArg, mask uint64, width int, ctx *evalContext) (evalValue, error) {
+	if len(args) != 2 {
+		return evalValue{}, errors.New("xor expects 2 args")
+	}
+	left, err := evaluateExprArg(args[0], ctx)
+	if err != nil {
+		return evalValue{}, err
+	}
+	right, err := evaluateExprArg(args[1], ctx)
+	if err != nil {
+		return evalValue{}, err
+	}
+	leftU64, err := left.asU64()
+	if err != nil {
+		return evalValue{}, err
+	}
+	rightU64, err := right.asU64()
+	if err != nil {
+		return evalValue{}, err
+	}
+	if width == 2 && (leftU64 > 0xFFFF || rightU64 > 0xFFFF) {
+		return evalValue{}, errors.New("xor16 overflow")
+	}
+	if width == 4 && (leftU64 > 0xFFFFFFFF || rightU64 > 0xFFFFFFFF) {
+		return evalValue{}, errors.New("xor32 overflow")
+	}
+	result := (leftU64 ^ rightU64) & mask
+	return evalValue{u64: &result}, nil
+}
+
+func measureExpr(expr *Expr, sizeCtx map[string]int) (int, error) {
+	switch expr.Op {
+	case "concat":
+		total := 0
+		for _, arg := range expr.Args {
+			size, err := measureExprArg(arg, sizeCtx)
+			if err != nil {
+				return 0, err
+			}
+			total += size
+		}
+		return total, nil
+	case "slice":
+		if len(expr.Args) != 3 {
+			return 0, errors.New("slice expects 3 args")
+		}
+		if v := expr.Args[2].U64; v != nil {
+			return int(*v), nil
+		}
+		return 0, errors.New("slice length must be u64")
+	case "be16", "le16":
+		return 2, nil
+	case "be32", "le32":
+		return 4, nil
+	case "le64":
+		return 8, nil
+	case "pad":
+		if len(expr.Args) != 3 {
+			return 0, errors.New("pad expects 3 args")
+		}
+		if v := expr.Args[1].U64; v != nil {
+			return int(*v), nil
+		}
+		return 0, errors.New("pad length must be u64")
+	case "truncate":
+		if len(expr.Args) != 2 {
+			return 0, errors.New("truncate expects 2 args")
+		}
+		if v := expr.Args[1].U64; v != nil {
+			return int(*v), nil
+		}
+		return 0, errors.New("truncate length must be u64")
+	default:
+		return 0, fmt.Errorf("expr size is not bytes for op: %s", expr.Op)
+	}
+}
+
+func evaluateExprArg(arg *ExprArg, ctx *evalContext) (evalValue, error) {
+	switch {
+	case arg == nil:
+		return evalValue{}, errors.New("empty expr arg")
+	case arg.Bytes != nil:
+		return evalValue{bytes: append([]byte(nil), arg.Bytes...), isBytes: true}, nil
+	case arg.U64 != nil:
+		v := *arg.U64
+		return evalValue{u64: &v}, nil
+	case arg.Var != "":
+		saved, ok := ctx.vars[arg.Var]
+		if !ok {
+			return evalValue{}, fmt.Errorf("unknown variable: %s", arg.Var)
+		}
+		return evalValue{bytes: append([]byte(nil), saved...), isBytes: true}, nil
+	case arg.Metadata != "":
+		metadata, ok := ctx.metadata[arg.Metadata]
+		if !ok {
+			return evalValue{}, fmt.Errorf("unknown metadata: %s", arg.Metadata)
+		}
+		return metadata, nil
+	case arg.Expr != nil:
+		return evaluateExpr(arg.Expr, ctx)
+	default:
+		return evalValue{}, errors.New("empty expr arg")
+	}
+}
+
+func measureExprArg(arg *ExprArg, sizeCtx map[string]int) (int, error) {
+	switch {
+	case arg == nil:
+		return 0, errors.New("empty expr arg")
+	case arg.Bytes != nil:
+		return len(arg.Bytes), nil
+	case arg.U64 != nil:
+		return 0, errors.New("u64 arg has no byte width")
+	case arg.Var != "":
+		length, ok := sizeCtx[arg.Var]
+		if !ok {
+			return 0, fmt.Errorf("unknown variable: %s", arg.Var)
+		}
+		return length, nil
+	case arg.Metadata != "":
+		return 0, fmt.Errorf("metadata not implemented: %s", arg.Metadata)
+	case arg.Expr != nil:
+		return measureExpr(arg.Expr, sizeCtx)
+	default:
+		return 0, errors.New("empty expr arg")
+	}
+}
+
+func (v evalValue) asBytes() ([]byte, error) {
+	if v.isBytes {
+		return append([]byte(nil), v.bytes...), nil
+	}
+	return nil, errors.New("expr value is not bytes")
+}
+
+func (v evalValue) asU64() (uint64, error) {
+	if v.u64 != nil {
+		return *v.u64, nil
+	}
+	return 0, errors.New("expr value is not u64")
+}
+
+func sizeMapFromEvalContext(ctx *evalContext) map[string]int {
+	sizes := make(map[string]int, len(ctx.vars))
+	for key, value := range ctx.vars {
+		sizes[key] = len(value)
+	}
+	return sizes
+}
+
+func loadMetadata(dst map[string]evalValue, prefix string, addr net.Addr) {
+	if addr == nil {
+		return
+	}
+
+	switch value := addr.(type) {
+	case *net.UDPAddr:
+		loadIPPortMetadata(dst, prefix, value.IP, value.Port)
+	case *net.TCPAddr:
+		loadIPPortMetadata(dst, prefix, value.IP, value.Port)
+	}
+}
+
+func loadIPPortMetadata(dst map[string]evalValue, prefix string, ip net.IP, port int) {
+	portValue := uint64(port)
+	dst[prefix+"_port"] = evalValue{u64: &portValue}
+	if prefix == "remote" {
+		dst["src_port_u16"] = evalValue{u64: &portValue}
+	} else if prefix == "local" {
+		dst["dst_port_u16"] = evalValue{u64: &portValue}
+	}
+
+	if ip4 := ip.To4(); ip4 != nil {
+		ipValue := uint64(binary.BigEndian.Uint32(ip4))
+		dst[prefix+"_ip4_u32"] = evalValue{u64: &ipValue}
+		if prefix == "remote" {
+			dst["src_ip4_u32"] = evalValue{u64: &ipValue}
+		} else if prefix == "local" {
+			dst["dst_ip4_u32"] = evalValue{u64: &ipValue}
+		}
+	}
+}
diff --git a/transport/finalmask/custom/option.go b/transport/finalmask/custom/option.go
new file mode 100644
index 0000000..2a88b5f
--- /dev/null
+++ b/transport/finalmask/custom/option.go
@@ -0,0 +1,362 @@
+package custom
+
+import (
+	"encoding/base64"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"regexp"
+	"strings"
+
+	"github.com/metacubex/mihomo/transport/finalmask"
+)
+
+// Item is one entry of a sequence as written in the config. Packet is the
+// bytes to send or expect: a string (by Type: str, hex, base64) or a list of
+// byte values (Type array, the default); exactly one of Packet, Rand, Reuse
+// and Transform is set. Capture keeps the bytes under a name, Reuse sends or
+// expects a captured one, Transform computes the bytes.
+type Item struct {
+	Delay     finalmask.Range  `proxy:"delay,omitempty"` // TCP only, milliseconds before the item
+	Rand      int32            `proxy:"rand,omitempty"`
+	RandRange *finalmask.Range `proxy:"rand-range,omitempty"` // byte values of Rand, 0-255 by default
+	Capture   string           `proxy:"capture,omitempty"`
+	Type      string           `proxy:"type,omitempty"`
+	Reuse     string           `proxy:"reuse,omitempty"`
+	Transform *Transform       `proxy:"transform,omitempty"`
+	Packet    any              `proxy:"packet,omitempty"`
+}
+
+type Transform struct {
+	Op   string         `proxy:"op"`
+	Args []TransformArg `proxy:"args"`
+}
+
+// TransformArg is one argument; exactly one of Bytes (with Type), U64,
+// Reuse, Metadata and Transform is set.
+type TransformArg struct {
+	Type      string     `proxy:"type,omitempty"`
+	Bytes     any        `proxy:"bytes,omitempty"`
+	U64       *uint64    `proxy:"u64,omitempty"`
+	Reuse     string     `proxy:"reuse,omitempty"`
+	Metadata  string     `proxy:"metadata,omitempty"`
+	Transform *Transform `proxy:"transform,omitempty"`
+}
+
+// TCPOption is the "header-custom" TCP mask as written in the config.
+type TCPOption struct {
+	Clients [][]Item `proxy:"clients,omitempty"`
+	Servers [][]Item `proxy:"servers,omitempty"`
+	Errors  [][]Item `proxy:"errors,omitempty"`
+}
+
+// UDPOption is the "header-custom" UDP mask as written in the config. Mode
+// is "prefix" (the default) or "standalone".
+type UDPOption struct {
+	Mode   string `proxy:"mode,omitempty"`
+	Client []Item `proxy:"client,omitempty"`
+	Server []Item `proxy:"server,omitempty"`
+}
+
+var varNamePattern = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`)
+
+// ParseBytes reads a packet value: a list of byte values, or a string by
+// typ: "str" as is, "hex", "base64"; "" and "array" take either.
+func ParseBytes(value any, typ string) ([]byte, error) {
+	if value == nil {
+		return nil, nil
+	}
+	typ = strings.ToLower(strings.TrimSpace(typ))
+	if list, ok := value.([]any); ok {
+		if typ != "" && typ != "array" {
+			return nil, fmt.Errorf("packet of type %s must be a string", typ)
+		}
+		out := make([]byte, 0, len(list))
+		for _, v := range list {
+			n, ok := toInt(v)
+			if !ok || n < 0 || n > 255 {
+				return nil, fmt.Errorf("invalid byte value %v", v)
+			}
+			out = append(out, byte(n))
+		}
+		return out, nil
+	}
+	str, ok := value.(string)
+	if !ok {
+		if n, isInt := toInt(value); isInt && (typ == "" || typ == "array") {
+			if n < 0 || n > 255 {
+				return nil, fmt.Errorf("invalid byte value %v", value)
+			}
+			return []byte{byte(n)}, nil
+		}
+		return nil, fmt.Errorf("packet must be a string or a list of bytes, got %T", value)
+	}
+	switch typ {
+	case "", "array", "str":
+		return []byte(str), nil
+	case "hex":
+		return hex.DecodeString(strings.TrimPrefix(strings.ReplaceAll(str, " ", ""), "0x"))
+	case "base64":
+		return base64.StdEncoding.DecodeString(str)
+	default:
+		return nil, fmt.Errorf("unknown packet type %q", typ)
+	}
+}
+
+func toInt(v any) (int64, bool) {
+	switch n := v.(type) {
+	case int:
+		return int64(n), true
+	case int64:
+		return n, true
+	case int32:
+		return int64(n), true
+	case uint64:
+		return int64(n), true
+	case uint:
+		return int64(n), true
+	case float64:
+		if n != float64(int64(n)) {
+			return 0, false
+		}
+		return int64(n), true
+	}
+	return 0, false
+}
+
+func validateVarName(name string) error {
+	if name == "" {
+		return nil
+	}
+	if !varNamePattern.MatchString(name) {
+		return fmt.Errorf("invalid variable name %q", name)
+	}
+	return nil
+}
+
+func (it *Item) validate() error {
+	if err := validateVarName(it.Capture); err != nil {
+		return err
+	}
+	if err := validateVarName(it.Reuse); err != nil {
+		return err
+	}
+	kinds := 0
+	if it.Packet != nil {
+		kinds++
+	}
+	if it.Rand > 0 {
+		kinds++
+	}
+	if it.Reuse != "" {
+		kinds++
+	}
+	if it.Transform != nil {
+		kinds++
+	}
+	if kinds > 1 {
+		return errors.New("exactly one of packet, rand, reuse and transform must be set")
+	}
+	if kinds == 0 && it.Capture != "" {
+		return errors.New("capture needs packet, rand, reuse or transform")
+	}
+	return nil
+}
+
+func (it *Item) randRange() (int32, int32, error) {
+	if it.RandRange == nil {
+		return 0, 255, nil
+	}
+	from, to := it.RandRange.From, it.RandRange.To
+	if from > to {
+		from, to = to, from
+	}
+	if from < 0 || to > 255 {
+		return 0, 0, fmt.Errorf("invalid rand-range %s", it.RandRange)
+	}
+	return int32(from), int32(to), nil
+}
+
+func (it *Item) buildTCP() (*TCPItem, error) {
+	if err := it.validate(); err != nil {
+		return nil, err
+	}
+	randMin, randMax, err := it.randRange()
+	if err != nil {
+		return nil, err
+	}
+	packet, err := ParseBytes(it.Packet, it.Type)
+	if err != nil {
+		return nil, err
+	}
+	transform, err := it.Transform.build()
+	if err != nil {
+		return nil, err
+	}
+	delayMin, delayMax := int64(it.Delay.From), int64(it.Delay.To)
+	if delayMin > delayMax {
+		delayMin, delayMax = delayMax, delayMin
+	}
+	return &TCPItem{
+		DelayMin: delayMin,
+		DelayMax: delayMax,
+		Rand:     it.Rand,
+		RandMin:  randMin,
+		RandMax:  randMax,
+		Packet:   packet,
+		Save:     it.Capture,
+		Var:      it.Reuse,
+		Expr:     transform,
+	}, nil
+}
+
+func (it *Item) buildUDP() (*UDPItem, error) {
+	tcp, err := it.buildTCP()
+	if err != nil {
+		return nil, err
+	}
+	return &UDPItem{
+		Rand:    tcp.Rand,
+		RandMin: tcp.RandMin,
+		RandMax: tcp.RandMax,
+		Packet:  tcp.Packet,
+		Save:    tcp.Save,
+		Var:     tcp.Var,
+		Expr:    tcp.Expr,
+	}, nil
+}
+
+func (t *Transform) build() (*Expr, error) {
+	if t == nil {
+		return nil, nil
+	}
+	if t.Op == "" {
+		return nil, errors.New("transform op is required")
+	}
+	if len(t.Args) == 0 {
+		return nil, errors.New("transform args are required")
+	}
+	args := make([]*ExprArg, 0, len(t.Args))
+	for _, arg := range t.Args {
+		built, err := arg.build()
+		if err != nil {
+			return nil, err
+		}
+		args = append(args, built)
+	}
+	return &Expr{Op: t.Op, Args: args}, nil
+}
+
+func (a TransformArg) build() (*ExprArg, error) {
+	kinds := 0
+	if a.Bytes != nil {
+		kinds++
+	}
+	if a.U64 != nil {
+		kinds++
+	}
+	if a.Reuse != "" {
+		kinds++
+	}
+	if a.Metadata != "" {
+		kinds++
+	}
+	if a.Transform != nil {
+		kinds++
+	}
+	if kinds != 1 {
+		return nil, errors.New("transform arg must set exactly one of bytes, u64, reuse, metadata and transform")
+	}
+	switch {
+	case a.Bytes != nil:
+		value, err := ParseBytes(a.Bytes, a.Type)
+		if err != nil {
+			return nil, err
+		}
+		if value == nil {
+			value = []byte{}
+		}
+		return &ExprArg{Bytes: value}, nil
+	case a.U64 != nil:
+		v := *a.U64
+		return &ExprArg{U64: &v}, nil
+	case a.Reuse != "":
+		if err := validateVarName(a.Reuse); err != nil {
+			return nil, err
+		}
+		return &ExprArg{Var: a.Reuse}, nil
+	case a.Metadata != "":
+		return &ExprArg{Metadata: a.Metadata}, nil
+	default:
+		expr, err := a.Transform.build()
+		if err != nil {
+			return nil, err
+		}
+		return &ExprArg{Expr: expr}, nil
+	}
+}
+
+func buildSequences(lists [][]Item) ([]*TCPSequence, error) {
+	out := make([]*TCPSequence, len(lists))
+	for i, list := range lists {
+		out[i] = &TCPSequence{}
+		for j := range list {
+			item, err := list[j].buildTCP()
+			if err != nil {
+				return nil, fmt.Errorf("item %d: %w", j, err)
+			}
+			out[i].Sequence = append(out[i].Sequence, item)
+		}
+	}
+	return out, nil
+}
+
+func buildUDPItems(list []Item) ([]*UDPItem, error) {
+	out := make([]*UDPItem, 0, len(list))
+	for j := range list {
+		item, err := list[j].buildUDP()
+		if err != nil {
+			return nil, fmt.Errorf("item %d: %w", j, err)
+		}
+		out = append(out, item)
+	}
+	return out, nil
+}
+
+// NewTCP builds the TCP mask from its config.
+func NewTCP(o TCPOption) (*TCPConfig, error) {
+	clients, err := buildSequences(o.Clients)
+	if err != nil {
+		return nil, fmt.Errorf("header-custom clients: %w", err)
+	}
+	servers, err := buildSequences(o.Servers)
+	if err != nil {
+		return nil, fmt.Errorf("header-custom servers: %w", err)
+	}
+	errs, err := buildSequences(o.Errors)
+	if err != nil {
+		return nil, fmt.Errorf("header-custom errors: %w", err)
+	}
+	return &TCPConfig{Clients: clients, Servers: servers, Errors: errs}, nil
+}
+
+// NewUDP builds the UDP mask from its config: a *UDPConfig in prefix mode,
+// a *UDPStandaloneConfig in standalone mode.
+func NewUDP(o UDPOption) (finalmask.UDPMask, error) {
+	client, err := buildUDPItems(o.Client)
+	if err != nil {
+		return nil, fmt.Errorf("header-custom client: %w", err)
+	}
+	server, err := buildUDPItems(o.Server)
+	if err != nil {
+		return nil, fmt.Errorf("header-custom server: %w", err)
+	}
+	switch strings.ToLower(o.Mode) {
+	case "", "prefix":
+		return &UDPConfig{Client: client, Server: server}, nil
+	case "standalone":
+		return &UDPStandaloneConfig{Client: client, Server: server}, nil
+	default:
+		return nil, fmt.Errorf("header-custom: unknown udp mode %q, want prefix or standalone", o.Mode)
+	}
+}
diff --git a/transport/finalmask/custom/state.go b/transport/finalmask/custom/state.go
new file mode 100644
index 0000000..477a95a
--- /dev/null
+++ b/transport/finalmask/custom/state.go
@@ -0,0 +1,59 @@
+package custom
+
+import (
+	"sync"
+	"time"
+)
+
+type stateEntry struct {
+	vars      map[string][]byte
+	expiresAt time.Time
+}
+
+// stateStore keeps the captured variables of a peer for a short while, so a
+// later datagram or connection can reuse what an earlier one captured.
+type stateStore struct {
+	mu      sync.Mutex
+	ttl     time.Duration
+	entries map[string]stateEntry
+}
+
+func newStateStore(ttl time.Duration) *stateStore {
+	return &stateStore{
+		ttl:     ttl,
+		entries: make(map[string]stateEntry),
+	}
+}
+
+func (s *stateStore) get(key string) (map[string][]byte, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	entry, ok := s.entries[key]
+	if !ok {
+		return nil, false
+	}
+	if !entry.expiresAt.IsZero() && time.Now().After(entry.expiresAt) {
+		delete(s.entries, key)
+		return nil, false
+	}
+	return cloneVars(entry.vars), true
+}
+
+func (s *stateStore) set(key string, vars map[string][]byte) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	s.entries[key] = stateEntry{
+		vars:      cloneVars(vars),
+		expiresAt: time.Now().Add(s.ttl),
+	}
+}
+
+func cloneVars(vars map[string][]byte) map[string][]byte {
+	cloned := make(map[string][]byte, len(vars))
+	for key, value := range vars {
+		cloned[key] = append([]byte(nil), value...)
+	}
+	return cloned
+}
diff --git a/transport/finalmask/custom/tcp.go b/transport/finalmask/custom/tcp.go
new file mode 100644
index 0000000..f4431d2
--- /dev/null
+++ b/transport/finalmask/custom/tcp.go
@@ -0,0 +1,318 @@
+package custom
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"net"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/metacubex/mihomo/transport/finalmask"
+)
+
+var errHeaderAuth = errors.New("header auth failed")
+
+func (c *TCPConfig) WrapConnClient(_ context.Context, conn net.Conn, _ *finalmask.Destination, _ *finalmask.Dialer) (net.Conn, error) {
+	return NewConnClientTCP(c, conn)
+}
+
+func (c *TCPConfig) WrapConnServer(conn net.Conn) (net.Conn, error) {
+	return NewConnServerTCP(c, conn)
+}
+
+type tcpCustomClient struct {
+	clients []*TCPSequence
+	servers []*TCPSequence
+	state   *stateStore
+}
+
+// tcpCustomClientConn runs the exchange on the first Write and lets the
+// stream through once the server answered as scripted.
+type tcpCustomClientConn struct {
+	net.Conn
+	header *tcpCustomClient
+
+	auth     bool
+	finished atomic.Bool
+	wg       sync.WaitGroup
+	once     sync.Once
+}
+
+func NewConnClientTCP(c *TCPConfig, raw net.Conn) (net.Conn, error) {
+	conn := &tcpCustomClientConn{
+		Conn: raw,
+		header: &tcpCustomClient{
+			clients: c.Clients,
+			servers: c.Servers,
+			state:   newStateStore(5 * time.Second),
+		},
+	}
+
+	conn.wg.Add(1)
+
+	return conn, nil
+}
+
+func (c *tcpCustomClientConn) CloseWrite() error {
+	if _, err := c.Write(nil); err != nil {
+		return err
+	}
+	if closeWriter, ok := c.Conn.(interface{ CloseWrite() error }); ok {
+		return closeWriter.CloseWrite()
+	}
+	return nil
+}
+
+func (c *tcpCustomClientConn) MaskConn() {}
+
+func (c *tcpCustomClientConn) RawConn() net.Conn { return c.Conn }
+
+// Splice is true: after the exchange the stream is the raw one.
+func (c *tcpCustomClientConn) Splice() bool { return true }
+
+func (c *tcpCustomClientConn) Upstream() any { return c.Conn }
+
+// Once the exchange went through, the relay may copy to and from the raw
+// connection directly.
+func (c *tcpCustomClientConn) ReaderReplaceable() bool { return c.finished.Load() && c.auth }
+
+func (c *tcpCustomClientConn) WriterReplaceable() bool { return c.finished.Load() && c.auth }
+
+func (c *tcpCustomClientConn) Read(p []byte) (n int, err error) {
+	c.wg.Wait()
+
+	if !c.auth {
+		return 0, errHeaderAuth
+	}
+
+	return c.Conn.Read(p)
+}
+
+func (c *tcpCustomClientConn) Write(p []byte) (n int, err error) {
+	c.once.Do(func() {
+		defer c.wg.Done()
+		defer c.finished.Store(true)
+		ctx := newEvalContextWithAddrs(c.LocalAddr(), c.RemoteAddr())
+		if vars, ok := c.header.state.get(tcpStateKey(c.LocalAddr(), c.RemoteAddr())); ok {
+			ctx.vars = cloneVars(vars)
+		}
+		j := 0
+		for i := range c.header.clients {
+			if !writeSequenceWithContext(c.Conn, c.header.clients[i], ctx) {
+				return
+			}
+
+			if j < len(c.header.servers) {
+				if !readSequenceWithContext(c.Conn, c.header.servers[j], ctx) {
+					return
+				}
+				j++
+			}
+		}
+
+		for j < len(c.header.servers) {
+			if !readSequenceWithContext(c.Conn, c.header.servers[j], ctx) {
+				return
+			}
+			j++
+		}
+
+		c.header.state.set(tcpStateKey(c.LocalAddr(), c.RemoteAddr()), ctx.vars)
+		c.auth = true
+	})
+
+	c.wg.Wait()
+
+	if !c.auth {
+		return 0, errHeaderAuth
+	}
+
+	return c.Conn.Write(p)
+}
+
+type tcpCustomServer struct {
+	clients []*TCPSequence
+	servers []*TCPSequence
+	errors  []*TCPSequence
+	state   *stateStore
+}
+
+type tcpCustomServerConn struct {
+	net.Conn
+	header *tcpCustomServer
+
+	auth bool
+	wg   sync.WaitGroup
+	once sync.Once
+}
+
+func NewConnServerTCP(c *TCPConfig, raw net.Conn) (net.Conn, error) {
+	conn := &tcpCustomServerConn{
+		Conn: raw,
+		header: &tcpCustomServer{
+			clients: c.Clients,
+			servers: c.Servers,
+			errors:  c.Errors,
+			state:   newStateStore(5 * time.Second),
+		},
+	}
+
+	conn.wg.Add(1)
+
+	return conn, nil
+}
+
+func (c *tcpCustomServerConn) CloseWrite() error {
+	c.wg.Wait()
+	if closeWriter, ok := c.Conn.(interface{ CloseWrite() error }); ok {
+		return closeWriter.CloseWrite()
+	}
+	return nil
+}
+
+func (c *tcpCustomServerConn) MaskConn() {}
+
+func (c *tcpCustomServerConn) RawConn() net.Conn { return c.Conn }
+
+func (c *tcpCustomServerConn) Splice() bool { return true }
+
+func (c *tcpCustomServerConn) Read(p []byte) (n int, err error) {
+	c.once.Do(func() {
+		defer c.wg.Done()
+		ctx := newEvalContextWithAddrs(c.LocalAddr(), c.RemoteAddr())
+		if vars, ok := c.header.state.get(tcpStateKey(c.LocalAddr(), c.RemoteAddr())); ok {
+			ctx.vars = cloneVars(vars)
+		}
+		j := 0
+		for i := range c.header.clients {
+			if !readSequenceWithContext(c.Conn, c.header.clients[i], ctx) {
+				if i < len(c.header.errors) {
+					writeSequenceWithContext(c.Conn, c.header.errors[i], ctx)
+				}
+				return
+			}
+
+			if j < len(c.header.servers) {
+				if !writeSequenceWithContext(c.Conn, c.header.servers[j], ctx) {
+					return
+				}
+				j++
+			}
+		}
+
+		for j < len(c.header.servers) {
+			if !writeSequenceWithContext(c.Conn, c.header.servers[j], ctx) {
+				return
+			}
+			j++
+		}
+
+		c.header.state.set(tcpStateKey(c.LocalAddr(), c.RemoteAddr()), ctx.vars)
+		c.auth = true
+	})
+
+	c.wg.Wait()
+
+	if !c.auth {
+		return 0, errHeaderAuth
+	}
+
+	return c.Conn.Read(p)
+}
+
+func (c *tcpCustomServerConn) Write(p []byte) (n int, err error) {
+	c.wg.Wait()
+
+	if !c.auth {
+		return 0, errHeaderAuth
+	}
+
+	return c.Conn.Write(p)
+}
+
+func readSequenceWithContext(r io.Reader, sequence *TCPSequence, ctx *evalContext) bool {
+	for _, item := range sequence.Sequence {
+		length, err := measureItem(item.Rand, item.Packet, item.Save, item.Var, item.Expr, sizeMapFromEvalContext(ctx))
+		if err != nil {
+			return false
+		}
+		buf := make([]byte, length)
+		n, err := io.ReadFull(r, buf)
+		if err != nil {
+			return false
+		}
+		if n != length {
+			return false
+		}
+		switch {
+		case item.Rand > 0:
+		case len(item.Packet) > 0:
+			if !bytes.Equal(item.Packet, buf[:n]) {
+				return false
+			}
+		case item.Var != "":
+			saved, ok := ctx.vars[item.Var]
+			if !ok || !bytes.Equal(saved, buf[:n]) {
+				return false
+			}
+		case item.Expr != nil:
+			evaluated, err := evaluateExpr(item.Expr, ctx)
+			if err != nil {
+				return false
+			}
+			expected, err := evaluated.asBytes()
+			if err != nil || !bytes.Equal(expected, buf[:n]) {
+				return false
+			}
+		}
+		if item.Save != "" {
+			ctx.vars[item.Save] = append([]byte(nil), buf[:n]...)
+		}
+	}
+	return true
+}
+
+// writeSequenceWithContext writes the sequence, merging items into one write
+// unless an item asks for a delay before it.
+func writeSequenceWithContext(w io.Writer, sequence *TCPSequence, ctx *evalContext) bool {
+	var merged []byte
+	for _, item := range sequence.Sequence {
+		if item.DelayMax > 0 {
+			if len(merged) > 0 {
+				_, err := w.Write(merged)
+				if err != nil {
+					return false
+				}
+				merged = nil
+			}
+			time.Sleep(time.Duration(finalmask.RandBetween(item.DelayMin, item.DelayMax)) * time.Millisecond)
+		}
+		evaluated, err := evaluateItem(item.Rand, item.RandMin, item.RandMax, item.Packet, item.Save, item.Var, item.Expr, ctx)
+		if err != nil {
+			return false
+		}
+		merged = append(merged, evaluated...)
+	}
+	if len(merged) > 0 {
+		_, err := w.Write(merged)
+		if err != nil {
+			return false
+		}
+	}
+	return true
+}
+
+func tcpStateKey(local, remote net.Addr) string {
+	localKey := ""
+	if local != nil {
+		localKey = local.String()
+	}
+	remoteKey := ""
+	if remote != nil {
+		remoteKey = remote.String()
+	}
+	return localKey + "|" + remoteKey
+}
diff --git a/transport/finalmask/custom/udp.go b/transport/finalmask/custom/udp.go
new file mode 100644
index 0000000..e0e7e93
--- /dev/null
+++ b/transport/finalmask/custom/udp.go
@@ -0,0 +1,461 @@
+package custom
+
+import (
+	"bytes"
+	"context"
+	"net"
+	"sync"
+	"time"
+
+	"github.com/metacubex/mihomo/common/pool"
+	"github.com/metacubex/mihomo/log"
+	"github.com/metacubex/mihomo/transport/finalmask"
+)
+
+const udpStandaloneBufferSize = 4096
+
+func (c *UDPConfig) WrapPacketConnClient(_ context.Context, conn net.PacketConn, _ *finalmask.Destination, _ *finalmask.Dialer) (net.PacketConn, error) {
+	return NewConnClientUDP(c, conn)
+}
+
+func (c *UDPConfig) WrapPacketConnServer(conn net.PacketConn) (net.PacketConn, error) {
+	return NewConnServerUDP(c, conn)
+}
+
+func (c *UDPStandaloneConfig) WrapPacketConnClient(_ context.Context, conn net.PacketConn, _ *finalmask.Destination, _ *finalmask.Dialer) (net.PacketConn, error) {
+	return NewConnClientUDPStandalone(c, conn)
+}
+
+func (c *UDPStandaloneConfig) WrapPacketConnServer(conn net.PacketConn) (net.PacketConn, error) {
+	return NewConnServerUDPStandalone(c, conn)
+}
+
+// udpHeader is the prefix of one side: what it writes (own) and what it
+// expects in front of what it reads (peer).
+type udpHeader struct {
+	own    []*UDPItem
+	peer   []*UDPItem
+	merged []byte
+	read   int
+	state  *stateStore
+	vars   map[string][]byte
+}
+
+func (h *udpHeader) match(b []byte, addr net.Addr) bool {
+	var initial map[string][]byte
+	if h.state != nil {
+		initial, _ = h.state.get(udpStateKey(addr))
+	}
+	vars, ok := matchUDPItems(h.peer, b, h.read, initial)
+	if ok {
+		h.vars = vars
+		if h.state != nil {
+			h.state.set(udpStateKey(addr), vars)
+		}
+	}
+	return ok
+}
+
+type udpCustomConn struct {
+	net.PacketConn
+	header *udpHeader
+}
+
+func NewConnClientUDP(c *UDPConfig, raw net.PacketConn) (net.PacketConn, error) {
+	return newUDPCustomConn(raw, c.Client, c.Server, true)
+}
+
+func NewConnServerUDP(c *UDPConfig, raw net.PacketConn) (net.PacketConn, error) {
+	return newUDPCustomConn(raw, c.Client, c.Server, false)
+}
+
+func newUDPCustomConn(raw net.PacketConn, client, server []*UDPItem, isClient bool) (net.PacketConn, error) {
+	own, peer := client, server
+	if !isClient {
+		own, peer = server, client
+	}
+	conn := &udpCustomConn{
+		PacketConn: raw,
+		header: &udpHeader{
+			own:   own,
+			peer:  peer,
+			state: newStateStore(5 * time.Second),
+			vars:  make(map[string][]byte),
+		},
+	}
+	// A variable the client captures in its own header is known to the
+	// server's header only by size; the client sizes its header without a
+	// fallback and the server sizes the client's with one, as Xray does.
+	clientSavedSizes := collectSavedUDPSizes(client)
+	var err error
+	if isClient {
+		conn.header.merged, err = measuredBuffer(measureUDPItems(client))
+		if err != nil {
+			return nil, err
+		}
+		conn.header.read, err = measureUDPItemsWithFallback(server, clientSavedSizes)
+	} else {
+		conn.header.merged, err = measuredBuffer(measureUDPItemsWithFallback(server, clientSavedSizes))
+		if err != nil {
+			return nil, err
+		}
+		conn.header.read, err = measureUDPItems(client)
+	}
+	if err != nil {
+		return nil, err
+	}
+	return conn, nil
+}
+
+func measuredBuffer(size int, err error) ([]byte, error) {
+	if err != nil {
+		return nil, err
+	}
+	return make([]byte, size), nil
+}
+
+func (c *udpCustomConn) ReadFrom(p []byte) (n int, addr net.Addr, err error) {
+	b := p
+	if len(b) < finalmask.UDPSize {
+		buf := pool.Get(finalmask.UDPSize)
+		defer pool.Put(buf)
+		b = buf
+	}
+
+	for {
+		n, addr, err := c.PacketConn.ReadFrom(b)
+		if err != nil {
+			return n, addr, err
+		}
+
+		if !c.header.match(b[:n], addr) {
+			log.Debugln("[finalmask] header-custom: drop packet from %s with size %d: header mismatch", addr, n)
+			continue
+		}
+
+		copy(p, b[c.header.read:n])
+		return n - c.header.read, addr, nil
+	}
+}
+
+func (c *udpCustomConn) WriteTo(p []byte, addr net.Addr) (n int, err error) {
+	buf := pool.Get(finalmask.UDPSize)
+	defer pool.Put(buf)
+
+	ctx := newEvalContextWithAddrs(c.PacketConn.LocalAddr(), addr)
+	if vars, ok := c.header.state.get(udpStateKey(addr)); ok {
+		ctx.vars = cloneVars(vars)
+	} else if len(c.header.vars) > 0 {
+		ctx.vars = cloneVars(c.header.vars)
+	}
+	evaluated, err := evaluateUDPItemsWithContext(c.header.own, ctx)
+	if err != nil {
+		log.Debugln("[finalmask] header-custom: drop packet to %s with size %d: %v", addr, len(p), err)
+		return 0, nil
+	}
+	if len(evaluated) != len(c.header.merged) {
+		log.Debugln("[finalmask] header-custom: drop packet to %s with size %d: header size mismatch", addr, len(p))
+		return 0, nil
+	}
+	if len(evaluated)+len(p) > len(buf) {
+		log.Debugln("[finalmask] header-custom: drop packet to %s with size %d: too large", addr, len(p))
+		return 0, nil
+	}
+	c.header.state.set(udpStateKey(addr), ctx.vars)
+	copy(buf, evaluated)
+	copy(buf[len(evaluated):], p)
+	_, err = c.PacketConn.WriteTo(buf[:len(evaluated)+len(p)], addr)
+	if err != nil {
+		return 0, err
+	}
+
+	return len(p), nil
+}
+
+func matchUDPItems(items []*UDPItem, data []byte, totalSize int, initial map[string][]byte) (map[string][]byte, bool) {
+	if len(data) < totalSize {
+		return nil, false
+	}
+
+	ctx := newEvalContext()
+	ctx.vars = cloneVars(initial)
+	offset := 0
+	for _, item := range items {
+		length, err := measureItem(item.Rand, item.Packet, item.Save, item.Var, item.Expr, sizeMapFromEvalContext(ctx))
+		if err != nil {
+			return nil, false
+		}
+		if len(data[offset:]) < length {
+			return nil, false
+		}
+		segment := append([]byte(nil), data[offset:offset+length]...)
+		switch {
+		case item.Rand > 0:
+		case len(item.Packet) > 0:
+			if !bytes.Equal(item.Packet, segment) {
+				return nil, false
+			}
+		case item.Var != "":
+			saved, ok := ctx.vars[item.Var]
+			if !ok || !bytes.Equal(saved, segment) {
+				return nil, false
+			}
+		case item.Expr != nil:
+			evaluated, err := evaluateExpr(item.Expr, ctx)
+			if err != nil {
+				return nil, false
+			}
+			expected, err := evaluated.asBytes()
+			if err != nil || !bytes.Equal(expected, segment) {
+				return nil, false
+			}
+		}
+		if item.Save != "" {
+			ctx.vars[item.Save] = segment
+		}
+		offset += length
+	}
+
+	return ctx.vars, true
+}
+
+func udpStateKey(addr net.Addr) string {
+	if addr == nil {
+		return ""
+	}
+	return addr.String()
+}
+
+// udpCustomStandaloneClientConn sends the client sequence as a datagram of
+// its own before the first payload to a peer and waits for the server's.
+type udpCustomStandaloneClientConn struct {
+	net.PacketConn
+	client []*UDPItem
+	server []*UDPItem
+	state  *stateStore
+	read   int
+	mu     sync.Mutex
+	once   sync.Once
+	queue  chan udpStandalonePacket
+	wait   map[string]*udpStandaloneWaiter
+}
+
+type udpStandalonePacket struct {
+	data []byte
+	addr net.Addr
+	err  error
+}
+
+type udpStandaloneWaiter struct {
+	vars map[string][]byte
+	done chan error
+}
+
+func NewConnClientUDPStandalone(c *UDPStandaloneConfig, raw net.PacketConn) (net.PacketConn, error) {
+	clientSavedSizes := collectSavedUDPSizes(c.Client)
+	read, err := measureUDPItemsWithFallback(c.Server, clientSavedSizes)
+	if err != nil {
+		return nil, err
+	}
+
+	return &udpCustomStandaloneClientConn{
+		PacketConn: raw,
+		client:     c.Client,
+		server:     c.Server,
+		state:      newStateStore(5 * time.Second),
+		read:       read,
+		queue:      make(chan udpStandalonePacket, 16),
+		wait:       make(map[string]*udpStandaloneWaiter),
+	}, nil
+}
+
+func (c *udpCustomStandaloneClientConn) ReadFrom(p []byte) (n int, addr net.Addr, err error) {
+	c.ensureReader()
+	packet, ok := <-c.queue
+	if !ok {
+		return 0, nil, net.ErrClosed
+	}
+	if packet.err != nil {
+		return 0, packet.addr, packet.err
+	}
+	if len(packet.data) > len(p) {
+		copy(p, packet.data[:len(p)])
+		return len(p), packet.addr, nil
+	}
+	copy(p, packet.data)
+	return len(packet.data), packet.addr, nil
+}
+
+func (c *udpCustomStandaloneClientConn) WriteTo(p []byte, addr net.Addr) (n int, err error) {
+	c.ensureReader()
+	key := udpStateKey(addr)
+	if _, ok := c.state.get(key); !ok {
+		var localAddr net.Addr
+		if c.PacketConn != nil {
+			localAddr = c.PacketConn.LocalAddr()
+		}
+
+		ctx := newEvalContextWithAddrs(localAddr, addr)
+		request, err := evaluateUDPItemsWithContext(c.client, ctx)
+		if err != nil {
+			return 0, err
+		}
+		waiter := c.registerWaiter(key, ctx.vars)
+		if _, err := c.PacketConn.WriteTo(request, addr); err != nil {
+			c.unregisterWaiter(key, waiter)
+			return 0, err
+		}
+		if err := <-waiter.done; err != nil {
+			return 0, err
+		}
+	}
+
+	return c.PacketConn.WriteTo(p, addr)
+}
+
+func (c *udpCustomStandaloneClientConn) ensureReader() {
+	c.once.Do(func() {
+		go c.readerLoop(c.queue)
+	})
+}
+
+func (c *udpCustomStandaloneClientConn) registerWaiter(key string, vars map[string][]byte) *udpStandaloneWaiter {
+	waiter := &udpStandaloneWaiter{
+		vars: cloneVars(vars),
+		done: make(chan error, 1),
+	}
+	c.mu.Lock()
+	c.wait[key] = waiter
+	c.mu.Unlock()
+	return waiter
+}
+
+func (c *udpCustomStandaloneClientConn) unregisterWaiter(key string, waiter *udpStandaloneWaiter) {
+	c.mu.Lock()
+	if c.wait[key] == waiter {
+		delete(c.wait, key)
+	}
+	c.mu.Unlock()
+}
+
+func (c *udpCustomStandaloneClientConn) readerLoop(queue chan udpStandalonePacket) {
+	buf := make([]byte, udpStandaloneBufferSize)
+	for {
+		n, addr, err := c.PacketConn.ReadFrom(buf)
+		if err != nil {
+			c.failWaiters(err)
+			queue <- udpStandalonePacket{addr: addr, err: err}
+			close(queue)
+			return
+		}
+		data := append([]byte(nil), buf[:n]...)
+		if c.tryCompleteHandshake(addr, data) {
+			continue
+		}
+		queue <- udpStandalonePacket{data: data, addr: addr}
+	}
+}
+
+func (c *udpCustomStandaloneClientConn) tryCompleteHandshake(addr net.Addr, data []byte) bool {
+	key := udpStateKey(addr)
+	c.mu.Lock()
+	waiter, ok := c.wait[key]
+	c.mu.Unlock()
+	if !ok || len(data) != c.read {
+		return false
+	}
+
+	vars, matched := matchUDPItems(c.server, data, c.read, waiter.vars)
+	if !matched {
+		return false
+	}
+
+	c.state.set(key, vars)
+	c.mu.Lock()
+	if c.wait[key] == waiter {
+		delete(c.wait, key)
+	}
+	c.mu.Unlock()
+	waiter.done <- nil
+	return true
+}
+
+func (c *udpCustomStandaloneClientConn) failWaiters(err error) {
+	c.mu.Lock()
+	waiters := c.wait
+	c.wait = make(map[string]*udpStandaloneWaiter)
+	c.mu.Unlock()
+	for _, waiter := range waiters {
+		waiter.done <- err
+	}
+}
+
+// udpCustomStandaloneServerConn answers a client sequence with the server
+// one and passes every other datagram through.
+type udpCustomStandaloneServerConn struct {
+	net.PacketConn
+	client []*UDPItem
+	server []*UDPItem
+	state  *stateStore
+	read   int
+}
+
+func NewConnServerUDPStandalone(c *UDPStandaloneConfig, raw net.PacketConn) (net.PacketConn, error) {
+	read, err := measureUDPItems(c.Client)
+	if err != nil {
+		return nil, err
+	}
+
+	return &udpCustomStandaloneServerConn{
+		PacketConn: raw,
+		client:     c.Client,
+		server:     c.Server,
+		state:      newStateStore(5 * time.Second),
+		read:       read,
+	}, nil
+}
+
+func (c *udpCustomStandaloneServerConn) ReadFrom(p []byte) (n int, addr net.Addr, err error) {
+	buf := p
+	copyBack := false
+	if len(buf) < udpStandaloneBufferSize {
+		buf = make([]byte, udpStandaloneBufferSize)
+		copyBack = true
+	}
+
+	for {
+		n, addr, err = c.PacketConn.ReadFrom(buf)
+		if err != nil {
+			return 0, addr, err
+		}
+		if n == c.read {
+			vars, ok := matchUDPItems(c.client, buf[:n], c.read, nil)
+			if ok {
+				var localAddr net.Addr
+				if c.PacketConn != nil {
+					localAddr = c.PacketConn.LocalAddr()
+				}
+				ctx := newEvalContextWithAddrs(localAddr, addr)
+				ctx.vars = cloneVars(vars)
+				response, err := evaluateUDPItemsWithContext(c.server, ctx)
+				if err != nil {
+					return 0, addr, err
+				}
+				if _, err := c.PacketConn.WriteTo(response, addr); err != nil {
+					return 0, addr, err
+				}
+				c.state.set(udpStateKey(addr), ctx.vars)
+				continue
+			}
+		}
+
+		if copyBack {
+			copy(p, buf[:n])
+		}
+		return n, addr, nil
+	}
+}
+
+func (c *udpCustomStandaloneServerConn) WriteTo(p []byte, addr net.Addr) (n int, err error) {
+	return c.PacketConn.WriteTo(p, addr)
+}
diff --git a/transport/finalmask/finalmask.go b/transport/finalmask/finalmask.go
new file mode 100644
index 0000000..94f2381
--- /dev/null
+++ b/transport/finalmask/finalmask.go
@@ -0,0 +1,268 @@
+// Package finalmask ports the finalmask layer of Xray-core (the Jolymmiles
+// fork): a chain of masks applied under the transport, between the socket
+// and TLS, that reshape the bytes on the wire. TCP masks wrap a stream, UDP
+// masks wrap a packet connection.
+//
+// A chain is written as in Xray: the first mask of the list is the outermost
+// (nearest to TLS and the proxy protocol), the last one is the innermost
+// (nearest to the socket), so the last entry is what the network sees.
+//
+// SlothClash core patch 0044: finalmask for vless and trojan.
+// Ported from Prizrak-Core v1.19.34-r4.
+package finalmask
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"net/netip"
+	"strconv"
+)
+
+// UDPSize is the largest datagram a UDP mask carries.
+const UDPSize = 4096
+
+// Dialer opens the base sockets for masks that need their own: udphop opens a
+// new socket on every hop, xdns reaches its resolvers through it. Addresses
+// are host:port, a host may be a domain.
+type Dialer struct {
+	DialTCP func(ctx context.Context, addr string) (net.Conn, error)
+	DialUDP func(ctx context.Context, addr string) (net.PacketConn, net.Addr, error)
+}
+
+// Destination is where the chain dials to. A UDP mask that picks its own
+// remote (udphop) changes it before the base socket is opened.
+type Destination struct {
+	Host string
+	Port uint16
+}
+
+func (d Destination) Addr() string {
+	return net.JoinHostPort(d.Host, strconv.Itoa(int(d.Port)))
+}
+
+// IP returns the destination's address when it is an IP literal.
+func (d Destination) IP() (netip.Addr, bool) {
+	ip, err := netip.ParseAddr(d.Host)
+	return ip, err == nil
+}
+
+// ParseDestination splits a host:port address.
+func ParseDestination(addr string) (Destination, error) {
+	host, port, err := net.SplitHostPort(addr)
+	if err != nil {
+		return Destination{}, err
+	}
+	p, err := strconv.ParseUint(port, 10, 16)
+	if err != nil {
+		return Destination{}, fmt.Errorf("invalid port in %q", addr)
+	}
+	return Destination{Host: host, Port: uint16(p)}, nil
+}
+
+// TCPMask reshapes a TCP stream.
+type TCPMask interface {
+	WrapConnClient(ctx context.Context, conn net.Conn, dest *Destination, dialer *Dialer) (net.Conn, error)
+	WrapConnServer(conn net.Conn) (net.Conn, error)
+}
+
+// UDPMask reshapes a packet connection. A mask that opens the network itself
+// (udphop, xdns, xicmp) also implements DialHandler; it then gets a nil conn
+// and must be the innermost mask of the chain.
+type UDPMask interface {
+	WrapPacketConnClient(ctx context.Context, conn net.PacketConn, dest *Destination, dialer *Dialer) (net.PacketConn, error)
+	WrapPacketConnServer(conn net.PacketConn) (net.PacketConn, error)
+}
+
+// DialHandler marks a UDP mask that opens the network itself instead of
+// wrapping a socket the chain opened.
+type DialHandler interface {
+	HandleDial()
+}
+
+// FinalMask is a chain of TCP masks and a chain of UDP masks.
+type FinalMask struct {
+	// tcp and udp hold the masks innermost first, so wrapping walks them in
+	// order; the config lists them outermost first.
+	tcp []TCPMask
+	udp []UDPMask
+	// err, set by Broken, fails every dial of the chain.
+	err error
+}
+
+// Broken is a chain that fails every dial with err. SlothClash patch 0044: a
+// finalmask block that cannot be used keeps the proxy loaded, as patch 0043
+// does for other options, but the proxy must not dial without its masks.
+func Broken(err error) *FinalMask { return &FinalMask{err: err} }
+
+// Err is the error of a Broken chain.
+func (fm *FinalMask) Err() error {
+	if fm == nil {
+		return nil
+	}
+	return fm.err
+}
+
+// New takes the chains as the config lists them, outermost first.
+func New(tcp []TCPMask, udp []UDPMask) (*FinalMask, error) {
+	fm := &FinalMask{}
+	for i := len(tcp) - 1; i >= 0; i-- {
+		fm.tcp = append(fm.tcp, tcp[i])
+	}
+	for i := len(udp) - 1; i >= 0; i-- {
+		fm.udp = append(fm.udp, udp[i])
+	}
+	for i, mask := range fm.udp {
+		if _, ok := mask.(DialHandler); ok && i > 0 {
+			return nil, fmt.Errorf("finalmask: UDP mask %T opens the network itself, so it must be the last entry of the list", mask)
+		}
+	}
+	return fm, nil
+}
+
+func (fm *FinalMask) HasTCP() bool { return fm != nil && (len(fm.tcp) > 0 || fm.err != nil) }
+
+func (fm *FinalMask) HasUDP() bool { return fm != nil && (len(fm.udp) > 0 || fm.err != nil) }
+
+// WrapConnClient applies the TCP chain to a dialed connection. The chain
+// takes over conn: on an error it is closed.
+func (fm *FinalMask) WrapConnClient(ctx context.Context, conn net.Conn, dest *Destination, dialer *Dialer) (net.Conn, error) {
+	if !fm.HasTCP() {
+		return conn, nil
+	}
+	if dest == nil {
+		dest = &Destination{}
+	}
+	for _, mask := range fm.tcp {
+		wrapped, err := mask.WrapConnClient(ctx, conn, dest, dialer)
+		if err != nil {
+			_ = conn.Close()
+			return nil, err
+		}
+		conn = wrapped
+	}
+	return conn, nil
+}
+
+// DialTCP dials dest through dialer and applies the TCP chain.
+func (fm *FinalMask) DialTCP(ctx context.Context, dest Destination, dialer *Dialer) (net.Conn, error) {
+	conn, err := dialer.DialTCP(ctx, dest.Addr())
+	if err != nil {
+		return nil, err
+	}
+	return fm.WrapConnClient(ctx, conn, &dest, dialer)
+}
+
+// WrapConnServer applies the TCP chain to an accepted connection.
+func (fm *FinalMask) WrapConnServer(conn net.Conn) (net.Conn, error) {
+	for _, mask := range fm.tcp {
+		wrapped, err := mask.WrapConnServer(conn)
+		if err != nil {
+			_ = conn.Close()
+			return nil, err
+		}
+		conn = wrapped
+	}
+	return conn, nil
+}
+
+// DialUDP opens a packet connection to dest through the UDP chain and returns
+// it with the address to send to. Without a chain it is the base socket.
+func (fm *FinalMask) DialUDP(ctx context.Context, dest Destination, dialer *Dialer) (net.PacketConn, net.Addr, error) {
+	if !fm.HasUDP() {
+		return dialer.DialUDP(ctx, dest.Addr())
+	}
+	var conn net.PacketConn
+	var addr net.Addr
+	if _, ok := fm.udp[0].(DialHandler); !ok {
+		var err error
+		conn, addr, err = dialer.DialUDP(ctx, dest.Addr())
+		if err != nil {
+			return nil, nil, err
+		}
+	}
+	for _, mask := range fm.udp {
+		wrapped, err := mask.WrapPacketConnClient(ctx, conn, &dest, dialer)
+		if err != nil {
+			if conn != nil {
+				_ = conn.Close()
+			}
+			return nil, nil, err
+		}
+		conn = wrapped
+	}
+	if addr == nil {
+		// A mask that opened the network itself routes by itself; the
+		// address only has to be a UDP one for the layers above.
+		addr = &net.UDPAddr{IP: net.IPv4zero}
+	}
+	return conn, addr, nil
+}
+
+// WrapPacketConnServer applies the UDP chain to a listening socket.
+func (fm *FinalMask) WrapPacketConnServer(conn net.PacketConn) (net.PacketConn, error) {
+	for _, mask := range fm.udp {
+		if _, ok := mask.(DialHandler); ok && conn == nil {
+			return nil, errors.New("finalmask: this UDP mask has no server side")
+		}
+		wrapped, err := mask.WrapPacketConnServer(conn)
+		if err != nil {
+			if conn != nil {
+				_ = conn.Close()
+			}
+			return nil, err
+		}
+		conn = wrapped
+	}
+	return conn, nil
+}
+
+// MaskConn is implemented by TCP mask connections. Splice reports whether
+// the relay may bypass the wrapper once its work is done (a header that was
+// exchanged, a ClientHello that was split), like Xray's TcpMaskConn.
+type MaskConn interface {
+	MaskConn()
+	RawConn() net.Conn
+	Splice() bool
+}
+
+// Unwrap returns the innermost connection that still has to see the data.
+func Unwrap(conn net.Conn) net.Conn {
+	for {
+		v, ok := conn.(MaskConn)
+		if !ok || !v.Splice() {
+			return conn
+		}
+		conn = v.RawConn()
+	}
+}
+
+// Listener applies the TCP chain to every accepted connection, as Xray's
+// inbound does. A connection the chain refuses is closed and the next one
+// is accepted, so a bad peer does not stop the listener.
+type Listener struct {
+	net.Listener
+	fm *FinalMask
+}
+
+func NewListener(l net.Listener, fm *FinalMask) net.Listener {
+	if !fm.HasTCP() {
+		return l
+	}
+	return &Listener{Listener: l, fm: fm}
+}
+
+func (l *Listener) Accept() (net.Conn, error) {
+	for {
+		conn, err := l.Listener.Accept()
+		if err != nil {
+			return nil, err
+		}
+		wrapped, err := l.fm.WrapConnServer(conn)
+		if err != nil {
+			continue
+		}
+		return wrapped, nil
+	}
+}
diff --git a/transport/finalmask/finalmask_test.go b/transport/finalmask/finalmask_test.go
new file mode 100644
index 0000000..3a25993
--- /dev/null
+++ b/transport/finalmask/finalmask_test.go
@@ -0,0 +1,194 @@
+package finalmask_test
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/transport/finalmask"
+	"github.com/metacubex/mihomo/transport/finalmask/custom"
+	"github.com/metacubex/mihomo/transport/finalmask/fragment"
+	"github.com/metacubex/mihomo/transport/finalmask/noise"
+	"github.com/metacubex/mihomo/transport/finalmask/sudoku"
+	"github.com/metacubex/mihomo/transport/finalmask/xdns"
+
+	"github.com/stretchr/testify/require"
+)
+
+func localDialer() *finalmask.Dialer {
+	return &finalmask.Dialer{
+		DialTCP: func(ctx context.Context, addr string) (net.Conn, error) {
+			return net.Dial("tcp", addr)
+		},
+		DialUDP: func(ctx context.Context, addr string) (net.PacketConn, net.Addr, error) {
+			udpAddr, err := net.ResolveUDPAddr("udp", addr)
+			if err != nil {
+				return nil, nil, err
+			}
+			conn, err := net.ListenPacket("udp", "127.0.0.1:0")
+			return conn, udpAddr, err
+		},
+	}
+}
+
+func tcpChain(t *testing.T) *finalmask.FinalMask {
+	t.Helper()
+	frag, err := fragment.New(fragment.Option{Packets: "1-2", Length: finalmask.Range{From: 10, To: 20}})
+	require.NoError(t, err)
+	sud, err := sudoku.New(sudoku.Config{Password: "chain"})
+	require.NoError(t, err)
+	hdr, err := custom.NewTCP(custom.TCPOption{
+		Clients: [][]custom.Item{{{Packet: "hello", Type: "str"}}},
+		Servers: [][]custom.Item{{{Packet: "world", Type: "str"}}},
+	})
+	require.NoError(t, err)
+	fm, err := finalmask.New([]finalmask.TCPMask{hdr, sud, frag}, nil)
+	require.NoError(t, err)
+	return fm
+}
+
+// The same chain on both ends carries a stream through a listener and a
+// dial, whatever the order of the masks is as long as it is the same.
+func TestTCPChainThroughListener(t *testing.T) {
+	fm := tcpChain(t)
+	raw, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	ln := finalmask.NewListener(raw, fm)
+	defer ln.Close()
+
+	payload := make([]byte, 100*1024)
+	_, _ = rand.Read(payload)
+	served := make(chan error, 1)
+	go func() {
+		conn, err := ln.Accept()
+		if err != nil {
+			served <- err
+			return
+		}
+		defer conn.Close()
+		_ = conn.SetDeadline(time.Now().Add(10 * time.Second))
+		buf := make([]byte, len(payload))
+		if _, err := io.ReadFull(conn, buf); err != nil {
+			served <- err
+			return
+		}
+		_, err = conn.Write(buf)
+		served <- err
+	}()
+
+	dest, err := finalmask.ParseDestination(raw.Addr().String())
+	require.NoError(t, err)
+	conn, err := fm.DialTCP(context.Background(), dest, localDialer())
+	require.NoError(t, err)
+	defer conn.Close()
+	_ = conn.SetDeadline(time.Now().Add(10 * time.Second))
+	go func() { _, _ = conn.Write(payload) }()
+	got := make([]byte, len(payload))
+	_, err = io.ReadFull(conn, got)
+	require.NoError(t, err)
+	require.True(t, bytes.Equal(payload, got))
+	require.NoError(t, <-served)
+}
+
+// A listener survives a connection its chain refuses: the next client gets
+// through, and a plain client does not reach the stream.
+func TestListenerKeepsAcceptingAfterBadPeer(t *testing.T) {
+	fm := tcpChain(t)
+	raw, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	ln := finalmask.NewListener(raw, fm)
+	defer ln.Close()
+
+	results := make(chan string, 2)
+	go func() {
+		for i := 0; i < 2; i++ {
+			conn, err := ln.Accept()
+			if err != nil {
+				results <- "accept: " + err.Error()
+				return
+			}
+			go func() {
+				defer conn.Close()
+				_ = conn.SetDeadline(time.Now().Add(2 * time.Second))
+				buf := make([]byte, 4)
+				if _, err := io.ReadFull(conn, buf); err != nil {
+					results <- "bad"
+					return
+				}
+				results <- string(buf)
+			}()
+		}
+	}()
+
+	plain, err := net.Dial("tcp", raw.Addr().String())
+	require.NoError(t, err)
+	_, _ = plain.Write([]byte("junk that is not the header"))
+	defer plain.Close()
+
+	dest, _ := finalmask.ParseDestination(raw.Addr().String())
+	good, err := fm.DialTCP(context.Background(), dest, localDialer())
+	require.NoError(t, err)
+	defer good.Close()
+	_, err = good.Write([]byte("ping"))
+	require.NoError(t, err)
+
+	seen := map[string]bool{}
+	for i := 0; i < 2; i++ {
+		select {
+		case r := <-results:
+			seen[r] = true
+		case <-time.After(5 * time.Second):
+			t.Fatal("timeout")
+		}
+	}
+	require.True(t, seen["ping"], "%v", seen)
+	require.True(t, seen["bad"], "%v", seen)
+}
+
+func TestUDPChainOrder(t *testing.T) {
+	n, err := noise.New(noise.Option{Noise: []noise.ItemOption{{Rand: finalmask.Range{From: 8, To: 8}}}})
+	require.NoError(t, err)
+	x, err := xdns.New(xdns.Option{
+		Domains:   []xdns.DomainOption{{Names: []string{"t.example.com"}}},
+		Resolvers: []xdns.ResolverOption{{Addrs: []string{"127.0.0.1:1"}}},
+	})
+	require.NoError(t, err)
+	_, err = finalmask.New(nil, []finalmask.UDPMask{x, n})
+	require.Error(t, err, "a mask that opens the network must be last")
+	fm, err := finalmask.New(nil, []finalmask.UDPMask{n, x})
+	require.NoError(t, err)
+	require.True(t, fm.HasUDP())
+	require.False(t, fm.HasTCP())
+	require.False(t, (*finalmask.FinalMask)(nil).HasUDP())
+}
+
+func TestRange(t *testing.T) {
+	var r finalmask.Range
+	require.NoError(t, r.UnmarshalText([]byte("10-20")))
+	require.Equal(t, finalmask.Range{From: 10, To: 20}, r)
+	require.NoError(t, r.UnmarshalText([]byte("7")))
+	require.Equal(t, finalmask.Range{From: 7, To: 7}, r)
+	require.NoError(t, r.UnmarshalText([]byte("-5--1")))
+	require.Equal(t, finalmask.Range{From: -5, To: -1}, r)
+	require.NoError(t, r.UnmarshalText([]byte("")))
+	require.True(t, r.IsZero())
+	require.Error(t, r.UnmarshalText([]byte("a-b")))
+	require.Equal(t, "10-20", finalmask.Range{From: 10, To: 20}.String())
+
+	for i := 0; i < 100; i++ {
+		v := finalmask.RandBetween(5, 8)
+		require.GreaterOrEqual(t, v, int64(5))
+		require.Less(t, v, int64(8))
+	}
+	require.Equal(t, int64(5), finalmask.RandBetween(5, 5))
+	require.Equal(t, int64(5), finalmask.RandBetween(5, 6))
+	b := make([]byte, 256)
+	finalmask.RandBytesBetween(b, 'a', 'f')
+	for _, c := range b {
+		require.True(t, c >= 'a' && c <= 'f')
+	}
+}
diff --git a/transport/finalmask/fragment/fragment.go b/transport/finalmask/fragment/fragment.go
new file mode 100644
index 0000000..126802b
--- /dev/null
+++ b/transport/finalmask/fragment/fragment.go
@@ -0,0 +1,100 @@
+// Package fragment is the "fragment" finalmask of Xray-core: it cuts the
+// first writes of a TCP stream into pieces. The cutting itself is done by
+// transport/fragment, which the freedom outbound uses as well.
+package fragment
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"strings"
+
+	"github.com/metacubex/mihomo/component/fragment"
+	"github.com/metacubex/mihomo/transport/finalmask"
+)
+
+// Option is the mask's settings as written in the config.
+type Option struct {
+	// Packets: "tlshello" splits the first TLS ClientHello into TLS records,
+	// "" splits every write into TCP segments, "N-M" splits writes N to M.
+	Packets string `proxy:"packets,omitempty"`
+	// Length and Delay (milliseconds) are the [min, max) ranges for every
+	// piece; Lengths and Delays give piece i its own range instead, the last
+	// entry serving every later piece.
+	Length   finalmask.Range   `proxy:"length,omitempty"`
+	Delay    finalmask.Range   `proxy:"delay,omitempty"`
+	Lengths  []finalmask.Range `proxy:"lengths,omitempty"`
+	Delays   []finalmask.Range `proxy:"delays,omitempty"`
+	MaxSplit finalmask.Range   `proxy:"max-split,omitempty"`
+	// Interval is Xray's freedom spelling of Delay, taken when Delay is unset.
+	Interval finalmask.Range `proxy:"interval,omitempty"`
+}
+
+type Mask struct {
+	cfg *fragment.Config
+}
+
+func rangeText(r finalmask.Range) string {
+	if r.IsZero() {
+		return ""
+	}
+	return r.String()
+}
+
+// New maps the mask onto component/fragment (SlothClash patch 0032).
+func New(o Option) (*Mask, error) {
+	if len(o.Lengths) > 1 || len(o.Delays) > 1 {
+		return nil, errors.New("fragment: per-piece lengths/delays are not supported")
+	}
+	length, delay := o.Length, o.Delay
+	if len(o.Lengths) == 1 {
+		length = o.Lengths[0]
+	}
+	if len(o.Delays) == 1 {
+		delay = o.Delays[0]
+	}
+	if delay.IsZero() {
+		delay = o.Interval
+	}
+	packets := strings.TrimSpace(o.Packets)
+	if packets == "" {
+		packets = "tlshello"
+	}
+	cfg, err := fragment.Options{Packets: packets, Length: rangeText(length), Delay: rangeText(delay), MaxSplit: rangeText(o.MaxSplit)}.Parse()
+	if err != nil {
+		return nil, fmt.Errorf("finalmask %w", err)
+	}
+	return &Mask{cfg: cfg}, nil
+}
+
+func (m *Mask) WrapConnClient(_ context.Context, conn net.Conn, _ *finalmask.Destination, _ *finalmask.Dialer) (net.Conn, error) {
+	return &maskConn{Conn: fragment.NewConn(conn, m.cfg), raw: conn}, nil
+}
+
+func (m *Mask) WrapConnServer(conn net.Conn) (net.Conn, error) {
+	return &maskConn{Conn: fragment.NewConn(conn, m.cfg), raw: conn}, nil
+}
+
+type maskConn struct {
+	net.Conn
+	raw net.Conn
+}
+
+func (c *maskConn) MaskConn() {}
+
+func (c *maskConn) RawConn() net.Conn { return c.raw }
+
+func (c *maskConn) Splice() bool {
+	if r, ok := c.Conn.(interface{ WriterReplaceable() bool }); ok {
+		return r.WriterReplaceable()
+	}
+	return false
+}
+
+func (c *maskConn) CloseWrite() error {
+	if cw, ok := c.raw.(interface{ CloseWrite() error }); ok {
+		return cw.CloseWrite()
+	}
+	return nil
+}
diff --git a/transport/finalmask/noise/noise.go b/transport/finalmask/noise/noise.go
new file mode 100644
index 0000000..93f005d
--- /dev/null
+++ b/transport/finalmask/noise/noise.go
@@ -0,0 +1,156 @@
+// Package noise is the "noise" finalmask of Xray-core: before the first
+// datagram to a peer, and again after a reset interval, it sends a few
+// datagrams of noise that look like another protocol's handshake.
+package noise
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/binary"
+	"net"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/metacubex/mihomo/transport/finalmask"
+)
+
+type SegmentKind int
+
+const (
+	SegmentBytes SegmentKind = iota
+	SegmentRandom
+	SegmentRandomASCII
+	SegmentRandomDigit
+	SegmentTimestamp
+	SegmentCounter
+	SegmentNonce
+)
+
+// Segment is one part of a composed noise packet.
+type Segment struct {
+	Kind    SegmentKind
+	Bytes   []byte
+	MinSize int64 // random kinds: size in [MinSize, MaxSize]
+	MaxSize int64
+}
+
+// Item is one noise packet: Segments when composed, otherwise RandMin..RandMax
+// random bytes in [RandRangeMin, RandRangeMax], otherwise Packet.
+type Item struct {
+	RandMin, RandMax           int64
+	RandRangeMin, RandRangeMax int32
+	Packet                     []byte
+	DelayMin, DelayMax         int64 // milliseconds after the packet
+	Segments                   []*Segment
+}
+
+type Config struct {
+	ResetMin, ResetMax int64 // seconds; 0 sends the noise once per peer
+	Items              []*Item
+}
+
+const asciiLetters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
+
+func (c *Config) WrapPacketConnClient(_ context.Context, conn net.PacketConn, _ *finalmask.Destination, _ *finalmask.Dialer) (net.PacketConn, error) {
+	return NewConn(c, conn), nil
+}
+
+func (c *Config) WrapPacketConnServer(conn net.PacketConn) (net.PacketConn, error) {
+	return NewConn(c, conn), nil
+}
+
+type noiseConn struct {
+	net.PacketConn
+	config  *Config
+	m       map[string]time.Time
+	mu      sync.Mutex
+	counter atomic.Uint32
+}
+
+func NewConn(c *Config, raw net.PacketConn) net.PacketConn {
+	return &noiseConn{
+		PacketConn: raw,
+		config:     c,
+		m:          make(map[string]time.Time),
+	}
+}
+
+func (c *noiseConn) buildPacket(item *Item) []byte {
+	if len(item.Segments) == 0 {
+		if item.RandMax > 0 {
+			buf := make([]byte, finalmask.RandBetween(item.RandMin, item.RandMax))
+			finalmask.RandBytesBetween(buf, byte(item.RandRangeMin), byte(item.RandRangeMax))
+			return buf
+		}
+		return item.Packet
+	}
+	var out []byte
+	for _, seg := range item.Segments {
+		out = append(out, c.buildSegment(seg)...)
+	}
+	return out
+}
+
+func (c *noiseConn) buildSegment(seg *Segment) []byte {
+	switch seg.Kind {
+	case SegmentBytes:
+		return seg.Bytes
+	case SegmentTimestamp:
+		b := make([]byte, 4)
+		binary.BigEndian.PutUint32(b, uint32(time.Now().Unix()))
+		return b
+	case SegmentCounter:
+		b := make([]byte, 4)
+		binary.BigEndian.PutUint32(b, c.counter.Add(1))
+		return b
+	case SegmentNonce:
+		b := make([]byte, 8)
+		mustRead(b)
+		return b
+	default:
+		size := finalmask.RandBetween(seg.MinSize, seg.MaxSize+1)
+		if size <= 0 {
+			return nil
+		}
+		buf := make([]byte, size)
+		mustRead(buf)
+		switch seg.Kind {
+		case SegmentRandomASCII:
+			for i := range buf {
+				buf[i] = asciiLetters[int(buf[i])%len(asciiLetters)]
+			}
+		case SegmentRandomDigit:
+			for i := range buf {
+				buf[i] = '0' + buf[i]%10
+			}
+		}
+		return buf
+	}
+}
+
+func mustRead(b []byte) {
+	if _, err := rand.Read(b); err != nil {
+		panic(err)
+	}
+}
+
+func (c *noiseConn) WriteTo(p []byte, addr net.Addr) (n int, err error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	t := c.m[addr.String()]
+
+	if t.IsZero() || (c.config.ResetMax > 0 && time.Now().After(t)) {
+		for _, item := range c.config.Items {
+			_, _ = c.PacketConn.WriteTo(c.buildPacket(item), addr)
+			if d := finalmask.RandBetween(item.DelayMin, item.DelayMax); d > 0 {
+				time.Sleep(time.Duration(d) * time.Millisecond)
+			}
+		}
+	}
+
+	c.m[addr.String()] = time.Now().Add(time.Duration(finalmask.RandBetween(c.config.ResetMin, c.config.ResetMax)) * time.Second)
+
+	return c.PacketConn.WriteTo(p, addr)
+}
diff --git a/transport/finalmask/noise/noise_test.go b/transport/finalmask/noise/noise_test.go
new file mode 100644
index 0000000..8542361
--- /dev/null
+++ b/transport/finalmask/noise/noise_test.go
@@ -0,0 +1,169 @@
+package noise
+
+import (
+	"bytes"
+	"encoding/binary"
+	"net"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/transport/finalmask"
+
+	"github.com/stretchr/testify/require"
+)
+
+type fakePacketConn struct {
+	mu      sync.Mutex
+	written [][]byte
+}
+
+func (c *fakePacketConn) WriteTo(p []byte, _ net.Addr) (int, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.written = append(c.written, bytes.Clone(p))
+	return len(p), nil
+}
+
+func (c *fakePacketConn) packets() [][]byte {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.written
+}
+
+func (c *fakePacketConn) ReadFrom(_ []byte) (int, net.Addr, error) { return 0, nil, nil }
+func (c *fakePacketConn) Close() error                             { return nil }
+func (c *fakePacketConn) LocalAddr() net.Addr                      { return &net.UDPAddr{} }
+func (c *fakePacketConn) SetDeadline(time.Time) error              { return nil }
+func (c *fakePacketConn) SetReadDeadline(time.Time) error          { return nil }
+func (c *fakePacketConn) SetWriteDeadline(time.Time) error         { return nil }
+
+func newTestConn() *noiseConn {
+	return NewConn(&Config{}, &fakePacketConn{}).(*noiseConn)
+}
+
+func TestBuildSegments(t *testing.T) {
+	c := newTestConn()
+	require.Equal(t, []byte{0x0d, 0x0a}, c.buildSegment(&Segment{Kind: SegmentBytes, Bytes: []byte{0x0d, 0x0a}}))
+
+	before := time.Now().Unix()
+	ts := c.buildSegment(&Segment{Kind: SegmentTimestamp})
+	require.Len(t, ts, 4)
+	require.GreaterOrEqual(t, int64(binary.BigEndian.Uint32(ts)), before)
+
+	require.Equal(t, uint32(1), binary.BigEndian.Uint32(c.buildSegment(&Segment{Kind: SegmentCounter})))
+	require.Equal(t, uint32(2), binary.BigEndian.Uint32(c.buildSegment(&Segment{Kind: SegmentCounter})))
+
+	a := c.buildSegment(&Segment{Kind: SegmentNonce})
+	b := c.buildSegment(&Segment{Kind: SegmentNonce})
+	require.Len(t, a, 8)
+	require.NotEqual(t, a, b)
+
+	for i := 0; i < 100; i++ {
+		require.Len(t, c.buildSegment(&Segment{Kind: SegmentRandom, MinSize: 24, MaxSize: 24}), 24)
+		n := len(c.buildSegment(&Segment{Kind: SegmentRandom, MinSize: 20, MaxSize: 32}))
+		require.GreaterOrEqual(t, n, 20)
+		require.LessOrEqual(t, n, 32)
+		for _, b := range c.buildSegment(&Segment{Kind: SegmentRandomASCII, MinSize: 40, MaxSize: 40}) {
+			require.True(t, (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z'), "not a letter: %q", b)
+		}
+		for _, b := range c.buildSegment(&Segment{Kind: SegmentRandomDigit, MinSize: 40, MaxSize: 40}) {
+			require.True(t, b >= '0' && b <= '9', "not a digit: %q", b)
+		}
+	}
+}
+
+func TestBuildPacket(t *testing.T) {
+	c := newTestConn()
+	got := c.buildPacket(&Item{Segments: []*Segment{
+		{Kind: SegmentBytes, Bytes: []byte{0x0d, 0x0a, 0x0d, 0x0a}},
+		{Kind: SegmentTimestamp},
+		{Kind: SegmentRandom, MinSize: 24, MaxSize: 24},
+	}})
+	require.Len(t, got, 4+4+24)
+	require.Equal(t, []byte{0x0d, 0x0a, 0x0d, 0x0a}, got[:4])
+
+	require.Equal(t, []byte{1, 2, 3}, c.buildPacket(&Item{Packet: []byte{1, 2, 3}}))
+	require.Len(t, c.buildPacket(&Item{RandMin: 16, RandMax: 17}), 16)
+	for _, b := range c.buildPacket(&Item{RandMin: 64, RandMax: 65, RandRangeMin: 'a', RandRangeMax: 'f'}) {
+		require.True(t, b >= 'a' && b <= 'f')
+	}
+}
+
+func TestWriteToSendsNoiseThenPayload(t *testing.T) {
+	raw := &fakePacketConn{}
+	c := NewConn(&Config{Items: []*Item{
+		{Segments: []*Segment{{Kind: SegmentBytes, Bytes: []byte{0x0d, 0x0a, 0x0d, 0x0a}}, {Kind: SegmentRandom, MinSize: 8, MaxSize: 8}}},
+		{RandMin: 40, RandMax: 41},
+	}}, raw)
+	addr := &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 51820}
+	payload := []byte("real-handshake")
+	_, err := c.WriteTo(payload, addr)
+	require.NoError(t, err)
+
+	sent := raw.packets()
+	require.Len(t, sent, 3)
+	require.Len(t, sent[0], 12)
+	require.Equal(t, []byte{0x0d, 0x0a, 0x0d, 0x0a}, sent[0][:4])
+	require.Len(t, sent[1], 40)
+	require.Equal(t, payload, sent[2])
+
+	// Without a reset the noise is sent once per peer.
+	_, err = c.WriteTo(payload, addr)
+	require.NoError(t, err)
+	require.Len(t, raw.packets(), 4)
+
+	// Another peer gets its own noise.
+	_, err = c.WriteTo(payload, &net.UDPAddr{IP: net.IPv4(127, 0, 0, 2), Port: 1})
+	require.NoError(t, err)
+	require.Len(t, raw.packets(), 7)
+}
+
+func TestParseExp(t *testing.T) {
+	segs, err := ParseExp("<b 0x0d0a> <t><c> <n> <r 24> <rc 8-16> <rd 4>")
+	require.NoError(t, err)
+	require.Len(t, segs, 7)
+	require.Equal(t, []byte{0x0d, 0x0a}, segs[0].Bytes)
+	require.Equal(t, SegmentTimestamp, segs[1].Kind)
+	require.Equal(t, SegmentCounter, segs[2].Kind)
+	require.Equal(t, SegmentNonce, segs[3].Kind)
+	require.Equal(t, int64(24), segs[4].MinSize)
+	require.Equal(t, SegmentRandomASCII, segs[5].Kind)
+	require.Equal(t, int64(8), segs[5].MinSize)
+	require.Equal(t, int64(16), segs[5].MaxSize)
+	require.Equal(t, SegmentRandomDigit, segs[6].Kind)
+
+	for _, bad := range []string{"", "<x 1>", "<r>", "<t 1>", "junk <t>", "<b zz>"} {
+		_, err := ParseExp(bad)
+		require.Error(t, err, bad)
+	}
+}
+
+func TestOption(t *testing.T) {
+	cfg, err := New(Option{
+		Reset: finalmask.Range{From: 10, To: 20},
+		Noise: []ItemOption{
+			{Rand: finalmask.Range{From: 50, To: 100}, RandRange: &finalmask.Range{From: 0x20, To: 0x7e}, Delay: finalmask.Range{From: 10, To: 20}},
+			{Type: "str", Packet: "hello"},
+			{Type: "hex", Packet: "0d0a"},
+			{Type: "exp", Packet: "<b 16> <r 32>"},
+			{Packet: []any{1, 2, 3}},
+		},
+	})
+	require.NoError(t, err)
+	require.Equal(t, int64(10), cfg.ResetMin)
+	require.Equal(t, int64(20), cfg.ResetMax)
+	require.Len(t, cfg.Items, 5)
+	require.Equal(t, int64(50), cfg.Items[0].RandMin)
+	require.Equal(t, int32(0x7e), cfg.Items[0].RandRangeMax)
+	require.Equal(t, int64(20), cfg.Items[0].DelayMax)
+	require.Equal(t, []byte("hello"), cfg.Items[1].Packet)
+	require.Equal(t, []byte{0x0d, 0x0a}, cfg.Items[2].Packet)
+	require.Len(t, cfg.Items[3].Segments, 2)
+	require.Equal(t, []byte{1, 2, 3}, cfg.Items[4].Packet)
+
+	_, err = New(Option{Noise: []ItemOption{{Rand: finalmask.Range{From: 1, To: 2}, Packet: "x"}}})
+	require.Error(t, err)
+	_, err = New(Option{Noise: []ItemOption{{}}})
+	require.Error(t, err)
+}
diff --git a/transport/finalmask/noise/option.go b/transport/finalmask/noise/option.go
new file mode 100644
index 0000000..00467b3
--- /dev/null
+++ b/transport/finalmask/noise/option.go
@@ -0,0 +1,190 @@
+package noise
+
+import (
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"regexp"
+	"strings"
+
+	"github.com/metacubex/mihomo/transport/finalmask"
+	"github.com/metacubex/mihomo/transport/finalmask/custom"
+)
+
+// Option is the mask's settings as written in the config.
+type Option struct {
+	// Reset, in seconds, is how long the noise is not repeated to a peer;
+	// 0 sends it once.
+	Reset finalmask.Range `proxy:"reset,omitempty"`
+	Noise []ItemOption    `proxy:"noise,omitempty"`
+}
+
+// ItemOption is one noise packet. Rand sends that many random bytes in
+// RandRange; Packet sends fixed bytes (Type: str, hex, base64, or a list of
+// byte values); Type "exp" composes the packet from Packet's expression:
+// "<b 0d0a> <t> <c> <n> <r 24> <rc 8-16> <rd 4>" are fixed hex bytes, a
+// 4-byte timestamp, a 4-byte counter, an 8-byte nonce, random bytes, random
+// letters and random digits of the given size.
+type ItemOption struct {
+	Rand      finalmask.Range  `proxy:"rand,omitempty"`
+	RandRange *finalmask.Range `proxy:"rand-range,omitempty"`
+	Type      string           `proxy:"type,omitempty"`
+	Packet    any              `proxy:"packet,omitempty"`
+	Delay     finalmask.Range  `proxy:"delay,omitempty"`
+}
+
+func New(o Option) (*Config, error) {
+	items := make([]*Item, 0, len(o.Noise))
+	for i, item := range o.Noise {
+		built, err := item.build()
+		if err != nil {
+			return nil, fmt.Errorf("noise item %d: %w", i, err)
+		}
+		items = append(items, built)
+	}
+	resetMin, resetMax := int64(o.Reset.From), int64(o.Reset.To)
+	if resetMin > resetMax {
+		resetMin, resetMax = resetMax, resetMin
+	}
+	if resetMin < 0 {
+		return nil, errors.New("noise reset can't be negative")
+	}
+	return &Config{ResetMin: resetMin, ResetMax: resetMax, Items: items}, nil
+}
+
+func (it ItemOption) build() (*Item, error) {
+	randMin, randMax := int64(it.Rand.From), int64(it.Rand.To)
+	if randMin > randMax {
+		randMin, randMax = randMax, randMin
+	}
+	if randMin < 0 {
+		return nil, errors.New("rand can't be negative")
+	}
+	delayMin, delayMax := int64(it.Delay.From), int64(it.Delay.To)
+	if delayMin > delayMax {
+		delayMin, delayMax = delayMax, delayMin
+	}
+	if delayMin < 0 {
+		return nil, errors.New("delay can't be negative")
+	}
+	if it.Packet != nil && randMax > 0 {
+		return nil, errors.New("packet and rand are exclusive")
+	}
+	if strings.EqualFold(it.Type, "exp") {
+		exp, ok := it.Packet.(string)
+		if !ok {
+			return nil, errors.New(`packet of type "exp" must be a string`)
+		}
+		segments, err := ParseExp(exp)
+		if err != nil {
+			return nil, err
+		}
+		return &Item{Segments: segments, DelayMin: delayMin, DelayMax: delayMax}, nil
+	}
+	rangeMin, rangeMax := 0, 255
+	if it.RandRange != nil {
+		rangeMin, rangeMax = it.RandRange.From, it.RandRange.To
+		if rangeMin > rangeMax {
+			rangeMin, rangeMax = rangeMax, rangeMin
+		}
+		if rangeMin < 0 || rangeMax > 255 {
+			return nil, fmt.Errorf("invalid rand-range %s", it.RandRange)
+		}
+	}
+	packet, err := custom.ParseBytes(it.Packet, it.Type)
+	if err != nil {
+		return nil, err
+	}
+	if randMax == 0 && len(packet) == 0 {
+		return nil, errors.New("either packet or rand is required")
+	}
+	return &Item{
+		RandMin:      randMin,
+		RandMax:      randMax,
+		RandRangeMin: int32(rangeMin),
+		RandRangeMax: int32(rangeMax),
+		Packet:       packet,
+		DelayMin:     delayMin,
+		DelayMax:     delayMax,
+	}, nil
+}
+
+var expPattern = regexp.MustCompile(`<\s*([a-z]+)(?:\s+([^>]*?))?\s*>`)
+
+// ParseExp reads a composed packet expression, see ItemOption.
+func ParseExp(exp string) ([]*Segment, error) {
+	var segments []*Segment
+	matches := expPattern.FindAllStringSubmatchIndex(exp, -1)
+	last := 0
+	for _, m := range matches {
+		if strings.TrimSpace(exp[last:m[0]]) != "" {
+			return nil, fmt.Errorf("invalid noise exp near %q", exp[last:m[0]])
+		}
+		last = m[1]
+		key := exp[m[2]:m[3]]
+		arg := ""
+		if m[4] >= 0 {
+			arg = exp[m[4]:m[5]]
+		}
+		segment, err := buildSegment(key, arg)
+		if err != nil {
+			return nil, err
+		}
+		segments = append(segments, segment)
+	}
+	if strings.TrimSpace(exp[last:]) != "" {
+		return nil, fmt.Errorf("invalid noise exp near %q", exp[last:])
+	}
+	if len(segments) == 0 {
+		return nil, fmt.Errorf("empty noise exp %q", exp)
+	}
+	return segments, nil
+}
+
+func buildSegment(key, arg string) (*Segment, error) {
+	sizeSegment := func(kind SegmentKind) (*Segment, error) {
+		if arg == "" {
+			return nil, fmt.Errorf("<%s> in noise exp needs a size", key)
+		}
+		lo, hi, err := finalmask.ParseRange(arg)
+		if err != nil {
+			return nil, err
+		}
+		if lo < 0 || hi < lo || hi > 65535 {
+			return nil, fmt.Errorf("invalid size in noise exp: %s", arg)
+		}
+		return &Segment{Kind: kind, MinSize: int64(lo), MaxSize: int64(hi)}, nil
+	}
+	noArg := func(kind SegmentKind) (*Segment, error) {
+		if arg != "" {
+			return nil, fmt.Errorf("<%s> in noise exp takes no argument", key)
+		}
+		return &Segment{Kind: kind}, nil
+	}
+	switch key {
+	case "b":
+		hexStr := strings.TrimPrefix(strings.TrimPrefix(strings.Join(strings.Fields(arg), ""), "0x"), "0X")
+		if len(hexStr) == 0 {
+			return nil, errors.New("empty bytes in noise exp")
+		}
+		raw, err := hex.DecodeString(hexStr)
+		if err != nil {
+			return nil, fmt.Errorf("invalid hex in noise exp %q: %w", arg, err)
+		}
+		return &Segment{Kind: SegmentBytes, Bytes: raw}, nil
+	case "r":
+		return sizeSegment(SegmentRandom)
+	case "rc":
+		return sizeSegment(SegmentRandomASCII)
+	case "rd":
+		return sizeSegment(SegmentRandomDigit)
+	case "t":
+		return noArg(SegmentTimestamp)
+	case "c":
+		return noArg(SegmentCounter)
+	case "n":
+		return noArg(SegmentNonce)
+	default:
+		return nil, fmt.Errorf("unknown <%s> in noise exp", key)
+	}
+}
diff --git a/transport/finalmask/option/option.go b/transport/finalmask/option/option.go
new file mode 100644
index 0000000..72c4b78
--- /dev/null
+++ b/transport/finalmask/option/option.go
@@ -0,0 +1,245 @@
+// Package option reads a finalmask block of the config into the mask
+// chain; the mask types it knows are the registry of the port.
+package option
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+
+	"github.com/metacubex/mihomo/common/structure"
+	"github.com/metacubex/mihomo/transport/finalmask"
+	"github.com/metacubex/mihomo/transport/finalmask/custom"
+	"github.com/metacubex/mihomo/transport/finalmask/fragment"
+	"github.com/metacubex/mihomo/transport/finalmask/noise"
+	"github.com/metacubex/mihomo/transport/finalmask/sudoku"
+	"github.com/metacubex/mihomo/transport/finalmask/udphop"
+	"github.com/metacubex/mihomo/transport/finalmask/xdns"
+	"github.com/metacubex/mihomo/transport/finalmask/xmc"
+)
+
+// ErrXICMPUnsupported is the error of an xicmp entry, see BuildUDPMask.
+var ErrXICMPUnsupported = errors.New("finalmask: xicmp is not supported: its ICMP sockets would bypass interface binding and loop into the TUN")
+
+// Option is the finalmask block of a vless or trojan proxy or listener, as
+// in Xray-core: TCP masks wrap the stream under TLS, UDP masks wrap the QUIC
+// socket of xhttp over HTTP/3. Each entry has a type and the mask's own
+// settings beside it (or under settings, as Xray nests them); the first
+// entry is the outermost mask, the last one is what the network sees.
+type Option struct {
+	TCP []map[string]any `proxy:"tcp,omitempty" inbound:"tcp,omitempty" yaml:"tcp,omitempty" json:"tcp,omitempty"`
+	UDP []map[string]any `proxy:"udp,omitempty" inbound:"udp,omitempty" yaml:"udp,omitempty" json:"udp,omitempty"`
+}
+
+var decoder = structure.NewDecoder(structure.Option{TagName: "proxy", WeaklyTypedInput: true, KeyReplacer: structure.DefaultKeyReplacer})
+
+// maskEntry splits an entry into its type and the settings to decode.
+func maskEntry(entry map[string]any) (string, map[string]any, error) {
+	typ, _ := entry["type"].(string)
+	typ = strings.ToLower(strings.TrimSpace(typ))
+	if typ == "" {
+		return "", nil, errors.New("finalmask: mask without a type")
+	}
+	settings := make(map[string]any, len(entry))
+	for k, v := range entry {
+		if k == "type" {
+			continue
+		}
+		settings[k] = v
+	}
+	if nested, ok := settings["settings"]; ok && len(settings) == 1 {
+		switch nested := nested.(type) {
+		case map[string]any:
+			settings = nested
+		case map[any]any:
+			settings = make(map[string]any, len(nested))
+			for k, v := range nested {
+				settings[fmt.Sprint(k)] = v
+			}
+		case nil:
+			settings = map[string]any{}
+		default:
+			return "", nil, fmt.Errorf("finalmask: settings of %s must be a map", typ)
+		}
+	}
+	return typ, kebabKeys(settings).(map[string]any), nil
+}
+
+// kebabKeys writes the lowerCamelCase keys of Xray-core's JSON (maxSplit,
+// randRange) the way the masks' options are tagged (max-split, rand-range),
+// at every depth, so a finalmask copied verbatim from an Xray config or a
+// panel decodes completely instead of losing those keys silently. Other keys,
+// header names among them, are left as they are. SlothClash patch 0044.
+func kebabKeys(v any) any {
+	switch v := v.(type) {
+	case map[string]any:
+		out := make(map[string]any, len(v))
+		for k, item := range v {
+			out[kebabKey(k)] = kebabKeys(item)
+		}
+		return out
+	case map[any]any:
+		out := make(map[string]any, len(v))
+		for k, item := range v {
+			out[kebabKey(fmt.Sprint(k))] = kebabKeys(item)
+		}
+		return out
+	case []any:
+		out := make([]any, len(v))
+		for i, item := range v {
+			out[i] = kebabKeys(item)
+		}
+		return out
+	}
+	return v
+}
+
+func kebabKey(k string) string {
+	if k == "" || k[0] < 'a' || k[0] > 'z' {
+		return k
+	}
+	camel := false
+	for _, r := range k {
+		switch {
+		case r >= 'A' && r <= 'Z':
+			camel = true
+		case r >= 'a' && r <= 'z', r >= '0' && r <= '9':
+		default:
+			return k
+		}
+	}
+	if !camel {
+		return k
+	}
+	var b strings.Builder
+	for _, r := range k {
+		if r >= 'A' && r <= 'Z' {
+			b.WriteByte('-')
+			r += 'a' - 'A'
+		}
+		b.WriteRune(r)
+	}
+	return b.String()
+}
+
+func decodeMask(settings map[string]any, option any) error {
+	if len(settings) == 0 {
+		return nil
+	}
+	return decoder.Decode(settings, option)
+}
+
+func BuildTCPMask(entry map[string]any) (finalmask.TCPMask, error) {
+	typ, settings, err := maskEntry(entry)
+	if err != nil {
+		return nil, err
+	}
+	switch typ {
+	case "fragment":
+		var o fragment.Option
+		if err := decodeMask(settings, &o); err != nil {
+			return nil, err
+		}
+		return fragment.New(o)
+	case "header-custom":
+		var o custom.TCPOption
+		if err := decodeMask(settings, &o); err != nil {
+			return nil, err
+		}
+		return custom.NewTCP(o)
+	case "sudoku":
+		var o sudoku.Config
+		if err := decodeMask(settings, &o); err != nil {
+			return nil, err
+		}
+		return sudoku.New(o)
+	case "xmc":
+		var o xmc.Option
+		if err := decodeMask(settings, &o); err != nil {
+			return nil, err
+		}
+		return xmc.New(o)
+	case "mkcp-legacy", "salamander", "realm", "noise", "udphop", "xdns", "xicmp":
+		return nil, fmt.Errorf("finalmask: %s is not a TCP mask", typ)
+	default:
+		return nil, fmt.Errorf("finalmask: unknown TCP mask %q, want fragment, header-custom, sudoku or xmc", typ)
+	}
+}
+
+func BuildUDPMask(entry map[string]any) (finalmask.UDPMask, error) {
+	typ, settings, err := maskEntry(entry)
+	if err != nil {
+		return nil, err
+	}
+	switch typ {
+	case "noise":
+		var o noise.Option
+		if err := decodeMask(settings, &o); err != nil {
+			return nil, err
+		}
+		return noise.New(o)
+	case "header-custom":
+		var o custom.UDPOption
+		if err := decodeMask(settings, &o); err != nil {
+			return nil, err
+		}
+		return custom.NewUDP(o)
+	case "sudoku":
+		var o sudoku.Config
+		if err := decodeMask(settings, &o); err != nil {
+			return nil, err
+		}
+		return sudoku.New(o)
+	case "udphop":
+		var o udphop.Option
+		if err := decodeMask(settings, &o); err != nil {
+			return nil, err
+		}
+		return udphop.New(o)
+	case "xdns":
+		var o xdns.Option
+		if err := decodeMask(settings, &o); err != nil {
+			return nil, err
+		}
+		return xdns.New(o)
+	case "xicmp":
+		// SlothClash 0044: refused on every platform. xicmp opens its ICMP
+		// sockets itself (icmp.ListenPacket on the wildcard address), not
+		// through the proxy's dialer, so interface-name, routing-mark and
+		// auto-detect-interface do not apply to them: with TUN and
+		// auto-route the echo requests to the server would enter the
+		// core's own tunnel, which answers echo requests itself. The
+		// package stays for the day its sockets can be bound.
+		return nil, ErrXICMPUnsupported
+	case "mkcp-legacy", "salamander", "realm":
+		return nil, fmt.Errorf("finalmask: the %s UDP mask is not supported", typ)
+	case "fragment", "xmc":
+		return nil, fmt.Errorf("finalmask: %s is not a UDP mask", typ)
+	default:
+		return nil, fmt.Errorf("finalmask: unknown UDP mask %q, want noise, header-custom, sudoku, udphop, xdns or xicmp", typ)
+	}
+}
+
+// Parse builds the chains; nil when the block is absent or empty.
+func (o *Option) Parse() (*finalmask.FinalMask, error) {
+	if o == nil || (len(o.TCP) == 0 && len(o.UDP) == 0) {
+		return nil, nil
+	}
+	tcp := make([]finalmask.TCPMask, 0, len(o.TCP))
+	for i, entry := range o.TCP {
+		mask, err := BuildTCPMask(entry)
+		if err != nil {
+			return nil, fmt.Errorf("finalmask.tcp[%d]: %w", i, err)
+		}
+		tcp = append(tcp, mask)
+	}
+	udp := make([]finalmask.UDPMask, 0, len(o.UDP))
+	for i, entry := range o.UDP {
+		mask, err := BuildUDPMask(entry)
+		if err != nil {
+			return nil, fmt.Errorf("finalmask.udp[%d]: %w", i, err)
+		}
+		udp = append(udp, mask)
+	}
+	return finalmask.New(tcp, udp)
+}
diff --git a/transport/finalmask/option/option_test.go b/transport/finalmask/option/option_test.go
new file mode 100644
index 0000000..40ecece
--- /dev/null
+++ b/transport/finalmask/option/option_test.go
@@ -0,0 +1,169 @@
+package option
+
+import (
+	"testing"
+
+	"github.com/metacubex/mihomo/transport/finalmask/custom"
+	"github.com/metacubex/mihomo/transport/finalmask/fragment"
+	"github.com/metacubex/mihomo/transport/finalmask/noise"
+	"github.com/metacubex/mihomo/transport/finalmask/sudoku"
+	"github.com/metacubex/mihomo/transport/finalmask/udphop"
+	"github.com/metacubex/mihomo/transport/finalmask/xdns"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestParse(t *testing.T) {
+	var none *Option
+	fm, err := none.Parse()
+	require.NoError(t, err)
+	require.Nil(t, fm)
+	require.False(t, fm.HasTCP())
+	require.False(t, fm.HasUDP())
+
+	fm, err = (&Option{}).Parse()
+	require.NoError(t, err)
+	require.Nil(t, fm)
+
+	fm, err = (&Option{
+		TCP: []map[string]any{
+			{"type": "fragment", "packets": "tlshello", "length": "100-200", "delay": "10-20"},
+			{"type": "header-custom", "clients": []any{[]any{map[string]any{"packet": "GET / HTTP/1.1\r\n", "type": "str"}}}},
+			{"type": "sudoku", "password": "p", "custom-tables": []any{"xpxvvpvv"}, "padding-min": 10, "padding-max": 30},
+		},
+		UDP: []map[string]any{
+			{"type": "noise", "noise": []any{map[string]any{"type": "exp", "packet": "<b 0d0a> <r 16>"}}},
+			{"type": "header-custom", "mode": "standalone", "client": []any{map[string]any{"rand": 4, "capture": "txid"}}, "server": []any{map[string]any{"reuse": "txid"}}},
+			{"type": "sudoku", "password": "p"},
+			{"type": "udphop", "mode": "intervalLocal", "interval": "10-20"},
+		},
+	}).Parse()
+	require.NoError(t, err)
+	require.True(t, fm.HasTCP())
+	require.True(t, fm.HasUDP())
+}
+
+// Xray nests the mask's settings under "settings"; that spelling is accepted
+// as well, so a finalmask block can be copied from an Xray config.
+func TestAcceptsXraySettings(t *testing.T) {
+	fm, err := (&Option{
+		TCP: []map[string]any{
+			{"type": "fragment", "settings": map[string]any{"packets": "tlshello", "length": "1-1", "delay": 0}},
+			{"type": "xmc", "settings": map[string]any{
+				"password": "p", "hostname": "mc.example.com",
+				"profiles": []any{map[string]any{"username": "Steve", "uuid": "069a79f4-44e9-4726-a5be-fca90e38aaf5", "textures-value": "v", "textures-signature": "s"}},
+			}},
+		},
+		UDP: []map[string]any{
+			{"type": "noise", "settings": map[string]any{"noise": []any{map[string]any{"rand": "10-20"}}}},
+		},
+	}).Parse()
+	require.NoError(t, err)
+	require.True(t, fm.HasTCP())
+	require.True(t, fm.HasUDP())
+	// xdns must be the last UDP entry: it is the one on the wire.
+	_, err = (&Option{UDP: []map[string]any{
+		{"type": "xdns", "domains": []any{map[string]any{"names": []any{"t.example.com"}}}, "resolvers": []any{map[string]any{"addrs": []any{"1.1.1.1"}}}},
+		{"type": "noise", "noise": []any{map[string]any{"rand": "10-20"}}},
+	}}).Parse()
+	require.Error(t, err)
+	fm, err = (&Option{UDP: []map[string]any{
+		{"type": "noise", "noise": []any{map[string]any{"rand": "10-20"}}},
+		{"type": "xdns", "domains": []any{map[string]any{"names": []any{"t.example.com"}}}, "resolvers": []any{map[string]any{"addrs": []any{"1.1.1.1"}}}},
+	}}).Parse()
+	require.NoError(t, err)
+	require.True(t, fm.HasUDP())
+}
+
+func TestRejects(t *testing.T) {
+	for name, o := range map[string]*Option{
+		"no type":        {TCP: []map[string]any{{"packets": "tlshello"}}},
+		"unknown tcp":    {TCP: []map[string]any{{"type": "nope"}}},
+		"udp as tcp":     {TCP: []map[string]any{{"type": "noise"}}},
+		"tcp as udp":     {UDP: []map[string]any{{"type": "fragment"}}},
+		"mkcp dropped":   {UDP: []map[string]any{{"type": "mkcp-legacy"}}},
+		"salamander":     {UDP: []map[string]any{{"type": "salamander", "password": "x"}}},
+		"realm":          {UDP: []map[string]any{{"type": "realm"}}},
+		"bad fragment":   {TCP: []map[string]any{{"type": "fragment", "packets": "0-1", "length": "1"}}},
+		"bad sudoku":     {TCP: []map[string]any{{"type": "sudoku", "custom-table": "abc"}}},
+		"bad udphop":     {UDP: []map[string]any{{"type": "udphop", "mode": "intervalLocal", "interval": 1}}},
+		"xicmp":          {UDP: []map[string]any{{"type": "xicmp", "settings": map[string]any{"dgram": true, "ips": []any{"10.0.0.1"}}}}},
+		"bad settings":   {TCP: []map[string]any{{"type": "fragment", "settings": "x"}}},
+		"wrong type":     {TCP: []map[string]any{{"type": "fragment", "length": []any{1}}}},
+		"xmc no profile": {TCP: []map[string]any{{"type": "xmc", "password": "p"}}},
+	} {
+		_, err := o.Parse()
+		require.Error(t, err, name)
+	}
+}
+
+// The mask types stay the ones the registry hands out.
+func TestRegistryTypes(t *testing.T) {
+	cases := []struct {
+		entry map[string]any
+		want  any
+		udp   bool
+	}{
+		{map[string]any{"type": "fragment", "length": "1"}, &fragment.Mask{}, false},
+		{map[string]any{"type": "header-custom"}, &custom.TCPConfig{}, false},
+		{map[string]any{"type": "sudoku"}, &sudoku.Config{}, false},
+		{map[string]any{"type": "noise"}, &noise.Config{}, true},
+		{map[string]any{"type": "header-custom"}, &custom.UDPConfig{}, true},
+		{map[string]any{"type": "header-custom", "mode": "standalone"}, &custom.UDPStandaloneConfig{}, true},
+		{map[string]any{"type": "sudoku"}, &sudoku.Config{}, true},
+		{map[string]any{"type": "udphop", "mode": "intervalLocal"}, &udphop.Config{}, true},
+		{map[string]any{"type": "xdns", "domains": []any{map[string]any{"names": []any{"t.example.com"}}}, "resolvers": []any{map[string]any{"addrs": []any{"1.1.1.1"}}}}, &xdns.Config{}, true},
+	}
+	for _, c := range cases {
+		if c.udp {
+			mask, err := BuildUDPMask(c.entry)
+			require.NoError(t, err, c.entry)
+			require.IsType(t, c.want, mask, c.entry)
+		} else {
+			mask, err := BuildTCPMask(c.entry)
+			require.NoError(t, err, c.entry)
+			require.IsType(t, c.want, mask, c.entry)
+		}
+	}
+}
+
+// SlothClash patch 0044: Xray's camelCase keys, as panels copy them.
+func TestXrayCamelCaseKeys(t *testing.T) {
+	if got := kebabKey("maxSplit"); got != "max-split" {
+		t.Fatalf("maxSplit -> %q", got)
+	}
+	for _, k := range []string{"packets", "User-Agent", "rand-range", "x_y", ""} {
+		if got := kebabKey(k); got != k {
+			t.Fatalf("%q -> %q", k, got)
+		}
+	}
+	_, settings, err := maskEntry(map[string]any{"type": "fragment", "settings": map[string]any{
+		"packets": "1-1", "maxSplit": "5", "lengths": []any{"20-40"},
+		"nested": []any{map[string]any{"randRange": "0-255"}},
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if settings["max-split"] != "5" || settings["maxSplit"] != nil {
+		t.Fatalf("settings %v", settings)
+	}
+	if settings["nested"].([]any)[0].(map[string]any)["rand-range"] != "0-255" {
+		t.Fatalf("nested %v", settings["nested"])
+	}
+}
+
+// SlothClash 0044: xicmp is refused on every platform, with or without its
+// settings, before any socket exists: its ICMP sockets would bypass the
+// proxy's dialer (interface binding) and enter the core's own TUN.
+func TestXICMPRefused(t *testing.T) {
+	for _, entry := range []map[string]any{
+		{"type": "xicmp"},
+		{"type": "xicmp", "ips": []any{"10.0.0.1"}},
+		{"type": "xicmp", "settings": map[string]any{"dgram": true, "ips": []any{"10.0.0.1"}}},
+	} {
+		_, err := BuildUDPMask(entry)
+		require.ErrorIs(t, err, ErrXICMPUnsupported, entry)
+		_, err = (&Option{UDP: []map[string]any{entry}}).Parse()
+		require.ErrorIs(t, err, ErrXICMPUnsupported, entry)
+	}
+}
diff --git a/transport/finalmask/sudoku/codec.go b/transport/finalmask/sudoku/codec.go
new file mode 100644
index 0000000..cd36fdd
--- /dev/null
+++ b/transport/finalmask/sudoku/codec.go
@@ -0,0 +1,165 @@
+package sudoku
+
+import (
+	"fmt"
+	"github.com/metacubex/randv2"
+)
+
+var perm4 = [24][4]byte{
+	{0, 1, 2, 3},
+	{0, 1, 3, 2},
+	{0, 2, 1, 3},
+	{0, 2, 3, 1},
+	{0, 3, 1, 2},
+	{0, 3, 2, 1},
+	{1, 0, 2, 3},
+	{1, 0, 3, 2},
+	{1, 2, 0, 3},
+	{1, 2, 3, 0},
+	{1, 3, 0, 2},
+	{1, 3, 2, 0},
+	{2, 0, 1, 3},
+	{2, 0, 3, 1},
+	{2, 1, 0, 3},
+	{2, 1, 3, 0},
+	{2, 3, 0, 1},
+	{2, 3, 1, 0},
+	{3, 0, 1, 2},
+	{3, 0, 2, 1},
+	{3, 1, 0, 2},
+	{3, 1, 2, 0},
+	{3, 2, 0, 1},
+	{3, 2, 1, 0},
+}
+
+// codec is the classic sudoku encoding: every byte becomes the four hints of
+// a 4x4 grid, in a random order, with random padding bytes between them.
+type codec struct {
+	tables        []*table
+	rng           *randv2.Rand
+	paddingChance int
+	tableIndex    int
+}
+
+func newCodec(tables []*table, pMin, pMax int) *codec {
+	if len(tables) == 0 {
+		tables = nil
+	}
+	rng := newSeededRand()
+	return &codec{
+		tables:        tables,
+		rng:           rng,
+		paddingChance: pickPaddingChance(rng, pMin, pMax),
+	}
+}
+
+func pickPaddingChance(rng *randv2.Rand, pMin, pMax int) int {
+	if pMin < 0 {
+		pMin = 0
+	}
+	if pMax < pMin {
+		pMax = pMin
+	}
+	if pMin > 100 {
+		pMin = 100
+	}
+	if pMax > 100 {
+		pMax = 100
+	}
+	if pMax == pMin {
+		return pMin
+	}
+	return pMin + rng.IntN(pMax-pMin+1)
+}
+
+func (c *codec) shouldPad() bool {
+	if c.paddingChance <= 0 {
+		return false
+	}
+	if c.paddingChance >= 100 {
+		return true
+	}
+	return c.rng.IntN(100) < c.paddingChance
+}
+
+func (c *codec) currentTable() *table {
+	if len(c.tables) == 0 {
+		return nil
+	}
+	return c.tables[c.tableIndex%len(c.tables)]
+}
+
+func (c *codec) randomPadding(t *table) byte {
+	pool := t.layout.paddingPool
+	return pool[c.rng.IntN(len(pool))]
+}
+
+func (c *codec) encode(in []byte) ([]byte, error) {
+	if len(in) == 0 {
+		return nil, nil
+	}
+
+	out := make([]byte, 0, len(in)*6+8)
+	for _, b := range in {
+		t := c.currentTable()
+		if t == nil {
+			return nil, fmt.Errorf("sudoku table set missing")
+		}
+		if c.shouldPad() {
+			out = append(out, c.randomPadding(t))
+		}
+
+		enc := t.encode[b]
+		if len(enc) == 0 {
+			return nil, fmt.Errorf("sudoku encode table missing for byte %d", b)
+		}
+
+		hints := enc[c.rng.IntN(len(enc))]
+		perm := perm4[c.rng.IntN(len(perm4))]
+		for _, idx := range perm {
+			if c.shouldPad() {
+				out = append(out, c.randomPadding(t))
+			}
+			out = append(out, hints[idx])
+		}
+		c.tableIndex++
+	}
+
+	if c.shouldPad() {
+		if t := c.currentTable(); t != nil {
+			out = append(out, c.randomPadding(t))
+		}
+	}
+
+	return out, nil
+}
+
+func decodeBytes(tables []*table, tableIndex *int, in []byte, hintBuf []byte, out []byte) ([]byte, []byte, error) {
+	if len(tables) == 0 {
+		return hintBuf, out, fmt.Errorf("sudoku table set missing")
+	}
+	for _, b := range in {
+		t := tables[*tableIndex%len(tables)]
+		if !t.layout.isHint(b) {
+			continue
+		}
+
+		hintBuf = append(hintBuf, b)
+		if len(hintBuf) < 4 {
+			continue
+		}
+
+		keyBytes := sort4([4]byte{hintBuf[0], hintBuf[1], hintBuf[2], hintBuf[3]})
+		key := packKey(keyBytes)
+		decoded, ok := t.decode[key]
+		if !ok {
+			return hintBuf[:0], out, fmt.Errorf("invalid sudoku hint tuple")
+		}
+
+		out = append(out, decoded)
+		hintBuf = hintBuf[:0]
+		*tableIndex++
+	}
+
+	return hintBuf, out, nil
+}
diff --git a/transport/finalmask/sudoku/config.go b/transport/finalmask/sudoku/config.go
new file mode 100644
index 0000000..e429c10
--- /dev/null
+++ b/transport/finalmask/sudoku/config.go
@@ -0,0 +1,71 @@
+// Package sudoku is the "sudoku" finalmask of Xray-core: a pure appearance
+// transform of the bytes on the wire, with no handshake of its own. On TCP
+// the client's writes use the classic encoding and the server's the packed
+// one; UDP datagrams use the classic one.
+package sudoku
+
+import (
+	"context"
+	"net"
+
+	"github.com/metacubex/mihomo/transport/finalmask"
+)
+
+// Config is the mask's settings, as written in the config.
+type Config struct {
+	Password string `proxy:"password,omitempty"`
+	// ASCII: "prefer_entropy" (the default, also "entropy") or
+	// "prefer_ascii" ("ascii").
+	ASCII string `proxy:"ascii,omitempty"`
+	// CustomTable is a bit layout of 8 letters: 2 x, 2 p, 4 v (entropy mode
+	// only); CustomTables rotates several.
+	CustomTable  string   `proxy:"custom-table,omitempty"`
+	CustomTables []string `proxy:"custom-tables,omitempty"`
+	// PaddingMin..PaddingMax is the chance in percent of a padding byte.
+	PaddingMin uint32 `proxy:"padding-min,omitempty"`
+	PaddingMax uint32 `proxy:"padding-max,omitempty"`
+}
+
+// New checks the config by building its tables.
+func New(c Config) (*Config, error) {
+	if _, err := getTables(&c); err != nil {
+		return nil, err
+	}
+	return &c, nil
+}
+
+func (c *Config) WrapConnClient(_ context.Context, conn net.Conn, _ *finalmask.Destination, _ *finalmask.Dialer) (net.Conn, error) {
+	return newPackedDirectionalConn(conn, c, true)
+}
+
+func (c *Config) WrapConnServer(conn net.Conn) (net.Conn, error) {
+	return newPackedDirectionalConn(conn, c, false)
+}
+
+func newPackedDirectionalConn(raw net.Conn, config *Config, readPacked bool) (net.Conn, error) {
+	pureReader, pureWriter, err := newPureReaderWriter(raw, config)
+	if err != nil {
+		return nil, err
+	}
+	packedReader, packedWriter, err := newPackedReaderWriter(raw, config)
+	if err != nil {
+		return nil, err
+	}
+
+	reader, writer := pureReader, pureWriter
+	if readPacked {
+		reader = packedReader
+	} else {
+		writer = packedWriter
+	}
+
+	return newWrappedConn(raw, reader, writer), nil
+}
+
+func (c *Config) WrapPacketConnClient(_ context.Context, conn net.PacketConn, _ *finalmask.Destination, _ *finalmask.Dialer) (net.PacketConn, error) {
+	return NewUDPConn(conn, c)
+}
+
+func (c *Config) WrapPacketConnServer(conn net.PacketConn) (net.PacketConn, error) {
+	return NewUDPConn(conn, c)
+}
diff --git a/transport/finalmask/sudoku/conn_tcp.go b/transport/finalmask/sudoku/conn_tcp.go
new file mode 100644
index 0000000..648db7d
--- /dev/null
+++ b/transport/finalmask/sudoku/conn_tcp.go
@@ -0,0 +1,213 @@
+package sudoku
+
+import (
+	"bufio"
+	"io"
+	"net"
+	"sync"
+
+	"github.com/metacubex/mihomo/transport/finalmask"
+)
+
+const ioBufferSize = 32 * 1024
+
+var _ finalmask.MaskConn = (*wrappedConn)(nil)
+
+type streamDecoder interface {
+	decodeChunk(in []byte, pending []byte) ([]byte, error)
+	reset()
+}
+
+type streamReader struct {
+	reader  *bufio.Reader
+	rawBuf  []byte
+	pending []byte
+	decode  streamDecoder
+	mu      sync.Mutex
+}
+
+func newStreamReader(raw net.Conn, decode streamDecoder) io.Reader {
+	return &streamReader{
+		reader:  bufio.NewReaderSize(raw, ioBufferSize),
+		rawBuf:  make([]byte, ioBufferSize),
+		pending: make([]byte, 0, 4096),
+		decode:  decode,
+	}
+}
+
+func (r *streamReader) Read(p []byte) (int, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	if n, ok := drainPending(p, &r.pending); ok {
+		return n, nil
+	}
+
+	for len(r.pending) == 0 {
+		nr, rErr := r.reader.Read(r.rawBuf)
+		if nr > 0 {
+			var dErr error
+			r.pending, dErr = r.decode.decodeChunk(r.rawBuf[:nr], r.pending)
+			if dErr != nil {
+				return 0, dErr
+			}
+		}
+
+		if rErr != nil {
+			if rErr == io.EOF {
+				r.decode.reset()
+				if len(r.pending) > 0 {
+					break
+				}
+			}
+			return 0, rErr
+		}
+	}
+
+	n, _ := drainPending(p, &r.pending)
+	return n, nil
+}
+
+type streamWriter struct {
+	conn   net.Conn
+	encode func([]byte) ([]byte, error)
+	mu     sync.Mutex
+}
+
+func newStreamWriter(raw net.Conn, encode func([]byte) ([]byte, error)) io.Writer {
+	return &streamWriter{
+		conn:   raw,
+		encode: encode,
+	}
+}
+
+func (w *streamWriter) Write(p []byte) (int, error) {
+	if len(p) == 0 {
+		return 0, nil
+	}
+
+	w.mu.Lock()
+	defer w.mu.Unlock()
+
+	encoded, err := w.encode(p)
+	if err != nil {
+		return 0, err
+	}
+	if err := writeAll(w.conn, encoded); err != nil {
+		return 0, err
+	}
+	return len(p), nil
+}
+
+type wrappedConn struct {
+	net.Conn
+	reader io.Reader
+	writer io.Writer
+}
+
+type closeWriteConn interface {
+	CloseWrite() error
+}
+
+func newWrappedConn(raw net.Conn, reader io.Reader, writer io.Writer) net.Conn {
+	return &wrappedConn{
+		Conn:   raw,
+		reader: reader,
+		writer: writer,
+	}
+}
+
+func (c *wrappedConn) Read(p []byte) (int, error) {
+	return c.reader.Read(p)
+}
+
+func (c *wrappedConn) Write(p []byte) (int, error) {
+	return c.writer.Write(p)
+}
+
+func (c *wrappedConn) MaskConn() {}
+
+func (c *wrappedConn) RawConn() net.Conn {
+	return c.Conn
+}
+
+// Splice is false: sudoku transforms the whole stream.
+func (c *wrappedConn) Splice() bool {
+	return false
+}
+
+func (c *wrappedConn) CloseWrite() error {
+	if raw, ok := c.Conn.(closeWriteConn); ok {
+		return raw.CloseWrite()
+	}
+	return net.ErrClosed
+}
+
+// NewTCPConn encodes both directions with the classic codec.
+func NewTCPConn(raw net.Conn, config *Config) (net.Conn, error) {
+	reader, writer, err := newPureReaderWriter(raw, config)
+	if err != nil {
+		return nil, err
+	}
+	return newWrappedConn(raw, reader, writer), nil
+}
+
+func newPureReaderWriter(raw net.Conn, config *Config) (io.Reader, io.Writer, error) {
+	tables, err := getTables(config)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	pMin, pMax := normalizedPadding(config)
+	c := newCodec(tables, pMin, pMax)
+	return newStreamReader(raw, newHintStreamDecoder(tables)), newStreamWriter(raw, c.encode), nil
+}
+
+type hintStreamDecoder struct {
+	tables     []*table
+	tableIndex int
+	hintBuf    []byte
+}
+
+func newHintStreamDecoder(tables []*table) *hintStreamDecoder {
+	return &hintStreamDecoder{
+		tables:  tables,
+		hintBuf: make([]byte, 0, 4),
+	}
+}
+
+func (d *hintStreamDecoder) decodeChunk(in []byte, pending []byte) ([]byte, error) {
+	var err error
+	d.hintBuf, pending, err = decodeBytes(d.tables, &d.tableIndex, in, d.hintBuf, pending)
+	return pending, err
+}
+
+func (d *hintStreamDecoder) reset() {}
+
+func drainPending(p []byte, pending *[]byte) (int, bool) {
+	if len(*pending) == 0 {
+		return 0, false
+	}
+
+	n := copy(p, *pending)
+	if n >= len(*pending) {
+		*pending = (*pending)[:0]
+		return n, true
+	}
+
+	remaining := len(*pending) - n
+	copy(*pending, (*pending)[n:])
+	*pending = (*pending)[:remaining]
+	return n, true
+}
+
+func writeAll(conn net.Conn, b []byte) error {
+	for len(b) > 0 {
+		n, err := conn.Write(b)
+		if err != nil {
+			return err
+		}
+		b = b[n:]
+	}
+	return nil
+}
diff --git a/transport/finalmask/sudoku/conn_tcp_packed.go b/transport/finalmask/sudoku/conn_tcp_packed.go
new file mode 100644
index 0000000..4a4d86b
--- /dev/null
+++ b/transport/finalmask/sudoku/conn_tcp_packed.go
@@ -0,0 +1,186 @@
+package sudoku
+
+import (
+	"fmt"
+	"io"
+	"net"
+)
+
+// packedEncoder is the downlink encoding: 6 bits per byte on the wire (one
+// hint byte per 6-bit group) instead of 4 hints per byte, with the same
+// padding and layout rotation as the classic codec.
+type packedEncoder struct {
+	layouts    []*byteLayout
+	codec      *codec
+	groupIndex int
+}
+
+func newPackedEncoder(tables []*table, pMin, pMax int) *packedEncoder {
+	layouts := make([]*byteLayout, 0, len(tables))
+	for _, t := range tables {
+		layouts = append(layouts, t.layout)
+	}
+	if len(layouts) == 0 {
+		layouts = append(layouts, entropyLayout())
+	}
+	return &packedEncoder{
+		layouts: layouts,
+		codec:   newCodec(nil, pMin, pMax),
+	}
+}
+
+func (e *packedEncoder) encode(p []byte) ([]byte, error) {
+	out := make([]byte, 0, len(p)*2+8)
+	var bitBuf uint64
+	var bitCount uint8
+
+	for _, b := range p {
+		bitBuf = (bitBuf << 8) | uint64(b)
+		bitCount += 8
+
+		for bitCount >= 6 {
+			bitCount -= 6
+			layout := e.layouts[e.groupIndex%len(e.layouts)]
+			group := byte(bitBuf >> bitCount)
+			out = e.maybePad(out, layout)
+			out = append(out, layout.encodeGroup(group&0x3f))
+			e.groupIndex++
+			if bitCount > 0 {
+				bitBuf &= (uint64(1) << bitCount) - 1
+			} else {
+				bitBuf = 0
+			}
+		}
+	}
+
+	if bitCount > 0 {
+		layout := e.layouts[e.groupIndex%len(e.layouts)]
+		group := byte(bitBuf << (6 - bitCount))
+		out = e.maybePad(out, layout)
+		out = append(out, layout.encodeGroup(group&0x3f))
+		e.groupIndex++
+		nextLayout := e.layouts[e.groupIndex%len(e.layouts)]
+		out = append(out, nextLayout.padMarker)
+	}
+
+	out = e.maybePad(out, e.layouts[e.groupIndex%len(e.layouts)])
+	return out, nil
+}
+
+func (e *packedEncoder) maybePad(out []byte, layout *byteLayout) []byte {
+	if !e.codec.shouldPad() {
+		return out
+	}
+	if len(layout.paddingPool) == 1 {
+		return append(out, layout.paddingPool[0])
+	}
+	for {
+		b := layout.paddingPool[e.codec.rng.IntN(len(layout.paddingPool))]
+		if b != layout.padMarker {
+			return append(out, b)
+		}
+	}
+}
+
+type packedStreamDecoder struct {
+	layouts    []*byteLayout
+	groupIndex int
+	bitBuf     uint64
+	bitCount   int
+}
+
+func (d *packedStreamDecoder) decodeChunk(in []byte, pending []byte) ([]byte, error) {
+	var err error
+	d.bitBuf, d.bitCount, d.groupIndex, pending, err = decodePackedBytes(
+		d.layouts,
+		in,
+		d.bitBuf,
+		d.bitCount,
+		d.groupIndex,
+		pending,
+	)
+	return pending, err
+}
+
+func (d *packedStreamDecoder) reset() {
+	d.bitBuf = 0
+	d.bitCount = 0
+}
+
+// NewPackedTCPConn encodes both directions with the packed codec.
+func NewPackedTCPConn(raw net.Conn, config *Config) (net.Conn, error) {
+	reader, writer, err := newPackedReaderWriter(raw, config)
+	if err != nil {
+		return nil, err
+	}
+	return newWrappedConn(raw, reader, writer), nil
+}
+
+func newPackedReaderWriter(raw net.Conn, config *Config) (io.Reader, io.Writer, error) {
+	tables, err := getTables(config)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	pMin, pMax := normalizedPadding(config)
+	encoder := newPackedEncoder(tables, pMin, pMax)
+	decoder := &packedStreamDecoder{
+		layouts: tablesToLayouts(tables),
+	}
+	return newStreamReader(raw, decoder), newStreamWriter(raw, encoder.encode), nil
+}
+
+func tablesToLayouts(tables []*table) []*byteLayout {
+	layouts := make([]*byteLayout, 0, len(tables))
+	for _, t := range tables {
+		layouts = append(layouts, t.layout)
+	}
+	if len(layouts) == 0 {
+		layouts = append(layouts, entropyLayout())
+	}
+	return layouts
+}
+
+func decodePackedBytes(
+	layouts []*byteLayout,
+	in []byte,
+	bitBuf uint64,
+	bitCount int,
+	groupIndex int,
+	out []byte,
+) (uint64, int, int, []byte, error) {
+	if len(layouts) == 0 {
+		return bitBuf, bitCount, groupIndex, out, fmt.Errorf("sudoku layout set missing")
+	}
+	for _, b := range in {
+		layout := layouts[groupIndex%len(layouts)]
+		if !layout.isHint(b) {
+			if b == layout.padMarker {
+				bitBuf = 0
+				bitCount = 0
+			}
+			continue
+		}
+
+		group, ok := layout.decodeGroup(b)
+		if !ok {
+			return bitBuf, bitCount, groupIndex, out, fmt.Errorf("invalid packed sudoku byte: %d", b)
+		}
+		groupIndex++
+
+		bitBuf = (bitBuf << 6) | uint64(group)
+		bitCount += 6
+
+		for bitCount >= 8 {
+			bitCount -= 8
+			out = append(out, byte(bitBuf>>bitCount))
+			if bitCount > 0 {
+				bitBuf &= (uint64(1) << bitCount) - 1
+			} else {
+				bitBuf = 0
+			}
+		}
+	}
+
+	return bitBuf, bitCount, groupIndex, out, nil
+}
diff --git a/transport/finalmask/sudoku/conn_udp.go b/transport/finalmask/sudoku/conn_udp.go
new file mode 100644
index 0000000..ff22cf2
--- /dev/null
+++ b/transport/finalmask/sudoku/conn_udp.go
@@ -0,0 +1,109 @@
+package sudoku
+
+import (
+	"net"
+	"sync"
+	"time"
+
+	"github.com/metacubex/mihomo/log"
+)
+
+type udpConn struct {
+	conn   net.PacketConn
+	tables []*table
+	pMin   int
+	pMax   int
+
+	readBuf []byte
+
+	readMu  sync.Mutex
+	writeMu sync.Mutex
+}
+
+// NewUDPConn encodes every datagram with the classic codec, restarting at the
+// first table for each one.
+func NewUDPConn(raw net.PacketConn, config *Config) (net.PacketConn, error) {
+	tables, err := getTables(config)
+	if err != nil {
+		return nil, err
+	}
+
+	pMin, pMax := normalizedPadding(config)
+	return &udpConn{
+		conn:    raw,
+		tables:  tables,
+		pMin:    pMin,
+		pMax:    pMax,
+		readBuf: make([]byte, 65535),
+	}, nil
+}
+
+func (c *udpConn) ReadFrom(p []byte) (n int, addr net.Addr, err error) {
+	c.readMu.Lock()
+	defer c.readMu.Unlock()
+
+	for {
+		n, addr, err = c.conn.ReadFrom(c.readBuf)
+		if err != nil {
+			return n, addr, err
+		}
+
+		decoded := make([]byte, 0, n/4+1)
+		hints := make([]byte, 0, 4)
+		tableIndex := 0
+		hints, decoded, err = decodeBytes(c.tables, &tableIndex, c.readBuf[:n], hints, decoded)
+		if err != nil {
+			log.Debugln("[finalmask] sudoku: drop packet from %s with size %d: %v", addr, n, err)
+			continue
+		}
+		if len(hints) != 0 {
+			log.Debugln("[finalmask] sudoku: drop packet from %s with size %d: trailing hints", addr, n)
+			continue
+		}
+		if len(p) < len(decoded) {
+			log.Debugln("[finalmask] sudoku: drop packet from %s with size %d: buffer too small", addr, n)
+			continue
+		}
+		copy(p, decoded)
+		return len(decoded), addr, nil
+	}
+}
+
+func (c *udpConn) WriteTo(p []byte, addr net.Addr) (n int, err error) {
+	c.writeMu.Lock()
+	defer c.writeMu.Unlock()
+
+	// UDP decoding restarts at table 0 for every datagram, so encoding must do the same.
+	encoded, err := newCodec(c.tables, c.pMin, c.pMax).encode(p)
+	if err != nil {
+		log.Debugln("[finalmask] sudoku: drop packet to %s with size %d: %v", addr, len(p), err)
+		return 0, nil
+	}
+
+	_, err = c.conn.WriteTo(encoded, addr)
+	if err != nil {
+		return 0, err
+	}
+
+	return len(p), nil
+}
+
+func (c *udpConn) Close() error {
+	return c.conn.Close()
+}
+
+func (c *udpConn) LocalAddr() net.Addr {
+	return c.conn.LocalAddr()
+}
+
+func (c *udpConn) SetDeadline(t time.Time) error {
+	return c.conn.SetDeadline(t)
+}
+
+func (c *udpConn) SetReadDeadline(t time.Time) error {
+	return c.conn.SetReadDeadline(t)
+}
+
+func (c *udpConn) SetWriteDeadline(t time.Time) error {
+	return c.conn.SetWriteDeadline(t)
+}
diff --git a/transport/finalmask/sudoku/sudoku_test.go b/transport/finalmask/sudoku/sudoku_test.go
