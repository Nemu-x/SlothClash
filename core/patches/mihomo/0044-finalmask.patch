+func TestTCPServerAnswersErrorSequence(t *testing.T) {
+	cfg := &TCPConfig{
+		Clients: []*TCPSequence{{Sequence: []*TCPItem{{Packet: []byte("GET / HTTP/1.1\r\n\r\n")}}}},
+		Servers: []*TCPSequence{{Sequence: []*TCPItem{{Packet: []byte("HTTP/1.1 101\r\n\r\n")}}}},
+		Errors:  []*TCPSequence{{Sequence: []*TCPItem{{Packet: []byte("HTTP/1.1 400\r\n\r\n")}}}},
+	}
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer ln.Close()
+	go func() {
+		raw, err := ln.Accept()
+		if err != nil {
+			return
+		}
+		defer raw.Close()
+		server, _ := cfg.WrapConnServer(raw)
+		_ = server.SetDeadline(time.Now().Add(time.Second))
+		_, _ = server.Read(make([]byte, 1))
+	}()
+	client, err := net.Dial("tcp", ln.Addr().String())
+	require.NoError(t, err)
+	defer client.Close()
+	_ = client.SetDeadline(time.Now().Add(time.Second))
+	// As long as the expected sequence: the server reads all of it before it
+	// answers with the error sequence and closes, so nothing is left unread
+	// and the close is a FIN. A longer request would leave bytes unread, the
+	// close would become an RST, and the client could lose the answer.
+	_, err = client.Write([]byte("GET / HTTP/1.0\r\n\r\n"))
+	require.NoError(t, err)
+	got, _ := io.ReadAll(client)
+	require.True(t, strings.HasPrefix(string(got), "HTTP/1.1 400"), "got %q", got)
+}
