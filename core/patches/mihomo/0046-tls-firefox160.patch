+package config
+
+// SlothClash core patch 0046 at the profile level: client-fingerprint
+// firefox156 / firefox160 and the Xray names load (finalMaskTestNode and
+// parseFinalMaskProfile come from the 0044 test); "firefox" stays valid.
+
+import "testing"
+
+func TestFirefox160FingerprintProfileAccepted(t *testing.T) {
+	fingerprints := []string{"firefox156", "firefox160", "hellofirefox_156", "HelloFirefox_160", "firefox"}
+	var nodes []string
+	for _, fp := range fingerprints {
+		nodes = append(nodes, finalMaskTestNode(fp, "vless", fp, ""))
+	}
+	proxies := parseFinalMaskProfile(t, nodes...)
+	for _, fp := range fingerprints {
+		if _, ok := proxies[fp]; !ok {
+			t.Fatalf("client-fingerprint %s: proxy missing", fp)
+		}
+	}
+}
