+// firefox160 through REALITY: with the hybrid share it passes the XTLS/REALITY
+// key-share gate as itself.
+func TestFirefox160Reality(t *testing.T) {
+	key, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer SetRealityMLKEMPolicy(RealityMLKEMAuto)
+	for _, policy := range []RealityMLKEMPolicy{RealityMLKEMOn, RealityMLKEMOff} {
+		SetRealityMLKEMPolicy(policy)
+		hello := captureRealityHello(t, HelloFirefox160, &RealityConfig{PublicKey: key.PublicKey()})
+		got := parseClientHello(t, hello.Raw)
+		if _, ok := got.extensions[0x001c]; !ok { // record_size_limit: Firefox, not Chrome
+			t.Fatalf("policy %d: REALITY hello is not Firefox", policy)
+		}
+		_, ok := xrayAcceptsKeyShares(hello.KeyShares)
+		if want := policy == RealityMLKEMOn; ok != want {
+			t.Fatalf("policy %d: Xray 26.9.8+ key-share gate = %v, want %v (shares %v)", policy, ok, want, hello.KeyShares)
+		}
+	}
+}
