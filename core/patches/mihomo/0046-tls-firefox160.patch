index 0000000..5982e97
--- /dev/null
+++ b/component/tls/firefox160_test.go
@@ -0,0 +1,229 @@
+package tls
+
+// SlothClash core patch 0046 tests. The fixtures are ClientHello handshake
+// messages of fresh connections of Firefox 156.0 and 160.0, one per line.
+// Ported from Prizrak-Core v1.19.34-r4 (the testdata of its utls fork).
+
+import (
+	"bytes"
+	"crypto/ecdh"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/binary"
+	"encoding/hex"
+	"io"
+	"math/big"
+	"net"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	utls "github.com/metacubex/utls"
+)
+
+func readHelloFixture(t *testing.T, path string) [][]byte {
+	t.Helper()
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var hellos [][]byte
+	for _, line := range strings.Split(string(data), "\n") {
+		line = strings.TrimSpace(line)
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+		raw, err := hex.DecodeString(line)
+		if err != nil {
+			t.Fatal(err)
+		}
+		hellos = append(hellos, raw)
+	}
+	if len(hellos) == 0 {
+		t.Fatalf("%s: no hellos", path)
+	}
+	return hellos
+}
+
+// sniHost reads the host name of a server_name extension.
+func sniHost(t *testing.T, data []byte) string {
+	t.Helper()
+	if len(data) < 5 || data[2] != 0 {
+		t.Fatalf("server_name %x", data)
+	}
+	return string(data[5 : 5+int(binary.BigEndian.Uint16(data[3:]))])
+}
+
+func TestFirefox160MatchesBrowserCapture(t *testing.T) {
+	const (
+		extKeyShare = 51
+		extECH      = 0xfe0d
+	)
+	for _, tc := range []struct {
+		fixture string
+		names   []string
+	}{
+		{"testdata/firefox156_clienthellos.hex", []string{"firefox156", "hellofirefox_156", "HelloFirefox_156"}},
+		{"testdata/firefox160_clienthellos.hex", []string{"firefox160", "hellofirefox_160"}},
+	} {
+		for i, raw := range readHelloFixture(t, tc.fixture) {
+			want := parseClientHello(t, raw)
+			host := sniHost(t, want.extensions[0])
+			for _, name := range tc.names {
+				got := parseClientHello(t, buildRawClientHello(t, name, host))
+
+				if got.version != want.version || got.sessionIDLen != want.sessionIDLen {
+					t.Fatalf("%s %s: version %04x, session ID %d bytes; Firefox sends %04x and %d", name, host, got.version, got.sessionIDLen, want.version, want.sessionIDLen)
+				}
+				if !equalUint16s(got.cipherSuites, want.cipherSuites) {
+					t.Fatalf("%s: cipher suites %04x, Firefox sends %04x", name, got.cipherSuites, want.cipherSuites)
+				}
+				if !bytes.Equal(got.compression, want.compression) {
+					t.Fatalf("%s: compression %x, Firefox sends %x", name, got.compression, want.compression)
+				}
+				// Firefox does not shuffle: the order is part of the fingerprint.
+				if !equalUint16s(got.extensionIDs, want.extensionIDs) {
+					t.Fatalf("%s %s (#%d): extensions %04x, Firefox sends %04x", name, host, i, got.extensionIDs, want.extensionIDs)
+				}
+				for _, id := range want.extensionIDs {
+					g, w := got.extensions[id], want.extensions[id]
+					switch id {
+					case extKeyShare:
+						if gs, ws := keyShareShape(t, g), keyShareShape(t, w); strings.Join(gs, ",") != strings.Join(ws, ",") {
+							t.Fatalf("%s: key shares %v, Firefox sends %v", name, gs, ws)
+						}
+						continue
+					case extECH:
+						// Random AEAD (AES-128-GCM or ChaCha20-Poly1305, the
+						// captures have both), config id, enc and payload:
+						// compare the layout.
+						aead := binary.BigEndian.Uint16(g[3:5])
+						if len(g) != len(w) || !bytes.Equal(g[:3], w[:3]) || (aead != 1 && aead != 3) || !bytes.Equal(g[6:8], w[6:8]) {
+							t.Fatalf("%s: GREASE ECH %x..., %d bytes; Firefox sends %x..., %d bytes", name, g[:8], len(g), w[:8], len(w))
+						}
+						continue
+					}
+					if !bytes.Equal(g, w) {
+						t.Fatalf("%s: extension %04x = %x, Firefox sends %x", name, id, g, w)
+					}
+				}
+			}
+		}
+	}
+}
+
+// NSS draws the GREASE ECH enc uniformly; an X25519 public key never has the
+// top bit of its last byte set.
+func TestFirefox160GreaseECHEncIsUniform(t *testing.T) {
+	const extECH = 0xfe0d
+	topBit := 0
+	for i := 0; i < 64; i++ {
+		got := parseClientHello(t, buildRawClientHello(t, "firefox160", "example.com"))
+		ech := got.extensions[extECH]
+		if binary.BigEndian.Uint16(ech[6:8]) != 32 {
+			t.Fatalf("GREASE ECH enc is %d bytes, want 32", binary.BigEndian.Uint16(ech[6:8]))
+		}
+		if ech[8+31]&0x80 != 0 {
+			topBit++
+		}
+	}
+	if topBit == 0 || topBit == 64 {
+		t.Fatalf("top bit of the enc's last byte set in %d of 64 hellos", topBit)
+	}
+}
+
+// "firefox" keeps mihomo's meaning (Firefox 148): the patch only adds names.
+func TestFirefoxStaysStock(t *testing.T) {
+	id, ok := GetFingerprint("firefox")
+	if !ok || id == HelloFirefox156 || id == HelloFirefox160 {
+		t.Fatalf("firefox is %v", id)
+	}
+	for _, id := range []UClientHelloID{HelloFirefox156, HelloFirefox160} {
+		if !FingerprintSupportsX25519MLKEM768(id) {
+			t.Fatalf("%v: no X25519MLKEM768 share", id)
+		}
+	}
+}
+
+// A full handshake with a Go TLS 1.3 server, then a second connection with
+// the session cache filled: the spec has no pre_shared_key, so the second
+// hello must still be built (no utls panic) and complete.
+func TestFirefox160Handshake(t *testing.T) {
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	template := &x509.Certificate{SerialNumber: big.NewInt(1), DNSNames: []string{"example.com"}, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour)}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	serverConfig := &tls.Config{Certificates: []tls.Certificate{{Certificate: [][]byte{der}, PrivateKey: key}}}
+	go func() {
+		for {
+			conn, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			go func() {
+				defer conn.Close()
+				server := tls.Server(conn, serverConfig)
+				if server.Handshake() == nil {
+					_, _ = server.Write([]byte{1})
+					_, _ = io.Copy(io.Discard, server)
+				}
+			}()
+		}
+	}()
+
+	config := &utls.Config{ServerName: "example.com", InsecureSkipVerify: true, ClientSessionCache: utls.NewLRUClientSessionCache(1)}
+	for i := 0; i < 2; i++ {
+		conn, err := net.Dial("tcp", ln.Addr().String())
+		if err != nil {
+			t.Fatal(err)
+		}
+		_ = conn.SetDeadline(time.Now().Add(5 * time.Second))
+		uConn := UClient(conn, config, HelloFirefox160)
+		if err := uConn.Handshake(); err != nil {
+			t.Fatalf("handshake %d: %v", i, err)
+		}
+		if _, err := io.ReadFull(uConn, make([]byte, 1)); err != nil {
+			t.Fatalf("read %d: %v", i, err)
+		}
+		if _, ok := parseClientHello(t, uConn.HandshakeState.Hello.Raw).extensions[0xfe0d]; !ok {
+			t.Fatalf("hello %d is not Firefox 160", i)
+		}
+		_ = uConn.Close()
+	}
+}
